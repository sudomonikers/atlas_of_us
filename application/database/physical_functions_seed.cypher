  { code: "b7650", parent: "b765" },
  { code: "b7651", parent: "b765" },
  { code: "b7652", parent: "b765" },
  { code: "b7653", parent: "b765" },
  { code: "b7800", parent: "b780" },
  { code: "b7801", parent: "b780" }
] AS c
MATCH (n:BodyFunction {code: c.code}), (p:BodyFunction {code: c.parent})
MERGE (n)-[:SUBFUNCTION_OF]->(p);


