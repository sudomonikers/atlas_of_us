  { code: "b7401", name: "Endurance of muscle groups", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Muscle functions", sourceUri: "http://id.who.int/icd/entity/1521707777",
    description: "Functions related to sustaining muscle contraction of isolated muscle groups for the required period of time.",
    includes: [], excludes: [] },
  { code: "b7402", name: "Endurance of all muscles of the body", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Muscle functions", sourceUri: "http://id.who.int/icd/entity/1674298945",
    description: "Functions related to sustaining muscle contraction of all muscles of the body for the required period of time.",
    includes: [], excludes: [] },
  { code: "b750", name: "Motor reflex functions", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1777008610",
    description: "Functions of involuntary contraction of muscles automatically induced by specific stimuli.",
    includes: ["automatic local joint reflex", "emergence and persistence of reflexes"], excludes: [] },
  { code: "b7500", name: "Stretch motor reflex", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1434015402",
    description: "Functions of involuntary contractions of muscles automatically induced by stretching.",
    includes: ["ankle reflex", "biceps reflex", "patellar reflex", "quadriceps reflex", "radius reflex"], excludes: [] },
  { code: "b7501", name: "Reflexes generated by noxious stimuli", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1112617578",
    description: "Functions of involuntary contractions of muscles automatically induced by painful or other noxious stimuli.",
    includes: ["withdrawal reflex"], excludes: [] },
  { code: "b7502", name: "Reflexes generated by other exteroceptive stimuli", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/2066325290",
    description: "Functions of involuntary contractions of muscles automatically induced by external stimuli other than noxious stimuli.",
    includes: ["other primitive reflexes", "rooting", "sucking"], excludes: [] },
  { code: "b755", name: "Involuntary movement reaction functions", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/576915490",
    description: "Functions of involuntary contractions of large muscles or the whole body induced by body position, balance and threatening stimuli.",
    includes: ["balance reactions", "body adjustment reactions", "defensive reactions", "functions of postural reactions", "righting reactions", "supporting reactions"], excludes: ["Motor reflex functions"] },
  { code: "b760", name: "Control of voluntary movement functions", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/838096586",
    description: "Functions associated with control over and coordination of voluntary movements.",
    includes: [], excludes: ["Gait pattern functions", "Involuntary movement functions", "Muscle power functions"] },
  { code: "b7600", name: "Control of simple voluntary movements", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1490109614",
    description: "Functions associated with control over and coordination of simple or isolated voluntary movements.",
    includes: [], excludes: [] },
  { code: "b7601", name: "Control of complex voluntary movements", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1341726830",
    description: "Functions associated with control over and coordination of complex voluntary movements.",
    includes: [], excludes: [] },
  { code: "b7602", name: "Coordination of voluntary movements", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1988201774",
    description: "Functions associated with coordination of simple and complex voluntary movements, performing movements in an orderly combination.",
    includes: ["coordination of visually directed movements", "eye foot coordination", "eye hand coordination", "right left coordination"], excludes: [] },
  { code: "b7603", name: "Supportive functions of arm or leg", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1638525422",
    description: "Functions associated with control over and coordination of voluntary movements by placing weight either on the arms (elbows or hands) or on the legs (knees or feet).",
    includes: [], excludes: [] },
  { code: "b761", name: "Spontaneous movements", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/651964938",
    description: "Functions associated with frequency, fluency and complexity of total and individual body-part movements such as infant spontaneous movements and patterns of movement.",
    includes: [], excludes: ["Motor reflex functions", "Involuntary movement reaction functions", "Involuntary movement functions"] },
  { code: "b7610", name: "General movements", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/638312055",
    description: "Repertoire and quality of age-specific general spontaneous movements such as \"writhing\" movements and \"fidgety\" movements in early life.",
    includes: [], excludes: [] },
  { code: "b7611", name: "Specific spontaneous movements", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/824425143",
    description: "Repertoire and quality of other spontaneous movements normally present in the first postnatal months, such as arm and leg movements toward midline, finger movements and kicking.",
    includes: [], excludes: [] },
  { code: "b765", name: "Involuntary movement functions", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/2055053578",
    description: "Functions of unintentional, non- or semi-purposive involuntary contractions of a muscle or group of muscles.",
    includes: [], excludes: ["Control of voluntary movement functions", "Gait pattern functions"] },
  { code: "b7650", name: "Involuntary contractions of muscles", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1326268458",
    description: "Functions of unintentional, non- or semi-purposive involuntary contractions of a muscle or group of muscles, such as those involved in part of a psychological dysfunction.",
    includes: [], excludes: [] },
  { code: "b7651", name: "Tremor", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1478829290",
    description: "Functions of alternating contraction and relaxation of a group of muscles around a joint, resulting in shakiness.",
    includes: [], excludes: [] },
  { code: "b7652", name: "Tics and mannerisms", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1633520042",
    description: "Functions of repetitive, quasi-purposive, involuntary contractions of a group of muscles.",
    includes: [], excludes: [] },
  { code: "b7653", name: "Stereotypies and motor perseveration", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1987439978",
    description: "Functions of spontaneous, non-purposive movements such as repetitively rocking to and fro and nodding the head or wiggling.",
    includes: [], excludes: [] },
  { code: "b770", name: "Gait pattern functions", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1328466963",
    description: "Functions of movement patterns associated with walking, running or other whole body movements.",
    includes: ["running patterns"], excludes: ["Control of voluntary movement functions", "Involuntary movement functions", "Muscle power functions", "Muscle tone functions"] },
  { code: "b780", name: "Sensations related to muscles and movement functions", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/1405368356",
    description: "Sensations associated with the muscles or muscle groups of the body and their movement.",
    includes: ["sensations of heaviness of muscles"], excludes: ["Sensation of pain"] },
  { code: "b7800", name: "Sensation of muscle stiffness", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/841397411",
    description: "Sensation of tightness or stiffness of muscles.",
    includes: [], excludes: [] },
  { code: "b7801", name: "Sensation of muscle spasm", group: "Neuromusculoskeletal and movement-related functions", subgroup: "Movement functions", sourceUri: "http://id.who.int/icd/entity/621727843",
    description: "Sensation of involuntary contraction of a muscle or a group of muscles.",
    includes: ["muscle constriction"], excludes: [] },
  { code: "b810", name: "Protective functions of the skin", group: "Functions of the skin and related structures", subgroup: "Functions of the skin", sourceUri: "http://id.who.int/icd/entity/1928972505",
    description: "Functions of the skin for protecting the body from physical, chemical and biological threats.",
    includes: ["callus formation", "functions of protecting against the sun and other radiation", "hardening", "insulating function of skin", "photosensitivity", "pigmentation", "quality of skin"], excludes: ["Repair functions of the skin", "Other functions of the skin"] },
  { code: "b820", name: "Repair functions of the skin", group: "Functions of the skin and related structures", subgroup: "Functions of the skin", sourceUri: "http://id.who.int/icd/entity/719806961",
    description: "Functions of the skin for repairing breaks and other damage to the skin.",
    includes: ["bruising", "functions of scab formation", "healing", "keloid formation", "scarring"], excludes: ["Protective functions of the skin", "Other functions of the skin"] },
  { code: "b830", name: "Other functions of the skin", group: "Functions of the skin and related structures", subgroup: "Functions of the skin", sourceUri: "http://id.who.int/icd/entity/1413348136",
    description: "Functions of the skin other than protection and repair, such as regulating body temperature via sweat, regulating changes in peripheral circulation and fluid balance via sweat, reservoir for the synthesis of vitamin D.",
    includes: ["functions of sweating", "glandular functions of the skin and resulting body odour"], excludes: ["Protective functions of the skin", "Repair functions of the skin"] },
  { code: "b840", name: "Sensation related to the skin", group: "Functions of the skin and related structures", subgroup: "Functions of the skin", sourceUri: "http://id.who.int/icd/entity/1696975967",
    description: "Sensations related to the skin such as itching, burning sensation and tingling.",
    includes: [], excludes: ["Sensation of pain"] },
  { code: "b850", name: "Functions of hair", group: "Functions of the skin and related structures", subgroup: "Functions of the hair and nails", sourceUri: "http://id.who.int/icd/entity/469718664",
    description: "Functions of the hair, such as protection, coloration and appearance.",
    includes: ["functions of growth of hair", "location of hair", "pigmentation of hair"], excludes: [] },
  { code: "b860", name: "Functions of nails", group: "Functions of the skin and related structures", subgroup: "Functions of the hair and nails", sourceUri: "http://id.who.int/icd/entity/1138884528",
    description: "Functions of the nails, such as protection, scratching and appearance.",
    includes: ["growth of nails", "pigmentation of nails", "quality of nails"], excludes: [] }
] AS c
MERGE (n:BodyFunction {code: c.code})
ON CREATE SET n.id = randomUUID()
SET n.name = c.name,
    n.group = c.group,
    n.subgroup = c.subgroup,
    n.sourceUri = c.sourceUri,
    n.description = c.description,
    n.includes = c.includes,
    n.excludes = c.excludes;

