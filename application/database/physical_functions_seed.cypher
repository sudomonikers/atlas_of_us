// -----------------------------------------------------------------------------
// 0. Constraints
// -----------------------------------------------------------------------------

CREATE CONSTRAINT bodyfunction_code_unique IF NOT EXISTS
FOR (n:BodyFunction) REQUIRE n.code IS UNIQUE;

CREATE CONSTRAINT bodyfunction_id_unique IF NOT EXISTS
FOR (n:BodyFunction) REQUIRE n.id IS UNIQUE;


