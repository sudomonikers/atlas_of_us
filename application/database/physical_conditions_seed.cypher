  { sourceId: "MONDO:0006559", source: "Mondo", name: "hidradenitis suppurativa", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0006559",
    description: "A chronic suppurative and cicatricial disease of the apocrine glands occurring chiefly in the axillae in women and in the groin and anal regions in men. It is characterized by poral occlusion with secondary bacterial infection, evolving into abscesses which eventually rupture. As the disease becomes chronic, ulcers appear, sinus tracts enlarge, fistulas develop, and fibrosis and scarring become evident.",
    synonyms: ["acne inversa", "ectopic acne", "fox den disease", "hidradenitis suppurativa", "pyoderma fistulans significa", "verneuil disease"],
