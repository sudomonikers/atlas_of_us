    ancestors: ["MONDO:0000001", "MONDO:0002022", "MONDO:0003847", "MONDO:0004892", "MONDO:0005328", "MONDO:0024458", "MONDO:0100581", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0004891", source: "Mondo", name: "hyperopia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0004891",
    description: "A refractive error in which rays of light entering the eye parallel to the optic axis are brought to a focus behind the retina, as a result of the eyeball being too short from front to back. It is also called farsightedness because the near point is more distant than it is in emmetropia with an equal amplitude of accommodation. (Dorland, 27th ed)",
    synonyms: ["hypermetropia"],
    ancestors: ["MONDO:0000001", "MONDO:0002022", "MONDO:0004892", "MONDO:0005328", "MONDO:0024458", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0011284", source: "Mondo", name: "astigmatism", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0011284",
    description: "Unequal curvature of the refractive surfaces of the eye. Thus a point source of light cannot be brought to a point focus on the retina but is spread over a more or less diffuse area. This results from the radius of curvature in one plane being longer or shorter than the radius at right angles to it. (Dorland, 27th ed)",
    synonyms: ["astigmatism", "astigmatism (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0002022", "MONDO:0004892", "MONDO:0005328", "MONDO:0024458", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0001330", source: "Mondo", name: "presbyopia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001330",
    description: "The normal decreasing elasticity of the crystalline lens that leads to loss of accommodation.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0000926", "MONDO:0002022", "MONDO:0004892", "MONDO:0005328", "MONDO:0024458", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0001703", source: "Mondo", name: "color vision disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001703",
    description: "The absence of or defect in the perception of colors.",
    synonyms: ["blindness color", "blindness colour", "color blindness", "color vision defects", "color vision deficiency", "color-vision disease", "colour vision defects"],
    ancestors: ["MONDO:0000001", "MONDO:0021084", "MONDO:0024458", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0000662", source: "HPO", name: "Nyctalopia", sourceUri: "http://purl.obolibrary.org/obo/HP_0000662",
    description: "Inability to see well at night or in poor light.",
    synonyms: ["Night blindness", "Night-blindness", "Poor night vision"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000478", "HP:0000504", "HP:0012373"] },
  { sourceId: "HP:0000613", source: "HPO", name: "Photophobia", sourceUri: "http://purl.obolibrary.org/obo/HP_0000613",
    description: "Excessive sensitivity to light with the sensation of discomfort or pain in the eyes due to exposure to bright light.",
    synonyms: ["Extreme sensitivity of the eyes to light", "Light hypersensitivity", "Photodysphoria"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000478", "HP:0000504", "HP:0000707", "HP:0000708", "HP:0011446", "HP:0012373", "HP:0012638", "HP:5200046", "HP:5200058"] },
  { sourceId: "HP:0000505", source: "HPO", name: "Visual impairment", sourceUri: "http://purl.obolibrary.org/obo/HP_0000505",
    description: "Visual impairment (or vision impairment) is vision loss (of a person) to such a degree as to qualify as an additional support need through a significant limitation of visual capability resulting from either disease, trauma, or congenital or degenerative conditions that cannot be corrected by conventional means, such as refractive correction, medication, or surgery.",
    synonyms: ["Impaired vision", "Loss of eyesight", "Poor vision", "Visual impairment"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000478", "HP:0000504", "HP:0012373"] },
  { sourceId: "HP:0000618", source: "HPO", name: "Blindness", sourceUri: "http://purl.obolibrary.org/obo/HP_0000618",
    description: "Blindness is the condition of lacking visual perception defined as a profound reduction in visual perception. On the 6m visual acuity scale, blindness is defined as less than 3/60. On the 20ft visual acuity scale, blindness is defined as less than 20/400. On the decimal visual acuity scale, blindness is defined as less than 0.05. Blindness is typically characterized by a visual field of no greater than 10 degrees in radius around central fixation.",
    synonyms: ["Blindness", "Total vision loss"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000478", "HP:0000504", "HP:0000505", "HP:0007663", "HP:0012373"] },
  { sourceId: "MONDO:0005041", source: "Mondo", name: "glaucoma", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005041",
    description: "Increased pressure in the eyeball due to obstruction of the outflow of aqueous humor.",
    synonyms: ["glaucoma", "glaucoma (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0002022", "MONDO:0005328", "MONDO:0024458", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0005129", source: "Mondo", name: "cataract", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005129",
    description: "Partial or complete opacity of the crystalline lens of one or both eyes that decreases visual acuity and eventually results in blindness. Some cataracts appear in infancy or in childhood, but most develop in older individuals. (Sternberg Diagnostic Surgical Pathology, 3rd ed.)",
    synonyms: ["cataract", "cataract (disease)", "opacity of the lens"],
    ancestors: ["MONDO:0000001", "MONDO:0001176", "MONDO:0002022", "MONDO:0003847", "MONDO:0005328", "MONDO:0024458", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0005150", source: "Mondo", name: "age-related macular degeneration", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005150",
    description: "Age-related loss of vision in the central portion of the retina (macula), secondary to retinal degeneration.",
    synonyms: ["age-related macular degeneration", "AMD", "ARMD", "macular degeneration, age-related", "Senile macular retinal degeneration"],
    ancestors: ["MONDO:0000001", "MONDO:0002022", "MONDO:0002175", "MONDO:0003004", "MONDO:0003847", "MONDO:0004580", "MONDO:0005071", "MONDO:0005283", "MONDO:0005328", "MONDO:0019118", "MONDO:0024458", "MONDO:0100545", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0015486", source: "Mondo", name: "keratoconus", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0015486",
    description: "A degenerative, structural disorder of the eye, characterized by a cone-shaped protrusion of the cornea. It may lead to visual disturbances.",
    synonyms: ["keratoconus", "keratoconus (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0000942", "MONDO:0002022", "MONDO:0003847", "MONDO:0005328", "MONDO:0024458", "MONDO:0100581", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0001020", source: "Mondo", name: "amblyopia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001020",
    description: "Decreased vision that results from abnormal visual development.",
    synonyms: ["amblyopia", "amblyopia (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0021084", "MONDO:0024458", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0003432", source: "Mondo", name: "strabismus", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0003432",
    description: "Strabismus is the intermittent or constant misalignment of an eye so that its line of vision is not pointed at the same object as the other eye. Strabismus is caused by an imbalance in the extraocular muscles which control the positioning of the eyes. Strabismus is normal in newborns but should resolve by the time the baby is 6 months old. In older children with strabismus, the brain may learn to ignore the input from one eye, and this may lead to amblyopia, a potentially permanent decrease in vision in that eye if not corrected.",
    synonyms: ["squint", "strabismus"],
    ancestors: ["MONDO:0000001", "MONDO:0001584", "MONDO:0003569", "MONDO:0005071", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0000639", source: "HPO", name: "Nystagmus", sourceUri: "http://purl.obolibrary.org/obo/HP_0000639",
    description: "Rhythmic, involuntary oscillations of one or both eyes related to abnormality in fixation, conjugate gaze, or vestibular mechanisms.",
    synonyms: ["Involuntary, rapid, rhythmic eye movements"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000478", "HP:0000496", "HP:0012373", "HP:0012547"] },
  { sourceId: "MONDO:0006733", source: "Mondo", name: "dry eye syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0006733",
    description: "A syndrome characterized by dryness of the cornea and conjunctiva. It is usually caused by a deficiency in tear production. Symptoms include a feeling of burning eyes and a possible foreign body presence in the eye.",
    synonyms: ["dry eye", "dry eye syndrome", "dry eye(s)", "eye(s), dry", "keratoconjunctivitis sicca", "sicca, keratoconjunctivitis"],
    ancestors: ["MONDO:0000001", "MONDO:0000462", "MONDO:0000942", "MONDO:0001854", "MONDO:0002022", "MONDO:0002254", "MONDO:0003085", "MONDO:0003799", "MONDO:0004768", "MONDO:0005328", "MONDO:0006170", "MONDO:0021166", "MONDO:0024458", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0019200", source: "Mondo", name: "retinitis pigmentosa", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0019200",
    description: "Retinitis pigmentosa (RP) is an inherited retinal dystrophy leading to progressive loss of the photoreceptors and retinal pigment epithelium and resulting in blindness usually after several decades.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0002022", "MONDO:0003847", "MONDO:0004580", "MONDO:0005071", "MONDO:0005283", "MONDO:0005328", "MONDO:0019118", "MONDO:0024458", "MONDO:0100545", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0005266", source: "Mondo", name: "diabetic retinopathy", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005266",
    description: "A chronic, pathological complication associated with diabetes mellitus, where retinal damages are incurred due to microaneurysms in the vasculature of the retina, progressively leading to abnormal blood vessel growth, and swelling and leaking of fluid from blood vessels, resulting in vision loss or blindness.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0002022", "MONDO:0002311", "MONDO:0004995", "MONDO:0005066", "MONDO:0005071", "MONDO:0005283", "MONDO:0005328", "MONDO:0005385", "MONDO:0005552", "MONDO:0024458", "MONDO:0043218", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "HP:0000508", source: "HPO", name: "Ptosis", sourceUri: "http://purl.obolibrary.org/obo/HP_0000508",
    description: "The upper eyelid margin is positioned 3 mm or more lower than usual and covers the superior portion of the iris (objective); or, the upper lid margin obscures at least part of the pupil (subjective).",
    synonyms: ["Blepharoptosis", "Drooping upper eyelid", "Eyelid ptosis", "Palpebral ptosis"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000478", "HP:0012373"] },
  { sourceId: "HP:0001100", source: "HPO", name: "Heterochromia iridis", sourceUri: "http://purl.obolibrary.org/obo/HP_0001100",
    description: "Heterochromia iridis is a difference in the color of the iris in the two eyes.",
    synonyms: ["Different colored eyes", "Different coloured eyes", "Heterochromia irides"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000478", "HP:0000525", "HP:0000553", "HP:0004328", "HP:0008034", "HP:0012372", "HP:0200064"] },
  { sourceId: "HP:0000365", source: "HPO", name: "Hearing impairment", sourceUri: "http://purl.obolibrary.org/obo/HP_0000365",
    description: "A decreased magnitude of the sensory perception of sound.",
    synonyms: ["Deafness", "Hearing defect", "Hearing impairment", "Hypacusis"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000364", "HP:0000598", "HP:0031704"] },
  { sourceId: "HP:0009900", source: "HPO", name: "Unilateral deafness", sourceUri: "http://purl.obolibrary.org/obo/HP_0009900",
    description: "A unilateral absence of sensory perception of sound.",
    synonyms: ["Deafness in one ear", "Deafness, unilateral"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000364", "HP:0000365", "HP:0000598", "HP:0031704"] },
  { sourceId: "MONDO:0020678", source: "Mondo", name: "sensorineural hearing loss disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0020678",
    description: "Hearing loss in which the root cause lies in the inner ear or sensory organ (cochlea and associated structures) or the vestibulocochlear nerve (cranial nerve VIII).",
    synonyms: ["sensorineural deafness", "sensorineural hearing loss", "SNHL"],
    ancestors: ["MONDO:0000001", "MONDO:0002409", "MONDO:0005365", "MONDO:0021945", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0000360", source: "HPO", name: "Tinnitus", sourceUri: "http://purl.obolibrary.org/obo/HP_0000360",
    description: "Tinnitus is an auditory perception that can be described as the experience of sound, in the ear or in the head, in the absence of external acoustic stimulation.",
    synonyms: ["Ringing in ears", "Ringing in the ears"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000364", "HP:0000598", "HP:0031704"] },
  { sourceId: "HP:0010780", source: "HPO", name: "Hyperacusis", sourceUri: "http://purl.obolibrary.org/obo/HP_0010780",
    description: "Over-sensitivity to certain frequency ranges of sound.",
    synonyms: [],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0000708", "HP:0011446", "HP:0012638", "HP:5200046", "HP:5200058", "HP:5200060"] },
  { sourceId: "MONDO:0007972", source: "Mondo", name: "Meniere disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007972",
    description: "A disease of the inner ear (labyrinth) that is characterized by fluctuating sensorineural hearing loss; tinnitus; episodic vertigo; and aural fullness. It is the most common form of endolymphatic hydrops.",
    synonyms: ["Meniere disease"],
    ancestors: ["MONDO:0000001", "MONDO:0002409", "MONDO:0002467", "MONDO:0002643", "MONDO:0003847", "MONDO:0004900", "MONDO:0006744", "MONDO:0018751", "MONDO:0021205", "MONDO:0024623", "MONDO:0037940", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0005349", source: "Mondo", name: "otosclerosis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005349",
    description: "Formation of spongy bone in the labyrinth capsule which can progress toward the stapes (stapedial fixation) or anteriorly toward the cochlea leading to conductive, sensorineural, or mixed hearing loss. Several genes are associated with familial otosclerosis with varied clinical signs.",
    synonyms: ["otosclerosis", "otosclerosis (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0002409", "MONDO:0002467", "MONDO:0003847", "MONDO:0018751", "MONDO:0021205", "MONDO:0024623", "MONDO:0037940", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "HP:0002321", source: "HPO", name: "Vertigo", sourceUri: "http://purl.obolibrary.org/obo/HP_0002321",
    description: "An abnormal sensation of spinning while the body is actually stationary.",
    synonyms: ["Dizzy spell"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000598", "HP:0001751", "HP:0011389", "HP:0031704"] },
  { sourceId: "HP:0000458", source: "HPO", name: "Anosmia", sourceUri: "http://purl.obolibrary.org/obo/HP_0000458",
    description: "An inability to perceive odors. This is a general term describing inability to smell arising in any part of the process of smelling from absorption of odorants into the nasal mucous overlying the olfactory epithelium, diffusion to the cilia, binding to olfactory receptor sites, generation of action potentials in olfactory neurons, and perception of a smell.",
    synonyms: ["Loss of smell", "Lost smell"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000152", "HP:0000234", "HP:0000271", "HP:0000366", "HP:0000707", "HP:0004408", "HP:0012638"] },
  { sourceId: "HP:0410030", source: "HPO", name: "Cleft lip", sourceUri: "http://purl.obolibrary.org/obo/HP_0410030",
    description: "A gap in the lip or lips.",
    synonyms: ["Cleft lip", "Cleft of the lip"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000152", "HP:0000153", "HP:0000159", "HP:0000163", "HP:0000234", "HP:0000271", "HP:0031816"] },
  { sourceId: "MONDO:0005300", source: "Mondo", name: "chronic kidney disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005300",
    description: "Impairment of the renal function secondary to chronic kidney damage persisting for three or more months.",
    synonyms: ["chronic kidney disease", "chronic renal disease", "CKD - chronic kidney disease", "kidney disease, chronic"],
    ancestors: ["MONDO:0000001", "MONDO:0002118", "MONDO:0005240", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0008171", source: "Mondo", name: "nephrolithiasis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0008171",
    description: "The presence of a calculus in the pelvis of the kidney; this is most often composed of mineral salts and proteins.",
    synonyms: ["calculus of kidney and ureter", "kidney stone", "renal calculi"],
    ancestors: ["MONDO:0000001", "MONDO:0002118", "MONDO:0005240", "MONDO:0024647", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0020642", source: "Mondo", name: "polycystic kidney disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0020642",
    description: "A usually autosomal dominant and less frequently autosomal recessive genetic disorder characterized by the presence of numerous cysts in the kidneys leading to end-stage renal failure. The autosomal dominant trait is associated with abnormalities on the short arm of chromosome 16. Symptoms in patients with the autosomal dominant trait usually appear at middle age and include abdominal pain, hematuria, and high blood pressure. Patients may develop brain aneurysms and liver cysts. Patients with the autosomal recessive trait present with progressive renal failure early in life and symptoms resulting from hepatic fibrosis. The autosomal recessive trait is associated with abnormalities of chromosome 6. Polycystic kidney disease may also result as a side effect in patients on renal dialysis.",
    synonyms: ["fibrocystic renal disease", "PKD - polycystic kidney disease", "polycystic kidney disease"],
    ancestors: ["MONDO:0000001", "MONDO:0002118", "MONDO:0002473", "MONDO:0003847", "MONDO:0005240", "MONDO:0019741", "MONDO:0100191", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0006624", source: "Mondo", name: "overactive bladder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0006624",
    description: "Symptom of overactive detrusor muscle of the urinary bladder that contracts with abnormally high frequency and urgency. Overactive bladder is characterized by the frequent feeling of needing to urinate during the day, during the night, or both. urinary incontinence may or may not be present.",
    synonyms: ["overactive bladder", "overactive bladder (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0002118", "MONDO:0006026", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0000020", source: "HPO", name: "Urinary incontinence", sourceUri: "http://purl.obolibrary.org/obo/HP_0000020",
    description: "Loss of the ability to control the urinary bladder leading to involuntary urination.",
    synonyms: ["Bladder incontinence", "Loss of bladder control"],
    ancestors: ["HP:0000001", "HP:0000009", "HP:0000014", "HP:0000079", "HP:0000118", "HP:0000119", "HP:0010936", "HP:0025142", "HP:0031058", "HP:0031064"] },
  { sourceId: "HP:0000012", source: "HPO", name: "Urinary urgency", sourceUri: "http://purl.obolibrary.org/obo/HP_0000012",
    description: "Urge incontinence is the strong, sudden need to urinate.",
    synonyms: ["Overactive bladder", "Urgent micturition", "Urinary urgency"],
    ancestors: ["HP:0000001", "HP:0000009", "HP:0000014", "HP:0000079", "HP:0000118", "HP:0000119", "HP:0010936"] },
  { sourceId: "MONDO:0018301", source: "Mondo", name: "interstitial cystitis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0018301",
    description: "A rare chronic debilitating urogenital disease characterized by urinary frequency, urgency, and pelvic pain.",
    synonyms: ["bladder pain syndrome", "chronic interstitial cystitis", "IC/BPS", "IC/PBS", "interstitial cystitis, chronic", "interstitial cystitis/bladder pain syndrome", "interstitial cystitis/painful bladder syndrome", "painful bladder syndrome"],
    ancestors: ["MONDO:0000001", "MONDO:0002118", "MONDO:0003900", "MONDO:0006026", "MONDO:0006030", "MONDO:0006032", "MONDO:0021166", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0010811", source: "Mondo", name: "benign prostatic hyperplasia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0010811",
    description: "A non-cancerous nodular enlargement of the prostate gland. It is characterized by the presence of epithelial cell nodules, and stromal nodules containing fibrous and smooth muscle elements. It is the most common urologic disorder in men, causing blockage of urine flow.",
    synonyms: ["benign hyperplasia of prostate", "benign hyperplasia of the prostate", "benign prostate hyperplasia", "benign prostatic hyperplasia", "benign prostatic hyperplasia (disease)", "benign prostatic hyperplasia - BPH", "benign prostatic Hypertrophy", "benign prostatic hypertrophy"],
    ancestors: ["MONDO:0000001", "MONDO:0003105", "MONDO:0003150", "MONDO:0005039", "MONDO:0005043", "MONDO:0045024", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008"] },
  { sourceId: "MONDO:0005133", source: "Mondo", name: "endometriosis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005133",
    description: "The growth of functional endometrial tissue in anatomic sites outside the uterine body. It most often occurs in the pelvic organs.",
    synonyms: ["endometriosis", "endometriosis (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0000931", "MONDO:0002263", "MONDO:0002654", "MONDO:0005039", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0010888", source: "Mondo", name: "adenomyosis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0010888",
    description: "The growth of endometrial tissue inside the muscular wall of the uterine corpus. Clinical manifestations include pain, dysmenorrhea, and menorrhagia.",
    synonyms: ["adenomyosis of the uterus", "adenomyosis of uterus", "endometriosis (disease) of myometrium", "endometriosis interna", "endometriosis of myometrium", "endometriosis of uterus", "endometriosis, myometrium", "myometrium endometriosis (disease)", "uterine adenomyosis", "uterine corpus adenomyosis", "uterus corpus adenomyosis"],
    ancestors: ["MONDO:0000001", "MONDO:0000931", "MONDO:0002263", "MONDO:0002654", "MONDO:0005039", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0007886", source: "Mondo", name: "uterine corpus leiomyoma", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007886",
    description: "A benign smooth muscle neoplasm arising from the body of the uterus. It is characterized by the presence of spindle cells with cigar-shaped nuclei, interlacing fascicles, and a whorled pattern.",
    synonyms: ["body of uterus fibroid", "body of uterus leiomyoma", "corpus uteri fibroid", "corpus uteri leiomyoma", "fibroid of body of uterus", "fibroid of corpus uteri", "fibroid of the body of uterus", "fibroid of the corpus uteri", "fibroid of the uterine body", "fibroid of the uterine corpus", "fibroid of uterine body", "fibroid of uterine corpus", "leiomyoma of body of uterus", "leiomyoma of corpus uteri", "leiomyoma of the body of uterus", "leiomyoma of the corpus uteri", "leiomyoma of the uterine body", "leiomyoma of the uterine corpus", "leiomyoma of uterine body", "leiomyoma of uterine corpus", "uterine body fibroid", "uterine body leiomyoma", "uterine corpus fibroid", "uterine corpus leiomyoma", "uterine corpus leiomyomata", "uterine fibroid"],
    ancestors: ["MONDO:0000001", "MONDO:0000383", "MONDO:0000624", "MONDO:0000632", "MONDO:0000636", "MONDO:0001572", "MONDO:0002081", "MONDO:0002263", "MONDO:0002616", "MONDO:0002654", "MONDO:0003061", "MONDO:0003847", "MONDO:0003900", "MONDO:0003939", "MONDO:0005039", "MONDO:0005070", "MONDO:0005165", "MONDO:0005167", "MONDO:0006054", "MONDO:0006106", "MONDO:0006209", "MONDO:0006975", "MONDO:0021148", "MONDO:0021254", "MONDO:0021353", "MONDO:0021525", "MONDO:0021545", "MONDO:0021581", "MONDO:0023370", "MONDO:0023603", "MONDO:0045024", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "HP:0100607", source: "HPO", name: "Dysmenorrhea", sourceUri: "http://purl.obolibrary.org/obo/HP_0100607",
    description: "Pain during menstruation that interferes with daily activities.",
    synonyms: ["Painful menstruation"],
    ancestors: ["HP:0000001", "HP:0000078", "HP:0000080", "HP:0000118", "HP:0000119", "HP:0000140", "HP:0012531", "HP:0025142", "HP:0030012"] },
  { sourceId: "HP:0000132", source: "HPO", name: "Menorrhagia", sourceUri: "http://purl.obolibrary.org/obo/HP_0000132",
    description: "Prolonged and excessive menses at regular intervals in excess of 80 mL or lasting longer than 7 days.",
    synonyms: ["Abnormally heavy bleeding during menstruation", "Abnormally heavy periods", "Hypermenorrhea"],
    ancestors: ["HP:0000001", "HP:0000078", "HP:0000080", "HP:0000118", "HP:0000119", "HP:0000140", "HP:0001871", "HP:0001892", "HP:0030012"] },
  { sourceId: "MONDO:1010182", source: "Mondo", name: "premenstrual dysphoric disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_1010182",
    description: "A severe form of premenstrual syndrome (PMS) that involves significant emotional and physical symptoms in the week or two before a period.",
    synonyms: ["PMDD"],
    ancestors: ["MONDO:0000001", "MONDO:0002263", "MONDO:0004169", "MONDO:0005039", "MONDO:0700096", "MONDO:1060204", "MONDO:7770006"] },
  { sourceId: "MONDO:0005047", source: "Mondo", name: "infertility disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005047",
    description: "Inability to conceive for at least one year after trying and having unprotected sex. Causes of female infertility include endometriosis, fallopian tubes obstruction, and polycystic ovary syndrome. Causes of male infertility include abnormal sperm production or function, blockage of the epididymis, blockage of the ejaculatory ducts, hypospadias, exposure to pesticides, and health related issues.",
    synonyms: ["fertility disorders", "infertile", "Sterile", "sterile", "sterility"],
    ancestors: ["MONDO:0000001", "MONDO:0005039", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0005362", source: "Mondo", name: "erectile dysfunction", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005362",
    description: "Persistent or recurrent inability to achieve or to maintain an erection during sexual activity.",
    synonyms: ["erectile dysfunction", "erectile dysfunction (disease)", "male erectile Disorder", "sexual impotence (finding)"],
    ancestors: ["MONDO:0000001", "MONDO:0002036", "MONDO:0002134", "MONDO:0003150", "MONDO:0005039", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0008608", source: "Mondo", name: "Down syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0008608",
    description: "Down syndrome is a chromosomal abnormality caused by the presence of a third (partial or total) copy of the chromosome 21 genetic material and that is characterized by variable intellectual disability, muscular hypotonia, and joint laxity, often associated with a characteristic facial dysmorphism and various anomalies such as cardiac, gastrointestinal, or endocrine defects.",
    synonyms: ["Down syndrome", "Down syndrome, Isolated cases", "Down's syndrome", "leukemia, megakaryoblastic, with or without Down syndrome, somatic", "trisomy 21 (Down syndrome)"],
    ancestors: ["MONDO:0000001", "MONDO:0019040", "MONDO:0020049", "MONDO:0700096", "MONDO:0700124", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0019499", source: "Mondo", name: "Turner syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0019499",
    description: "Turner syndrome is a chromosomal disorder associated with the complete or partial absence of an X chromosome.",
    synonyms: ["45,X gonadal dysgenesis", "45,X syndrome", "45,X/46,XX syndrome", "45,X0 syndrome", "45X syndrome", "karyotype 45, X"],
    ancestors: ["MONDO:0000001", "MONDO:0001889", "MONDO:0001967", "MONDO:0002145", "MONDO:0002146", "MONDO:0002254", "MONDO:0002259", "MONDO:0002263", "MONDO:0003847", "MONDO:0005039", "MONDO:0005047", "MONDO:0005151", "MONDO:0005387", "MONDO:0005558", "MONDO:0015514", "MONDO:0017975", "MONDO:0019755", "MONDO:0019852", "MONDO:0021124", "MONDO:0021147", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0006823", source: "Mondo", name: "Klinefelter syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0006823",
    description: "A sex chromosome disorder caused by the presence of an extra X chromosome in the male karyotype. Affected individuals are infertile and have a small penis and testes. They tend to have tall stature and long legs and may have difficulties with speech and language development. Gynecomastia may be present.",
    synonyms: ["47,XXY syndrome", "Klinefelter syndrome", "Klinefelter's syndrome", "Klinefelter's syndrome, XXY", "XXY syndrome", "XXY syndrome (Klinefelter syndrome)"],
    ancestors: ["MONDO:0000001", "MONDO:0002145", "MONDO:0002259", "MONDO:0005039", "MONDO:0005151", "MONDO:0017975", "MONDO:0019040", "MONDO:0019755", "MONDO:0020058", "MONDO:0021147", "MONDO:0700027", "MONDO:0700064", "MONDO:0700065", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0010383", source: "Mondo", name: "fragile X syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0010383",
    description: "A genetic syndrome caused by mutations in the FMR1 gene which is responsible for the expression of the fragile X mental retardation 1 protein. This protein participates in neural development. This syndrome is manifested with mental, emotional, behavioral, physical, and learning disabilities.",
    synonyms: ["fragile X intellectual disability syndrome", "Fragile X syndrome, X-linked dominant", "FraX syndrome", "FRAXA syndrome", "FXS", "marker X syndrome", "Martin-Bell syndrome"],
    ancestors: ["MONDO:0000001", "MONDO:0002254", "MONDO:0003847", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0009861", source: "Mondo", name: "phenylketonuria", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0009861",
    description: "A rare inborn error of amino acid metabolism characterized by elevated blood phenylalanine and low levels or absence of phenylalanine hydroxylase enzyme. If not detected early or left untreated, the disorder manifests with mild to severe mental disability.",
    synonyms: ["PKU"],
    ancestors: ["MONDO:0000001", "MONDO:0000429", "MONDO:0003847", "MONDO:0004736", "MONDO:0005066", "MONDO:0006025", "MONDO:0017306", "MONDO:0019052", "MONDO:0019189", "MONDO:0019235", "MONDO:0037871", "MONDO:0700096", "MONDO:1060259", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0018975", source: "Mondo", name: "neurofibromatosis type 1", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0018975",
    description: "A clinically heterogeneous, neurocutaneous genetic disorder characterized by cafe-au-lait spots, iris Lisch nodules, axillary and inguinal freckling, and multiple neurofibromas.",
    synonyms: ["Neurofibromatosis 1", "neurofibromatosis 1", "neurofibromatosis type i", "neurofibromatosis, type 1", "NF1", "Nf1-Microdeletion syndrome", "nonmosaic neurofibromatosis type 1", "nonmosaic NF1", "peripheral neurofibromatosis"],
    ancestors: ["MONDO:0000001", "MONDO:0000426", "MONDO:0000429", "MONDO:0002254", "MONDO:0003847", "MONDO:0005071", "MONDO:0015356", "MONDO:0019755", "MONDO:0020573", "MONDO:0021058", "MONDO:0021060", "MONDO:0021061", "MONDO:0021147", "MONDO:0021635", "MONDO:0023370", "MONDO:0042489", "MONDO:0042983", "MONDO:0045024", "MONDO:0100545", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009", "MONDO:7770011"] },
  { sourceId: "MONDO:0007254", source: "Mondo", name: "breast cancer", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007254",
    description: "A primary or metastatic malignant neoplasm involving the breast. The vast majority of cases are carcinomas arising from the breast parenchyma or the nipple. Malignant breast neoplasms occur more frequently in females than in males.",
    synonyms: ["breast cancer", "cancer of breast", "malignant breast neoplasm", "malignant breast tumor", "malignant breast tumour", "malignant neoplasm of breast", "malignant neoplasm of the breast", "malignant tumor of breast", "malignant tumor of the breast", "malignant tumour of breast", "malignant tumour of the breast"],
    ancestors: ["MONDO:0000001", "MONDO:0002657", "MONDO:0003274", "MONDO:0004992", "MONDO:0005070", "MONDO:0021100", "MONDO:0021350", "MONDO:0023370", "MONDO:0045024", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008"] },
  { sourceId: "MONDO:0008315", source: "Mondo", name: "prostate cancer", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0008315",
    description: "A primary or metastatic malignant tumor involving the prostate gland. The vast majority are carcinomas.",
    synonyms: ["cancer of prostate gland", "malignant neoplasm of prostate", "malignant neoplasm of prostate gland", "malignant neoplasm of the prostate", "malignant prostate gland neoplasm", "malignant prostate neoplasm", "malignant prostate tumor", "malignant prostate tumour", "malignant tumor of prostate", "malignant tumor of the prostate", "malignant tumour of prostate", "malignant tumour of the prostate", "prostate gland cancer"],
    ancestors: ["MONDO:0000001", "MONDO:0002149", "MONDO:0003105", "MONDO:0003150", "MONDO:0004992", "MONDO:0005039", "MONDO:0005070", "MONDO:0005836", "MONDO:0006054", "MONDO:0021259", "MONDO:0023370", "MONDO:0024582", "MONDO:0045024", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008"] },
  { sourceId: "MONDO:0005575", source: "Mondo", name: "colorectal cancer", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005575",
    description: "A primary or metastatic malignant neoplasm that affects the colon or rectum. Representative examples include carcinoma, lymphoma, and sarcoma.",
    synonyms: ["cancer of colorectum", "cancer of large bowel", "cancer of large intestine", "cancer of the large bowel", "colon cancer, advanced, somatic", "colon cancer, somatic", "colorectal cancer", "colorectal cancer with chromosomal instability, somatic", "colorectal cancer, autosomal dominant, somatic mutation", "colorectal cancer, somatic", "colorectal cancer, susceptibility to, autosomal dominant, somatic mutation", "colorectum cancer", "malignant colorectal neoplasm", "malignant colorectal tumor", "malignant colorectal tumour", "malignant colorectum neoplasm", "malignant large bowel neoplasm", "malignant large bowel tumor", "malignant large bowel tumour", "malignant large intestine neoplasm", "malignant large intestine tumor", "malignant large intestine tumour", "malignant neoplasm of colorectum", "malignant neoplasm of large bowel", "malignant neoplasm of large intestine", "malignant neoplasm of the large bowel", "malignant neoplasm of the large intestine", "malignant tumor of large bowel", "malignant tumor of large intestine", "malignant tumor of the large bowel", "malignant tumor of the large intestine", "malignant tumour of large bowel", "malignant tumour of large intestine", "malignant tumour of the large bowel", "malignant tumour of the large intestine"],
    ancestors: ["MONDO:0000001", "MONDO:0002516", "MONDO:0004335", "MONDO:0004992", "MONDO:0005020", "MONDO:0005070", "MONDO:0005335", "MONDO:0005814", "MONDO:0021118", "MONDO:0021223", "MONDO:0023370", "MONDO:0024634", "MONDO:0045024", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008"] },
  { sourceId: "MONDO:0008903", source: "Mondo", name: "lung cancer", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0008903",
    description: "A malignant neoplasm involving the lung.",
    synonyms: ["adenocarcinoma of lung, response to tyrosine kinase inhibitor in, autosomal dominant, somatic mutation", "adenocarcinoma of lung, somatic", "cancer of lung", "lung cancer", "lung cancer, protection against, autosomal dominant, somatic mutation", "lung cancer, resistance to, autosomal dominant, somatic mutation", "lung cancer, somatic", "lung cancer, susceptibility to, autosomal dominant, somatic mutation", "malignant lung neoplasm", "malignant lung tumor", "malignant lung tumour", "malignant neoplasm of lung", "malignant neoplasm of the lung", "malignant tumor of lung", "malignant tumor of the lung", "malignant tumour of lung", "malignant tumour of the lung", "nonsmall cell lung cancer, response to tyrosine kinase inhibitor in, autosomal dominant, somatic mutation", "nonsmall cell lung cancer, somatic", "nonsmall cell lung cancer, susceptibility to, autosomal dominant, somatic mutation"],
    ancestors: ["MONDO:0000001", "MONDO:0000270", "MONDO:0000376", "MONDO:0003274", "MONDO:0004992", "MONDO:0005070", "MONDO:0005087", "MONDO:0005275", "MONDO:0020641", "MONDO:0021117", "MONDO:0021350", "MONDO:0023370", "MONDO:0045024", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008"] },
  { sourceId: "MONDO:0005105", source: "Mondo", name: "melanoma", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005105",
    description: "A malignant, usually aggressive tumor composed of atypical, neoplastic melanocytes. Most often, melanomas arise in the skin (cutaneous melanomas) and include the following histologic subtypes: superficial spreading melanoma, nodular melanoma, acral lentiginous melanoma, and lentigo maligna melanoma. Cutaneous melanomas may arise from acquired or congenital melanocytic or dysplastic nevi. Melanomas may also arise in other anatomic sites including the gastrointestinal system, eye, urinary tract, and reproductive system. Melanomas frequently metastasize to lymph nodes, liver, lungs, and brain.",
    synonyms: ["malignant melanoma", "melanoma", "melanoma (disease)", "melanoma, malignant"],
    ancestors: ["MONDO:0000001", "MONDO:0005070", "MONDO:0021143", "MONDO:0021147", "MONDO:0021635", "MONDO:0023370", "MONDO:0045024", "MONDO:0700096", "MONDO:7770007", "MONDO:7770008"] },
  { sourceId: "MONDO:0005059", source: "Mondo", name: "leukemia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005059",
    description: "A malignant (clonal) hematologic disorder, involving hematopoietic stem cells and characterized by the presence of primitive or atypical myeloid or lymphoid cells in the bone marrow and the blood. Leukemias are classified as acute or chronic based on the degree of cellular differentiation and the predominant cell type present. Leukemia is usually associated with anemia, fever, hemorrhagic episodes, and splenomegaly. Common leukemias include acute myeloid leukemia, chronic myelogenous leukemia, acute lymphoblastic or precursor lymphoblastic leukemia, and chronic lymphocytic leukemia. Treatment is vital to patient survival; untreated, the natural course of acute leukemias is normally measured in weeks or months, while that of chronic leukemias is more often measured in months or years.",
    synonyms: ["blood (leukemia)", "leukaemia (disease)", "leukemia", "leukemia (disease)", "leukemia, disease", "leukemia, malignant", "leukemias", "leukemias, general"],
    ancestors: ["MONDO:0000001", "MONDO:0002334", "MONDO:0005070", "MONDO:0005570", "MONDO:0023370", "MONDO:0044881", "MONDO:0045024", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008"] },
  { sourceId: "MONDO:0004952", source: "Mondo", name: "Hodgkins lymphoma", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0004952",
    description: "A heterogeneous group of malignant lymphoid neoplasms of B-cell origin characterized histologically by the presence of Hodgkin and Reed-Sternberg (HRS) cells in the vast majority of cases. There are two distinct subtypes: nodular lymphocyte predominant Hodgkin lymphoma and classical Hodgkin lymphoma. Hodgkin lymphoma involves primarily lymph nodes.",
    synonyms: ["HL", "Hodgkin disease", "Hodgkin lymphoma", "Hodgkin's disease", "Hodgkin's lymphoma"],
    ancestors: ["MONDO:0000001", "MONDO:0002334", "MONDO:0005062", "MONDO:0005070", "MONDO:0005157", "MONDO:0005570", "MONDO:0015757", "MONDO:0017341", "MONDO:0017342", "MONDO:0017343", "MONDO:0021669", "MONDO:0021674", "MONDO:0023370", "MONDO:0044881", "MONDO:0045024", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770010"] },
  { sourceId: "MONDO:0002108", source: "Mondo", name: "thyroid cancer", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0002108",
    description: "A malignant neoplasm involving the thyroid gland",
    synonyms: ["cancer of thyroid gland", "malignant neoplasm of the thyroid", "malignant neoplasm of the thyroid gland", "malignant neoplasm of thyroid", "malignant neoplasm of thyroid gland", "malignant thyroid gland neoplasm", "malignant thyroid gland tumor", "malignant thyroid gland tumour", "malignant thyroid neoplasm", "malignant thyroid tumor", "malignant thyroid tumour", "malignant tumor of the thyroid", "malignant tumor of the thyroid gland", "malignant tumor of thyroid", "malignant tumor of thyroid gland", "malignant tumour of the thyroid", "malignant tumour of the thyroid gland", "malignant tumour of thyroid", "malignant tumour of thyroid gland", "thyroid gland cancer"],
    ancestors: ["MONDO:0000001", "MONDO:0002082", "MONDO:0003240", "MONDO:0004992", "MONDO:0005070", "MONDO:0005151", "MONDO:0015074", "MONDO:0021069", "MONDO:0023370", "MONDO:0045024", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008"] },
  { sourceId: "MONDO:0005447", source: "Mondo", name: "testicular cancer", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005447",
    description: "A primary or metastatic malignant neoplasm that affects the testis. Representative examples include seminoma, embryonal carcinoma, sarcoma, leukemia, and lymphoma.",
    synonyms: ["cancer of testis", "malignant neoplasm of testis", "malignant neoplasm of the testis", "malignant testicular neoplasm", "malignant testicular tumor", "malignant testicular tumour", "malignant testis neoplasm", "malignant tumor of testis", "malignant tumor of the testis", "malignant tumour of testis", "malignant tumour of the testis", "testis cancer"],
    ancestors: ["MONDO:0000001", "MONDO:0002149", "MONDO:0002259", "MONDO:0002329", "MONDO:0003150", "MONDO:0004992", "MONDO:0005039", "MONDO:0005070", "MONDO:0005151", "MONDO:0005836", "MONDO:0006054", "MONDO:0021348", "MONDO:0023370", "MONDO:0024582", "MONDO:0045024", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008"] },
  { sourceId: "MONDO:0018076", source: "Mondo", name: "tuberculosis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0018076",
    description: "A chronic, recurrent infection caused by the bacterium Mycobacterium tuberculosis. Tuberculosis (TB) may affect almost any tissue or organ of the body with the lungs being the most common site of infection. The clinical stages of TB are primary or initial infection, latent or dormant infection, and recrudescent or adult-type TB. Ninety to 95% of primary TB infections may go unrecognized. Histopathologically, tissue lesions consist of granulomas which usually undergo central caseation necrosis. Local symptoms of TB vary according to the part affected; acute symptoms include hectic fever, sweats, and emaciation; serious complications include granulomatous erosion of pulmonary bronchi associated with hemoptysis. If untreated, progressive TB may be associated with a high degree of mortality. This infection is frequently observed in immunocompromised individuals with AIDS or a history of illicit IV drug use.",
    synonyms: ["tuberculosis disease"],
    ancestors: ["MONDO:0000001", "MONDO:0000314", "MONDO:0005113", "MONDO:0005550", "MONDO:0020590", "MONDO:0700096", "MONDO:7770008", "MONDO:7770010"] },
  { sourceId: "MONDO:0019632", source: "Mondo", name: "Lyme disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0019632",
    description: "Lyme disease (named after the towns in the USA where the disease was first identified) is a bacterial infection caused by Borrelia burgdorferi.",
    synonyms: ["Borrelia", "Borrelia burgdorferi infection", "Borreliella burgdorferi caused disease or disorder", "Borreliella burgdorferi disease or disorder", "Borreliella burgdorferi infectious disease", "Lyme borreliosis", "Lyme disease"],
    ancestors: ["MONDO:0000001", "MONDO:0000314", "MONDO:0005113", "MONDO:0005550", "MONDO:0021839", "MONDO:0025294", "MONDO:0100120", "MONDO:0700096", "MONDO:7770008", "MONDO:7770010"] },
  { sourceId: "MONDO:0100233", source: "Mondo", name: "long COVID-19", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0100233",
    description: "A chronic disease triggered by acute COVID-19 infection that is characterized by persistent symptoms following the acute phase of the SARS-CoV-2 infection, which may include fatigue, coughing, dyspnea, clouding of mentation, sleep disturbances, exercise intolerance and autonomic symptoms including tachycardia upon mild exercise or standing, night sweats, temperature dysregulation, gastroparesis, constipation or loose stools, and peripheral vasoconstriction.",
    synonyms: ["long haul COVID-19", "long-haul COVID-19", "PASC", "post-acute sequelae of COVID-19", "post-acute sequelae of SARS-CoV-2 infection", "sequelae of COVID-19"],
    ancestors: ["MONDO:0000001", "MONDO:0021669", "MONDO:0021674", "MONDO:0100320", "MONDO:0700096", "MONDO:7770008", "MONDO:7770010"] },
  { sourceId: "MONDO:0005609", source: "Mondo", name: "herpes zoster", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005609",
    description: "A common dermal and neurologic disorder caused by reactivation of the varicella-zoster virus that has remained dormant within dorsal root ganglia, often for decades, after the patient's initial exposure to the virus in the form of varicella (chickenpox). It is characterized by severe neuralgic pain along the distribution of the affected nerve and crops of clustered vesicles over the area.",
    synonyms: ["herpes Zoster", "shingles", "Zoster"],
    ancestors: ["MONDO:0000001", "MONDO:0002051", "MONDO:0005093", "MONDO:0005108", "MONDO:0005550", "MONDO:0005608", "MONDO:0005794", "MONDO:0006617", "MONDO:0021669", "MONDO:0021674", "MONDO:0024294", "MONDO:0100329", "MONDO:0100330", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770010"] }
] AS c
MERGE (n:Condition {sourceId: c.sourceId})
ON CREATE SET n.id = randomUUID()
SET n.source = c.source,
    n.name = c.name,
    n.sourceUri = c.sourceUri,
    n.description = c.description,
    n.synonyms = c.synonyms,
    n.ancestors = c.ancestors;

