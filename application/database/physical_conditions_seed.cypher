  { sourceId: "MONDO:0007186", source: "Mondo", name: "gastroesophageal reflux disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007186",
    description: "A chronic disorder characterized by reflux of the gastric and/or duodenal contents into the distal esophagus. It is usually caused by incompetence of the lower esophageal sphincter. Symptoms include heartburn and acid indigestion. It may cause injury to the esophageal mucosa.",
    synonyms: ["acid reflux", "gastroesophageal reflux", "gastroesophageal reflux disease", "GERD"],
    ancestors: ["MONDO:0000001", "MONDO:0003749", "MONDO:0003847", "MONDO:0004298", "MONDO:0004335", "MONDO:0044991", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0005052", source: "Mondo", name: "irritable bowel syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005052",
    description: "Irritable bowel syndrome (IBS) is a chronic functional condition of the lower gastrointestinal (GI) tract characterized by abdominal pain or discomfort and disordered bowel habit (diarrhea, constipation, or fluctuation between the two).",
    synonyms: ["IBS", "irritable bowel syndrome", "irritable colon", "mucus colitis", "spastic colon"],
    ancestors: ["MONDO:0000001", "MONDO:0002254", "MONDO:0004335", "MONDO:0005020", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0005011", source: "Mondo", name: "Crohn disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005011",
    description: "A gastrointestinal disorder characterized by chronic inflammation involving all layers of the intestinal wall, noncaseating granulomas affecting the intestinal wall and regional lymph nodes, and transmural fibrosis. Crohn disease most commonly involves the terminal ileum; the colon is the second most common site of involvement.",
    synonyms: ["Crohn disease", "Crohn's disease", "regional enteritis"],
    ancestors: ["MONDO:0000001", "MONDO:0003847", "MONDO:0004335", "MONDO:0005020", "MONDO:0005046", "MONDO:0005265", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0005101", source: "Mondo", name: "ulcerative colitis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005101",
    description: "An inflammatory bowel disease involving the mucosal surface of the large intestine and rectum. It may present with an acute or slow onset and follows an intermittent or continuous course. Signs and symptoms include abdominal pain, diarrhea, fever, weight loss, and intestinal hemorrhage.",
    synonyms: ["colitis ulcerative", "ulcerative colitis", "ulcerative colitis (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0002269", "MONDO:0003409", "MONDO:0003847", "MONDO:0004335", "MONDO:0005020", "MONDO:0005046", "MONDO:0005265", "MONDO:0005292", "MONDO:0021166", "MONDO:0024634", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0004235", source: "Mondo", name: "diverticulitis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0004235",
    description: "An infection that develops in the diverticula of the intestinal tract. Signs and symptoms include abdominal pain, fever, and leukocytosis.",
