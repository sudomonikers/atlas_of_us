    ancestors: ["HP:0000001", "HP:0000118", "HP:0001574", "HP:0007550", "HP:0025276"] },
  { sourceId: "MONDO:0001384", source: "Mondo", name: "myopia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001384",
    description: "The condition in which the individual does not see far distances clearly.",
