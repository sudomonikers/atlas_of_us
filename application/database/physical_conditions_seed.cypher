    ancestors: ["MONDO:0000001", "MONDO:0003240", "MONDO:0005151", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0007699", source: "Mondo", name: "Hashimoto thyroiditis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007699",
    description: "An autoimmune disorder caused by the production of autoantibodies against thyroid tissue. There is progressive destruction of the thyroid follicles leading to hypothyroidism.",
    synonyms: ["chronic lymphocytic thyroiditis", "Hashimoto disease", "Hashimoto hypothyroidism", "Hashimoto thyroiditis", "Hashimoto's disease", "Hashimoto's syndrome", "Hashimoto's thyroiditis"],
    ancestors: ["MONDO:0000001", "MONDO:0000569", "MONDO:0003240", "MONDO:0004126", "MONDO:0005046", "MONDO:0005151", "MONDO:0005623", "MONDO:0007179", "MONDO:0021166", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0005364", source: "Mondo", name: "Graves disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005364",
    description: "Graves' disease is an autoimmune disorder that leads to overactivity of the thyroid gland (hyperthyroidism).It is caused by an abnormal immune system response that causes the thyroid gland to produce too much thyroid hormones. Graves disease is the most common cause of hyperthyroidism andoccurs mostoften in women over age 20. However, the disorder may occur at any age and may affect males as well.Treatmentmayinclude radioiodine therapy, antithyroid drugs, and/or thyroid surgery.",
    synonyms: ["Graves disease"],
    ancestors: ["MONDO:0000001", "MONDO:0000569", "MONDO:0001104", "MONDO:0003240", "MONDO:0004126", "MONDO:0004425", "MONDO:0005046", "MONDO:0005151", "MONDO:0005397", "MONDO:0005623", "MONDO:0007179", "MONDO:0021166", "MONDO:0700096", "MONDO:1060200", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0008487", source: "Mondo", name: "polycystic ovary syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0008487",
    description: "A disorder that manifests as multiple cysts on the ovaries. It results in hormonal imbalances and leads to irregular and abnormal menstrual periods, excess growth of hair, acne eruptions and obesity.",
    synonyms: ["PCOS", "polycystic ovarian disease", "polycystic ovaries", "polycystic ovary syndrome", "Stein-Leventhal syndrome"],
    ancestors: ["MONDO:0000001", "MONDO:0002254", "MONDO:0003847", "MONDO:0005151", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0100480", source: "Mondo", name: "autoimmune primary adrenal insufficiency", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0100480",
    description: "Diminished production of adrenocortical hormones due to autoimmune destruction of the adrenal glands.",
    synonyms: ["Addison disease", "Addison's disease", "autoimmune Addison disease", "autoimmune Addison's disease", "autoimmune adrenalitis", "classic Addison's disease", "primary Addison's disease"],
    ancestors: ["MONDO:0000001", "MONDO:0000004", "MONDO:0002816", "MONDO:0005151", "MONDO:0005495", "MONDO:0015128", "MONDO:0015129", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0018912", source: "Mondo", name: "Cushing syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0018912",
    description: "Cushing's syndrome (CS) encompasses a group of hormonal disorders caused by prolonged and high exposure levels to glucocorticoids that can be of either endogenous (adrenal cortex production) or exogenous (iatrogenic) origin.",
    synonyms: ["cortisol Excess", "Cushing syndrome", "Cushing's syndrome", "hyperadrenocorticism", "pituitary basophilism", "suprarenogenic syndrome"],
    ancestors: ["MONDO:0000001", "MONDO:0002254", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0005393", source: "Mondo", name: "gout", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005393",
    description: "A condition characterized by painful swelling of the joints, which is caused by deposition of urate crystals.",
    synonyms: ["gout", "gouty arthropathy"],
    ancestors: ["MONDO:0000001", "MONDO:0005066", "MONDO:0700096", "MONDO:7770007"] },
  { sourceId: "MONDO:0005298", source: "Mondo", name: "osteoporosis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005298",
    description: "A condition of reduced bone mass, with decreased cortical thickness and a decrease in the number and size of the trabeculae of cancellous bone (but normal chemical composition), resulting in increased fracture incidence. Osteoporosis is classified as primary (Type 1, postmenopausal osteoporosis; Type 2, age-associated osteoporosis; and idiopathic, which can affect juveniles, premenopausal women, and middle-aged men) and secondary osteoporosis (which results from an identifiable cause of bone mass loss).",
    synonyms: ["bone mineral density quantitative trait locus", "osteoporosis, involutional", "osteoporosis, postmenopausal"],
    ancestors: ["MONDO:0000001", "MONDO:0000833", "MONDO:0000837", "MONDO:0002081", "MONDO:0005172", "MONDO:0005381", "MONDO:0700096", "MONDO:0800486", "MONDO:7770006"] },
  { sourceId: "MONDO:0100471", source: "Mondo", name: "vitamin D deficiency", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0100471",
    description: "Abnormally low level of 25-hydroxyvitamin D in the blood.",
    synonyms: ["avitaminosis D", "avitaminosis D, NOS", "DEFIC VITAMIN D", "deficiencies, vitamin D", "deficiency of vitamin D (disorder)", "deficiency, vitamin D", "VITAMIN D DEFIC", "vitamin D deficiencies", "vitamin D deficiency (disorder)", "vitamin D deficiency, NOS", "vitamin D insufficiency"],
    ancestors: ["MONDO:0000001", "MONDO:0005137", "MONDO:0006873", "MONDO:0024298", "MONDO:0700096", "MONDO:7770008"] },
  { sourceId: "MONDO:0006507", source: "Mondo", name: "hereditary hemochromatosis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0006507",
    description: "An inherited metabolic disorder characterized by iron accumulation in the tissues.",
    synonyms: ["hemochromatosis, hereditary"],
    ancestors: ["MONDO:0000001", "MONDO:0000226", "MONDO:0001436", "MONDO:0002279", "MONDO:0003847", "MONDO:0004689", "MONDO:0005066", "MONDO:0017757", "MONDO:0017761", "MONDO:0017763", "MONDO:0019052", "MONDO:0700096", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "HP:0004322", source: "HPO", name: "Short stature", sourceUri: "http://purl.obolibrary.org/obo/HP_0004322",
    description: "A height below that which is expected according to age and gender norms. Although there is no universally accepted definition of short stature, many refer to \"short stature\" as height more than 2 standard deviations below the mean for age and gender (or below the 3rd percentile for age and gender dependent norms).",
    synonyms: ["Decreased body height", "Height less than 3rd percentile", "Short stature", "Small stature", "Stature below 3rd percentile"],
    ancestors: ["HP:0000001", "HP:0000002", "HP:0000118", "HP:0001507", "HP:0001510"] },
  { sourceId: "HP:0000098", source: "HPO", name: "Tall stature", sourceUri: "http://purl.obolibrary.org/obo/HP_0000098",
    description: "A height above that which is expected according to age and gender norms.",
    synonyms: ["Accelerated linear growth", "Increased body height", "Increased linear growth", "Tall stature"],
    ancestors: ["HP:0000001", "HP:0000002", "HP:0000118", "HP:0001507"] },
  { sourceId: "HP:6000855", source: "HPO", name: "Cold intolerance", sourceUri: "http://purl.obolibrary.org/obo/HP_6000855",
    description: "The inability to maintain a comfortable body temperature in a cold environment or cold temperatures.",
    synonyms: ["Cold sensitivity"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0001939", "HP:0004370", "HP:0012337"] },
  { sourceId: "HP:0002046", source: "HPO", name: "Heat intolerance", sourceUri: "http://purl.obolibrary.org/obo/HP_0002046",
    description: "The inability to maintain a comfortable body temperature in warm or hot weather.",
    synonyms: ["Heat intolerance", "Intolerance to heat and fevers"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0001939", "HP:0004370", "HP:0012337"] },
  { sourceId: "MONDO:0001356", source: "Mondo", name: "iron deficiency anemia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001356",
    description: "Anemia caused by low iron intake, inefficient iron absorption in the gastrointestinal tract, or chronic blood loss.",
    synonyms: ["iron-deficiency anaemia", "iron-deficiency anemia"],
    ancestors: ["MONDO:0000001", "MONDO:0000387", "MONDO:0001245", "MONDO:0001357", "MONDO:0002280", "MONDO:0005137", "MONDO:0005570", "MONDO:0006873", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008"] },
  { sourceId: "MONDO:0011382", source: "Mondo", name: "sickle cell disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0011382",
    description: "Sickle cell anemias are chronic hemolytic diseases that may induce three types of acute accidents: severe anemia, severe bacterial infections, and ischemic vasoocclusive accidents (VOA) caused by sickle-shaped red blood cells obstructing small blood vessels and capillaries. Many diverse complications can occur.",
    synonyms: ["Haemoglobin S disease without crisis", "Hb-S/Hb-C disease", "sickle cell anemia", "sickle cell disease", "sickle-cell/Hb-C disease without crisis", "sickling disorder due to Haemoglobin S", "sickling disorder due to Hemoglobin S"],
    ancestors: ["MONDO:0000001", "MONDO:0000429", "MONDO:0003847", "MONDO:0005570", "MONDO:0006025", "MONDO:0019050", "MONDO:0044347", "MONDO:0044348", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0019402", source: "Mondo", name: "beta thalassemia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0019402",
    description: "Beta-thalassemia (BT) is characterized by deficiency (Beta+) or absence (Beta0) of synthesis of the beta globin chains of hemoglobin (Hb).",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0000984", "MONDO:0002280", "MONDO:0003847", "MONDO:0005151", "MONDO:0005570", "MONDO:0017145", "MONDO:0019050", "MONDO:0044347", "MONDO:0044348", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0010602", source: "Mondo", name: "hemophilia A", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0010602",
    description: "The most common form of hemophilia characterized by spontaneous or prolonged hemorrhages due to factor VIII deficiency.",
    synonyms: ["congenital factor VIII disorder", "factor VIII deficiency", "haemophilia a, X-linked recessive", "haemophilia type A", "haemophilia type a", "hemophilia a, X-linked recessive", "hemophilia type A", "hemophilia type a", "hereditary Factor VIII deficiency", "hereditary Factor VIII deficiency disease"],
    ancestors: ["MONDO:0000001", "MONDO:0000425", "MONDO:0001531", "MONDO:0002242", "MONDO:0002243", "MONDO:0003847", "MONDO:0005570", "MONDO:0018660", "MONDO:0021181", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0024574", source: "Mondo", name: "von Willebrand disease (hereditary or acquired)", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0024574",
    description: "Hereditary or acquired coagulation disorder characterized by a qualitative or quantitative deficiency of the von Willebrand factor. The latter plays an important role in platelet adhesion. Signs and symptoms include bruises, nose bleeding, gum bleeding following a dental procedure, heavy menstrual bleeding, and gastrointestinal bleeding.",
    synonyms: ["Von Willebrand Disease", "von Willebrand disorder", "von Willebrand's disease", "VWD"],
    ancestors: ["MONDO:0000001", "MONDO:0001531", "MONDO:0002242", "MONDO:0005570", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0000978", source: "HPO", name: "Bruising susceptibility", sourceUri: "http://purl.obolibrary.org/obo/HP_0000978",
    description: "An ecchymosis (bruise) refers to the skin discoloration caused by the escape of blood into the tissues from ruptured blood vessels. This term refers to an abnormally increased susceptibility to bruising. The corresponding phenotypic abnormality is generally elicited on medical history as a report of frequent ecchymoses or bruising without adequate trauma.",
    synonyms: ["Bruisability", "Bruise easily", "Bruising susceptibility", "Easy bruisability", "Easy bruising"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000951", "HP:0001574", "HP:0001626", "HP:0001871", "HP:0001892", "HP:0001933", "HP:0002597", "HP:0011121", "HP:0011276", "HP:0011354"] },
  { sourceId: "MONDO:0005775", source: "Mondo", name: "G6PD deficiency", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005775",
    description: "An X-linked genetic condition caused by alterations in the gene G6PD that result in moderately to severely decreased activity levels of the enzyme glucose-6-phosphate dehydrogenase. Most individuals with G6PD deficiency are asymptomatic throughout their life. Individuals with G6PD variants that cause G6PD deficiency are at risk for severe neonatal jaundice. These individuals are also at risk for acute hemolytic anemia in response to certain medication exposures, chemical exposures, infections, or consumption of fava beans.",
    synonyms: ["G-6-PD variant enzyme deficiency Anaemia", "G-6-PD variant enzyme deficiency Anemia", "G6PD", "G6PD deficiency", "glucose-6-phosphate dehydrogenase deficiency", "glucosephosphate dehydrogenase deficiency", "inborn error of glucose-6-phosphate dehydrogenase activity", "inborn glucose-6-phosphate dehydrogenase activity disorder", "rare inborn error of glucose-6-phosphate dehydrogenase activity"],
    ancestors: ["MONDO:0000001", "MONDO:0003847", "MONDO:0005066", "MONDO:0019052", "MONDO:0019214", "MONDO:0037792", "MONDO:0700096", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0005109", source: "Mondo", name: "HIV infectious disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005109",
    description: "An infection caused by the human immunodeficiency virus.",
    synonyms: ["HIV infection", "Human immunodeficiency virus caused disease or disorder", "Human immunodeficiency virus disease or disorder", "Human immunodeficiency virus infectious disease"],
    ancestors: ["MONDO:0000001", "MONDO:0005039", "MONDO:0005108", "MONDO:0005550", "MONDO:0021681", "MONDO:0021682", "MONDO:0022034", "MONDO:0100329", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770010"] },
  { sourceId: "MONDO:0700226", source: "Mondo", name: "food allergy", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0700226",
    description: "Gastrointestinal disturbances, skin eruptions, or shock due to allergic reactions to allergens in food.",
    synonyms: ["allergic disease from food material", "allergy of food material", "food material allergic disease"],
    ancestors: ["MONDO:0000001", "MONDO:0000605", "MONDO:0005046", "MONDO:0005271", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0000775", source: "Mondo", name: "drug allergy", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0000775",
    description: "Immunologically mediated adverse reactions to medicinal substances used legally or illegally.",
    synonyms: ["allergy of exposure to drug", "exposure to drug allergic disease"],
    ancestors: ["MONDO:0000001", "MONDO:0000605", "MONDO:0005046", "MONDO:0005271", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0012537", source: "HPO", name: "Food intolerance", sourceUri: "http://purl.obolibrary.org/obo/HP_0012537",
    description: "A detrimental reaction to a food, beverage, food additive, or compound found in foods that produces symptoms in one or more body organs and systems that is not mediated by an immune reaction.",
    synonyms: ["Food intolerance", "Non-allergic food hypersensitivity"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0001939", "HP:0012337"] },
  { sourceId: "MONDO:0100345", source: "Mondo", name: "lactose intolerance", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0100345",
    description: null,
    synonyms: ["lactose intolerance", "lactose intolerance (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0003847", "MONDO:0004335", "MONDO:0005020", "MONDO:0005066", "MONDO:0005137", "MONDO:0019052", "MONDO:0019214", "MONDO:0020598", "MONDO:0037792", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0005130", source: "Mondo", name: "celiac disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005130",
    description: "An autoimmune genetic disorder with an unknown pattern of inheritance that primarily affects the digestive tract. It is caused by intolerance to dietary gluten. Consumption of gluten protein triggers an immune response which damages small intestinal villi and prevents adequate absorption of nutrients. Clinical signs include abdominal cramping, diarrhea or constipation and weight loss. If untreated, the clinical course may progress to malnutrition, anemia, osteoporosis and an increased risk of intestinal malignancies. However, the prognosis is favorable with successful avoidance of gluten in the diet.",
    synonyms: ["celiac disease", "celiac sprue", "coeliac sprue", "gluten intolerance", "gluten-induced enteropathy", "non tropical sprue"],
    ancestors: ["MONDO:0000001", "MONDO:0000588", "MONDO:0003847", "MONDO:0004335", "MONDO:0005020", "MONDO:0005046", "MONDO:0007179", "MONDO:0020598", "MONDO:0024635", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0007743", source: "Mondo", name: "attention deficit-hyperactivity disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007743",
    description: "A disorder characterized by a marked pattern of inattention and/or hyperactivity-impulsivity that is inconsistent with developmental level and clearly interferes with functioning in at least two settings (e.g. at home and at school). When present, the symptoms of hyperactivity are most often present before the age of 7 years. There are three recognized presentations or subtypes from most to least common: combined type, inattentive/distractible type, hyperactive/impulsive type.",
    synonyms: ["attention deficit hyperactivity disorder", "attention deficit-hyperactivity disorder", "attention deficit/hyperactivity disorder"],
    ancestors: ["MONDO:0000001", "MONDO:0000592", "MONDO:0002025", "MONDO:0002602", "MONDO:0005071", "MONDO:0005084", "MONDO:0005503", "MONDO:0005560", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0005258", source: "Mondo", name: "autism spectrum disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005258",
    description: "A spectrum of developmental disorders that includes autism, and Asperger syndrome. Signs and symptoms include poor communication skills, defective social interactions, and repetitive behaviors.",
    synonyms: ["autistic spectrum disorder", "pervasive developmental disorder - not otherwise specified", "pervasive developmental disorders"],
    ancestors: ["MONDO:0000001", "MONDO:0000594", "MONDO:0002025", "MONDO:0002602", "MONDO:0005071", "MONDO:0005084", "MONDO:0005503", "MONDO:0005560", "MONDO:0100038", "MONDO:0700092", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0005489", source: "Mondo", name: "dyslexia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005489",
    description: "A learning disorder characterized by an impairment in processing written words. Reading difficulties can include distortions, omissions or substitutions of characters. Oral and silent reading difficulties can include faulty and slow comprehension.",
    synonyms: ["dyslexia", "dyslexia (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0000592", "MONDO:0001697", "MONDO:0002025", "MONDO:0002602", "MONDO:0004681", "MONDO:0005071", "MONDO:0005084", "MONDO:0005503", "MONDO:0005560", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0001552", source: "Mondo", name: "dyscalculia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001552",
    description: "A wide group of related learning disorders characterized by difficulties with mathematics and manipulating numbers; the difficulty with math may be caused or exacerbated by visuo-spatial or language processing difficulties.",
    synonyms: ["dyscalculia", "dyscalculia (disease)", "mathematics disorder"],
    ancestors: ["MONDO:0000001", "MONDO:0000592", "MONDO:0002025", "MONDO:0002602", "MONDO:0004681", "MONDO:0005071", "MONDO:0005084", "MONDO:0005503", "MONDO:0005560", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "HP:0010526", source: "HPO", name: "Dysgraphia", sourceUri: "http://purl.obolibrary.org/obo/HP_0010526",
    description: "A writing disability in the absence of motor or sensory deficits of the upper extremities, resulting in an impairment in the ability to write regardless of the ability to read and not due to intellectual impairment.",
    synonyms: [],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0002167", "HP:0011446", "HP:0012638", "HP:0025792", "HP:0034434", "HP:4000072"] },
  { sourceId: "MONDO:0004922", source: "Mondo", name: "developmental coordination disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0004922",
    description: "A disorder characterized by an impairment in the development of an individual's motor coordination skills; this impairment in motor development is not due to a medical condition.",
    synonyms: ["clumsy child syndrome", "development coordination disorder", "developmental dyspraxia"],
    ancestors: ["MONDO:0000001", "MONDO:0000592", "MONDO:0002025", "MONDO:0002602", "MONDO:0005071", "MONDO:0005084", "MONDO:0005503", "MONDO:0005560", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "HP:0002312", source: "HPO", name: "Clumsiness", sourceUri: "http://purl.obolibrary.org/obo/HP_0002312",
    description: "Lack of physical coordination resulting in an abnormal tendency to drop items or bump into objects.",
    synonyms: ["Clumsiness"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0011442", "HP:0011443", "HP:0012638"] },
  { sourceId: "MONDO:0001071", source: "Mondo", name: "intellectual disability", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001071",
    description: "A broad category of disorders characterized by an impairment to the intelligence an individual possesses. These impairments can result from trauma, birth, or disease and are not restricted to any particular age group.",
    synonyms: ["intellectual disabilities"],
    ancestors: ["MONDO:0000001", "MONDO:0005071", "MONDO:0700092", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0007661", source: "Mondo", name: "Tourette syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007661",
    description: "A neurologic disorder caused by defective metabolism of the neurotransmitters in the brain. It is characterized by repeated involuntary movements (motor tics) and uncontrollable vocal sounds (vocal tics). The symptoms are usually manifested before the age of eighteen.",
    synonyms: ["motor-verbal tic disorder", "Tourette disease", "Tourette syndrome", "Tourette's syndrome"],
    ancestors: ["MONDO:0000001", "MONDO:0000592", "MONDO:0002025", "MONDO:0002254", "MONDO:0002420", "MONDO:0002602", "MONDO:0003847", "MONDO:0005071", "MONDO:0005084", "MONDO:0005395", "MONDO:0005503", "MONDO:0005560", "MONDO:0100545", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "HP:0025268", source: "HPO", name: "Stuttering", sourceUri: "http://purl.obolibrary.org/obo/HP_0025268",
    description: "Disruptions in the production of speech sounds, with involuntary repetitions of words or parts of words, prolongations of speech sounds, or complete blockage of speech production for several seconds.",
    synonyms: ["Stammering", "Stuttering"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0002167", "HP:0011446", "HP:0012638", "HP:0025792", "HP:0034434", "HP:4000072"] },
  { sourceId: "MONDO:0000598", source: "Mondo", name: "aphasia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0000598",
    description: "A language disorder that involves an acquired impairment of any language modality such as producing or comprehending spoken or written language.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0000592", "MONDO:0002025", "MONDO:0002182", "MONDO:0002602", "MONDO:0004750", "MONDO:0005071", "MONDO:0005084", "MONDO:0005503", "MONDO:0005560", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0003227", source: "Mondo", name: "prosopagnosia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0003227",
    description: "Impaired ability to recognize other human faces in the absence of a vision disorder. It may be a congenital disorder or the result of brain injury.",
    synonyms: ["face blindness", "prosopagnosia", "prosopagnosia (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0005071", "MONDO:0005638", "MONDO:0024417", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0020345", source: "HPO", name: "Aphantasia", sourceUri: "http://purl.obolibrary.org/obo/HP_0020345",
    description: "Absence or near-absence of voluntary visual mental imagery, such that an individual is unable to intentionally generate visual images in the mind.",
    synonyms: [],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0011446", "HP:0012638", "HP:0020344", "HP:0025792"] },
  { sourceId: "HP:6000024", source: "HPO", name: "Synesthesia", sourceUri: "http://purl.obolibrary.org/obo/HP_6000024",
    description: "A phenomenon whereby stimulation of one sensory or cognitive pathway leads to automatic, involuntary experiences in a second sensory or cognitive pathway. For instance, people with synaesthesia may experience unusual colors, tastes, and other sensations when engaged in everyday activities like reading or listening to music.",
    synonyms: [],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0011446", "HP:0012638"] },
  { sourceId: "HP:0025113", source: "HPO", name: "Misophonia", sourceUri: "http://purl.obolibrary.org/obo/HP_0025113",
    description: "Misophonia is characterized by strong physiological, emotional, and behavioral reactions to auditory, visual, and/or kinesthetic stimuli of different nature regardless of their physical characteristics. These misophonic responses include anger, general discomfort, disgust, anxiety, and avoidance and escape behaviors.",
    synonyms: [],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0000708", "HP:0011446", "HP:0012638", "HP:5200046", "HP:5200058", "HP:5200060"] },
  { sourceId: "MONDO:0002009", source: "Mondo", name: "major depressive disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0002009",
    description: "An episode of depression lasting two or more weeks without an intervening episode of mania.",
    synonyms: ["major depression", "major depressive disorder", "major depressive disorder and accelerated response to antidepressant drug treatment", "major depressive disorder, response to citalopram therapy in", "unipolar depression", "unipolar depression, susceptibility to"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002050", "MONDO:0002602", "MONDO:0005071", "MONDO:0005084", "MONDO:0005371", "MONDO:0005560", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0000694", source: "Mondo", name: "seasonal affective disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0000694",
    description: "A syndrome characterized by depressions that recur annually at the same time each year, usually during the winter months. Other symptoms include anxiety, irritability, decreased energy, increased appetite (carbohydrate cravings), increased duration of sleep, and weight gain. sad (seasonal affective disorder) can be treated by daily exposure to bright artificial lights (phototherapy), during the season of recurrence.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002050", "MONDO:0002602", "MONDO:0005071", "MONDO:0005084", "MONDO:0005371", "MONDO:0005560", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0001942", source: "Mondo", name: "generalized anxiety disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001942",
    description: "An anxiety disorder characterized by excessive and difficult-to-control worry about a number of life situations. The worry is accompanied by restlessness, fatigue, inability to concentrate, irritability, muscle tension, and/or sleep disturbance and lasts for at least 6 months.",
    synonyms: ["GAD"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002602", "MONDO:0005071", "MONDO:0005084", "MONDO:0005560", "MONDO:0005618", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0005383", source: "Mondo", name: "panic disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005383",
    description: "An anxiety disorder characterized by multiple unexpected panic attacks with persistent concern of recurring attacks. Panic disorder may or may not be accompanied by agoraphobia.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002602", "MONDO:0005071", "MONDO:0005084", "MONDO:0005560", "MONDO:0005618", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0001247", source: "Mondo", name: "social phobia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001247",
    description: "An anxiety disorder characterized by an intense, irrational fear of one or more social or performance situations in which the individual believes that he or she will be scrutinized by others. Exposure to social situations immediately provokes an anxiety response. In adults, the social phobia is recognized as excessive or unreasonable.",
    synonyms: ["social anxiety disorder"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002602", "MONDO:0003699", "MONDO:0005071", "MONDO:0005084", "MONDO:0005560", "MONDO:0005618", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0012000", source: "Mondo", name: "specific phobia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0012000",
    description: "An anxiety disorder characterized by an intense, irrational fear cued by the presence or anticipation of a specific object or situation. Exposure to the phobic stimulus immediately provokes an anxiety response. In adults, the specific phobia is recognized as excessive or unreasonable.",
    synonyms: ["simple phobia"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002602", "MONDO:0003699", "MONDO:0003847", "MONDO:0005071", "MONDO:0005084", "MONDO:0005560", "MONDO:0005618", "MONDO:0100545", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0004985", source: "Mondo", name: "bipolar disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0004985",
    description: "A disorder of the brain that causes unusual shifts in mood, energy, activity levels and the ability to carry out day-to-day tasks. Often these moods range and shift from periods of elation and energized behavior to those of hopelessness and depression.",
    synonyms: ["bipolar disorder", "major affective disorder", "manic-depression"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002602", "MONDO:0005071", "MONDO:0005084", "MONDO:0005371", "MONDO:0005560", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0005090", source: "Mondo", name: "schizophrenia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005090",
    description: "A major psychotic disorder characterized by abnormalities in the perception or expression of reality. It affects the cognitive and psychomotor functions. Common clinical signs and symptoms include delusions, hallucinations, disorganized thinking, and retreat from reality.",
    synonyms: ["schizophrenia (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002039", "MONDO:0002602", "MONDO:0005071", "MONDO:0005084", "MONDO:0005485", "MONDO:0005560", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0008114", source: "Mondo", name: "obsessive-compulsive disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0008114",
    description: "A disorder characterized by the presence of persistent and recurrent irrational thoughts (obsessions), resulting in marked anxiety and repetitive excessive behaviors (compulsions) as a way to try to decrease that anxiety.",
    synonyms: ["obsessive compulsive disorder", "obsessive-compulsive disorder", "obsessive-compulsive disorder, susceptibility to"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002602", "MONDO:0003847", "MONDO:0005071", "MONDO:0005084", "MONDO:0005560", "MONDO:0005618", "MONDO:0100545", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0005146", source: "Mondo", name: "post-traumatic stress disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005146",
    description: "An anxiety disorder precipitated by an experience of intense fear or horror while exposed to a traumatic (especially life-threatening) event. The disorder is characterized by intrusive recurring thoughts or images of the traumatic event; avoidance of anything associated with the event; a state of hyperarousal and diminished emotional responsiveness. These symptoms are present for at least one month and the disorder is usually long-term.",
    synonyms: ["post-traumatic stress disorder", "PTSD", "traumatic neurosis"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002602", "MONDO:0005071", "MONDO:0005084", "MONDO:0005379", "MONDO:0005560", "MONDO:0005618", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0001156", source: "Mondo", name: "borderline personality disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001156",
    description: "A disorder characterized by an enduring pattern of unstable self-image and mood together with volatile interpersonal relationships, self-damaging impulsivity, recurrent suicidal threats or gestures and/or self-mutilating behavior.",
    synonyms: ["borderline personality disorder", "borderline personality disorder (disease)", "BPD"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002028", "MONDO:0700096", "MONDO:7770007"] },
  { sourceId: "MONDO:0005351", source: "Mondo", name: "anorexia nervosa", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005351",
    description: "A disorder most often seen in adolescent females characterized by a refusal to maintain a minimally normal body weight, an intense fear of gaining weight, a disturbance in body image, and, in postmenarcheal females, the development of amenorrhea.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0005137", "MONDO:0005451", "MONDO:0700096", "MONDO:7770007", "MONDO:7770008"] },
  { sourceId: "MONDO:0005452", source: "Mondo", name: "bulimia nervosa", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005452",
    description: "A disorder characterized by recurrent episodes of binge-eating over which the individual feels a lack of control; these episodes of binge-eating are followed by recurrent compensatory behavior to prevent weight gain, usually self-induced vomiting. In addition, self-evaluation is unduly influenced by body image.",
    synonyms: ["bulimia", "hyperorexia nervosa"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0005137", "MONDO:0005451", "MONDO:0700096", "MONDO:7770007", "MONDO:7770008"] },
  { sourceId: "MONDO:0005582", source: "Mondo", name: "binge eating disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005582",
    description: "Recurrent episodes of over-eating.",
    synonyms: ["binge eating", "binge eating disorder"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0005137", "MONDO:0005451", "MONDO:0700096", "MONDO:7770007", "MONDO:7770008"] },
  { sourceId: "MONDO:0007079", source: "Mondo", name: "alcohol dependence", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007079",
    description: "Physical and psychological dependence on alcohol.",
    synonyms: ["alcohol dependence", "alcoholism"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002494", "MONDO:0004938", "MONDO:0005303", "MONDO:0021698", "MONDO:0700096", "MONDO:7770007"] },
  { sourceId: "MONDO:0013600", source: "Mondo", name: "insomnia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0013600",
    description: "A sleep disorder characterized by difficulty in falling asleep and/or remaining asleep.",
    synonyms: ["insomnia", "insomnia (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0002602", "MONDO:0005071", "MONDO:0005560", "MONDO:0100081", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0021107", source: "Mondo", name: "narcolepsy", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0021107",
    description: "A sleep disorder characterized by a tendency for excessive sleepiness during the day which occurs even after adequate sleep in the nighttime. The persons who suffer from this condition experience fatigue and may fall asleep at inappropriate times during the day.",
    synonyms: ["narcolepsy with or without cataplexy", "paroxysmal sleep"],
    ancestors: ["MONDO:0000001", "MONDO:0003406", "MONDO:0100081", "MONDO:0700096", "MONDO:7770007"] },
  { sourceId: "HP:0001262", source: "HPO", name: "Excessive daytime somnolence", sourceUri: "http://purl.obolibrary.org/obo/HP_0001262",
    description: "A state of abnormally strong desire for sleep during the daytime.",
    synonyms: ["Excessive daytime sleepiness", "More than typical sleepiness during day"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0002360", "HP:0004372", "HP:0011446", "HP:0012638"] },
  { sourceId: "HP:0025236", source: "HPO", name: "Sleep walking", sourceUri: "http://purl.obolibrary.org/obo/HP_0025236",
    description: "Ambulation during sleep with lack awareness and limited or no recall of the event.",
    synonyms: ["Sleep walking", "Somnambulism"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0002360", "HP:0011446", "HP:0012638", "HP:0025234", "HP:0025235", "HP:5200300"] },
  { sourceId: "HP:0003763", source: "HPO", name: "Bruxism", sourceUri: "http://purl.obolibrary.org/obo/HP_0003763",
    description: "Bruxism is characterized by the grinding of the teeth including the clenching of the jaw and typically occur during sleep.",
    synonyms: ["Teeth grinding"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0000708", "HP:0000733", "HP:0002360", "HP:0011446", "HP:0012638", "HP:0025234", "HP:0031432", "HP:5200017", "HP:5200241", "HP:5200300", "HP:6000768"] },
  { sourceId: "MONDO:0005391", source: "Mondo", name: "restless legs syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005391",
    description: "A condition that occurs while resting or lying in bed; it is characterized by an irresistible urgency to move the legs to obtain relief from a strange and uncomfortable sensation in the legs.",
    synonyms: ["restless leg syndrome"],
    ancestors: ["MONDO:0000001", "MONDO:0005071", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0005277", source: "Mondo", name: "migraine disorder", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005277",
    description: "A common, severe type of vascular headache often associated with increased sympathetic activity, resulting in nausea, vomiting, and light sensitivity.",
    synonyms: ["migraine", "migraine headache"],
    ancestors: ["MONDO:0000001", "MONDO:0002602", "MONDO:0004995", "MONDO:0005071", "MONDO:0005385", "MONDO:0005560", "MONDO:0017181", "MONDO:0021146", "MONDO:0043218", "MONDO:0700057", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0012228", source: "HPO", name: "Tension-type headache", sourceUri: "http://purl.obolibrary.org/obo/HP_0012228",
    description: "A type of headache that last hours with continuous pain of mild or moderate intensity, bilateral location, a pressing/tightening (non-pulsating) quality and that is not aggravated by routine physical activity such as walking or climbing stairs.",
    synonyms: ["Tension-type headache"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0002315", "HP:0012638"] },
  { sourceId: "MONDO:0043537", source: "Mondo", name: "cluster headache syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0043537",
    description: "A headache disorder that is characterized by periodic severe, unilateral orbital, supraorbital, and/or temporal pain, and is associated with ipsilateral cranial autonomic symptoms.",
    synonyms: ["Cephalgia, histamine", "Cephalgias, histamine", "ciliary neuralgia", "ciliary neuralgias", "cluster headache", "cluster headache syndrome", "cluster migraine", "erythromelalgia of the head", "erythroprosopalgia of bing", "histamine cephalgia", "histamine cephalgias", "histamine headache", "Horton headache", "Horton syndrome", "Horton's headache", "Horton's neuralgia", "Horton's syndrome", "Hortons syndrome", "migraine, neuralgic", "migraines, neuralgic", "migrainous neuralgia", "red migraine"],
    ancestors: ["MONDO:0000001", "MONDO:0002602", "MONDO:0003543", "MONDO:0003569", "MONDO:0003620", "MONDO:0004995", "MONDO:0005071", "MONDO:0005385", "MONDO:0005560", "MONDO:0015530", "MONDO:0017181", "MONDO:0021146", "MONDO:0043218", "MONDO:0700057", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0002315", source: "HPO", name: "Headache", sourceUri: "http://purl.obolibrary.org/obo/HP_0002315",
    description: "Cephalgia, or pain sensed in various parts of the head, not confined to the area of distribution of any nerve.",
    synonyms: ["Headache", "Headaches"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0012638"] },
  { sourceId: "MONDO:0005027", source: "Mondo", name: "epilepsy", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005027",
    description: "A brain disorder characterized by episodes of abnormally increased neuronal discharge resulting in transient episodes of sensory or motor neurological dysfunction, or psychic dysfunction. These episodes may or may not be associated with loss of consciousness or convulsions.",
    synonyms: ["seizure disorder"],
    ancestors: ["MONDO:0000001", "MONDO:0002602", "MONDO:0005071", "MONDO:0005560", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0005301", source: "Mondo", name: "multiple sclerosis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005301",
    description: "A progressive autoimmune disorder affecting the central nervous system resulting in demyelination. Patients develop physical and cognitive impairments that correspond with the affected nerve fibers.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0000568", "MONDO:0002562", "MONDO:0002602", "MONDO:0002977", "MONDO:0005046", "MONDO:0005071", "MONDO:0005559", "MONDO:0005560", "MONDO:0006704", "MONDO:0007179", "MONDO:0020800", "MONDO:0021147", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0005180", source: "Mondo", name: "Parkinson disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005180",
    description: "A progressive degenerative disorder of the central nervous system characterized by loss of dopamine producing neurons in the substantia nigra and the presence of Lewy bodies in the substantia nigra and locus coeruleus. Signs and symptoms include tremor which is most pronounced during rest, muscle rigidity, slowing of the voluntary movements, a tendency to fall back, and a mask-like facial expression.",
    synonyms: ["paralysis agitans", "Parkinson's disease", "PD"],
    ancestors: ["MONDO:0000001", "MONDO:0002602", "MONDO:0003847", "MONDO:0003996", "MONDO:0005071", "MONDO:0005560", "MONDO:0021095", "MONDO:0100545", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0004975", source: "Mondo", name: "Alzheimer disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0004975",
    description: "A progressive, neurodegenerative disease characterized by loss of function and death of nerve cells in several areas of the brain leading to loss of cognitive function such as memory and language.",
    synonyms: ["AD", "Alzheimer dementia", "Alzheimer disease", "Alzheimer's dementia", "Alzheimer's disease", "Alzheimers disease", "presenile and senile dementia"],
    ancestors: ["MONDO:0000001", "MONDO:0001627", "MONDO:0002025", "MONDO:0002039", "MONDO:0002602", "MONDO:0005071", "MONDO:0005559", "MONDO:0005574", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770011"] },
  { sourceId: "MONDO:0001627", source: "Mondo", name: "dementia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001627",
    description: "Loss of intellectual abilities interfering with an individual's social and occupational functions. Causes include Alzheimer's disease, brain injuries, brain tumors, and vascular disorders.",
    synonyms: ["dementia", "dementia (disease)"],
    ancestors: ["MONDO:0000001", "MONDO:0002025", "MONDO:0002039", "MONDO:0700096", "MONDO:7770007"] },
  { sourceId: "MONDO:0006497", source: "Mondo", name: "cerebral palsy", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0006497",
    description: "A group of disorders affecting the development of movement and posture, often accompanied by disturbances of sensation, perception, cognition, and behavior. It results from damage to the fetal or infant brain.",
    synonyms: ["infantile cerebral palsy"],
    ancestors: ["MONDO:0000001", "MONDO:0002602", "MONDO:0005071", "MONDO:0005560", "MONDO:0006496", "MONDO:0044996", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0003233", source: "Mondo", name: "essential tremor", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0003233",
    description: "A relatively common disorder characterized by a fairly specific pattern of tremors which are most prominent in the upper extremities and neck, inducing titubations of the head. The tremor is usually mild, but when severe may be disabling. An autosomal dominant pattern of inheritance may occur in some families (i.e., familial tremor). (Mov Disord 1988;13(1):5-10)",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0003847", "MONDO:0005071", "MONDO:0005395", "MONDO:0100545", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "HP:0001337", source: "HPO", name: "Tremor", sourceUri: "http://purl.obolibrary.org/obo/HP_0001337",
    description: "An unintentional, oscillating to-and-fro muscle movement about a joint axis.",
    synonyms: ["Tremor", "Tremors"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0004305", "HP:0011442", "HP:0012638", "HP:0100022"] },
  { sourceId: "MONDO:0008599", source: "Mondo", name: "trigeminal neuralgia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0008599",
    description: "Trigeminal neuralgia is a nerve disorder that causes a stabbing or electric-shock-like pain in parts of the face. The pain lasts a few seconds to a few minutes, and usually on only one side of the face. It can also cause muscle spasms in the face the same time as the pain. The pain may result from a blood vessel pressing against the trigeminal nerve (the nerve that carries pain, feeling, and other sensations from the brain to the skin of theface), as a complication of multiple sclerosis, or due to compression of the nerve by a tumor or cyst. In some cases, the cause is unknown. Treatment options include medicines, surgery, and complementary approaches.",
    synonyms: ["neuralgia of trigeminal nerve", "trigeminal nerve neuralgia", "trigeminal neuralgia"],
    ancestors: ["MONDO:0000001", "MONDO:0002602", "MONDO:0003543", "MONDO:0003569", "MONDO:0003620", "MONDO:0005071", "MONDO:0005244", "MONDO:0015923", "MONDO:0016374", "MONDO:0019056", "MONDO:0021667", "MONDO:0700057", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0005665", source: "Mondo", name: "Bell's palsy", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005665",
    description: "Partial or complete paralysis of the facial muscles of one side of a person's face. It is caused by damage to the seventh cranial nerve. It is usually temporary but it may recur.",
    synonyms: ["facial nerve palsy", "facial nerve paralysis", "nerve paralysis, Facial", "palsy of facial nerve", "paralysis Of Facial nerve"],
    ancestors: ["MONDO:0000001", "MONDO:0001835", "MONDO:0002098", "MONDO:0002602", "MONDO:0002782", "MONDO:0003569", "MONDO:0003620", "MONDO:0005071", "MONDO:0006496", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0007275", source: "Mondo", name: "carpal tunnel syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007275",
    description: "Entrapment of the median nerve in the wrist that is characterized by numbness, tingling and painful movement.",
    synonyms: ["carpal tunnel syndrome"],
    ancestors: ["MONDO:0000001", "MONDO:0003615", "MONDO:0003620", "MONDO:0003847", "MONDO:0005071", "MONDO:0005244", "MONDO:0019056", "MONDO:0020127", "MONDO:0100545", "MONDO:0100546", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0005244", source: "Mondo", name: "peripheral neuropathy", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005244",
    description: "A disorder affecting the peripheral nervous system. It manifests with pain, tingling, numbness, and muscle weakness. It may be the result of physical injury, toxic substances, viral diseases, diabetes, renal failure, cancer, and drugs.",
    synonyms: ["neuropathy", "peripheral nerve disorder", "peripheral neuropathy"],
    ancestors: ["MONDO:0000001", "MONDO:0003620", "MONDO:0005071", "MONDO:0019056", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0003401", source: "HPO", name: "Paresthesia", sourceUri: "http://purl.obolibrary.org/obo/HP_0003401",
    description: "Abnormal sensations such as tingling, pricking, or numbness of the skin with no apparent physical cause.",
    synonyms: ["Paresthesias", "Pins and needles feeling", "Tingling"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0003474", "HP:0012638", "HP:0033747"] },
  { sourceId: "MONDO:0009688", source: "Mondo", name: "myasthenia gravis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0009688",
    description: "Myasthenia gravis (MG) is a rare, clinically heterogeneous, autoimmune disorder of the neuromuscular junction characterized by fatigable weakness of voluntary muscles.",
    synonyms: ["acquired myasthenia", "autoimmune myasthenia gravis", "myasthenia gravis"],
    ancestors: ["MONDO:0000001", "MONDO:0000590", "MONDO:0002977", "MONDO:0003620", "MONDO:0005046", "MONDO:0005071", "MONDO:0007179", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0004976", source: "Mondo", name: "amyotrophic lateral sclerosis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0004976",
    description: "Amyotrophic lateral sclerosis (ALS) is a neurodegenerative disease characterized by progressive muscular paralysis reflecting degeneration of motor neurons in the primary motor cortex, corticospinal tracts, brainstem and spinal cord.",
    synonyms: ["ALS", "Charcot disease", "Lou Gehrig disease"],
    ancestors: ["MONDO:0000001", "MONDO:0002545", "MONDO:0002602", "MONDO:0003182", "MONDO:0005071", "MONDO:0005559", "MONDO:0019056", "MONDO:0020128", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0007739", source: "Mondo", name: "Huntington disease", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007739",
    description: "Huntington disease (HD) is a rare neurodegenerative disorder of the central nervous system characterized by unwanted choreatic movements, behavioral and psychiatric disturbances and dementia.",
    synonyms: ["HD", "Huntington chorea", "Huntington disease", "Huntington's chorea", "Huntington's disease"],
    ancestors: ["MONDO:0000001", "MONDO:0000167", "MONDO:0002602", "MONDO:0003847", "MONDO:0005071", "MONDO:0005395", "MONDO:0005559", "MONDO:0024237", "MONDO:0100545", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0008449", source: "Mondo", name: "spina bifida", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0008449",
    description: "A congenital neural tube defect in which vertebrae are not fully formed. It results in the protrusion of the spinal cord through the opening of the vertebrae.",
    synonyms: ["rachischisis", "spina bifida", "spina bifida (disease)", "spinal meningocele", "spinal myelocele", "spinal myelomeningocele"],
    ancestors: ["MONDO:0000001", "MONDO:0002320", "MONDO:0002545", "MONDO:0002602", "MONDO:0005071", "MONDO:0021147", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0001150", source: "Mondo", name: "hydrocephalus", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001150",
    description: "A disorder characterized by an abnormal increase of cerebrospinal fluid in the ventricles of the brain.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0002602", "MONDO:0005071", "MONDO:0005560", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0002301", source: "HPO", name: "Hemiplegia", sourceUri: "http://purl.obolibrary.org/obo/HP_0002301",
    description: "Paralysis (complete loss of muscle function) in the arm, leg, and in some cases the face on one side of the body.",
    synonyms: ["Paralysis on one side of body"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0002493", "HP:0004374", "HP:0010549", "HP:0011442", "HP:0012638"] },
  { sourceId: "HP:0010550", source: "HPO", name: "Paraplegia", sourceUri: "http://purl.obolibrary.org/obo/HP_0010550",
    description: "Severe or complete weakness of both lower extremities with sparing of the upper extremities.",
    synonyms: ["Leg paralysis"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0002493", "HP:0010549", "HP:0010551", "HP:0011442", "HP:0012638"] },
  { sourceId: "HP:0002445", source: "HPO", name: "Tetraplegia", sourceUri: "http://purl.obolibrary.org/obo/HP_0002445",
    description: "Paralysis of all four limbs, and trunk of the body below the level of an associated injury to the spinal cord. The etiology of quadriplegia is similar to that of paraplegia except that the lesion is in the cervical spinal cord rather than in the thoracic or lumbar segments of the spinal cord.",
    synonyms: ["Paralysis of all four limbs", "Quadriplegia"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000707", "HP:0002493", "HP:0010549", "HP:0011442", "HP:0012638", "HP:0030182"] },
  { sourceId: "MONDO:0005404", source: "Mondo", name: "myalgic encephalomeyelitis/chronic fatigue syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005404",
    description: "A medical condition characterized by long-term fatigue and other symptoms that limit a person's ability to carry out ordinary daily activities.",
    synonyms: ["CFS", "chronic fatigue immune dysfunction syndrome", "chronic fatigue syndrome", "myalgic encephalitis", "myalgic encephalomyelitis", "systemic exertion intolerance disease"],
    ancestors: ["MONDO:0000001", "MONDO:0002081", "MONDO:0002254", "MONDO:0003847", "MONDO:0003939", "MONDO:0005046", "MONDO:0005071", "MONDO:0021094", "MONDO:0100545", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "HP:0012378", source: "HPO", name: "Fatigue", sourceUri: "http://purl.obolibrary.org/obo/HP_0012378",
    description: "A subjective feeling of tiredness characterized by a lack of energy and motivation.",
    synonyms: ["Fatigue", "Tired", "Tiredness"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0025142"] },
  { sourceId: "MONDO:0005546", source: "Mondo", name: "fibromyalgia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005546",
    description: "A chronic disorder of unknown etiology characterized by pain, stiffness, and tenderness in the muscles of neck, shoulders, back, hips, arms, and legs. Other signs and symptoms include headaches, fatigue, sleep disturbances, and painful menstruation.",
    synonyms: ["fibromyalgia", "fibromyalgia syndrome"],
    ancestors: ["MONDO:0000001", "MONDO:0002254", "MONDO:0005071", "MONDO:0024317", "MONDO:0700007", "MONDO:0700057", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008"] },
  { sourceId: "HP:0012532", source: "HPO", name: "Chronic pain", sourceUri: "http://purl.obolibrary.org/obo/HP_0012532",
    description: "Persistent pain, usually defined as pain that has lasted longer than 3 to 6 months.",
    synonyms: ["Chronic pain", "Long-lasting pain"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0012531", "HP:0025142"] },
  { sourceId: "MONDO:0019369", source: "Mondo", name: "complex regional pain syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0019369",
    description: "A chronic pain syndrome characterized by a disproportionate spontaneous or stimulus-induced pain, accompanied by a variably mixed myriad of autonomic and motor disorders including symptoms such as swelling, allodynia, skin blood supply and trophic disturbances. CRPS most often affects one of the arms, legs, hands, or feet and usually occurs after an injury or trauma to that limb.",
    synonyms: ["algoneurodystrophy", "CRPS"],
    ancestors: ["MONDO:0000001", "MONDO:0005071", "MONDO:0024317", "MONDO:0700057", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0018486", source: "Mondo", name: "visual snow syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0018486",
    description: "Visual snow syndrome is described as a persistent visual problem characterized by seeing snow-like dots. Migraines are a common symptom. Many people also see drifting blobs of varying size and shape (floaters), visual effects (entopic phenomenon), glare, halos, starbursts, trails, odd colors and shapes, and may have persistent recurrence of a visual image (palinopsia) and double vision. Additional symptoms may include fatigue, tinnitus, or depersonalization and depression. Most people have normal vision tests and normal brain images. Standard migraine treatments are often not helpful. There is no cure or effective treatment to completely relieve the symptoms, but medication seems to help some people with visual snow.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0002022", "MONDO:0005328", "MONDO:0024458", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0008015", source: "Mondo", name: "motion sickness", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0008015",
    description: "A sensation of discomfort that results from a discordant relationship between visualized movement and any movement sensed by the vestibular system, which is characterized by dizziness, nausea, and vomiting.",
    synonyms: ["motion sickness", "travel sickness"],
    ancestors: ["MONDO:0000001", "MONDO:0002409", "MONDO:0002467", "MONDO:0003847", "MONDO:0018751", "MONDO:0021205", "MONDO:0024623", "MONDO:0037940", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0005178", source: "Mondo", name: "osteoarthritis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005178",
    description: "A noninflammatory degenerative joint disease occurring chiefly in older persons, characterized by degeneration of the articular cartilage, hypertrophy of bone at the margins and changes in the synovial membrane. It is accompanied by pain and stiffness, particularly after prolonged activity.",
    synonyms: ["degenerative joint disease"],
    ancestors: ["MONDO:0000001", "MONDO:0002081", "MONDO:0002614", "MONDO:0005172", "MONDO:0005381", "MONDO:0005578", "MONDO:0006816", "MONDO:0021166", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0008383", source: "Mondo", name: "rheumatoid arthritis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0008383",
    description: "A chronic, systemic autoimmune disorder characterized by inflammation in the synovial membranes and articular surfaces. It manifests primarily as a symmetric, erosive polyarthritis that spares the axial skeleton and is typically associated with the presence in the serum of rheumatoid factor.",
    synonyms: ["RA", "rheumatoid arthritis"],
    ancestors: ["MONDO:0000001", "MONDO:0000589", "MONDO:0002081", "MONDO:0002614", "MONDO:0003900", "MONDO:0005046", "MONDO:0005172", "MONDO:0005381", "MONDO:0005554", "MONDO:0005578", "MONDO:0006816", "MONDO:0007179", "MONDO:0021166", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0005306", source: "Mondo", name: "ankylosing spondylitis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005306",
    description: "An autoimmune chronic inflammatory disorder characterized by inflammation in the vertebral joints of the spine and sacroiliac joints. It predominantly affects young males. Patients present with stiffness and pain in the spine.",
    synonyms: ["ankylosing spondylarthritis"],
    ancestors: ["MONDO:0000001", "MONDO:0000589", "MONDO:0000812", "MONDO:0002081", "MONDO:0002614", "MONDO:0003900", "MONDO:0003937", "MONDO:0005046", "MONDO:0005095", "MONDO:0005172", "MONDO:0005381", "MONDO:0005554", "MONDO:0005578", "MONDO:0006816", "MONDO:0007179", "MONDO:0008383", "MONDO:0021166", "MONDO:0037847", "MONDO:0045002", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0011849", source: "Mondo", name: "psoriatic arthritis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0011849",
    description: "Joint inflammation associated with psoriasis.",
    synonyms: ["arthritis psoriatica", "arthropathic psoriasis"],
    ancestors: ["MONDO:0000001", "MONDO:0000589", "MONDO:0002081", "MONDO:0002254", "MONDO:0002614", "MONDO:0003900", "MONDO:0005046", "MONDO:0005172", "MONDO:0005381", "MONDO:0005554", "MONDO:0005578", "MONDO:0006816", "MONDO:0007179", "MONDO:0008383", "MONDO:0021166", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "MONDO:0007915", source: "Mondo", name: "systemic lupus erythematosus", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007915",
    description: "An autoimmune multi-organ disease typically associated with vasculopathy and autoantibody production. Most patients have antinuclear antibodies (ANA). The presence of anti-dsDNA or anti-Smith antibodies are highly-specific.",
    synonyms: ["disseminated lupus erythematosus", "lupus erythematosus, systemic", "SLE", "SLE - lupus erythematosus, systemic", "systemic lupus erythematosus", "systemic lupus erythematosus (disease)", "systemic lupus erythematosus susceptibility to"],
    ancestors: ["MONDO:0000001", "MONDO:0003847", "MONDO:0003900", "MONDO:0004670", "MONDO:0005046", "MONDO:0005554", "MONDO:0007179", "MONDO:0023603", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0010030", source: "Mondo", name: "Sjogren syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0010030",
    description: "An autoimmune disorder in which immune cells attack and destroy the glands that produce tears and saliva. Sjögren syndrome is also associated with rheumatic disorders such as rheumatoid arthritis or systemic lupus erythematosus. The hallmark symptoms of Sjögren syndrome are dry mouth and dry eyes. In addition, Sjogren syndrome may cause skin, nose, and vaginal dryness. It also may affect other organs of the body including the kidneys, blood vessels, lungs, liver, pancreas, and brain",
    synonyms: ["primary Sjogren-Gougerot syndrome", "primary Sjögren-Gougerot syndrome", "sicca syndrome", "Sjogren syndrome", "Sjögren syndrome", "Sjögren-Gougerot syndrome", "syndrome, Sjogren's"],
    ancestors: ["MONDO:0000001", "MONDO:0000462", "MONDO:0000586", "MONDO:0001142", "MONDO:0001854", "MONDO:0002022", "MONDO:0002254", "MONDO:0005046", "MONDO:0005328", "MONDO:0006858", "MONDO:0007179", "MONDO:0024458", "MONDO:0024625", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0019735", source: "Mondo", name: "polymyalgia rheumatica", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0019735",
    description: "A syndrome characterized by pain, stiffness, and tenderness of the proximal muscle groups including the shoulder, pelvic girdle and the neck. There is no muscle atrophy and muscle biopsies do not reveal pathologic changes. Additional signs and symptoms include low grade fever, fatigue and depression.",
    synonyms: ["polymyalgia rheumatica", "rhizomelic pseudopolyarthritis"],
    ancestors: ["MONDO:0000001", "MONDO:0002254", "MONDO:0003900", "MONDO:0005554", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0002829", source: "HPO", name: "Arthralgia", sourceUri: "http://purl.obolibrary.org/obo/HP_0002829",
    description: "Joint pain.",
    synonyms: ["Arthralgias", "Joint pain"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0012531", "HP:0025142"] },
  { sourceId: "MONDO:0005392", source: "Mondo", name: "scoliosis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005392",
    description: "A congenital or acquired spinal deformity characterized by lateral curvature of the spine.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0000836", "MONDO:0002081", "MONDO:0005172", "MONDO:0005381", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0002808", source: "HPO", name: "Kyphosis", sourceUri: "http://purl.obolibrary.org/obo/HP_0002808",
    description: "Exaggerated anterior convexity of the thoracic vertebral column.",
    synonyms: ["Gibbus deformity", "Hunched back", "Hyperkyphosis", "Round back"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000924", "HP:0000925", "HP:0009121", "HP:0010674", "HP:0011842", "HP:0033127"] },
  { sourceId: "HP:0001382", source: "HPO", name: "Joint hypermobility", sourceUri: "http://purl.obolibrary.org/obo/HP_0001382",
    description: "The capability that a joint (or a group of joints) has to move, passively and/or actively, beyond normal limits along physiological axes.",
    synonyms: ["Double-Jointed", "Extensible joints", "Flexible joints", "Hyperextensible joints", "Increased joint mobility", "Increased mobility of joints", "Joint hyperextensibility", "Joint hyperflexibility", "Joint hyperlaxity", "Joint laxity", "Joints move beyond expected range of motion", "Lax joints", "Loose-jointedness"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0011729", "HP:0011843", "HP:0033127", "HP:0034430"] },
  { sourceId: "MONDO:0001798", source: "Mondo", name: "hypermobility syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0001798",
    description: null,
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0002081", "MONDO:0005172", "MONDO:0006816", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "MONDO:0020066", source: "Mondo", name: "Ehlers-Danlos syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0020066",
    description: "The Ehlers–Danlos syndromes (EDS) are a clinically and genetically heterogeneous group of heritable connective tissue disorders (HCTDs) characterized by joint hypermobility, skin hyperextensibility, and tissue fragility.",
    synonyms: ["Danlos disease", "Danlos Disease, Ehlers", "danlos ehlers syndrome", "Disease, Ehlers Danlos", "Disease, Ehlers-Danlos", "Dystrophia mesodermalis congenita", "EDS", "Ehler Danlos Syndrome", "Ehlers Danlos Disease", "Ehlers Danlos syndrome", "Ehlers-Danlos Disease", "Ehlers-Danlos syndromes", "elastic skin", "Fibrodysplasia elastica generalisata", "Hereditary collagen dysplasia", "Meekeren-Ehlers-Danlos syndrome", "skin elastic", "Syndrome, Ehlers-Danlos"],
    ancestors: ["MONDO:0000001", "MONDO:0002254", "MONDO:0003847", "MONDO:0019755", "MONDO:0021147", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0007523", source: "Mondo", name: "Ehlers-Danlos syndrome, hypermobility type", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007523",
    description: "Ehlers-Danlos syndrome, hypermobility type (HT-EDS) is the most frequent form of EDS, a group of hereditary connective tissue diseases, and is characterized by joint hyperlaxity, mild skin hyperextensibility, tissue fragility and extra-musculoskeletal manifestations.",
    synonyms: ["EDS III", "EDSHMB", "Ehlers-Danlos syndrome type 3", "Ehlers-Danlos syndrome type 3 (formerly)", "Ehlers-Danlos syndrome, hypermobile type", "Ehlers-Danlos syndrome, hypermobility type", "Ehlers-Danlos syndrome, type 3", "Ehlers-Danlos syndrome, type III", "hEDS", "HT-EDS", "hypermobile EDS"],
    ancestors: ["MONDO:0000001", "MONDO:0002254", "MONDO:0003847", "MONDO:0019755", "MONDO:0020066", "MONDO:0021147", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0007947", source: "Mondo", name: "Marfan syndrome", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007947",
    description: "A disorder of the connective tissue. Connective tissue provides strength and flexibility to structures throughout the body such as bones, ligaments, muscles, walls of blood vessels, and heart valves. Marfan syndrome affects most organs and tissues, especially the skeleton, lungs, eyes, heart, and the large blood vessel that distributes blood from the heart to the rest of the body (the aorta). It is caused by mutations in the FBN1 gene, which provides instructions for making a protein called fibrillin-1. Marfan syndrome is inherited in an autosomal dominant pattern. At least 25% of cases are due to a new (de novo) mutation. Treatment is based on the signs and symptoms in each person.",
    synonyms: ["Marfan syndrome type 1", "Marfan syndrome, type 1", "Marfan's syndrome", "MFS", "MFS1"],
    ancestors: ["MONDO:0000001", "MONDO:0000426", "MONDO:0000429", "MONDO:0002081", "MONDO:0002254", "MONDO:0003847", "MONDO:0003900", "MONDO:0005172", "MONDO:0017310", "MONDO:0023603", "MONDO:0700096", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0019019", source: "Mondo", name: "osteogenesis imperfecta", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0019019",
    description: "Osteogenesis imperfecta (OI) comprises a heterogeneous group of genetic disorders characterized by increased bone fragility, low bone mass, and susceptibility to bone fractures with variable severity.",
    synonyms: ["brittle bone disease", "glass bone disease", "Lobstein disease", "OI", "Osteopsathyrosis", "Porak and Durante disease"],
    ancestors: ["MONDO:0000001", "MONDO:0002081", "MONDO:0003847", "MONDO:0005172", "MONDO:0005381", "MONDO:0005497", "MONDO:0005516", "MONDO:0018230", "MONDO:0021147", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0007037", source: "Mondo", name: "achondroplasia", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0007037",
    description: "Achondroplasia is the most common form of chondrodysplasia, characterized by rhizomelia, exaggerated lumbar lordosis, brachydactyly, and macrocephaly with frontal bossing and midface hypoplasia.",
    synonyms: ["ACH"],
    ancestors: ["MONDO:0000001", "MONDO:0002081", "MONDO:0003847", "MONDO:0005172", "MONDO:0005381", "MONDO:0005497", "MONDO:0005516", "MONDO:0018230", "MONDO:0019685", "MONDO:0021147", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0010679", source: "Mondo", name: "Duchenne muscular dystrophy", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0010679",
    description: "Duchenne muscular dystrophy (DMD) is a neuromuscular disease characterized by rapidly progressive muscle weakness and wasting due to degeneration of skeletal, smooth and cardiac muscle.",
    synonyms: ["DMD", "Duchenne muscular dystrophy, X-linked recessive", "severe dystrophinopathy, Duchenne type"],
    ancestors: ["MONDO:0000001", "MONDO:0002081", "MONDO:0003847", "MONDO:0003939", "MONDO:0005071", "MONDO:0005336", "MONDO:0019056", "MONDO:0020120", "MONDO:0020121", "MONDO:0100545", "MONDO:0100546", "MONDO:0700096", "MONDO:0700223", "MONDO:0700285", "MONDO:7770006", "MONDO:7770008", "MONDO:7770009"] },
  { sourceId: "MONDO:0004833", source: "Mondo", name: "plantar fasciitis", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0004833",
    description: "Inflammation of the thick tissue on the bottom of the foot (plantar fascia) causing heel pain. The plantar fascia (also called plantar aponeurosis) are bands of fibrous tissue extending from the calcaneal tuberosity to the toes. The etiology of plantar fasciitis remains controversial but is likely to involve a biomechanical imbalance. Though often presenting along with heel spur, they do not appear to be causally related.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0002081", "MONDO:0003900", "MONDO:0004830", "MONDO:0021166", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007"] },
  { sourceId: "HP:0001763", source: "HPO", name: "Pes planus", sourceUri: "http://purl.obolibrary.org/obo/HP_0001763",
    description: "A foot where the longitudinal arch of the foot is in contact with the ground or floor when the individual is standing; or, in a patient lying supine, a foot where the arch is in contact with the surface of a flat board pressed against the sole of the foot by the examiner with a pressure similar to that expected from weight bearing; or, the height of the arch is reduced.",
    synonyms: ["Flat feet", "Flat foot"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0001760", "HP:0002814", "HP:0040064"] },
  { sourceId: "HP:0001822", source: "HPO", name: "Hallux valgus", sourceUri: "http://purl.obolibrary.org/obo/HP_0001822",
    description: "Lateral deviation of the great toe (i.e., in the direction of the little toe).",
    synonyms: ["Bunion", "Lateral deviation of great toe", "Lateral deviation of halluces"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000924", "HP:0001760", "HP:0001780", "HP:0001844", "HP:0002813", "HP:0002814", "HP:0010051", "HP:0011297", "HP:0011842", "HP:0011844", "HP:0033127", "HP:0040064", "HP:0040068", "HP:0100498"] },
  { sourceId: "HP:0002857", source: "HPO", name: "Genu valgum", sourceUri: "http://purl.obolibrary.org/obo/HP_0002857",
    description: "The legs angle inward, such that the knees are close together and the ankles far apart.",
    synonyms: ["Genu valga", "Genu valgus", "Genua valga", "Knee joint valgus deformity", "Knock knees"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000924", "HP:0000940", "HP:0001367", "HP:0002813", "HP:0002814", "HP:0002815", "HP:0002979", "HP:0002981", "HP:0006487", "HP:0011314", "HP:0011842", "HP:0011844", "HP:0033127", "HP:0034669", "HP:0040064", "HP:0040068", "HP:0100491"] },
  { sourceId: "HP:0002970", source: "HPO", name: "Genu varum", sourceUri: "http://purl.obolibrary.org/obo/HP_0002970",
    description: "A positional abnormality marked by outward bowing of the legs in which the knees stay wide apart when a person stands with the feet and ankles together.",
    synonyms: ["Genu vara", "Genua vara", "Outward bow-leggedness", "Outward bowing at knees"],
    ancestors: ["HP:0000001", "HP:0000118", "HP:0000924", "HP:0000940", "HP:0001367", "HP:0002813", "HP:0002814", "HP:0002815", "HP:0002979", "HP:0002981", "HP:0006487", "HP:0011314", "HP:0011842", "HP:0011844", "HP:0033127", "HP:0034669", "HP:0040064", "HP:0040068", "HP:0100491"] },
  { sourceId: "MONDO:0024333", source: "Mondo", name: "sciatica", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0024333",
    description: "A condition characterized by pain radiating from the back into the buttock and posterior/lateral aspects of the leg. Sciatica may be a manifestation of sciatic neuropathy; radiculopathy (involving the spinal nerve roots; L4, L5, S1, or S2, often associated with intervertebral disk displacement); or lesions of the cauda equina.",
    synonyms: [],
    ancestors: ["MONDO:0000001", "MONDO:0001397", "MONDO:0003620", "MONDO:0005071", "MONDO:0005244", "MONDO:0006960", "MONDO:0019056", "MONDO:0021667", "MONDO:0700057", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0003419", source: "HPO", name: "Low back pain", sourceUri: "http://purl.obolibrary.org/obo/HP_0003419",
