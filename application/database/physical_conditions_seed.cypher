    synonyms: ["TMD"],
    ancestors: ["MONDO:0000001", "MONDO:0002081", "MONDO:0005172", "MONDO:0006816", "MONDO:0700096", "MONDO:7770006"] },
  { sourceId: "HP:0003394", source: "HPO", name: "Muscle spasm", sourceUri: "http://purl.obolibrary.org/obo/HP_0003394",
