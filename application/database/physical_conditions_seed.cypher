// -----------------------------------------------------------------------------
// 0. Constraints
// -----------------------------------------------------------------------------

CREATE CONSTRAINT condition_source_id_unique IF NOT EXISTS
FOR (n:Condition) REQUIRE n.sourceId IS UNIQUE;

CREATE CONSTRAINT condition_id_unique IF NOT EXISTS
FOR (n:Condition) REQUIRE n.id IS UNIQUE;


