  { sourceId: "MONDO:0005420", source: "Mondo", name: "hypothyroidism", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0005420",
    description: "Abnormally low levels of thyroid hormone.",
    synonyms: ["hypothyroidism", "underactive thyroid"],
