    ancestors: ["MONDO:0000001", "MONDO:0002051", "MONDO:0002406", "MONDO:0003847", "MONDO:0005046", "MONDO:0005093", "MONDO:0021166", "MONDO:0100118", "MONDO:0700096", "MONDO:7770006", "MONDO:7770007", "MONDO:7770008", "MONDO:7770009"] },
