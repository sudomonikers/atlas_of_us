  { sourceId: "MONDO:0008560", source: "Mondo", name: "thrombophilia due to activated protein C resistance", sourceUri: "http://purl.obolibrary.org/obo/MONDO_0008560",
    description: "A hemostatic disorder characterized by a poor anticoagulant response to activated protein C (APC). The activated form of Factor V (Factor Va) is more slowly degraded by activated protein C. Factor V Leiden mutation (R506Q) is the most common cause of APC resistance.",
