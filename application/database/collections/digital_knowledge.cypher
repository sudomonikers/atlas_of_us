// =============================================================================
// Atlas of Us — Digital Knowledge seed
// Spec: documentation/data_model/topics/topics.md
//
// The Digital Knowledge collection, by the id the UI asks for it by, and the
// topics getting by safely and well online and on our devices takes, which it
// CONTAINS, each by its id, with `order` its place in the walkthrough. Each has
// three QuizQuestions, one TESTS each of its Remember, Understand and Apply
// levels. `answer` is the index of the right one of a question's `choices`.
// Run migrations 022, 025 and 026 first.
//
// Idempotent: safe to re-run. The list and its order are set from this file on
// every run. A question is matched on the level it tests, and written once,
// when the level has none.
// =============================================================================

MERGE (c:Collection {id: "digital-knowledge"})
SET c.name = "Digital Knowledge",
    c.description = "What getting by safely and well online and on our devices takes: security, privacy, how it all works, files, feeds and AI, money online and getting along.";

MATCH (:Collection {id: "digital-knowledge"})-[contains:CONTAINS]->(:Topic)
DELETE contains;

UNWIND [
  {id: "c3faddc6-1066-489f-8c1b-24f1fd2b59f0", name: "Internet Safety", order: 0, questions: [{rank: 1, prompt: "What is doxxing?", choices: ["Publishing someone's private details, such as their address","Breaking into someone's email account to read it","Sending someone a stream of hostile messages","Pretending to be someone else on social media"], answer: 0, explanation: "It turns online anger into a risk to someone's safety at home."}, {rank: 2, prompt: "Why can posting a photo of your new house keys or your boarding pass be risky?", choices: ["Photos of objects are often removed as spam","Codes and details in the photo can be copied and used","Those photos use more data than other photos","The site then owns the objects in the photo"], answer: 1, explanation: "Keys can be copied from a clear photo, and a boarding pass's barcode opens the booking."}, {rank: 3, prompt: "You're two weeks into a trip abroad and want to post your holiday photos. What's the safer choice?", choices: ["Post them once you're back home","Post them now, but only ones of the beach","Post them now with the location tagged","Post them now and turn the comments off"], answer: 0, explanation: "Posting while you're away tells anyone who sees it that your home is empty."}]},
  {id: "88aa6d52-23ac-4432-abdb-25cd28d111a6", name: "Cybersecurity", order: 1, questions: [{rank: 1, prompt: "In security, what does the principle of least privilege mean?", choices: ["The newest staff get the fewest computers","Each person or program gets only the access it needs","Passwords are changed at least once a year","Only managers may use the company's systems"], answer: 1, explanation: "Less access means less harm when an account is misused or taken over."}, {rank: 2, prompt: "Why do organizations use several layers of security, such as firewalls, passwords and backups, rather than one strong one?", choices: ["Each layer makes the other layers run faster","Laws require exactly three layers of security","Attackers can only break through one layer a day","If one layer fails, another can still stop the attack"], answer: 3, explanation: "No single defense is perfect, so each one covers for the others' gaps."}, {rank: 3, prompt: "A coworker leaves the company. What should happen to their accounts?", choices: ["They stay active in case the person comes back","Their access is turned off on their last day","Their password is given to their replacement","They're renamed and kept for the next hire"], answer: 1, explanation: "An account that still works after someone leaves is an easy way in for them or an attacker."}]},
  {id: "c373fe0f-73aa-42af-a17b-109ec915709e", name: "Password Security", order: 2, questions: [{rank: 1, prompt: "What is a passphrase?", choices: ["The answer to an account's security question","A one-time code texted to your phone","A password a whole family shares","A password made of several random words strung together"], answer: 3, explanation: "Several random words make a password long, which makes it hard to guess but easy to remember."}, {rank: 2, prompt: "Why is a password of four random everyday words usually harder to crack than a short one like \"Tr0ub@d!\"?", choices: ["Cracking software can't handle the spaces between words","Websites store long passwords in a safer way","Symbols and numbers make a password weaker","Every extra character multiplies the guesses an attacker has to try"], answer: 3, explanation: "Length adds far more possible combinations than swapping in symbols does."}, {rank: 3, prompt: "A site you used was breached, and you'd used the same password there and for your email. What should you do first?", choices: ["Delete your account on the breached site and leave it there","Change your email password, and anywhere else that password was used","Wait to see whether anything strange happens to your email","Add a number to the end of the old password everywhere"], answer: 1, explanation: "Attackers try leaked passwords on other sites, and a small change to the old one is easy to guess."}]},
  {id: "998ad3a9-a78d-4018-8005-b7fdb663a9ee", name: "Password Managers", order: 3, questions: [{rank: 1, prompt: "What does a password manager do?", choices: ["Changes every one of your passwords each day","Stores your passwords in an encrypted vault and fills them in","Blocks any website that asks for a password","Lets websites share your password with each other"], answer: 1, explanation: "You remember one master password, and it remembers the rest."}, {rank: 2, prompt: "Why can a password manager make you safer, even though it keeps all your passwords in one place?", choices: ["Its vault can't be opened by anyone, even with the master password","It stops the websites you use from ever being breached","It hides your accounts from anyone searching for them","Each account can get a long, unique password you never have to remember"], answer: 3, explanation: "Without one, most people reuse a few short passwords, and one leak opens many accounts."}, {rank: 3, prompt: "Your password manager always fills in your bank login on the bank's site, but won't on a page you reached from a text message link. What should you do?", choices: ["Leave the page and go to your bank's site yourself","Copy the password from the manager and paste it in","Turn the manager off and type the password from memory","Reply to the text to ask whether the link is real"], answer: 0, explanation: "A manager fills only on the exact site it saved, so a page it won't fill is likely a fake."}]},
  {id: "1e95146f-bf04-4f56-9989-7dd104a32223", name: "Two-Factor Authentication", order: 4, questions: [{rank: 1, prompt: "Which of these is a second factor in two-factor authentication?", choices: ["A code from an authenticator app on your phone","A second, longer password","The username on the account","The answer to a security question"], answer: 0, explanation: "A second factor is something you have or are, not another thing you know."}, {rank: 2, prompt: "Why is a code from an authenticator app generally safer than one sent by text message?", choices: ["Authenticator codes are longer than text codes","Text message codes never expire once sent","Authenticator apps only work while you're logged in","A phone number can be moved to a scammer's SIM card"], answer: 3, explanation: "Scammers can talk a phone company into moving your number to their SIM card."}, {rank: 3, prompt: "You get a login code by text for one of your accounts, but you didn't try to log in. What should you do?", choices: ["Reply to the text with STOP to block it","Enter the code so the login attempt finishes","Don't share the code, and change that account's password","Ignore it, since the code kept the account safe"], answer: 2, explanation: "The code was sent because someone had the password, so the password needs changing."}]},
  {id: "3d3dbbf2-bd43-4ee6-b7ed-6e8353ce7784", name: "Phishing", order: 5, questions: [{rank: 1, prompt: "What is spear phishing?", choices: ["Phishing carried out over a phone call","Phishing aimed at one person, using details about them","A fake website at a misspelled web address","The same scam email sent to millions of people"], answer: 1, explanation: "Personal details make the message more believable than a mass email."}, {rank: 2, prompt: "Why do phishing messages so often say your account will be locked unless you act right away?", choices: ["Accounts really are locked within the hour","Urgent wording gets messages past spam filters","Urgency pushes people to act before they stop to check","Laws require deadlines in account notices"], answer: 2, explanation: "A deadline cuts out the pause in which most people would notice something is off."}, {rank: 3, prompt: "An email in your boss's name urgently asks you to buy gift cards for a client and send the codes. It comes from a personal address you don't recognize. What should you do?", choices: ["Buy the cards, since your boss's name is on it","Check with your boss another way, such as a call","Reply to the email to ask whether it's real","Buy just one card first to see what happens"], answer: 1, explanation: "Replying reaches the scammer, and only a separate channel reaches your real boss."}]},
  {id: "3c900aa9-bf30-4a91-9a6f-160487510cca", name: "Online Scams", order: 6, questions: [{rank: 1, prompt: "In an advance-fee scam, what are you asked to do?", choices: ["Pay for an item in monthly installments","Pay a small fee up front to receive a much larger sum later","Leave a deposit that's refunded when you return a rental","Pay a membership fee for discounts at a store"], answer: 1, explanation: "The larger sum never comes, and more fees are asked for along the way."}, {rank: 2, prompt: "Why do scammers so often ask to be paid in gift cards, wire transfers or cryptocurrency?", choices: ["Those payments carry the lowest fees for sellers","They're hard to trace and almost never reversed","Banks require them for sales made online","They're the only ways to pay someone abroad"], answer: 1, explanation: "A card payment can be disputed, and these usually can't."}, {rank: 3, prompt: "A seller on a marketplace site offers a phone far below other prices, and asks you to pay outside the site by bank transfer. What should you do?", choices: ["Pay half by transfer now and half on delivery","Ask for a photo of the phone, then make the transfer","Make the transfer, since the price is so low","Pay only through the site's own payment system, or walk away"], answer: 3, explanation: "Paying outside the site gives up its buyer protection, which is what the scammer wants."}]},
  {id: "d57759a8-29a9-42f0-a915-8eb463050eae", name: "Social Engineering", order: 7, questions: [{rank: 1, prompt: "In security, what is social engineering?", choices: ["Designing the features of social media apps","Manipulating people into giving up information or access","Writing software that spreads between computers","Planning the public services of a city"], answer: 1, explanation: "It attacks people's trust rather than their computers."}, {rank: 2, prompt: "Why do social engineers often pretend to be from IT support or a company's management?", choices: ["Those roles can already see every password in the company","Calls from IT support can't be recorded or traced","Emails from managers skip the company's spam filters","People tend to trust and go along with those who seem to have authority"], answer: 3, explanation: "A claimed role makes an unusual request feel normal."}, {rank: 3, prompt: "Someone in a delivery uniform, arms full of boxes, asks you to hold the door into your badge-only office. What should you do?", choices: ["Hold the door, since their hands are full","Point them to reception rather than letting them in","Let them in if their uniform looks real","Let them in and keep an eye on where they go"], answer: 1, explanation: "Following someone through a secure door is a common way in, and a uniform is easy to fake."}]},
  {id: "13eded97-ed45-4cc9-938e-82726b7aaf89", name: "Malware", order: 8, questions: [{rank: 1, prompt: "What does a trojan do?", choices: ["Poses as useful software while doing harm in the background","Copies itself across a network with no help from anyone","Encrypts your files and demands a payment","Fills your browser with unwanted adverts"], answer: 0, explanation: "Like the wooden horse, it gets in by looking like something wanted."}, {rank: 2, prompt: "Why is an app from an official app store less likely to be malware than one downloaded from a random website?", choices: ["Official stores review apps and remove harmful ones","Apps from elsewhere are always out-of-date versions","Official stores run every app on their own servers","Phones stop outside apps from reaching the internet"], answer: 0, explanation: "Review isn't perfect, but it filters out much of what a random site would pass on."}, {rank: 3, prompt: "Your computer suddenly shows pop-ups, runs slowly, and your browser's home page has changed by itself. What should you do first?", choices: ["Buy more storage space for the computer","Click the pop-up that says it can remove a virus","Clear your browser history and carry on","Run a full scan with up-to-date security software"], answer: 3, explanation: "Those are signs of malware, and pop-ups offering to fix it are often malware too."}]},
  {id: "e7bdbcfa-3cec-4886-8546-40124e3afc83", name: "Ransomware", order: 9, questions: [{rank: 1, prompt: "What does ransomware do?", choices: ["Encrypts your files and demands payment to unlock them","Records your passwords as you type them","Fills your screen with adverts you can't close","Uses your computer to mine cryptocurrency"], answer: 0, explanation: "Paying doesn't guarantee the files come back."}, {rank: 2, prompt: "Why is a backup kept on a drive that's unplugged the best protection against ransomware?", choices: ["Unplugged drives keep files in a format ransomware can't read","Ransomware only targets files kept in cloud storage","Ransomware can only encrypt drives it can reach from the computer","A backup stops ransomware from installing in the first place"], answer: 2, explanation: "A backup that stays plugged in is usually encrypted along with everything else."}, {rank: 3, prompt: "Ransomware has encrypted your laptop's files, and you have a backup from last night on an unplugged drive. What should you do?", choices: ["Pay the ransom to get back today's work as well","Wipe the laptop, reinstall and restore the backup","Plug in the backup drive right away to check it","Restart the laptop until the files come back"], answer: 1, explanation: "Plugging the backup into an infected laptop risks losing it too."}]},
  {id: "0200ae1b-0d3b-4dd0-a9f6-256e7a1de6a1", name: "Software Updates", order: 10, questions: [{rank: 1, prompt: "What is a security patch?", choices: ["An update that fixes a weakness attackers could use","A sticker showing a device has been checked","A program that scans files for viruses","A new version of an app with a new design"], answer: 0, explanation: "Patches close holes that are often already known to attackers."}, {rank: 2, prompt: "Why do attacks on a weakness often increase right after a patch for it is released?", choices: ["Patches usually add new weaknesses of their own","Updated devices announce themselves to attackers","It points attackers to the hole, and many devices stay unpatched","Attackers can only reach devices while they update"], answer: 2, explanation: "Attackers study the fix to find the hole, then target everyone who hasn't updated."}, {rank: 3, prompt: "Your phone no longer gets updates because its maker has stopped supporting it. What's the safest choice?", choices: ["Keep using it as before, since it still works fine","Install an antivirus app, which does the same job","Plan to replace it, since new weaknesses won't be fixed","Reset it to factory settings every month"], answer: 2, explanation: "Without patches, every weakness found from now on stays open."}]},
  {id: "a0294ecc-2563-4c06-94bc-f1dcf22a7f3f", name: "Public Wi-Fi Security", order: 11, questions: [{rank: 1, prompt: "What is an evil twin?", choices: ["A fake Wi-Fi hotspot named like a real one to snoop on users","A copy of a website at a misspelled address","A second account made with your stolen details","A virus that copies itself onto USB drives"], answer: 0, explanation: "It might be called \"Airport Free WiFi\", one letter off the real one."}, {rank: 2, prompt: "Why is it risky to join an open public Wi-Fi network that needs no password?", choices: ["It uses up your phone plan's data allowance","It can only load websites at reduced speeds","Others on it may be able to see traffic that isn't encrypted","It shares your contacts with the network's owner"], answer: 2, explanation: "With no password, the network's own traffic isn't encrypted."}, {rank: 3, prompt: "You're at an airport and need to check your bank balance. Which is the safest way?", choices: ["Use the free airport Wi-Fi, since the airport runs it","Join whichever network has the strongest signal","Use the Wi-Fi, then clear your history afterward","Use your phone's mobile data instead of the airport Wi-Fi"], answer: 3, explanation: "Mobile data is encrypted between you and the network, and you can't be sure which hotspot is real."}]},
  {id: "b81ad318-b48d-42c4-9a28-ef4f2e53c76d", name: "Account Recovery", order: 12, questions: [{rank: 1, prompt: "What is a recovery code?", choices: ["A code saved ahead of time to get in if you lose your phone","The code a site texts you each time you log in","The PIN that unlocks your phone's screen","A code that deletes an account for good"], answer: 0, explanation: "Sites with two-factor give a few of these when you set it up, to keep somewhere safe."}, {rank: 2, prompt: "Why is it risky to answer security questions, like your mother's maiden name, truthfully?", choices: ["Sites show those answers on your profile page","True answers are too long for most forms","Sites close accounts that use real answers","The true answers are often public or easy to guess"], answer: 3, explanation: "A made-up answer kept in a password manager is far harder to find."}, {rank: 3, prompt: "You're setting up the email account that all your other accounts reset their passwords through. What's most important?", choices: ["Add a recovery phone or email, and save its recovery codes","Use your birth date as its password so you won't forget","Leave two-factor off so you can never be locked out","Use the same password as your old email account"], answer: 0, explanation: "Losing this account means losing the way back into all the others."}]},
  {id: "b64e9e36-ae84-4cb6-97b9-e3674ffc06a0", name: "Digital Footprint", order: 13, questions: [{rank: 1, prompt: "What is a passive digital footprint?", choices: ["The posts and photos you choose to publish","The total time you spend online each day","Data collected about you without you choosing to share it","The files you've deleted from your computer"], answer: 2, explanation: "Sites, apps and devices record things like your visits and location as you go."}, {rank: 2, prompt: "Why might deleting a post not remove it from the internet?", choices: ["Deleted posts become public again after a year","Deleting only works from a computer, not a phone","Laws require sites to show every post forever","Others may already have copied, shared or archived it"], answer: 3, explanation: "Screenshots, shares and archive sites keep copies the original site can't reach."}, {rank: 3, prompt: "You're about to apply for jobs. What should you do about your online presence?", choices: ["Delete your email account and start a new one","Search your name and tidy up what an employer shouldn't see","Post more often so older posts get pushed down","Nothing, since employers aren't allowed to look"], answer: 1, explanation: "Many employers search applicants' names, so it's worth seeing what they'd find."}]},
  {id: "e921fa5b-b146-4760-8c7e-be4df9bcea3c", name: "Browser Cookies", order: 14, questions: [{rank: 1, prompt: "What is a browser cookie?", choices: ["A program that blocks pop-up windows on sites","A virus that spreads through downloaded files","A small file a site keeps in your browser to remember you","A saved copy of a whole web page for later"], answer: 2, explanation: "Cookies keep you logged in and remember settings such as a shopping cart."}, {rank: 2, prompt: "What's the difference between first-party and third-party cookies?", choices: ["First-party are free to use, while third-party are paid for","First-party last for a day, while third-party never expire","First-party come from the site you visit, third-party from others","First-party hold passwords, while third-party hold photos"], answer: 2, explanation: "Third-party cookies, such as an ad network's, can follow you from site to site."}, {rank: 3, prompt: "You want to stay logged in to sites on your own laptop, but not be followed by ads across them. Which setting fits?", choices: ["Delete all cookies after each visit","Turn off JavaScript everywhere","Block third-party cookies","Use a different browser for each site"], answer: 2, explanation: "Deleting every cookie would log you out each time, while blocking third-party ones stops the cross-site tracking."}]},
  {id: "c06b30a9-c9e5-41de-b24a-9f1850ab2f2b", name: "Web Tracking", order: 15, questions: [{rank: 1, prompt: "What is browser fingerprinting?", choices: ["Unlocking the browser with your own fingerprint","Keeping a list of the websites you have visited","Recognizing a browser from its unique mix of settings","Checking a website's security certificate first"], answer: 2, explanation: "It can follow a browser even after its cookies are cleared."}, {rank: 2, prompt: "Why doesn't private or incognito mode stop websites from tracking you?", choices: ["It only works on websites you have visited before","It stops your device saving history, but sites still see you","It switches off whenever a page asks for a password","It hides you from your device but sends sites more data"], answer: 1, explanation: "Your device forgets the session, but the sites and your network still see it."}, {rank: 3, prompt: "You keep seeing ads for shoes you looked at on another site. Which change would cut down this tracking most?", choices: ["Clear your browsing history once a month","Buy the shoes so the ads stop","Switch to a different email address","Use a browser or extension that blocks trackers"], answer: 3, explanation: "Blocking trackers stops the ad networks recording where you go in the first place."}]}
] AS x
MATCH (t:Topic {id: x.id}), (c:Collection {id: "digital-knowledge"})
MERGE (c)-[contains:CONTAINS]->(t)
SET contains.order = x.order
WITH t, x
UNWIND x.questions AS q
MATCH (t)-[:HAS_LEVEL]->(l:BloomLevel {rank: q.rank})
MERGE (question:QuizQuestion)-[:TESTS]->(l)
ON CREATE SET question.id = randomUUID(), question.prompt = q.prompt, question.choices = q.choices,
              question.answer = q.answer, question.explanation = q.explanation, question.createdAt = datetime();

UNWIND [
  {id: "c690db32-12f5-4679-b60d-86c5df96fd7b", name: "App Permissions", order: 16, questions: [{rank: 1, prompt: "What is an app permission?", choices: ["Access an app asks for to your camera, contacts or data","A license you buy to keep using an app","The age rating an app is given in the store","A rule about which countries an app is sold in"], answer: 0, explanation: "Your phone asks you before an app gets each kind of access."}, {rank: 2, prompt: "Why should a flashlight app asking for your contacts and location make you wary?", choices: ["Flashlight apps drain the battery faster than others","Contacts access makes every app run more slowly","It doesn't need them to work, so it may be collecting data","Phones only allow one permission for each app"], answer: 2, explanation: "Asking for more than an app needs is a sign it's after your data."}, {rank: 3, prompt: "A photo-editing app asks for access to your photos, and your phone offers a choice. What's the safest option that still lets you edit?", choices: ["Allow full access to all your photos","Allow access to all photos and your location","Allow full access, then switch it off at night","Allow access only to the photos you pick"], answer: 3, explanation: "It can edit what you choose without seeing everything else you've taken."}]},
  {id: "301ff3fc-7dfe-4918-9c4e-6dc5f6fd0157", name: "Location Tracking", order: 17, questions: [{rank: 1, prompt: "What does a photo's location metadata record?", choices: ["Who is in the photo","How large the photo's file is","Where the photo was taken","Which app edited the photo"], answer: 2, explanation: "Phones often save the exact spot in the photo file unless you turn it off."}, {rank: 2, prompt: "Why can your phone know roughly where you are even with GPS turned off?", choices: ["It keeps the last place GPS was on forever","Its light sensor can work out where it is","Apps swap guesses about where you live","Nearby Wi-Fi networks and cell towers reveal it"], answer: 3, explanation: "Every tower and network has a known location, so the ones in range place the phone."}, {rank: 3, prompt: "You want to post a photo of your kids playing in your front yard publicly. What should you do first?", choices: ["Turn the photo black and white","Crop the photo into a square","Remove its location data before posting","Give the photo file a new name"], answer: 2, explanation: "Location data in the file can show strangers exactly where your kids live."}]},
  {id: "ab2cc7fd-91e8-45b1-bc4b-5ddf15973f3e", name: "Data Brokers", order: 18, questions: [{rank: 1, prompt: "What does a data broker do?", choices: ["Lends people money against their data","Stores backups of files for companies","Sets the prices of internet plans","Collects information about people and sells it"], answer: 3, explanation: "Its buyers include advertisers, lenders and people-search sites."}, {rank: 2, prompt: "How can a data broker know things you never told it, such as your likely income?", choices: ["Banks share everyone's balances in public lists","It reads the messages you send on your phone","It combines data from many sources and infers what's missing","Your income is printed on your identity card"], answer: 2, explanation: "Where you live, what you buy and what you browse together point to much more."}, {rank: 3, prompt: "You find your address and phone number listed on a people-search site. What can you usually do?", choices: ["Use the site's opt-out process to have it removed","Pay the site to show the listing less often","Leave a review asking them to remove it","Nothing, since anything listed there is public"], answer: 0, explanation: "Most such sites have an opt-out, though you may need to repeat it on others."}]},
  {id: "52dc7f3a-bcb0-48dc-87f8-9d02dafe07c5", name: "Encryption", order: 19, questions: [{rank: 1, prompt: "What does encryption do to data?", choices: ["Shrinks it so it takes up less space on a drive","Scrambles it so only someone with the key can read it","Copies it onto a second drive as a backup","Deletes it after a set amount of time has passed"], answer: 1, explanation: "Without the key, encrypted data looks like random noise."}, {rank: 2, prompt: "In public-key encryption, what's the difference between the public key and the private key?", choices: ["Anyone can encrypt with the public key, only the private one decrypts","The public key is shorter, so it is quicker to type in","Private keys only work on phones, public keys on computers","Public keys expire every day, private keys never do"], answer: 0, explanation: "That's how strangers can send you something only you can open."}, {rank: 3, prompt: "You need to send a scan of your passport to an agency that asked for it. Which is safest?", choices: ["Use the agency's secure upload page","Attach it to an ordinary email","Send it in a social media message","Share a link to a public cloud folder"], answer: 0, explanation: "A secure upload page encrypts the scan in transit and sends it only to the agency."}]},
  {id: "f8e0c7d5-d1ce-479b-9cf7-9f20132486c2", name: "End-to-End Encryption", order: 20, questions: [{rank: 1, prompt: "With end-to-end encryption, who can read a message?", choices: ["The sender, the recipient and the app company","Anyone connected to the same Wi-Fi","Only the company that runs the app","Only the sender and the recipient"], answer: 3, explanation: "It's encrypted on the sender's device and only decrypted on the recipient's."}, {rank: 2, prompt: "Why can't an end-to-end encrypted app hand over what your messages say, even when asked to?", choices: ["It deletes each message as soon as it's sent","The law forbids any request for messages","It stores messages only on its own servers","The company never has the keys to read them"], answer: 3, explanation: "The keys stay on the users' devices, so the company only ever holds scrambled data."}, {rank: 3, prompt: "You need to send a relative a sensitive medical document. Which way best keeps anyone else from reading it?", choices: ["An ordinary text message","A messaging app with end-to-end encryption","An ordinary email","A comment on a private social media post"], answer: 1, explanation: "Texts, ordinary email and posts can be read by the companies that carry them."}]},
  {id: "30372dd8-d0db-4d31-92eb-f05c05b87311", name: "Virtual Private Networks", order: 21, questions: [{rank: 1, prompt: "What does a VPN do?", choices: ["Makes your internet connection run faster","Blocks every virus from reaching your device","Sends your traffic through an encrypted tunnel","Hides you completely from every website"], answer: 2, explanation: "Sites see the VPN's address, and your network sees only encrypted traffic."}, {rank: 2, prompt: "Why doesn't a VPN make you anonymous to the websites you log into?", choices: ["VPNs only hide your location from banks","VPN servers publish their users' names","Logging in tells the site who you are","Websites can switch a VPN off remotely"], answer: 2, explanation: "A VPN hides your address, not the account you sign in with."}, {rank: 3, prompt: "On a café's Wi-Fi, you don't want the network's owner to see which sites you visit. What helps?", choices: ["Using a private browsing window","Turning on a trusted VPN","Clearing your cookies first","Turning off your Bluetooth"], answer: 1, explanation: "The network then sees only an encrypted connection to the VPN."}]},
  {id: "9aa6648a-3e44-4877-b52a-90d8b593d211", name: "Computer Basics", order: 22, questions: [{rank: 1, prompt: "What does a computer's CPU do?", choices: ["Carries out the instructions of programs","Keeps files when the power is off","Shows images on the screen","Connects the computer to Wi-Fi"], answer: 0, explanation: "The processor does the actual computing, step by step."}, {rank: 2, prompt: "What's the difference between memory (RAM) and storage?", choices: ["RAM holds photos and music, while storage holds the apps","They are the same thing, only measured in different units","Storage is faster than RAM, so programs run from storage","RAM holds what's running and empties when off, storage keeps files"], answer: 3, explanation: "That's why unsaved work is lost in a power cut but saved files aren't."}, {rank: 3, prompt: "Your laptop says its disk is full and won't save files. What helps most?", choices: ["Add more RAM to the laptop","Delete or move large files you don't need","Close all the programs you have open","Turn the screen brightness down"], answer: 1, explanation: "A full disk is a storage problem, and more RAM doesn't add room for files."}]},
  {id: "241b1a0e-7147-4629-94fb-c884861ce56b", name: "The Internet", order: 23, questions: [{rank: 1, prompt: "What does an internet service provider (ISP) do?", choices: ["Connects your home or phone to the internet","Builds the websites you visit","Makes the computers people buy","Runs every search engine"], answer: 0, explanation: "Your ISP is the company you pay for your connection."}, {rank: 2, prompt: "Why is information sent across the internet split into packets?", choices: ["Small pieces are too short for hackers to read","Pieces can take different routes and be resent if lost","Each country the data crosses takes one piece","Packets cost less to store than whole files"], answer: 1, explanation: "If one route is busy or a piece goes missing, only that piece needs to go again."}, {rank: 3, prompt: "Your video call keeps freezing while others at home stream movies. What will help most?", choices: ["Close the call app and open it again","Turn the call's video quality up","Pause the other streams during the call","Clear your browser's history"], answer: 2, explanation: "Everyone at home shares the same connection, so freeing some of it helps the call."}]},
  {id: "6d29d2fc-1c0d-4699-827c-ee02d5326452", name: "Computer Networks", order: 24, questions: [{rank: 1, prompt: "What is an IP address?", choices: ["The name a website is reached by","A number that identifies a device on a network","The login for an email account","A type of cable that links networks"], answer: 1, explanation: "Data is sent to and from these addresses, like mail to a street address."}, {rank: 2, prompt: "What's the difference between a local network (LAN) and the internet?", choices: ["A LAN is wireless only, and the internet only uses cables","A LAN uses satellites, which makes it faster than the internet","They're the same network, just seen from two places","A LAN links devices in one place, and the internet links networks worldwide"], answer: 3, explanation: "Your home network is a LAN, connected through your router to the rest of the internet."}, {rank: 3, prompt: "Your laptop sits next to the router, but video calls on Wi-Fi are still choppy. What will give the steadiest connection?", choices: ["Restart the router every hour during calls","Turn on a VPN before each call","Plug the laptop into the router with a network cable","Move the laptop further from the router"], answer: 2, explanation: "A cable avoids the interference and dropouts that Wi-Fi is prone to."}]},
  {id: "3a6fcb73-4128-41fe-bfa7-a7ccaf18a41e", name: "Domain Names", order: 25, questions: [{rank: 1, prompt: "In www.example.com, what is \".com\" called?", choices: ["The protocol","The path","The subdomain","The top-level domain"], answer: 3, explanation: "Others include .org, .net and country endings such as .jp."}, {rank: 2, prompt: "Why is \"paypal.com.secure-login.net\" not a PayPal website?", choices: ["PayPal only ever uses web addresses that end in .org","The real domain is secure-login.net, just before the end","Sites with a hyphen anywhere in the address are fake","Addresses longer than 20 characters are always fake"], answer: 1, explanation: "Anything to the left is a subdomain the owner of secure-login.net can name however they like."}, {rank: 3, prompt: "You type a familiar shop's address, and a login page loads with \"amaz0n.com\" in the address bar. What should you do?", choices: ["Log in, since the page looks just like the real one","Refresh the page until the real one loads","Close it and type the address carefully, or use a bookmark","Clear your cookies and then log in"], answer: 2, explanation: "A zero in place of an o is a look-alike address made to catch typos."}]},
  {id: "db07b763-1263-4b29-9c77-0396f7f4414a", name: "Web Browsers", order: 26, questions: [{rank: 1, prompt: "What is a browser extension?", choices: ["A longer version of a site's web address","An add-on that gives the browser extra features","The list of pages the browser has saved","A second window of the same browser open"], answer: 1, explanation: "Ad blockers and password managers often come as extensions."}, {rank: 2, prompt: "Why can a browser extension be a privacy risk?", choices: ["They make every page load more slowly","They change your device's IP address","They can only be removed by reinstalling","Many can read everything on the pages you visit"], answer: 3, explanation: "An extension with that access sees your email, banking and anything else you open."}, {rank: 3, prompt: "A website looks broken in your browser but works fine for a friend. What should you try first?", choices: ["Restart your router and modem","Turn off your computer's firewall","Change your Wi-Fi network's password","Update your browser, or try another one"], answer: 3, explanation: "If the connection works, the difference is usually the browser or its version."}]},
  {id: "ce700f2b-01bb-4195-910d-e0c4ff21b656", name: "Search Engines", order: 27, questions: [{rank: 1, prompt: "On a search results page, what does \"Sponsored\" next to a result mean?", choices: ["It's the most accurate result","The search engine checked it is true","It's the result shared most often","An advertiser paid to have it shown"], answer: 3, explanation: "Ads are placed above or among the results, so they're labeled."}, {rank: 2, prompt: "Why can two people searching for the same words see different results?", choices: ["Search engines choose the results at random each time","Newer computers are shown better and fuller results","Results are tailored to things like location and past searches","Only paying users are shown the full set of results"], answer: 2, explanation: "A search for \"pizza\" in two cities rightly gives two different lists."}, {rank: 3, prompt: "You want pages containing the exact phrase \"heat pump noise\". How should you search?", choices: ["Put the phrase in quotation marks","Type the phrase in capital letters","Add a question mark at the end","Put a hyphen between each word"], answer: 0, explanation: "Quotation marks match the words together and in that order, and a hyphen before a word usually excludes it."}]},
  {id: "4484033d-ed53-47be-8dc4-af91dc51f6b5", name: "Email", order: 28, questions: [{rank: 1, prompt: "What does \"Reply all\" do?", choices: ["Replies to all of your unread emails","Sends your reply to all of your contacts","Sends your reply to everyone the email went to","Replies to the sender with a copy to you"], answer: 2, explanation: "Worth a second thought before sending to a large list."}, {rank: 2, prompt: "Why can an email look like it's from your bank even though your bank didn't send it?", choices: ["The sender name and address shown can be faked","Banks share email accounts with other companies","Emails pass through the bank's servers on the way","Spam filters change the names of senders"], answer: 0, explanation: "The \"From\" line is easy to forge, which is why links in such emails need care."}, {rank: 3, prompt: "You need to email 40 parents who don't know each other about a school trip. How should you address it?", choices: ["Put their addresses in BCC","Put all of them in the To field","Put all of them in the CC field","Send it to one parent to forward"], answer: 0, explanation: "BCC hides everyone's address from the rest, so no one's email is shared with strangers."}]},
  {id: "bd2c33f6-e114-4f37-bb53-c784b0b85ca2", name: "Wi-Fi", order: 29, questions: [{rank: 1, prompt: "What is a Wi-Fi network's SSID?", choices: ["Its password","Its speed","Its name","Its owner's address"], answer: 2, explanation: "It's the name you pick from the list when you join."}, {rank: 2, prompt: "Why is Wi-Fi usually weaker far from the router or behind thick walls?", choices: ["Radio waves weaken with distance and are absorbed by walls","Routers cut their range on purpose to save power","Walls make the network change its password","Faraway devices switch to a different network"], answer: 0, explanation: "Thick walls, floors and metal block the signal most."}, {rank: 3, prompt: "Your bedroom, two floors from the router, gets weak Wi-Fi. What helps most?", choices: ["Give the Wi-Fi network a brand new name","Move the router centrally, or add a mesh point","Restart your phone once at the start of each day","Choose a longer password for the network"], answer: 1, explanation: "Getting the signal closer to the room is the only thing that strengthens it there."}]},
  {id: "565cfa99-b456-4135-87c4-c6b7acbc1d65", name: "Home Networking", order: 30, questions: [{rank: 1, prompt: "What does a modem do?", choices: ["Connects your home to your internet provider's line","Shares the connection with your devices over Wi-Fi","Stores files for every device in the house","Blocks viruses before they reach your devices"], answer: 0, explanation: "The router then shares that connection, and many boxes do both jobs."}, {rank: 2, prompt: "Why should you change a new router's default admin password?", choices: ["Default passwords are published and easy to look up","Changing it makes the Wi-Fi run faster","The router stops working after a month otherwise","Default passwords expire after the first week"], answer: 0, explanation: "Anyone on your network could otherwise log in and change its settings."}, {rank: 3, prompt: "A visitor needs Wi-Fi at your home, but you don't want them reaching your computers and smart devices. What should you do?", choices: ["Put them on a guest network","Give them your main Wi-Fi password","Turn off your computers while they're there","Let them use your laptop instead"], answer: 0, explanation: "A guest network reaches the internet but is kept apart from your own devices."}]},
  {id: "310e2480-b8e9-4d9a-b27e-d1b76e22dd68", name: "Cloud Storage", order: 31, questions: [{rank: 1, prompt: "What is cloud storage?", choices: ["Keeping files on a company's servers, online","Keeping files on a USB drive you carry","A folder kept only on your computer's desktop","Saving files to a phone's memory card"], answer: 0, explanation: "You can reach the files from any device you sign in on."}, {rank: 2, prompt: "Why isn't a folder synced to the cloud a full backup on its own?", choices: ["Deleting or damaging a file on one device copies to the rest","Cloud copies are compressed and lose their quality","Files in the cloud vanish after a year","Syncing only works for photos and videos"], answer: 0, explanation: "Syncing copies mistakes as faithfully as it copies files."}, {rank: 3, prompt: "You want to share a large video with one relative, not the public. What's the best way with cloud storage?", choices: ["Share it with their account only","Make the folder public and send the link","Email them your cloud password","Post the link on social media"], answer: 0, explanation: "Sharing with one account keeps the video out of reach of anyone else who finds the link."}]}
] AS x
MATCH (t:Topic {id: x.id}), (c:Collection {id: "digital-knowledge"})
MERGE (c)-[contains:CONTAINS]->(t)
SET contains.order = x.order
WITH t, x
UNWIND x.questions AS q
MATCH (t)-[:HAS_LEVEL]->(l:BloomLevel {rank: q.rank})
MERGE (question:QuizQuestion)-[:TESTS]->(l)
ON CREATE SET question.id = randomUUID(), question.prompt = q.prompt, question.choices = q.choices,
              question.answer = q.answer, question.explanation = q.explanation, question.createdAt = datetime();

UNWIND [
  {id: "79881298-b493-499d-acef-d9c3b448f51b", name: "Smartphones", order: 32, questions: [{rank: 1, prompt: "What does a phone's SIM card do?", choices: ["Stores the apps you install on the phone","Powers the phone's screen and camera","Holds the photos taken with the camera","Links the phone to your mobile account and number"], answer: 3, explanation: "Moving the SIM to another phone moves your number with it."}, {rank: 2, prompt: "Why does a phone's battery drain faster where the signal is weak?", choices: ["Weak signal lowers the battery's capacity","The phone works harder to reach the cell tower","The screen brightens to make up for it","Apps update more often to catch up"], answer: 1, explanation: "It boosts its radio power and keeps searching for a better signal."}, {rank: 3, prompt: "Your phone has just been stolen. What should you do first?", choices: ["Buy a new phone and restore your backup later","Change your home Wi-Fi password","Lock or erase it remotely, and call your carrier","Wait a few days to see whether it turns up"], answer: 2, explanation: "Locking it protects your accounts, and the carrier can block the SIM."}]},
  {id: "4290424f-d0ae-4d80-b66d-965f18e0cbc7", name: "Operating Systems", order: 33, questions: [{rank: 1, prompt: "Which of these is an operating system?", choices: ["Google Chrome","Android","Microsoft Word","Wi-Fi"], answer: 1, explanation: "Android, iOS, Windows, macOS and Linux are operating systems."}, {rank: 2, prompt: "What does an operating system do that an ordinary app doesn't?", choices: ["Edits documents and spreadsheets","Manages the hardware and lets apps share it","Connects you to websites","Stores your passwords"], answer: 1, explanation: "Apps ask the operating system for the screen, memory, storage and network."}, {rank: 3, prompt: "An app says it needs a newer version of your phone's operating system. What should you do?", choices: ["Update the operating system, if your phone supports it","Reinstall the app until it works","Install an older copy from a random website","Free up storage space on the phone"], answer: 0, explanation: "Apps from unknown sites are a common way malware gets in."}]},
  {id: "d08bf32b-7e31-45ce-84a5-b9c903ea4fe1", name: "File Management", order: 34, questions: [{rank: 1, prompt: "What is a folder, or directory?", choices: ["A kind of file that only holds photos","A program for opening files","A container that groups files and other folders","A backup copy of a file"], answer: 2, explanation: "Folders inside folders make a tree you can browse."}, {rank: 2, prompt: "Why do many people name files with dates like 2026-03-14 rather than 14 March 2026?", choices: ["Computers can't read the names of months","Shorter names take up less storage","Email attachments need names like that","Year-month-day names sort into date order"], answer: 3, explanation: "Sorting by name then puts files in the order they were made."}, {rank: 3, prompt: "You can't find a report you saved last week. What's the quickest way to find it?", choices: ["Restart the computer and then look again","Open every folder on the computer one at a time","Reinstall the program that made the report","Search for a word in its name, or check recent files"], answer: 3, explanation: "Searching and recent files look everywhere at once."}]},
  {id: "f52d051d-e6a4-42e2-8d18-a1f73386b3e7", name: "File Types", order: 35, questions: [{rank: 1, prompt: "Which file format is usually used for a document meant to look the same on any device?", choices: ["PDF","JPG","MP3","ZIP"], answer: 0, explanation: "PDFs keep their layout and fonts wherever they're opened."}, {rank: 2, prompt: "Why doesn't renaming photo.jpg to photo.pdf turn it into a PDF?", choices: ["PDF files can't contain images at all","The name changes, but the data inside is still an image","Renaming a file deletes what's inside it","Only email programs can change file names"], answer: 1, explanation: "The ending is only a label, and converting means rewriting the data."}, {rank: 3, prompt: "A coworker without your word processor needs to read your report without changing it. What should you send?", choices: ["The original word processor file","A PDF of the report","A ZIP of your documents folder","A screenshot of the first page"], answer: 1, explanation: "Anyone can open a PDF, and it shows every page as you laid it out."}]},
  {id: "75012236-8d09-4b7f-b2f5-42face9de55b", name: "Data Compression", order: 36, questions: [{rank: 1, prompt: "What does a ZIP file do?", choices: ["Locks files with a password every time","Packs files together, usually making them smaller","Turns any file into a PDF","Speeds up the computer that opens it"], answer: 1, explanation: "One ZIP file is also easier to send than many separate files."}, {rank: 2, prompt: "What's the difference between lossless and lossy compression?", choices: ["Lossless keeps every detail, and lossy drops some to save more space","Lossless only works on photos, and lossy only on music","Lossy can be fully undone, and lossless can't","They're the same, but one runs faster than the other"], answer: 0, explanation: "A ZIP is lossless, while a JPEG photo or MP3 song is lossy."}, {rank: 3, prompt: "A website wants a profile photo under 1 MB, and yours is 6 MB. What should you do?", choices: ["Rename the file so it ends in .zip","Put the photo inside a ZIP file","Save it smaller, or at lower quality, as a JPEG","Convert the photo into a PNG"], answer: 2, explanation: "A photo is already compressed, so zipping it barely helps, and a PNG is usually bigger."}]},
  {id: "ba9efe98-35ab-45f9-a313-0f5175bbf542", name: "Data Backup", order: 37, questions: [{rank: 1, prompt: "What is the 3-2-1 backup rule?", choices: ["Back up three times a day, two days a week, one month a year","Three copies, on two kinds of storage, one kept elsewhere","Three passwords, two devices and one email for every account","Three drives in the computer and two spares in a drawer"], answer: 1, explanation: "It guards against a failed drive and against losing a whole place."}, {rank: 2, prompt: "Why keep one backup in a different place from your computer?", choices: ["Backups kept elsewhere copy faster","A fire, flood or theft won't take both","The law requires a copy to be kept elsewhere","It stops viruses reaching the computer"], answer: 1, explanation: "Copies in the same room are lost together."}, {rank: 3, prompt: "You've never tried restoring anything from your backup. What should you do?", choices: ["Make a second backup just like the first","Trust it, since it says it completed","Restore a few files to check it works","Delete old backups to free up space"], answer: 2, explanation: "A backup that can't be restored only shows up when it's too late."}]},
  {id: "7475a1f7-81f6-40d9-8fc0-0ae7599cf6d8", name: "Data Storage", order: 38, questions: [{rank: 1, prompt: "Which is bigger, a gigabyte or a terabyte?", choices: ["A gigabyte, about 1,000 terabytes","They are the same size","A terabyte, about 10 gigabytes","A terabyte, about 1,000 gigabytes"], answer: 3, explanation: "Kilo, mega, giga and tera each go up by about a thousand."}, {rank: 2, prompt: "Why are solid-state drives (SSDs) faster than spinning hard drives?", choices: ["They hold less data, so there's less to search","They're always connected to the internet","They use stronger magnets to read the data","They have no moving parts, so data is reached electronically"], answer: 3, explanation: "A hard drive has to spin a disk and move an arm to each piece of data."}, {rank: 3, prompt: "Your phone is full. Which step will free up the most space?", choices: ["Move your videos to cloud storage or a computer","Delete all of your old text messages","Remove the contacts you never use","Turn off notifications for every app"], answer: 0, explanation: "Videos take far more space than messages or contacts."}]},
  {id: "8b1d1fa9-380b-47e1-b69d-cda1a92b4e47", name: "Spreadsheets", order: 39, questions: [{rank: 1, prompt: "In a spreadsheet, what is B3?", choices: ["The cell in row B, column 3","The third sheet in the file","The cell in column B, row 3","A formula that adds up column B"], answer: 2, explanation: "Columns are letters and rows are numbers."}, {rank: 2, prompt: "Why does copying =A1*2 from row 1 down to row 2 give =A2*2?", choices: ["The spreadsheet thinks the first one was a mistake","Formulas always point to the row below them","Copying a formula recalculates the whole sheet","Cell references are relative, so they shift with the formula"], answer: 3, explanation: "A $ sign, as in =$A$1*2, stops a reference from shifting."}, {rank: 3, prompt: "Cells A1 to A5 hold monthly costs. Which formula gives their total?", choices: ["=A1+A5","=SUM(A1,A5)","=SUM(A1:A5)","=TOTAL(A1-A5)"], answer: 2, explanation: "A colon means the whole range, while a comma adds only the cells it lists."}]},
  {id: "674060e0-8992-4e50-b11b-c605bd8fb8d4", name: "Social Media", order: 40, questions: [{rank: 1, prompt: "What does it mean when a post \"goes viral\"?", choices: ["The account that posted it gets a virus","It spreads quickly to huge numbers of people","The site removes it for breaking rules","Its author pays to have it promoted"], answer: 1, explanation: "Shares of shares can reach millions in hours."}, {rank: 2, prompt: "Why do most social media platforms cost nothing to use?", choices: ["Governments pay for them as a public service","Users pay for them through their phone bills","They make money from ads aimed using your data","They're run by charities on donations"], answer: 2, explanation: "Your attention and data are what they sell to advertisers."}, {rank: 3, prompt: "A friend shares a shocking post that's going viral. What should you do before sharing it?", choices: ["Share it if it has lots of likes","Share it with a note saying it might be fake","Check that the account has a profile photo","Check whether a reliable source reports it too"], answer: 3, explanation: "Shocking posts spread fastest, true or not, and likes say nothing about accuracy."}]},
  {id: "71375b23-6bf4-434a-8afd-a6ad2784567c", name: "Recommendation Algorithms", order: 41, questions: [{rank: 1, prompt: "What does a recommendation algorithm do?", choices: ["Shows every post in the order it was posted","Removes harmful posts before anyone sees them","Suggests friends' phone numbers to call","Picks what to show you from what people engaged with"], answer: 3, explanation: "Your watches, likes, pauses and skips all feed it."}, {rank: 2, prompt: "Why can a feed show more and more extreme content over time?", choices: ["Engineers program feeds to make people more extreme","Strong reactions mean more engagement, so it's shown more","Older posts become more extreme as they age","Phones change their own settings over time"], answer: 1, explanation: "Tuning a feed for engagement favors whatever grips people most."}, {rank: 3, prompt: "Your video feed has filled with content you don't want. What will change it fastest?", choices: ["Mark it \"not interested\" and stop watching it","Watch it to the end so the app learns","Like it so the app moves on to other things","Close and reopen the app"], answer: 0, explanation: "Watching or liking tells the app you want more of it."}]},
  {id: "dddd5d9f-350c-445e-b097-2deb069b05c3", name: "Online Advertising", order: 42, questions: [{rank: 1, prompt: "What is a targeted ad?", choices: ["An ad shown to everyone in the same way","An ad that attacks a rival product","An ad sent to your home by mail","An ad chosen for you using data about you"], answer: 3, explanation: "Your age, location, searches and browsing can all be used."}, {rank: 2, prompt: "Why do influencers label some posts \"#ad\" or \"sponsored\"?", choices: ["Labeled posts are shown higher up in people's feeds","The label means the product has been tested by them","Every post needs a label before it can be shared","They were paid or given something, and must often say so"], answer: 3, explanation: "Viewers then know the post is advertising, not an independent opinion."}, {rank: 3, prompt: "The top search result looks like the official site for renewing your passport, but it's marked \"Ad\" and charges a fee. What should you do?", choices: ["Find the official government site instead","Use the ad, since it came up first","Pay the fee, since it's small","Click it and look for a phone number"], answer: 0, explanation: "Paid look-alike sites often charge for what the official site does for less."}]},
  {id: "497d22f6-fbb2-4523-aed6-3bd78585422c", name: "Deepfakes", order: 43, questions: [{rank: 1, prompt: "What is a deepfake?", choices: ["Fake video or audio made with AI to seem real","A camera hidden inside an everyday object","A filter that smooths skin in your photos","A fake account set up on social media"], answer: 0, explanation: "Faces can be swapped and voices cloned."}, {rank: 2, prompt: "Why are voice deepfakes useful to scammers?", choices: ["A few seconds of a voice is enough to clone it","They make phone calls free for the caller","Calls made with them can't be recorded","They hide the caller's phone number"], answer: 0, explanation: "A clip from a social media video can be enough."}, {rank: 3, prompt: "You get a call in a relative's voice saying they're in trouble and need money sent now. What should you do?", choices: ["Send the money quickly, since it's urgent","Ask them to text the details instead","Send half now and half once they explain","Hang up and call them back on a number you know"], answer: 3, explanation: "Calling back on a number you know reaches the real person."}]},
  {id: "32d69382-ac7e-4327-a1ca-219ee8410033", name: "Screen Time", order: 44, questions: [{rank: 1, prompt: "What is the 20-20-20 rule for eye strain?", choices: ["Every 20 minutes, look 20 feet away for 20 seconds","Keep the screen 20 inches away and 20% dimmer","Use screens for no more than 20 hours a week","Blink 20 times every 20 minutes for 20 days"], answer: 0, explanation: "Looking far away lets the eye muscles relax."}, {rank: 2, prompt: "Why are endless feeds and autoplay so hard to stop using?", choices: ["They use less battery than other apps","They take away natural stopping points","Their posts are shorter than other content","They keep working without an internet connection"], answer: 1, explanation: "A page with an end prompts a choice, and an endless one never does."}, {rank: 3, prompt: "You want to stop checking your phone so often while you work. What's most likely to help?", choices: ["Switch the phone's display to dark mode","Lower the brightness of the phone's screen","Charge the phone less often during the day","Silence notifications and keep the phone out of sight"], answer: 3, explanation: "Fewer prompts and less temptation mean fewer checks."}]},
  {id: "325f3f5b-4c86-4b51-aedf-687f6b9d524b", name: "Artificial Intelligence", order: 45, questions: [{rank: 1, prompt: "What is machine learning?", choices: ["Computers learning patterns from data, not only set rules","Robots that build other machines in factories","Teaching people how to use their computers","Making computers run faster every year"], answer: 0, explanation: "A spam filter learns from examples of spam rather than a fixed list of words."}, {rank: 2, prompt: "Why can an AI system be biased?", choices: ["Engineers program their own opinions into it","It picks favorites at random","It learns from data that may reflect people's biases","Its hardware leans toward certain answers"], answer: 2, explanation: "Patterns of past unfairness in the data become patterns in its decisions."}, {rank: 3, prompt: "An AI tool at work scores job applications. What's the most responsible way to use it?", choices: ["Have people review its decisions for unfair patterns","Trust its scores, since computers are neutral","Use it only for applicants from inside the company","Keep its use secret from the applicants"], answer: 0, explanation: "A tool can repeat unfairness at scale unless people check what it does."}]},
  {id: "b7756786-d544-4aa3-9c3c-f464ddc76fa5", name: "Generative AI", order: 46, questions: [{rank: 1, prompt: "What does generative AI do?", choices: ["Creates new text, images or sound from what it learned","Searches existing web pages and lists them","Sorts files into folders by what type they are","Repairs software after it has crashed"], answer: 0, explanation: "Chatbots and image generators are examples."}, {rank: 2, prompt: "How can an AI image tool draw a scene that never existed?", choices: ["It searches the web for a matching photo","A person quickly draws it while you wait","It edits a photo you took at some point","It learned patterns from many images and combines them"], answer: 3, explanation: "It has learned what things look like, not stored pictures of them."}, {rank: 3, prompt: "You used an AI tool to help write a report for work. What should you do before handing it in?", choices: ["Check its facts and follow your workplace's AI rules","Hand it in just as the tool wrote it","Remove any mention of the tool from it","Run it through the tool a second time"], answer: 0, explanation: "You're responsible for what you hand in, and the tool can be wrong."}]},
  {id: "eb8fb5f0-7f39-4262-8a1d-2b30a440c35e", name: "Large Language Models", order: 47, questions: [{rank: 1, prompt: "What does a large language model mainly do?", choices: ["Looks up answers in a database of facts","Translates between two fixed languages","Predicts likely next words from patterns in text","Records everything said to it for later"], answer: 2, explanation: "Writing word by word this way produces fluent answers to almost anything."}, {rank: 2, prompt: "Why can a chatbot state something false with confidence?", choices: ["It's built to give a wrong answer now and then","It repeats whatever the last user told it","It produces plausible-sounding text, not checked facts","It runs out of memory partway through"], answer: 2, explanation: "Sounding right and being right are different things for it."}, {rank: 3, prompt: "A chatbot gives you a quote and its source for an essay. What should you do?", choices: ["Use it, since the chatbot named a source","Ask the chatbot whether it's sure","Change a few of its words and use it","Find the source and check the quote is really there"], answer: 3, explanation: "Only the source itself can confirm the quote."}]}
] AS x
MATCH (t:Topic {id: x.id}), (c:Collection {id: "digital-knowledge"})
MERGE (c)-[contains:CONTAINS]->(t)
SET contains.order = x.order
WITH t, x
UNWIND x.questions AS q
MATCH (t)-[:HAS_LEVEL]->(l:BloomLevel {rank: q.rank})
MERGE (question:QuizQuestion)-[:TESTS]->(l)
ON CREATE SET question.id = randomUUID(), question.prompt = q.prompt, question.choices = q.choices,
              question.answer = q.answer, question.explanation = q.explanation, question.createdAt = datetime();

UNWIND [
  {id: "54afc2f9-d223-47b2-9f69-403a0d7c363a", name: "Prompt Engineering", order: 48, questions: [{rank: 1, prompt: "In AI prompting, what is giving examples of the answer you want called?", choices: ["Fine-tuning","Jailbreaking","Few-shot prompting","Hallucinating"], answer: 2, explanation: "A few examples show the model the format and style to follow."}, {rank: 2, prompt: "Why does a prompt with context, such as who it's for and how long, usually get a better answer?", choices: ["Longer prompts are sent to a smarter model","Context unlocks features that are hidden","The model can't know what you want unless you say it","Prompts with context get answered faster"], answer: 2, explanation: "It fills gaps with guesses, and context replaces the guesses."}, {rank: 3, prompt: "You want an AI to draft an email declining a meeting. Which prompt will work best?", choices: ["\"Write me an email about a meeting, and please make sure it's a really good one\"","\"Pretend you're the best email writer in the world and write the perfect email\"","\"Write a short, polite email to a client declining Tuesday's meeting and offering Thursday\"","\"Write a polite email for me, using whatever details a meeting email needs\""], answer: 2, explanation: "It says who it's for, what to say, and how it should sound."}]},
  {id: "3d27cd27-a74c-4275-a4b4-43bfc1fd13c0", name: "Online Banking", order: 49, questions: [{rank: 1, prompt: "What is an automatic payment, or direct debit?", choices: ["Letting a company take payments from your account on a schedule","A transfer you make by hand each time you pay","Cash you pay in over the counter at a bank branch","A short-term loan your bank pays into your account"], answer: 0, explanation: "Bills such as phone and utilities are often paid this way."}, {rank: 2, prompt: "Why do banks say they'll never ask for your full password or PIN?", choices: ["Banks don't keep any record of PINs","Typing a PIN into a website is illegal","PINs change every day, so asking is pointless","So any message that asks for it can be recognized as a scam"], answer: 3, explanation: "A clear rule makes any request that breaks it stand out."}, {rank: 3, prompt: "You see a payment on your account that you don't recognize. What should you do?", choices: ["Wait to see whether it's on next month's statement","Reply to the shop named on the payment","Report it to your bank right away through its app or number","Close your account through a link in an email"], answer: 2, explanation: "Reporting quickly makes it more likely the money comes back."}]},
  {id: "6d0b60e3-c5dd-4473-a95f-0ca7fe33d112", name: "Digital Payments", order: 50, questions: [{rank: 1, prompt: "What is contactless payment?", choices: ["Paying by a transfer from your bank account","Paying without being given a receipt","Paying by holding a card or phone near the reader","Paying in cash at the counter"], answer: 2, explanation: "A chip in the card or phone talks to the reader at close range."}, {rank: 2, prompt: "Why is paying with a phone wallet often safer than giving out your card number?", choices: ["Phones are harder to steal or lose than cards","Shops can't see the amount you're paying","It sends a one-time token, not your real card number","Phone payments never cost the shop a fee"], answer: 2, explanation: "A stolen token is useless for other purchases."}, {rank: 3, prompt: "You're paying a stranger online for a used bike you'll collect next week. Which payment protects you best?", choices: ["A \"friends and family\" payment-app transfer","A bank transfer to their account","Gift cards bought at a store","A credit card or a payment with buyer protection"], answer: 3, explanation: "With buyer protection, you can get your money back if the bike never appears."}]},
  {id: "baf9db7a-d6c9-4e74-b927-8243f3c843da", name: "Online Shopping", order: 51, questions: [{rank: 1, prompt: "What is a chargeback?", choices: ["Your card issuer reversing a payment you dispute","A reward from a shop's loyalty program","A fee charged for delivery","A refund when a price drops after you buy"], answer: 0, explanation: "It's your route back when a seller won't refund."}, {rank: 2, prompt: "Why is paying online by credit card generally safer than by debit card?", choices: ["Credit cards are encrypted online and debit cards aren't","Debit cards can't be used to get a refund","Credit cards hide your name from the shop","A disputed credit charge isn't your own money while it's sorted"], answer: 3, explanation: "Debit fraud takes cash straight from your account until it's resolved."}, {rank: 3, prompt: "Before buying from an online shop for the first time, what's the best check?", choices: ["Check that it sells a large range of products","Look for independent reviews and its return policy","Check that its website design looks professional","Check whether it's having a sale right now"], answer: 1, explanation: "Fake shops can look polished, and other buyers' experiences are harder to fake."}]},
  {id: "69b7d7c0-f03a-47d3-828a-c5f08d5f9bd9", name: "Cryptocurrency", order: 52, questions: [{rank: 1, prompt: "What is a crypto wallet's recovery phrase?", choices: ["The username for the wallet's account online","The price you paid for the coins in the wallet","A code the exchange sends you when you log in","A list of words that can restore the wallet and its funds"], answer: 3, explanation: "Anyone who has it controls the funds."}, {rank: 2, prompt: "Why is a crypto payment usually impossible to undo?", choices: ["Refunding crypto is against the law everywhere","Crypto is sent in sealed digital envelopes","Payments are too small to be worth reversing","No bank in the middle can reverse it once confirmed"], answer: 3, explanation: "That's why scammers ask for it."}, {rank: 3, prompt: "An online offer promises guaranteed returns of 2% a day if you invest in crypto. What should you do?", choices: ["Invest a little to test it first","Walk away from it","Invest if friends say it worked for them","Ask them for a signed contract first"], answer: 1, explanation: "No real investment guarantees returns that high, and early payouts are often bait."}]},
  {id: "e297163e-9f59-4062-84e7-9d62ab605a22", name: "Blockchain", order: 53, questions: [{rank: 1, prompt: "What is a blockchain?", choices: ["A row of servers kept together in one building","A kind of very long password made of blocks","A shared record of transactions that many computers keep","A cloud service for backing up your files"], answer: 2, explanation: "Cryptocurrencies keep their records this way."}, {rank: 2, prompt: "Why is it so hard to change an old record on a public blockchain?", choices: ["Each block depends on the last, and every copy would change","Changing any record on one is against the law everywhere","The records are printed and kept on paper as well","Only banks have been given the power to change them"], answer: 0, explanation: "Changing one block breaks every block after it, on thousands of computers."}, {rank: 3, prompt: "A company wants a database that only it controls and can edit quickly. Does a blockchain suit it?", choices: ["Yes, blockchains are the fastest databases","No, an ordinary database fits better","Yes, because every blockchain is private","Yes, all business data belongs on one"], answer: 1, explanation: "A blockchain's strength is trust between many parties, which one owner doesn't need."}]},
  {id: "13eb20fe-5ee8-4817-9692-523cc2068082", name: "Terms of Service", order: 54, questions: [{rank: 1, prompt: "What are a service's terms of service?", choices: ["Its list of prices","The rules you agree to by using it","Its technical manual","Its customer reviews"], answer: 1, explanation: "They cover things like what you may post and what they may do with it."}, {rank: 2, prompt: "Why can clicking \"I agree\" matter even if you never read the terms?", choices: ["It downloads the terms to your device","It's only for show and changes nothing","It deletes your data from the service","It's usually treated as accepting them"], answer: 3, explanation: "Not reading them doesn't usually get you out of them."}, {rank: 3, prompt: "A free app's terms say it can use the photos you upload in its own ads. You don't want that. What should you do?", choices: ["Don't upload photos you wouldn't want used, or use another app","Upload them, since terms like that can't be enforced","Write \"I don't agree\" in your profile","Rename the files before you upload them"], answer: 0, explanation: "What you upload is covered by the terms you accepted."}]},
  {id: "42fa19cf-bea9-4d6d-8c2c-1972bf942e72", name: "Copyright", order: 55, questions: [{rank: 1, prompt: "Who owns the copyright to a photo you took?", choices: ["The company that made the camera","Whoever posts it online first","No one, since it's only a photo","You, the person who took it"], answer: 3, explanation: "Copyright belongs to the creator from the moment it's made."}, {rank: 2, prompt: "Why can't you freely use an image just because you found it online?", choices: ["Being online doesn't remove its creator's copyright","Online images are too low in quality to reuse","Search engines own the images that they show","Images found online may only be used on phones"], answer: 0, explanation: "Being easy to copy isn't permission to use it."}, {rank: 3, prompt: "You need a picture for your small business's website. What's the safe choice?", choices: ["Use any picture from an image search","Use one you hold a license for, such as stock or your own","Use one and credit the site you found it on","Use one but crop it so it looks different"], answer: 1, explanation: "Credit or cropping doesn't give you the right to use someone's work."}]},
  {id: "7161ad5e-d91b-48fe-9e15-0d8c57e2f47d", name: "Creative Commons", order: 56, questions: [{rank: 1, prompt: "What does a CC BY license require when you reuse a work?", choices: ["That you pay the creator a fee","That you ask permission each time","That you use it only in private","That you credit the creator"], answer: 3, explanation: "BY stands for attribution."}, {rank: 2, prompt: "Why do creators put Creative Commons licenses on their work?", choices: ["To give up all their rights to it","To let others reuse it under conditions they choose","To stop anyone ever copying it","To be paid automatically for each use"], answer: 1, explanation: "It's a ready-made way to say yes in advance, with conditions."}, {rank: 3, prompt: "A photo is licensed CC BY-NC. Can you use it in an ad for your shop?", choices: ["Yes, as long as you credit the creator","No, NC rules out commercial use","Yes, as long as you resize it","Yes, since Creative Commons means free"], answer: 1, explanation: "NC stands for noncommercial, and an ad is commercial."}]},
  {id: "d2bb63ce-f925-4f22-b40b-20311a12f4fa", name: "Open-Source Software", order: 57, questions: [{rank: 1, prompt: "What makes software open source?", choices: ["It's free to download and use, with no charge","No company is involved in making or selling it","It runs on every kind of device and system","Its source code is published to read, change and share"], answer: 3, explanation: "Much open-source software is free, but being free doesn't make software open source."}, {rank: 2, prompt: "Why can open-source software be checked for hidden flaws or tracking?", choices: ["The government tests it","It never receives updates","It can't connect to the internet","Anyone can read its code"], answer: 3, explanation: "Many eyes on the code make hidden behavior harder to keep hidden."}, {rank: 3, prompt: "A small nonprofit wants a free office suite with no ads or subscription. What fits?", choices: ["A cracked copy of a paid office suite","Free trials, renewed with new email addresses","An open-source office suite such as LibreOffice","Any app with \"free\" in its name"], answer: 2, explanation: "Open-source suites are free to use and share, legally."}]},
  {id: "64665906-fe4a-4e0b-b771-9019f4f0c4a0", name: "Online Etiquette", order: 58, questions: [{rank: 1, prompt: "What does typing in ALL CAPS usually come across as online?", choices: ["Politeness","Shouting","A joke","Formality"], answer: 1, explanation: "Capitals read as raised voices."}, {rank: 2, prompt: "Why are messages more easily misread online than in person?", choices: ["Messages are shortened when they're sent","Spell-check changes what people meant","Text loses tone of voice and facial expressions","Screens make text harder to read"], answer: 2, explanation: "Without tone, a joke can read as an insult."}, {rank: 3, prompt: "A coworker's message in a group chat makes you angry. What's best?", choices: ["Reply in the group straight away","Wait, then reply calmly, or talk to them privately","Screenshot it and share it with others","Leave the group without saying anything"], answer: 1, explanation: "A cooler, private reply is less likely to make things worse."}]},
  {id: "e2cf7a69-966d-430f-9c64-df5f038c3104", name: "Video Conferencing", order: 59, questions: [{rank: 1, prompt: "In a video call, what does muting do?", choices: ["Turns off your camera","Ends the call for you","Stops others hearing your microphone","Lowers everyone else's volume"], answer: 2, explanation: "Your camera stays on unless you turn it off."}, {rank: 2, prompt: "Why do others sometimes hear an echo of their own voice from you?", choices: ["The call has gone on for too long without a break","Your microphone picks up their voice from your speakers","Their camera is switched off during the call","Your internet connection is too fast for the call"], answer: 1, explanation: "Headphones stop your microphone hearing the speakers."}, {rank: 3, prompt: "You're joining an important video call from a noisy shared home. What should you do?", choices: ["Turn your speaker volume all the way up","Use headphones with a mic, and mute when not speaking","Keep your camera off and your mic on","Sit farther away from your laptop"], answer: 1, explanation: "Close sound and muting keep the noise off the call."}]},
  {id: "130b4a8b-e7ee-4fe5-8422-671d3f9f198d", name: "Cyberbullying", order: 60, questions: [{rank: 1, prompt: "What is cyberbullying?", choices: ["Repeatedly harassing someone through digital technology","A single disagreement in an online comment thread","Hacking into a company's computer systems","Unwanted advertising emails sent in bulk"], answer: 0, explanation: "It includes threats, cruel posts, and sharing private images."}, {rank: 2, prompt: "Why can cyberbullying feel harder to escape than bullying in person?", choices: ["It's always done anonymously, so no one knows who","It can reach people anywhere, at any time, in front of many","It's never against the law in any country","It only happens during school hours on school devices"], answer: 1, explanation: "It follows people home, onto their phones."}, {rank: 3, prompt: "Your child is being harassed in a group chat. What's a good first step?", choices: ["Delete all the messages right away","Reply to the bullies to stand up to them","Save evidence, then block and report the accounts","Take the phone away for good"], answer: 2, explanation: "Evidence helps the platform, the school or the police act."}]},
  {id: "5643cbb6-1e30-4210-a9ef-99e8850fe3d5", name: "Digital Accessibility", order: 61, questions: [{rank: 1, prompt: "What is alt text on an image?", choices: ["A written description that screen readers read aloud","A funny caption added under the image","The file name the image was saved with","A copyright notice hidden in the image"], answer: 0, explanation: "It tells people who can't see the image what it shows."}, {rank: 2, prompt: "Why does good color contrast in text matter?", choices: ["Pages with good contrast load faster for everyone","Search engines rank pages by how much contrast they have","People with low vision or color blindness can read it","It saves ink when the pages are printed out"], answer: 2, explanation: "Pale gray on white can be unreadable for many people."}, {rank: 3, prompt: "You're making a video for your team. What makes it accessible to colleagues who can't hear it?", choices: ["Raise its volume","Add captions","Make it shorter","Use bright colors"], answer: 1, explanation: "Captions carry what's said for anyone who can't hear it."}]}
] AS x
MATCH (t:Topic {id: x.id}), (c:Collection {id: "digital-knowledge"})
MERGE (c)-[contains:CONTAINS]->(t)
SET contains.order = x.order
WITH t, x
UNWIND x.questions AS q
MATCH (t)-[:HAS_LEVEL]->(l:BloomLevel {rank: q.rank})
MERGE (question:QuizQuestion)-[:TESTS]->(l)
ON CREATE SET question.id = randomUUID(), question.prompt = q.prompt, question.choices = q.choices,
              question.answer = q.answer, question.explanation = q.explanation, question.createdAt = datetime();
