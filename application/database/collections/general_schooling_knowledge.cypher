// =============================================================================
// Atlas of Us — General schooling knowledge seed
// Spec: documentation/data_model/topics/topics.md
//
// The General Schooling Knowledge collection, by the id the UI asks for it by, and the
// topics most people know something about that it CONTAINS, each by its id,
// with `order` its place in the walkthrough. Each has three QuizQuestions, one
// TESTS each of its Remember, Understand and Apply levels. `answer` is the
// index of the right one of a question's `choices`. Run migrations 022 and 025
// first.
//
// Idempotent: safe to re-run. The list and its order are set from this file on
// every run. A question is matched on the level it tests, and written once,
// when the level has none.
// =============================================================================

MERGE (c:Collection {id: "general-schooling-knowledge"})
SET c.name = "General Schooling Knowledge",
    c.description = "The topics most people were taught at school, from counting to climate change.";

MATCH (:Collection {id: "general-schooling-knowledge"})-[contains:CONTAINS]->(:Topic)
DELETE contains;

UNWIND [
  {id: "f4e5b48f-a8f3-49e7-9c03-bccfde4ad832", name: "Counting", order: 0, questions: [{rank: 1, prompt: "Which of these lists the counting numbers in order from 12?", choices: ["12, 14, 13, 15","12, 13, 15, 14","12, 21, 22, 23","12, 13, 14, 15"], answer: 3, explanation: "Counting goes up by one each time: 12, 13, 14, 15."}, {rank: 2, prompt: "You count the coins in a jar twice and get 47, then 49. What does that tell you?", choices: ["Both counts are right, since counting depends on the order","The jar must hold 48 coins, the average of the two","At least one count missed or repeated a coin","Coins can't be counted exactly, only estimated"], answer: 2, explanation: "A collection has one size, so two different counts mean at least one of them skipped or double-counted something."}, {rank: 3, prompt: "A cafe offers 3 kinds of bread and 4 fillings, and every sandwich uses one bread and one filling. How many different sandwiches can it make?", choices: ["7","12","4","16"], answer: 1, explanation: "Each of the 3 breads goes with each of the 4 fillings, so there are 3 times 4 combinations."}]},
  {id: "4edd7b57-0e1d-4a08-afac-876612e59515", name: "Place Value", order: 1, questions: [{rank: 1, prompt: "In the number 6,284, which digit is in the tens place?", choices: ["8","2","4","6"], answer: 0, explanation: "Reading from the right, the places are ones (4), tens (8), hundreds (2) and thousands (6)."}, {rank: 2, prompt: "Why does the 3 in 3,512 stand for a much larger amount than the 3 in 1,253?", choices: ["It is written first","It is the largest digit in its number","Digits on the left are always worth 3,000","Its position puts it in the thousands place"], answer: 3, explanation: "A digit's value depends on its place: the first 3 is in the thousands place, the second in the ones place."}, {rank: 3, prompt: "You have 4 hundred-dollar bills, 0 tens and 7 one-dollar coins. How much money is that?", choices: ["$407","$47","$470","$4,007"], answer: 0, explanation: "Four hundreds and seven ones with no tens is written 407, with a zero holding the tens place."}]},
  {id: "a0e60a8b-0b42-459b-a4d0-371f0e65d711", name: "Addition and Subtraction", order: 2, questions: [{rank: 1, prompt: "What is 8 + 7?", choices: ["14","16","15","13"], answer: 2, explanation: "8 plus 7 is 15."}, {rank: 2, prompt: "You worked out that 72 minus 45 is 27. Which calculation checks that answer?", choices: ["72 + 45 = 117","27 - 45 = 72","27 + 45 = 72","72 - 27 = 27"], answer: 2, explanation: "Subtraction undoes addition, so if 72 minus 45 is 27, then 27 plus 45 must give back 72."}, {rank: 3, prompt: "A bus leaves with 38 passengers. At the first stop 15 get off and 9 get on. How many passengers are on the bus now?", choices: ["44","62","14","32"], answer: 3, explanation: "38 minus 15 is 23, and 23 plus 9 is 32."}]},
  {id: "de7b076a-ceae-4ad9-9280-739bc0502791", name: "Multiplication and Division", order: 3, questions: [{rank: 1, prompt: "What is 7 times 8?", choices: ["54","56","64","48"], answer: 1, explanation: "Seven eights are 56."}, {rank: 2, prompt: "Which of these means the same thing as 4 times 6?", choices: ["4 + 6","6 + 6 + 6 + 6","6 + 6 + 6 + 6 + 6 + 6 + 4","4 + 4 + 4 + 4"], answer: 1, explanation: "Multiplying 4 by 6 is adding four groups of 6."}, {rank: 3, prompt: "84 chairs are set out in rows of 7. How many rows are there?", choices: ["11","12","14","77"], answer: 1, explanation: "84 divided by 7 is 12."}]},
  {id: "dec01e5f-bb7d-46e0-88fd-570a56a6cc87", name: "Fractions", order: 4, questions: [{rank: 1, prompt: "In the fraction 2/9, what is the 9 called?", choices: ["The numerator","The quotient","The remainder","The denominator"], answer: 3, explanation: "The bottom number of a fraction, which says how many equal parts the whole is split into, is the denominator."}, {rank: 2, prompt: "Which is larger, 1/3 or 1/5, and why?", choices: ["1/5, because 5 is larger than 3","They're equal, because both have 1 on top","1/3, because a whole split into 3 parts has bigger parts than one split into 5","1/5, because more parts make a larger fraction"], answer: 2, explanation: "With the same top number, a smaller bottom number means the whole is cut into fewer, larger pieces."}, {rank: 3, prompt: "A recipe needs 3/4 of a cup of sugar, and you're making half the recipe. How much sugar do you need?", choices: ["3/2 of a cup","1/4 of a cup","3/8 of a cup","1/2 of a cup"], answer: 2, explanation: "Half of 3/4 is 1/2 times 3/4, which is 3/8."}]},
  {id: "1e37ec52-1180-41e2-b39a-8f4cc0fbb898", name: "Decimals", order: 5, questions: [{rank: 1, prompt: "How is three tenths written as a decimal?", choices: ["0.03","3.0","0.3","0.33"], answer: 2, explanation: "The first place after the decimal point is tenths, so three tenths is 0.3."}, {rank: 2, prompt: "Which is larger, 0.5 or 0.45?", choices: ["0.45, because it has more digits","0.45, because 45 is larger than 5","They're equal","0.5, because 5 tenths is more than 4 tenths and 5 hundredths"], answer: 3, explanation: "0.5 is 0.50, which is more than 0.45 once both are written to hundredths."}, {rank: 3, prompt: "You buy items costing $2.75, $4.60 and $1.80. What is the total?", choices: ["$9.15","$8.15","$9.05","$7.95"], answer: 0, explanation: "Lining up the decimal points, 2.75 plus 4.60 plus 1.80 is 9.15."}]},
  {id: "08619183-334d-459c-85d3-9b2e484b4fb7", name: "Measurement", order: 6, questions: [{rank: 1, prompt: "How many grams are in a kilogram?", choices: ["100","1,000","10","10,000"], answer: 1, explanation: "The prefix kilo means a thousand, so a kilogram is 1,000 grams."}, {rank: 2, prompt: "Why would a doctor measure a baby's weight in grams rather than kilograms?", choices: ["Grams are heavier than kilograms","Kilograms are only for liquids","A smaller unit shows small changes more precisely","Grams measure length as well as weight"], answer: 2, explanation: "A gram is a thousandth of a kilogram, so measuring in grams picks up changes too small to show in whole kilograms."}, {rank: 3, prompt: "A room is 4.5 meters long. How many centimeters is that?", choices: ["450 centimeters","45 centimeters","4,500 centimeters","4.5 centimeters"], answer: 0, explanation: "There are 100 centimeters in a meter, so 4.5 meters is 450 centimeters."}]},
  {id: "4ce881a2-48c5-496c-93d4-8b0c86373ae1", name: "Basic Geometric Shapes", order: 7, questions: [{rank: 1, prompt: "How many sides does a pentagon have?", choices: ["6","5","8","4"], answer: 1, explanation: "A pentagon has five sides."}, {rank: 2, prompt: "Why is every square also a rectangle?", choices: ["It has four equal sides","Its sides are all different lengths","It has three sides","It has four right angles, which is all a rectangle needs"], answer: 3, explanation: "A rectangle is any four-sided shape with four right angles, and a square has those, with equal sides as well."}, {rank: 3, prompt: "A garden bed is a regular hexagon with sides of 2 meters. How much edging goes all the way around it?", choices: ["10 meters","8 meters","12 meters","6 meters"], answer: 2, explanation: "A hexagon has 6 sides, and 6 sides of 2 meters is 12 meters."}]},
  {id: "8ecf6e74-d90f-4d04-aebc-5013ae9fc3ed", name: "Percentages", order: 8, questions: [{rank: 1, prompt: "What fraction is the same as 50%?", choices: ["1/5","1/50","1/4","1/2"], answer: 3, explanation: "Percent means out of a hundred, and 50 out of 100 is one half."}, {rank: 2, prompt: "A price rises by 10% and then falls by 10%. How does the final price compare with where it started?", choices: ["It's the same","It's slightly higher","It's 20% lower","It's slightly lower"], answer: 3, explanation: "The 10% fall is taken from a larger amount than the 10% rise was, so it removes more than was added."}, {rank: 3, prompt: "A $60 jacket is 25% off. What does it cost now?", choices: ["$15","$35","$45","$55"], answer: 2, explanation: "25% of 60 is 15, and 60 minus 15 is 45."}]},
  {id: "eab9b398-0448-4dcb-98da-dd87493f708e", name: "Ratio and Proportion", order: 9, questions: [{rank: 1, prompt: "A class has 12 girls and 8 boys. What is the ratio of girls to boys in its simplest form?", choices: ["2 to 3","12 to 20","4 to 3","3 to 2"], answer: 3, explanation: "12 to 8 divides down by 4 to 3 to 2."}, {rank: 2, prompt: "A paint mix uses blue and yellow in the ratio 2 to 3. If you double both amounts, what happens to the color?", choices: ["It stays the same, since the ratio is unchanged","It becomes bluer","It becomes more yellow","It becomes twice as dark"], answer: 0, explanation: "Doubling both amounts keeps them in the same 2 to 3 ratio, so the mix looks the same."}, {rank: 3, prompt: "A recipe uses 2 cups of flour for 3 people. How much flour do you need for 9 people?", choices: ["6 cups","4 cups","5 cups","8 cups"], answer: 0, explanation: "9 people is 3 times as many as 3, so you need 3 times 2 cups."}]},
  {id: "6b5c66bc-0905-41c6-8ef7-6c68f30762c6", name: "Negative Numbers", order: 10, questions: [{rank: 1, prompt: "What is 3 minus 8?", choices: ["-5","5","-11","11"], answer: 0, explanation: "Going 8 down from 3 passes zero and ends at -5."}, {rank: 2, prompt: "Which is colder, -15 degrees or -5 degrees, and why?", choices: ["-5, because 5 is smaller than 15","-15, because it is further below zero","They're the same, since both are below zero","-5, because it is closer to zero"], answer: 1, explanation: "On a number line, -15 is further left than -5, so it is the lower temperature."}, {rank: 3, prompt: "It's -6 degrees Celsius at night and warms by 10 degrees by noon. What is the temperature at noon?", choices: ["4 degrees","16 degrees","-16 degrees","-4 degrees"], answer: 0, explanation: "Starting at -6 and going up 10 gives 4."}]},
  {id: "ab034c93-7b30-4956-a915-4b033c495509", name: "Order of Operations", order: 11, questions: [{rank: 1, prompt: "In the order of operations, which is worked out first?", choices: ["Addition","Subtraction","Anything inside parentheses","Whatever is furthest right"], answer: 2, explanation: "Operations inside parentheses come before exponents, multiplication, division, addition and subtraction."}, {rank: 2, prompt: "Why is 2 + 3 x 4 equal to 14 rather than 20?", choices: ["Multiplication is done before addition","Calculations always go right to left","Addition is done before multiplication","The larger number goes first"], answer: 0, explanation: "By the order of operations, 3 x 4 is worked out first, giving 2 + 12."}, {rank: 3, prompt: "A ticket costs $12 and a booking fee of $3 is added to each ticket. Which expression gives the cost of 4 tickets?", choices: ["4 x 12 + 3","4 x (12 + 3)","12 + 3 x 4","4 + 12 x 3"], answer: 1, explanation: "The fee is added to each ticket, so the price plus fee must be grouped before multiplying by 4."}]},
  {id: "6dacac06-bda1-45f4-a09d-4b999c3cdc96", name: "Exponents", order: 12, questions: [{rank: 1, prompt: "What is 10 to the power 2?", choices: ["20","100","12","1,000"], answer: 1, explanation: "10 to the power 2 is 10 times 10."}, {rank: 2, prompt: "Why is 2 to the power 3 not the same as 2 times 3?", choices: ["It means 2 multiplied by itself 3 times, which is 8","It means 3 multiplied by itself twice","They are the same, both 6","It means 2 added to itself 3 times"], answer: 0, explanation: "An exponent counts how many times the base is multiplied by itself: 2 x 2 x 2."}, {rank: 3, prompt: "A colony of bacteria doubles every hour, starting from 1. How many bacteria are there after 5 hours?", choices: ["10","25","32","64"], answer: 2, explanation: "Doubling 5 times is 2 to the power 5, which is 32."}]},
  {id: "09d10681-6ff1-4c48-aced-d0abee8d0658", name: "Algebraic Expressions", order: 13, questions: [{rank: 1, prompt: "In the expression 7y + 4, what is the 7 called?", choices: ["The constant","The exponent","The variable","The coefficient"], answer: 3, explanation: "The number multiplying a variable is its coefficient."}, {rank: 2, prompt: "Why can 3x + 5x be written as 8x, but 3x + 5 can't be simplified that way?", choices: ["3x and 5x are like terms, while 5 has no x","Numbers can never be added","3x + 5 is already 8x","x always equals 1"], answer: 0, explanation: "Only like terms, with the same variable, can be combined: three x's and five x's make eight x's."}, {rank: 3, prompt: "A taxi charges a $3 flat fee plus $2 per kilometer. Which expression gives the fare for k kilometers?", choices: ["3 + 2k","2 + 3k","5k","(3 + 2)k"], answer: 0, explanation: "The fee is charged once and the $2 is charged for each of the k kilometers."}]},
  {id: "de21ee46-d478-4e2a-8c78-ded55314f7ff", name: "Linear Equations", order: 14, questions: [{rank: 1, prompt: "What value of x makes 2x = 14 true?", choices: ["12","16","28","7"], answer: 3, explanation: "2 times 7 is 14."}, {rank: 2, prompt: "Why can you subtract 4 from both sides of x + 4 = 10 without changing the answer?", choices: ["Doing the same thing to both sides keeps them equal","Subtraction never changes an equation","It makes both sides 10","x always equals 4"], answer: 0, explanation: "An equation says two amounts are equal, and taking the same amount from both keeps them equal."}, {rank: 3, prompt: "A gym charges a $20 joining fee plus $15 a month. After how many months will you have paid $110 in total?", choices: ["7","5","6","8"], answer: 2, explanation: "20 + 15m = 110 gives 15m = 90, so m = 6."}]},
  {id: "24ff8bc8-0414-49f2-a1ae-c3c452e0ca02", name: "Coordinate Geometry", order: 15, questions: [{rank: 1, prompt: "In the point (5, -2), which number gives the position along the horizontal axis?", choices: ["-2","Both","Neither","5"], answer: 3, explanation: "A point is written (x, y), and x is the horizontal position."}, {rank: 2, prompt: "Which of these points lies on the vertical y-axis?", choices: ["(4, 0)","(4, 4)","(0, 4)","(1, 4)"], answer: 2, explanation: "Every point on the y-axis has an x-coordinate of 0."}, {rank: 3, prompt: "On a map grid, a cafe is at (2, 3) and a library is at (2, 9). How far apart are they on the grid?", choices: ["12 units","6 units","4 units","7 units"], answer: 1, explanation: "They share the same x, so the distance is the difference in y: 9 minus 3."}]},
  {id: "797e5cb1-eb52-45a6-871a-dcbcc6d7cfdd", name: "Area and Perimeter", order: 16, questions: [{rank: 1, prompt: "Which measures the distance around the edge of a shape?", choices: ["Area","Volume","Diagonal","Perimeter"], answer: 3, explanation: "The perimeter is the total length of a shape's boundary."}, {rank: 2, prompt: "Two rectangles both have a perimeter of 20 meters: one is 5 by 5, the other 9 by 1. What does this show?", choices: ["Equal perimeters always mean equal areas","Only squares have a perimeter","The thinner rectangle has more area","The same perimeter can enclose different areas"], answer: 3, explanation: "The 5 by 5 square encloses 25 square meters, while the 9 by 1 rectangle encloses only 9."}, {rank: 3, prompt: "A rectangular floor is 5 meters by 4 meters, and tiles cost $30 per square meter. How much do the tiles cost?", choices: ["$540","$270","$600","$900"], answer: 2, explanation: "The floor's area is 5 times 4, which is 20 square meters, and 20 times $30 is $600."}]},
  {id: "e0b742a8-853e-45c2-9265-37bb4f5b0e65", name: "Volume", order: 17, questions: [{rank: 1, prompt: "Which of these is a unit of volume?", choices: ["Kilogram","Meter","Square meter","Liter"], answer: 3, explanation: "A liter measures how much space something takes up, such as a liquid in a bottle."}, {rank: 2, prompt: "Why is volume measured in cubic units, such as cubic meters?", choices: ["It counts how many unit cubes fill a 3D space","It measures the distance around a shape","Cubes are the only shapes with volume","It's measured on one face only"], answer: 0, explanation: "Volume is the space inside a solid, counted in cubes that each have a length, width and height of one unit."}, {rank: 3, prompt: "A fish tank is 50 cm long, 30 cm wide and 40 cm high. How many liters does it hold? Use 1 liter = 1,000 cubic cm.", choices: ["120 liters","6 liters","600 liters","60 liters"], answer: 3, explanation: "50 x 30 x 40 is 60,000 cubic centimeters, which is 60 liters."}]},
  {id: "58db6500-e404-4177-8eb7-23b4d1d7b768", name: "Angles", order: 18, questions: [{rank: 1, prompt: "How many degrees are in a right angle?", choices: ["180","45","90","360"], answer: 2, explanation: "A right angle, a quarter turn, is 90 degrees."}, {rank: 2, prompt: "Why do the three angles of any triangle add up to the same total?", choices: ["Every triangle has three equal angles","Larger triangles have the same side lengths","Triangles always contain a right angle","Torn off and placed side by side, they always form a straight line"], answer: 3, explanation: "A triangle's three angles always fit together into a straight line, which is 180 degrees."}, {rank: 3, prompt: "A ramp rises at 25 degrees from the ground. What angle does it make with a vertical wall?", choices: ["25 degrees","155 degrees","65 degrees","90 degrees"], answer: 2, explanation: "The ground and the wall meet at 90 degrees, so 90 minus 25 leaves 65."}]},
  {id: "b2bb6a0b-06c1-483b-a46e-840f20ef13d7", name: "Pythagorean Theorem", order: 19, questions: [{rank: 1, prompt: "What is the longest side of a right triangle called?", choices: ["The base","The adjacent side","The height","The hypotenuse"], answer: 3, explanation: "The side opposite the right angle, the longest, is the hypotenuse."}, {rank: 2, prompt: "For which kind of triangle does the rule a squared plus b squared equals c squared hold?", choices: ["Any triangle","A triangle with three equal sides","A triangle with a right angle","A triangle with no right angle"], answer: 2, explanation: "The relationship between the sides holds only in a right triangle."}, {rank: 3, prompt: "A ladder's foot is 5 meters from a wall, and it reaches 12 meters up the wall. How long is the ladder?", choices: ["17 meters","11 meters","13 meters","15 meters"], answer: 2, explanation: "5 squared plus 12 squared is 169, and the square root of 169 is 13."}]},
  {id: "b83dd9d3-285e-4421-bddc-5c44c5a6deda", name: "Descriptive Statistics", order: 20, questions: [{rank: 1, prompt: "What is the mode of 3, 7, 7, 2, 9?", choices: ["7","5.6","3","9"], answer: 0, explanation: "The mode is the value that appears most often."}, {rank: 2, prompt: "Two classes both have a mean score of 70, but one class's scores range from 65 to 75 and the other's from 40 to 100. What does this show?", choices: ["Both classes did equally well on every question","The second class must have more students","The same mean can come from very different spreads","The mean is wrong for one class"], answer: 2, explanation: "A mean says where scores center, not how spread out they are."}, {rank: 3, prompt: "Five friends earn $30,000, $32,000, $35,000, $36,000 and $300,000 a year. Which figure best describes a typical income in the group?", choices: ["The median, $35,000","The mean, $86,600","The range, $270,000","The largest, $300,000"], answer: 0, explanation: "One very large income pulls the mean far up, while the middle value stays near what most of them earn."}]},
  {id: "692292fc-d6b3-486e-ab57-3b3e1cbe6f73", name: "Probability", order: 21, questions: [{rank: 1, prompt: "What is the probability of an event that is certain to happen?", choices: ["0","1/2","100","1"], answer: 3, explanation: "Probabilities run from 0, impossible, to 1, certain."}, {rank: 2, prompt: "A fair coin lands heads five times in a row. What is the chance it lands heads on the next flip?", choices: ["Still 1/2, since each flip is independent","Less than 1/2, since tails is due","More than 1/2, since heads is on a streak","Zero"], answer: 0, explanation: "A coin has no memory: each flip is a fresh 50-50."}, {rank: 3, prompt: "You roll two ordinary dice. What is the probability that both show 6?", choices: ["1/6","1/36","1/12","2/6"], answer: 1, explanation: "Each die shows 6 with probability 1/6, and both together is 1/6 times 1/6."}]},
  {id: "384762b1-6aca-49a6-851d-927ce4b64ba7", name: "Quadratic Equations", order: 22, questions: [{rank: 1, prompt: "Which of these is a quadratic equation?", choices: ["3x - 4 = 0","x squared + 3x - 4 = 0","x cubed = 8","1/x = 2"], answer: 1, explanation: "A quadratic equation's highest power of the unknown is 2."}, {rank: 2, prompt: "Why does x squared = 25 have two solutions?", choices: ["It has only one solution, 5","Every equation has exactly two solutions","Because 25 is odd","Both 5 and -5 give 25 when squared"], answer: 3, explanation: "Squaring a negative number gives a positive result, so -5 works as well as 5."}, {rank: 3, prompt: "A square garden has an area of 49 square meters. How long is each side?", choices: ["24.5 meters","12.25 meters","14 meters","7 meters"], answer: 3, explanation: "If the side is s, then s squared is 49, so s is 7 (a negative length makes no sense here)."}]},
  {id: "1d93d5e5-eeb4-4545-b030-9e9bf6398a35", name: "Systems of Linear Equations", order: 23, questions: [{rank: 1, prompt: "Does x = 1 and y = 3 solve both x + y = 4 and 2x + y = 5?", choices: ["Only the first","Only the second","Neither","Yes, both"], answer: 3, explanation: "1 + 3 is 4 and 2 + 3 is 5, so both hold."}, {rank: 2, prompt: "Two straight lines on a graph cross at the point (2, 5). What does that point mean for their two equations?", choices: ["Only one equation is true there","The equations have no solution","The equations are the same","x = 2 and y = 5 makes both equations true"], answer: 3, explanation: "A solution to a pair of equations lies on both lines, which is where they cross."}, {rank: 3, prompt: "Two notebooks and a pen cost $7, and one notebook and a pen cost $4. How much is a notebook?", choices: ["$1","$3","$2","$4"], answer: 1, explanation: "The difference between the two purchases is one notebook, and $7 minus $4 is $3."}]},
  {id: "672c8d24-8406-4a0e-9eb3-af72f2f06624", name: "Functions", order: 24, questions: [{rank: 1, prompt: "If f(x) = 3x, what is f(4)?", choices: ["7","34","12","1"], answer: 2, explanation: "f(4) means 3 times 4."}, {rank: 2, prompt: "Why can't a function give two different outputs for the same input?", choices: ["Functions only work with positive numbers","Outputs must always be larger than inputs","Two inputs can never share an output","Each input must have exactly one output"], answer: 3, explanation: "A function pairs every input with exactly one output, though different inputs may share one."}, {rank: 3, prompt: "A phone plan costs f(m) = 10 + 0.5m dollars for m minutes of calls. What does 40 minutes cost?", choices: ["$20","$30","$50","$14"], answer: 1, explanation: "f(40) = 10 + 0.5 x 40 = 10 + 20 = 30."}]},
  {id: "0cb69505-a98e-48d1-8428-18ae2f928284", name: "Exponential Functions", order: 25, questions: [{rank: 1, prompt: "Which of these is an exponential function?", choices: ["y = 2x","y = 2 to the power x","y = x squared","y = x + 2"], answer: 1, explanation: "In an exponential function, the variable is in the exponent."}, {rank: 2, prompt: "Why does an amount growing by a fixed percentage each year eventually outgrow one growing by a fixed amount each year?", choices: ["Fixed amounts shrink over time","The percentage applies to an ever larger amount","Percentages are always larger than fixed amounts","They grow at the same rate"], answer: 1, explanation: "Each year's increase is a share of a growing total, so the increases themselves keep getting bigger."}, {rank: 3, prompt: "A $1,000 investment grows by 10% each year. About how much is it worth after 2 years?", choices: ["$1,200","$1,210","$1,020","$1,100"], answer: 1, explanation: "After a year it's $1,100, and 10% more of that is $1,210."}]},
  {id: "961f16db-1592-4a98-98f2-6cf19a82ef1e", name: "Logarithms", order: 26, questions: [{rank: 1, prompt: "What is the log base 10 of 100?", choices: ["2","10","100","1"], answer: 0, explanation: "10 squared is 100."}, {rank: 2, prompt: "Why is the log base 10 of 1,000 equal to 3?", choices: ["1,000 has 3 zeros after a 1 by coincidence","1,000 divided by 10 is 3","10 to the power 3 is 1,000","3 times 10 is 1,000"], answer: 2, explanation: "A logarithm asks what power the base must be raised to, and 10 cubed is 1,000."}, {rank: 3, prompt: "Each step on the Richter scale is 10 times stronger shaking. How much stronger is a magnitude 6 earthquake's shaking than a magnitude 4's?", choices: ["2 times","20 times","1,000 times","100 times"], answer: 3, explanation: "Two steps up is 10 times 10."}]},
  {id: "85dd2189-d50f-4370-b4dc-e76a1aa91a16", name: "Trigonometry", order: 27, questions: [{rank: 1, prompt: "In a right triangle, which ratio is the tangent of an angle?", choices: ["Opposite over hypotenuse","Adjacent over hypotenuse","Hypotenuse over opposite","Opposite over adjacent"], answer: 3, explanation: "Tangent is the side opposite the angle divided by the side next to it."}, {rank: 2, prompt: "Why does the sine of an angle in a right triangle stay the same however large the triangle is?", choices: ["Sine depends on the length of the hypotenuse","All right triangles are the same size","Sine is always 1","Triangles with the same angles have their sides in the same proportions"], answer: 3, explanation: "Scaling a triangle up keeps its angles and the ratios between its sides."}, {rank: 3, prompt: "A ladder 5 meters long leans against a wall at 60 degrees to the ground. How far up the wall does it reach? Use sin 60 degrees = 0.87.", choices: ["About 2.5 meters","About 5.7 meters","About 3.1 meters","About 4.3 meters"], answer: 3, explanation: "The height is opposite the 60 degree angle, so it's 5 times sin 60, about 4.35 meters."}]},
  {id: "796d1632-608e-4e6d-9ff3-8fb3ff3d4ae3", name: "Sequences and Series", order: 28, questions: [{rank: 1, prompt: "What is the next number in 2, 7, 12, 17?", choices: ["21","24","19","22"], answer: 3, explanation: "Each term is 5 more than the one before."}, {rank: 2, prompt: "What makes 3, 6, 12, 24 a different kind of sequence from 3, 6, 9, 12?", choices: ["It multiplies by the same number each time instead of adding","It goes up","It starts at 3","It has four terms"], answer: 0, explanation: "One sequence doubles each term, while the other adds 3 each time."}, {rank: 3, prompt: "You save $5 in the first week and $3 more each week than the week before. How much do you save in week 10?", choices: ["$35","$32","$30","$50"], answer: 1, explanation: "Week 10 is 9 increases after week 1, so it's 5 + 9 x 3."}]},
  {id: "70f1820f-41aa-4826-aebd-efdd1c07f824", name: "Vectors", order: 29, questions: [{rank: 1, prompt: "Which of these is a vector?", choices: ["20 meters","20 seconds","20 meters north","20 kilograms"], answer: 2, explanation: "A vector has a direction as well as a size."}, {rank: 2, prompt: "Why is a car's velocity a vector but its speed is not?", choices: ["Speed is measured in different units","Velocity includes the direction of travel","Velocity is always larger","Speed includes direction"], answer: 1, explanation: "A vector has both a size and a direction, and velocity says which way the car is going."}, {rank: 3, prompt: "A boat heads east at 4 km per hour while the current carries it north at 3 km per hour. How fast does it move overall?", choices: ["7 km per hour","1 km per hour","12 km per hour","5 km per hour"], answer: 3, explanation: "The two speeds are at right angles, so the total is the square root of 4 squared plus 3 squared."}]},
  {id: "c9731937-f692-4024-bb18-d51721cd8a75", name: "Differential Calculus", order: 30, questions: [{rank: 1, prompt: "What is the derivative of x squared?", choices: ["x","x cubed over 3","2","2x"], answer: 3, explanation: "The power rule brings down the 2 and lowers the power by one."}, {rank: 2, prompt: "On a graph of distance against time, what does the steepness of the curve at a point tell you?", choices: ["The total distance traveled","The time elapsed","The average speed for the whole trip","The speed at that moment"], answer: 3, explanation: "The slope at a point, its derivative, is how fast distance is changing then."}, {rank: 3, prompt: "A ball's height in meters after t seconds is 20t - 5t squared. How fast is it rising at t = 1 second?", choices: ["15 meters per second","20 meters per second","10 meters per second","0 meters per second"], answer: 2, explanation: "The derivative is 20 - 10t, which is 10 at t = 1."}]},
  {id: "98476e98-428d-452e-b997-f66cd2ec9c1b", name: "Integral Calculus", order: 31, questions: [{rank: 1, prompt: "What is the integral of 2x with respect to x?", choices: ["2","2x squared","x plus a constant","x squared plus a constant"], answer: 3, explanation: "Differentiating x squared gives 2x, so x squared, plus any constant, is its integral."}, {rank: 2, prompt: "How is integration related to differentiation?", choices: ["Each one undoes the other","They are the same operation","Integration only works on straight lines","They are unrelated"], answer: 0, explanation: "Differentiating an integral gives back the original function, so the two are inverse operations."}, {rank: 3, prompt: "A car's speed rises steadily from 0 to 20 meters per second over 10 seconds. How far does it travel in that time?", choices: ["100 meters","2 meters","200 meters","20 meters"], answer: 0, explanation: "Distance is the area under the speed-time graph, here a triangle: half of 10 times 20."}]},
  {id: "f03d1a2f-a1b8-400d-8cc5-10d7e8bbdc0e", name: "Phonics", order: 32, questions: [{rank: 1, prompt: "What sound do the letters \"sh\" make together in \"ship\"?", choices: ["The \"s\" sound followed by the \"h\" sound","The same sound as \"ch\" in \"chip\"","One sound, as at the start of \"shoe\"","No sound, they are silent"], answer: 2, explanation: "\"Sh\" is a pair of letters that spells one sound."}, {rank: 2, prompt: "The word \"phone\" has five letters but only three sounds. Why?", choices: ["Every letter makes a sound but some are quiet","\"O\" and \"n\" blend into one sound","Words always have fewer sounds than letters","\"Ph\" makes one sound and the final \"e\" is silent"], answer: 3, explanation: "Two letters can spell a single sound, and some letters make none."}, {rank: 3, prompt: "You meet the unfamiliar word \"splint\" in a book. How do you work out how to say it?", choices: ["Say the sounds s-p-l-i-n-t in order and blend them","Match it to the closest word you already know by sight","Guess from the first letter and the length","Say the name of each letter in turn"], answer: 0, explanation: "Blending each letter's sound in order is how phonics decodes a new word."}]},
  {id: "40327e5b-90a4-4eea-a812-d8146c217c4d", name: "Spelling", order: 33, questions: [{rank: 1, prompt: "Which is the correct spelling?", choices: ["neccessary","necesary","necessary","neccesary"], answer: 2, explanation: "Necessary has one c and two s's."}, {rank: 2, prompt: "Why do \"their\", \"there\" and \"they're\" need different spellings even though they sound alike?", choices: ["Only one of them is correct English","The spelling depends on how loudly they're said","They mean the same thing and are interchangeable","They are different words with different meanings"], answer: 3, explanation: "Words that sound alike but mean different things are spelled differently so readers can tell them apart."}, {rank: 3, prompt: "You're adding -ing to \"hop\". How do you spell it?", choices: ["hopeing","hopinng","hoping","hopping"], answer: 3, explanation: "After a short vowel and one consonant, double the consonant before -ing. \"Hoping\" comes from \"hope\"."}]},
  {id: "5eaeb5a3-4f3e-4ef3-b861-614967b804f4", name: "Punctuation", order: 34, questions: [{rank: 1, prompt: "Which punctuation mark ends a direct question?", choices: ["A period","A comma","A semicolon","A question mark"], answer: 3, explanation: "A direct question ends with a question mark."}, {rank: 2, prompt: "How does the comma change the meaning of \"Let's eat, Grandma\" compared with \"Let's eat Grandma\"?", choices: ["It makes no difference to the meaning","It turns the sentence into a question","It shows Grandma is doing the eating","It shows Grandma is being spoken to, not eaten"], answer: 3, explanation: "A comma before a name marks the person being addressed."}, {rank: 3, prompt: "You need to join \"It was raining\" and \"we stayed inside\" into one sentence. Which is punctuated correctly?", choices: ["It was, raining so we stayed inside.","It was raining, so we stayed inside.","It was raining, we stayed inside.","It was raining so, we stayed inside."], answer: 1, explanation: "Two complete clauses joined by \"so\" take a comma before the conjunction. A comma alone can't join them."}]},
  {id: "12f603c0-9e1f-485e-b3eb-55cc188c33d7", name: "Parts of Speech", order: 35, questions: [{rank: 1, prompt: "What part of speech is a word that names a person, place or thing?", choices: ["Verb","Adjective","Noun","Preposition"], answer: 2, explanation: "Nouns name people, places, things and ideas."}, {rank: 2, prompt: "Why is \"run\" a verb in \"I run every day\" but a noun in \"I went for a run\"?", choices: ["Every word has one fixed part of speech","Nouns always come after \"a\"","A word's part of speech depends on its job in the sentence","Verbs always come after \"I\""], answer: 2, explanation: "In the first sentence \"run\" is the action, and in the second it names a thing."}, {rank: 3, prompt: "Your sentence \"He runs quick\" sounds wrong. How do you fix it?", choices: ["Change \"quick\" to the adverb \"quickly\"","Add \"very\" before \"quick\"","Change \"He\" to \"Him\"","Change \"runs\" to \"run\""], answer: 0, explanation: "\"Quick\" describes how he runs, a verb, so it needs to be an adverb."}]},
  {id: "654f5d6e-720d-41d0-822d-1d3e882c1843", name: "Reading Comprehension", order: 36, questions: [{rank: 1, prompt: "When you draw a conclusion a text suggests but doesn't state, what is that called?", choices: ["Summarizing","Skimming","Making an inference","Predicting the title"], answer: 2, explanation: "An inference is a conclusion drawn from clues in a text."}, {rank: 2, prompt: "What is the difference between a passage's main idea and a supporting detail?", choices: ["They are the same thing","The main idea always comes last","Supporting details are always opinions","The main idea is what the whole passage is about, and details back it up"], answer: 3, explanation: "A main idea is the central point, and details are the facts or examples that support it."}, {rank: 3, prompt: "You need the year a bridge opened, from a long article about the city's history. What's the quickest way to find it?", choices: ["Read only the first paragraph","Read the conclusion and guess","Scan for the word \"bridge\" and for dates near it","Read every word from the start"], answer: 2, explanation: "Scanning for key words finds a specific fact without reading everything."}]},
  {id: "c3285698-b496-48a8-8a50-230760ab711d", name: "Sentence Structure", order: 37, questions: [{rank: 1, prompt: "In \"The cat slept on the mat\", what is the subject?", choices: ["slept","on the mat","the mat","The cat"], answer: 3, explanation: "The subject is who or what does the action."}, {rank: 2, prompt: "Why is \"When the rain stopped\" not a complete sentence?", choices: ["It has no verb","It starts a thought it doesn't finish","It has no subject","It is too short"], answer: 1, explanation: "\"When\" makes it a dependent clause, which needs a main clause to complete it."}, {rank: 3, prompt: "Your draft has the line \"Because the shop was closed.\" Which rewrite makes it a complete sentence?", choices: ["Because the shop was closed, we went home.","Because the shop, was closed.","Because the shop was closed!","Because, the shop was closed."], answer: 0, explanation: "A clause starting with \"because\" needs a main clause to finish the thought."}]},
  {id: "ec071bba-217a-421e-ada4-cac0aa636a96", name: "Paragraph Structure", order: 38, questions: [{rank: 1, prompt: "What is the sentence that states a paragraph's main idea called?", choices: ["The thesis","The topic sentence","The conclusion","The caption"], answer: 1, explanation: "The topic sentence states what the paragraph is about."}, {rank: 2, prompt: "Why does a well-built paragraph usually stick to one main idea?", choices: ["It keeps the reader clear on what the paragraph is about","Paragraphs have a fixed word limit","Each sentence must repeat the same words","Readers skip paragraphs with more than one sentence"], answer: 0, explanation: "Grouping one idea with its support helps the reader follow the writing."}, {rank: 3, prompt: "A paragraph argues that cycling to work saves money. Which sentence would not belong in it?", choices: ["Cyclists spend nothing on fuel.","Parking a bike is free in most cities.","Bike repairs cost far less than car repairs.","Many bikes come in bright colors."], answer: 3, explanation: "Every sentence in a paragraph should support its main point, and bike colors have nothing to do with saving money."}]},
  {id: "622f220e-0937-44a6-8392-4eeae85c8eea", name: "Narrative Writing", order: 39, questions: [{rank: 1, prompt: "What is the time and place in which a story happens called?", choices: ["The theme","The climax","The setting","The narrator"], answer: 2, explanation: "The setting is where and when a story takes place."}, {rank: 2, prompt: "Why does a story usually need a conflict?", choices: ["Every story must include a fight","It makes the story shorter","It tells the reader the setting","It gives the characters a problem that drives the plot"], answer: 3, explanation: "A conflict creates tension and something for the characters to resolve."}, {rank: 3, prompt: "Your story about a girl who finds a lost dog feels flat. What would most give it drive?", choices: ["Give her a problem, like the owner wanting the dog back after she's grown to love it","Switch the story to the present tense","Describe the dog's fur in more detail","Add more characters who walk past"], answer: 0, explanation: "A conflict gives a story something to resolve, and the reader a reason to keep going."}]},
  {id: "b108db11-be47-4d4b-b81c-78f89af2440d", name: "Persuasive Writing", order: 40, questions: [{rank: 1, prompt: "What is the main purpose of persuasive writing?", choices: ["To convince the reader of a view","To entertain with a story","To describe a place","To list facts without a position"], answer: 0, explanation: "Persuasive writing argues for a position."}, {rank: 2, prompt: "Why does a persuasive essay often answer the other side's argument?", choices: ["Showing why the objection fails makes the case stronger","It is required by law","It proves the writer is undecided","It makes the essay neutral"], answer: 0, explanation: "Addressing counterarguments shows the writer has considered them and still holds the stronger position."}, {rank: 3, prompt: "You want to persuade your town to build a skate park. Which sentence is the strongest piece of evidence?", choices: ["Skate parks are really cool","A survey found 300 local teens would use it weekly","Everyone wants a skate park","I have always liked skate parks"], answer: 1, explanation: "A specific, checkable fact supports a claim better than an opinion or sweeping generalization."}]},
  {id: "1785ca9c-bc4e-47c7-9656-2cca4a99603e", name: "Figurative Language", order: 41, questions: [{rank: 1, prompt: "What is it called when a writer compares two things using \"like\" or \"as\"?", choices: ["Alliteration","Hyperbole","A simile","Onomatopoeia"], answer: 2, explanation: "A comparison with \"like\" or \"as\" is a simile."}, {rank: 2, prompt: "What does the idiom \"break the ice\" mean?", choices: ["To damage something frozen","To end a friendship","To cool a drink","To ease tension when people first meet"], answer: 3, explanation: "Idioms mean something different from their literal words."}, {rank: 3, prompt: "You want to tell a friend your new job is overwhelming, using a metaphor. Which works?", choices: ["My job is very, very hard.","My job is a tidal wave.","My job roared like a lion.","My job is like a tidal wave."], answer: 1, explanation: "A metaphor says one thing is another. \"Like\" makes it a simile."}]},
  {id: "51bdbd8e-7a72-4835-b442-60a36b6180a4", name: "Essay Writing", order: 42, questions: [{rank: 1, prompt: "Which sentence states an essay's central claim?", choices: ["The hook","The citation","The title","The thesis statement"], answer: 3, explanation: "The thesis statement says what the essay argues."}, {rank: 2, prompt: "Why does an essay's conclusion usually avoid bringing in a new main argument?", choices: ["Conclusions have a strict word limit","New ideas are not allowed in essays","It should wrap up the points already made","The reader stops reading before the end"], answer: 2, explanation: "A conclusion draws the essay together rather than opening a new line of argument."}, {rank: 3, prompt: "An essay's thesis is \"Cities should plant more trees.\" Which body paragraph topic best supports it?", choices: ["Trees lower summer temperatures in cities","Many trees lose their leaves in autumn","Some cities are near forests","Tree houses are popular with children"], answer: 0, explanation: "A body paragraph should give a reason that supports the thesis."}]},
  {id: "ddd9d23b-3292-41b6-aa42-3e68a2252b7d", name: "Rhetoric", order: 43, questions: [{rank: 1, prompt: "Which ancient Greek philosopher wrote the Rhetoric, which described the three persuasive appeals?", choices: ["Aristotle","Plato","Socrates","Homer"], answer: 0, explanation: "Aristotle's Rhetoric set out persuasion through character, emotion and reason."}, {rank: 2, prompt: "Why might a speaker use a moving personal story?", choices: ["To stir the audience's feelings and win them over","To prove a statistic","To show their qualifications","To shorten the speech"], answer: 0, explanation: "A personal story appeals to emotion, which is pathos."}, {rank: 3, prompt: "You're asking neighbors to fund a new playground. Which line appeals to their emotions?", choices: ["Studies show play improves children's fitness.","A city engineer approved the design.","The playground will cost $40,000.","Picture your kids laughing on new swings this summer."], answer: 3, explanation: "An appeal to emotion, pathos, makes people feel something. The others appeal to facts or authority."}]},
  {id: "0d3cdfb4-04e4-403e-807f-14f8600e102d", name: "Research Writing", order: 44, questions: [{rank: 1, prompt: "What is presenting someone else's words or ideas as your own called?", choices: ["Paraphrasing","Citation","Plagiarism","Summarizing"], answer: 2, explanation: "Plagiarism is using others' work without credit."}, {rank: 2, prompt: "Why do researchers check more than one source?", choices: ["To make the paper longer","To confirm facts and catch errors or bias","Because one source is never allowed","To avoid writing their own ideas"], answer: 1, explanation: "Agreement among independent sources makes a claim more trustworthy."}, {rank: 3, prompt: "You're researching the health effects of sugar. Which source is most reliable?", choices: ["A peer-reviewed medical journal article","An anonymous social media post","A candy company's advertisement","A personal blog with no sources"], answer: 0, explanation: "Peer-reviewed research is checked by experts and has no stake in selling a product."}]},
  {id: "288d04ad-1bc7-4f75-830d-e07d9f162bc3", name: "Citation", order: 45, questions: [{rank: 1, prompt: "What is the list of sources at the end of a research paper called?", choices: ["A glossary","An index","An abstract","A bibliography"], answer: 3, explanation: "A bibliography, or works cited list, lists the sources used."}, {rank: 2, prompt: "Why does a paraphrase still need a citation?", choices: ["Paraphrases are always inaccurate","Only paraphrases need citations","The idea still belongs to its original author","Citations make an essay longer"], answer: 2, explanation: "Rewording someone's idea doesn't make it yours."}, {rank: 3, prompt: "You quote a sentence word for word from a book in your essay. What must you do?", choices: ["Change a few words so you don't need to cite it","Cite it only if it is longer than a page","Nothing, if the book is famous","Put it in quotation marks and cite the source"], answer: 3, explanation: "Direct quotes need quotation marks and a citation."}]},
  {id: "74c6acb0-4c20-4eff-9a1a-645cc531b785", name: "Fairy Tales", order: 46, questions: [{rank: 1, prompt: "In the fairy tale, who leaves a glass slipper at the ball?", choices: ["Snow White","Rapunzel","Little Red Riding Hood","Cinderella"], answer: 3, explanation: "Cinderella loses her glass slipper as she rushes away at midnight."}, {rank: 2, prompt: "Why do fairy tales so often repeat events in threes?", choices: ["It's a legal requirement of the genre","Three is the most events a story can hold","Repetition builds suspense and makes the story easy to remember and retell","It shortens the story"], answer: 2, explanation: "Fairy tales came from oral storytelling, where patterns like threes help memory and build tension."}, {rank: 3, prompt: "You're writing a fairy tale for a child. Which opening fits the form best?", choices: ["In 2024, Sarah moved to Chicago for work.","Dear diary, today was strange.","Once upon a time, a poor miller had three daughters.","The spaceship's alarms blared as the crew woke."], answer: 2, explanation: "Fairy tales open in an unnamed long-ago time, often with a humble family and the number three."}]},
  {id: "0cd85707-12a9-4da7-9f17-217192e4d124", name: "Fables", order: 47, questions: [{rank: 1, prompt: "Who is the ancient Greek storyteller credited with many famous fables?", choices: ["Homer","Plato","Aesop","Hans Christian Andersen"], answer: 2, explanation: "Aesop's fables include the Tortoise and the Hare."}, {rank: 2, prompt: "Why do fables usually use animals as characters?", choices: ["Animals stand for human traits, making the lesson easy to see","Fables are written only for zoos","Animals can't have morals","It makes the stories true"], answer: 0, explanation: "A sly fox or slow tortoise is a simple stand-in for a type of person."}, {rank: 3, prompt: "You want to teach a child that slow, steady effort beats rushing. Which fable would you tell?", choices: ["The Ant and the Grasshopper","The Tortoise and the Hare","The Fox and the Grapes","The Boy Who Cried Wolf"], answer: 1, explanation: "The tortoise keeps going and beats the hare, who rushes ahead and naps."}]},
  {id: "5fecc8d3-463b-404d-a2e8-bf83fac0f96a", name: "Poetry", order: 48, questions: [{rank: 1, prompt: "What is a group of lines forming a unit in a poem called?", choices: ["A chapter","A verse play","A paragraph","A stanza"], answer: 3, explanation: "Poems are divided into stanzas."}, {rank: 2, prompt: "Why might a poet repeat a line throughout a poem?", choices: ["Because they ran out of words","Repeated lines are required in all poems","To make the poem shorter","To emphasize an idea and give the poem rhythm"], answer: 3, explanation: "Repetition stresses what matters and creates a pattern."}, {rank: 3, prompt: "You're writing a four-line poem rhyming AABB. Lines 1 and 2 end in \"night\" and \"light\". Which words could end lines 3 and 4?", choices: ["\"sea\" and \"free\"","\"bright\" and \"sea\"","\"tree\" and \"light\"","\"sea\" and \"night\""], answer: 0, explanation: "AABB means lines 3 and 4 rhyme with each other, on a new sound."}]},
  {id: "b7d80c3f-4960-4641-8124-721f89f7e8fd", name: "Mythology", order: 49, questions: [{rank: 1, prompt: "Who is the king of the gods in Greek mythology?", choices: ["Poseidon","Apollo","Hades","Zeus"], answer: 3, explanation: "Zeus rules from Mount Olympus."}, {rank: 2, prompt: "Why did ancient peoples tell myths about thunder, the seasons and the sun?", choices: ["To entertain only children","To record exact historical dates","To replace their laws","To explain natural events they couldn't otherwise account for"], answer: 3, explanation: "Myths offered explanations for the world before modern science."}, {rank: 3, prompt: "You're naming a delivery company after a figure from Greek myth, to suggest speed. Which fits?", choices: ["Hermes, the messenger of the gods","Hades, god of the underworld","Atlas, who holds up the sky","Athena, goddess of wisdom"], answer: 0, explanation: "Hermes, with his winged sandals, carried messages for the gods."}]}
] AS x
MATCH (t:Topic {id: x.id}), (c:Collection {id: "general-schooling-knowledge"})
MERGE (c)-[contains:CONTAINS]->(t)
SET contains.order = x.order
WITH t, x
UNWIND x.questions AS q
MATCH (t)-[:HAS_LEVEL]->(l:BloomLevel {rank: q.rank})
MERGE (question:QuizQuestion)-[:TESTS]->(l)
ON CREATE SET question.id = randomUUID(), question.prompt = q.prompt, question.choices = q.choices,
              question.answer = q.answer, question.explanation = q.explanation, question.createdAt = datetime();

UNWIND [
  {id: "f74ab2fc-7165-4476-84c0-c9f9a3869b77", name: "Plot (Narrative)", order: 50, questions: [{rank: 1, prompt: "What is the opening part of a plot, which introduces the characters and setting, called?", choices: ["The climax","The exposition","The falling action","The denouement"], answer: 1, explanation: "The exposition sets up the story."}, {rank: 2, prompt: "What is the purpose of a story's rising action?", choices: ["To introduce the setting","To build tension through complications toward the turning point","To tie up loose ends","To summarize the ending"], answer: 1, explanation: "Rising action develops the conflict and raises the stakes."}, {rank: 3, prompt: "You're writing a mystery. Where should the detective reveal the killer?", choices: ["Right after the first clue","Near the end, at the climax","A little in each chapter","In the opening scene"], answer: 1, explanation: "The reveal is the story's highest point of tension, so it comes at the climax, near the end."}]},
  {id: "7f9b3c13-9210-4e45-842c-cb73d7079c58", name: "Characterization", order: 51, questions: [{rank: 1, prompt: "What is the main character of a story called?", choices: ["The antagonist","The protagonist","The narrator","The foil"], answer: 1, explanation: "The protagonist is the central character."}, {rank: 2, prompt: "Why do writers often show a character's traits through actions instead of stating them?", choices: ["It lets readers judge the character themselves, which is more convincing","It's shorter","Stating traits is not allowed","It hides the character from the reader"], answer: 0, explanation: "Showing makes traits feel real and earned."}, {rank: 3, prompt: "You want readers to see a character is greedy without saying so. Which line does it?", choices: ["He counted the waiter's tip twice, then took half of it back.","Everyone in town said he was greedy.","He was a very greedy man.","He wore a gray wool coat."], answer: 0, explanation: "Showing a trait through what a character does lets readers draw the conclusion."}]},
  {id: "93a798e6-085e-4339-bbf4-516300f199c8", name: "Literary Genres", order: 52, questions: [{rank: 1, prompt: "What is a true account of a person's life, written by someone else, called?", choices: ["An autobiography","A novel","A biography","A memoir"], answer: 2, explanation: "A biography is someone's life story written by another person."}, {rank: 2, prompt: "What separates fantasy from science fiction?", choices: ["Fantasy is always set in the past","Science fiction never has heroes","Fantasy relies on magic, science fiction on imagined science","They are the same genre"], answer: 2, explanation: "Fantasy's impossible things come from magic, while science fiction's come from extensions of science."}, {rank: 3, prompt: "A friend loved The Lord of the Rings and asks what to read next. What should you suggest?", choices: ["A detective mystery","A fantasy novel with magic and a quest","A biography of a scientist","A romance set in modern Paris"], answer: 1, explanation: "The Lord of the Rings is fantasy, so another fantasy is the closest match."}]},
  {id: "6a1e2e61-b400-4eb7-bc3c-b006b208b9ba", name: "Drama", order: 53, questions: [{rank: 1, prompt: "What are the main divisions of a play called?", choices: ["Chapters","Stanzas","Acts","Verses"], answer: 2, explanation: "Plays are divided into acts, which are split into scenes."}, {rank: 2, prompt: "Why does a playwright use a soliloquy?", choices: ["To change the scenery","To introduce the cast","To speak directly to another character","To let the audience hear a character's private thoughts"], answer: 3, explanation: "A character speaking alone reveals what they really think."}, {rank: 3, prompt: "You're writing a play and need an actor to slam a door without saying anything. How do you show it in the script?", choices: ["A line of dialogue for the actor","A footnote at the end of the page","A new act heading","A stage direction in parentheses"], answer: 3, explanation: "Stage directions tell actors what to do, apart from what they say."}]},
  {id: "cfbdb2d4-a1b4-4997-af5e-7f8e106ea4ed", name: "Theme", order: 54, questions: [{rank: 1, prompt: "What is the central message or insight about life in a work of literature called?", choices: ["Its plot","Its theme","Its genre","Its setting"], answer: 1, explanation: "The theme is the underlying message."}, {rank: 2, prompt: "How is a story's theme different from its subject?", choices: ["The subject is what it's about, the theme is what it says about that","They are the same thing","The theme is the setting","The subject is always a lesson"], answer: 0, explanation: "A story about war, its subject, might say war wastes lives, its theme."}, {rank: 3, prompt: "You want a story whose theme is that honesty matters even when it costs you. Which plot shows it?", choices: ["A family moves to a new city and makes friends","A girl wins a race after months of training","A boy lies about a vase and is never found out","A girl admits she broke a vase, is punished, and later earns her family's trust"], answer: 3, explanation: "The theme comes through a character paying a price for honesty and being shown right."}]},
  {id: "082f16c5-2496-46d0-a5b1-131acfb0dec6", name: "Narrative Point of View", order: 55, questions: [{rank: 1, prompt: "What is a narrator who knows every character's thoughts called?", choices: ["First person","Unreliable","Limited","Omniscient"], answer: 3, explanation: "An omniscient narrator knows everything."}, {rank: 2, prompt: "Why might an author pick a first-person narrator?", choices: ["To show every character's thoughts","To keep the narrator outside the story","To put the reader inside one character's thoughts and feelings","To make the story longer"], answer: 2, explanation: "First person gives a personal, though limited, view."}, {rank: 3, prompt: "You want readers to know what every character is thinking. Which point of view should you write in?", choices: ["Second person","First person","Third person limited","Third person omniscient"], answer: 3, explanation: "An omniscient narrator sees into every character's mind. The others are limited to one."}]},
  {id: "e64c5d9c-bcc3-44fa-9e04-da13d7709d6c", name: "Literary Analysis", order: 56, questions: [{rank: 1, prompt: "What is a hint about what will happen later in a story called?", choices: ["Foreshadowing","Flashback","Irony","Theme"], answer: 0, explanation: "Foreshadowing gives clues to later events."}, {rank: 2, prompt: "Why should an analysis of a novel quote from the text?", choices: ["Quotes make the essay longer","Analysis must avoid the writer's own ideas","Quotes summarize the plot","Quotes are evidence that supports the reader's interpretation"], answer: 3, explanation: "Claims about a text are backed with its own words."}, {rank: 3, prompt: "You're arguing in an essay that a novel's hero is a coward. What best supports the claim?", choices: ["A summary of the whole plot","A quote showing him fleeing while his friends fight","Where the author was born","Your sense that he seems weak"], answer: 1, explanation: "An argument about a text is supported by evidence quoted from it."}]},
  {id: "13a491c7-f244-4913-a5f8-e142cf6f3c8d", name: "Shakespeare", order: 57, questions: [{rank: 1, prompt: "Which play includes the line \"To be, or not to be\"?", choices: ["Macbeth","Hamlet","Othello","King Lear"], answer: 1, explanation: "Prince Hamlet speaks the line while weighing life and death."}, {rank: 2, prompt: "Why are many of Shakespeare's plays still performed today?", choices: ["They are short and simple","They are required by law","They were written in modern English","Their themes of love, power and jealousy still speak to people"], answer: 3, explanation: "His plays deal with lasting human experiences."}, {rank: 3, prompt: "You're giving a speech about being unable to make a hard decision. Which Shakespeare line fits?", choices: ["\"To be, or not to be\"","\"Romeo, Romeo, wherefore art thou Romeo?\"","\"All the world's a stage\"","\"Friends, Romans, countrymen, lend me your ears\""], answer: 0, explanation: "Hamlet speaks these words while torn over whether to act."}]},
  {id: "883304fb-16d8-415c-99f6-df39ce10d435", name: "The Novel", order: 58, questions: [{rank: 1, prompt: "Who wrote the novel Pride and Prejudice?", choices: ["Charlotte Bronte","Charles Dickens","Jane Austen","Mary Shelley"], answer: 2, explanation: "Jane Austen published it in 1813."}, {rank: 2, prompt: "How does a novel differ from a short story?", choices: ["It's long enough to develop many characters and subplots","It's always true","It's written in verse","It has no plot"], answer: 0, explanation: "A novel's length allows complex plots and character development."}, {rank: 3, prompt: "You want to tell a long story with many characters and subplots, following a family over 30 years. Which form suits it?", choices: ["A short story","A novel","A fable","A sonnet"], answer: 1, explanation: "A novel's length gives room for many characters, subplots and a long span of time."}]},
  {id: "aa7fc55b-398e-4da0-9eb1-e24e7d6d5ad0", name: "Tragedy", order: 59, questions: [{rank: 1, prompt: "What is the release of pity and fear an audience feels at the end of a tragedy called?", choices: ["Hubris","Irony","Exposition","Catharsis"], answer: 3, explanation: "Aristotle called this emotional release catharsis."}, {rank: 2, prompt: "What makes the hero's downfall in a tragedy feel inevitable rather than random?", choices: ["It's caused by bad luck alone","It grows out of the hero's own character and choices","The hero chooses to fail on purpose","The audience decides the ending"], answer: 1, explanation: "Because the hero's ruin follows from who they are, it seems bound to happen."}, {rank: 3, prompt: "You're writing a tragedy. How should your hero's story end?", choices: ["In a random accident unrelated to anything they did","In a downfall brought on by the hero's own flaw","With a wedding and a happy reunion","With the villain punished and the hero rewarded"], answer: 1, explanation: "A tragic hero falls because of a flaw in themselves."}]},
  {id: "6fa13eb5-b4cc-4cda-852a-4b35943644e9", name: "Living Things", order: 60, questions: [{rank: 1, prompt: "Which of these is a living thing?", choices: ["A cloud","A mushroom","A river","A crystal"], answer: 1, explanation: "A mushroom is a fungus, made of living cells."}, {rank: 2, prompt: "A fire grows, spreads and uses oxygen, yet it isn't alive. What's the clearest reason?", choices: ["It's too hot","It doesn't move","It isn't made of cells and can't reproduce itself","It has no color"], answer: 2, explanation: "Living things are made of cells and reproduce, which fire does not."}, {rank: 3, prompt: "You find a small gray lump on a beach and want to know if it's alive. What should you check?", choices: ["Whether it's warm","Whether it moves when waves push it","Whether it feeds, grows and responds when touched","Whether it's soft"], answer: 2, explanation: "Living things feed, grow and respond to their surroundings. Being moved by water doesn't count."}]},
  {id: "211a4bba-1b9e-4767-b05c-bbe4c24d0c43", name: "Plants", order: 61, questions: [{rank: 1, prompt: "Which part of a flower makes pollen?", choices: ["The petal","The stamen","The sepal","The root"], answer: 1, explanation: "The stamen is the flower's pollen-making part."}, {rank: 2, prompt: "Why do plants need sunlight to grow?", choices: ["It keeps them warm only","They use its energy to make their own food","It helps them absorb soil directly","They don't, only water matters"], answer: 1, explanation: "Plants capture light energy to build sugars."}, {rank: 3, prompt: "A houseplant's lower leaves turn yellow and its soil stays soggy for days. What's the most likely fix?", choices: ["Water it less, since its roots are drowning","Water it more","Move it into total darkness","Cut off all its leaves"], answer: 0, explanation: "Waterlogged soil starves roots of air, and the plant can't take up nutrients."}]},
  {id: "8757b1d8-4e67-43d2-b633-3244fbdb1e12", name: "Animal Classification", order: 62, questions: [{rank: 1, prompt: "What is an animal with no backbone called?", choices: ["A vertebrate","A mammal","A reptile","An invertebrate"], answer: 3, explanation: "Invertebrates, such as insects and worms, lack a backbone."}, {rank: 2, prompt: "Why is a whale classified as a mammal rather than a fish?", choices: ["It lives in water","It is very large","It has fins","It breathes air and feeds its young on milk"], answer: 3, explanation: "Mammals breathe air with lungs and nurse their young, whatever their shape or habitat."}, {rank: 3, prompt: "A zoo is getting a newly found amphibian. What must its enclosure have?", choices: ["Water or damp ground, since amphibians' skin must stay moist","Only dry sand and a heat lamp","A perch high off the ground","Nothing special, as for a mammal"], answer: 0, explanation: "Amphibians breathe partly through their skin, which must stay moist."}]},
  {id: "2ad998ab-1f08-49ad-966f-1b48ac210f8a", name: "Life Cycles", order: 63, questions: [{rank: 1, prompt: "What stage comes between the caterpillar and the adult butterfly?", choices: ["The pupa, or chrysalis","The egg","The larva","The nymph"], answer: 0, explanation: "The caterpillar forms a chrysalis, in which it changes into a butterfly."}, {rank: 2, prompt: "Why does a caterpillar look so different from the butterfly it becomes?", choices: ["It goes through metamorphosis, a complete change of body form","It is a different species","It eats different food","Butterflies lay caterpillar-shaped eggs"], answer: 0, explanation: "Metamorphosis transforms the larva into an adult with a new body plan."}, {rank: 3, prompt: "You're raising caterpillars in a jar and want them to become butterflies. What must you give them?", choices: ["Sugar water and nothing else","Fresh leaves to eat and a twig to hang a chrysalis from","A sealed jar with no air holes","Water only"], answer: 1, explanation: "Caterpillars eat until they form a chrysalis, which hangs from a support while it changes."}]},
  {id: "ac586c13-4c0b-4c61-9827-b31bc62856e9", name: "Food Chains", order: 64, questions: [{rank: 1, prompt: "What is an animal that eats only plants called?", choices: ["A carnivore","A herbivore","An omnivore","A decomposer"], answer: 1, explanation: "Herbivores feed on plants."}, {rank: 2, prompt: "Why do food chains almost always begin with a plant?", choices: ["Plants are the largest living things","Plants make their own food from sunlight, so they're the source of energy for the rest","Animals can't eat each other","Plants are found everywhere"], answer: 1, explanation: "Producers capture energy that then passes up the chain."}, {rank: 3, prompt: "Farmers kill off the foxes in an area, and rabbits multiply and eat the crops. What would bring the rabbits back under control?", choices: ["Planting more crops for the rabbits","Letting the foxes return","Killing off the hawks as well","Watering the fields more"], answer: 1, explanation: "Foxes are the rabbits' predators, so they keep the rabbit numbers down."}]},
  {id: "0bb4df7e-39fb-4f5a-b609-c70e10ff0317", name: "Human Body", order: 65, questions: [{rank: 1, prompt: "Which organ pumps blood around the body?", choices: ["The lungs","The heart","The liver","The kidneys"], answer: 1, explanation: "The heart pumps blood through the blood vessels."}, {rank: 2, prompt: "Why do bones and muscles have to work together for you to move?", choices: ["Bones contract on their own","Muscles pull on bones to move them at the joints","Muscles hold the body upright without bones","They work separately"], answer: 1, explanation: "Muscles contract and pull bones, which pivot at joints."}, {rank: 3, prompt: "A friend is about to lift a heavy box off the floor. How should they lift it to protect their back?", choices: ["Jerk it up quickly with the arms","Bend the knees and lift with the legs, back straight","Bend at the waist with straight legs","Twist to the side while lifting"], answer: 1, explanation: "The big leg muscles should do the work, so the spine isn't strained."}]},
  {id: "f29c67f7-7158-4e14-91d7-a16132e217f4", name: "Cell Biology", order: 66, questions: [{rank: 1, prompt: "Which part of a cell holds its genetic material?", choices: ["The cell membrane","The nucleus","The cytoplasm","The ribosome"], answer: 1, explanation: "The nucleus contains the cell's DNA."}, {rank: 2, prompt: "Why does a muscle cell contain far more mitochondria than a skin cell?", choices: ["Mitochondria make cells stronger","Skin cells have no energy needs","Muscles need lots of energy, which mitochondria release","Mitochondria store water"], answer: 2, explanation: "Mitochondria release energy from food, and muscles use a lot of it."}, {rank: 3, prompt: "You want to know whether pond scum is made of plant cells. What should you look for under the microscope?", choices: ["Cell walls and green chloroplasts","A cell membrane","Mitochondria","A nucleus"], answer: 0, explanation: "Animal cells also have a nucleus, membrane and mitochondria. Cell walls and chloroplasts mark plant cells."}]},
  {id: "ffcd65b7-a84c-4ede-ae08-ebe47473496b", name: "Photosynthesis", order: 67, questions: [{rank: 1, prompt: "What green pigment in leaves captures light for photosynthesis?", choices: ["Chlorophyll","Hemoglobin","Melanin","Keratin"], answer: 0, explanation: "Chlorophyll absorbs light and gives leaves their green color."}, {rank: 2, prompt: "A plant left in the dark for days stops making food even though it has water and air. What does that show about light?", choices: ["Light supplies the energy the process needs","Light provides the carbon for the food","Light is a raw material made of sugar","Light only warms the leaves"], answer: 0, explanation: "Photosynthesis is powered by light energy."}, {rank: 3, prompt: "You're growing tomatoes in a greenhouse in winter. Which change would most increase the food the plants make?", choices: ["Keeping them dark for longer at night","Removing carbon dioxide from the air","Adding grow lights for more hours of light","Covering the leaves to keep them warm"], answer: 2, explanation: "In winter, short days limit photosynthesis, so more light means more food."}]},
  {id: "acca10c5-4185-4e85-b139-b8b5cf2b355b", name: "Human Digestive System", order: 68, questions: [{rank: 1, prompt: "Which organ produces bile?", choices: ["The gallbladder","The pancreas","The stomach","The liver"], answer: 3, explanation: "The liver makes bile, and the gallbladder stores it."}, {rank: 2, prompt: "Why is the small intestine so long and lined with tiny finger-like folds?", choices: ["They help it squeeze food back up","They store waste","They produce stomach acid","They give it a huge surface area for absorbing food"], answer: 3, explanation: "More surface area means more nutrients absorbed into the blood."}, {rank: 3, prompt: "Someone often gets heartburn after big late dinners. What's the most sensible change?", choices: ["Drink a lot of soda with meals","Eat smaller meals, and don't lie down right after eating","Eat one large meal just before bed","Lie down straight after eating to settle the stomach"], answer: 1, explanation: "A full stomach and lying flat let acid push up into the esophagus."}]},
  {id: "47099487-186b-4707-b011-c5f6fffcda9e", name: "Circulatory System", order: 69, questions: [{rank: 1, prompt: "What are the tiniest blood vessels, where oxygen passes into the body's tissues, called?", choices: ["Capillaries","Arteries","Veins","Ventricles"], answer: 0, explanation: "Capillary walls are thin enough for oxygen to pass through."}, {rank: 2, prompt: "Why do arteries have thicker, more muscular walls than veins?", choices: ["They carry more blood","They carry blood to the lungs only","They are closer to the skin","They carry blood away from the heart at higher pressure"], answer: 3, explanation: "Blood leaves the heart under high pressure, which thick walls withstand."}, {rank: 3, prompt: "Someone collapses, isn't breathing and has no pulse. What should you do while help is on the way?", choices: ["Start chest compressions to keep blood moving","Splash them with cold water","Raise their legs and wait","Give them a glass of water"], answer: 0, explanation: "Compressions pump blood to the brain and heart until the heart can be restarted."}]},
  {id: "4d9608c2-56f1-4c13-b1be-8f03f13a4904", name: "Respiratory System", order: 70, questions: [{rank: 1, prompt: "Which muscle beneath the lungs contracts to draw air in?", choices: ["The heart","The biceps","The stomach","The diaphragm"], answer: 3, explanation: "The diaphragm flattens as it contracts, pulling air into the lungs."}, {rank: 2, prompt: "Why are the lungs' air sacs surrounded by tiny blood vessels?", choices: ["To keep the lungs warm","So gases can pass between air and blood","To stop air reaching the blood","To pump air in and out"], answer: 1, explanation: "Oxygen moves into the blood and carbon dioxide out across these thin walls."}, {rank: 3, prompt: "You're planning to climb a 5,000-meter mountain. How should you go up to avoid altitude sickness?", choices: ["Breathe slowly and shallowly","Hold your breath on the steepest parts","Climb as fast as you can to limit time up high","Climb slowly over several days so the body can adjust"], answer: 3, explanation: "Over days, the body makes more red blood cells and adapts to thinner air."}]},
  {id: "38b76f23-e059-433a-8564-6522235e9ca6", name: "Ecosystems", order: 71, questions: [{rank: 1, prompt: "What is the role of decomposers, such as fungi, in an ecosystem?", choices: ["They make food from sunlight","They break down dead matter and return nutrients to the soil","They hunt other animals","They pollinate flowers"], answer: 1, explanation: "Decomposers recycle nutrients from dead organisms."}, {rank: 2, prompt: "Why does removing one species often affect many others in an ecosystem?", choices: ["Every species eats every other","Species are linked through what eats what and other relationships","Ecosystems contain only one species","Species never interact"], answer: 1, explanation: "Living things depend on each other, so a change ripples outward."}, {rank: 3, prompt: "A pond is choked with algae after fertilizer washed in from nearby fields. What would fix it best in the long run?", choices: ["Remove all the fish","Cover the pond with a tarp","Stop the runoff, for example with a strip of plants along the bank","Add more fertilizer to feed the fish"], answer: 2, explanation: "The fertilizer feeds the algae, so cutting it off at the source lets the pond recover."}]},
  {id: "57abde01-95e9-43cf-9bdb-1ac2f59ec62c", name: "Microorganisms", order: 72, questions: [{rank: 1, prompt: "Which of these illnesses is caused by a virus?", choices: ["Strep throat","The flu","Athlete's foot","Food poisoning from salmonella"], answer: 1, explanation: "Influenza is a virus, while the others are caused by bacteria or a fungus."}, {rank: 2, prompt: "Why is yeast added to bread dough?", choices: ["It gives off gas as it feeds, making the dough rise","It adds color","It makes the bread heavier","It kills bacteria in the flour"], answer: 0, explanation: "Yeast ferments sugars, releasing carbon dioxide that puffs up the dough."}, {rank: 3, prompt: "You want cooked rice to keep safely until tomorrow. What should you do?", choices: ["Keep it warm in the pot","Leave it by a sunny window","Leave it covered on the counter overnight","Cool it quickly and put it in the fridge"], answer: 3, explanation: "Bacteria multiply fast at room temperature and slowly in the cold."}]},
  {id: "4e86acca-12ef-4e0f-9562-eec83dba72af", name: "Cellular Respiration", order: 73, questions: [{rank: 1, prompt: "What gas do cells give off as waste during cellular respiration?", choices: ["Carbon dioxide","Oxygen","Nitrogen","Helium"], answer: 0, explanation: "Breaking down sugar for energy releases carbon dioxide."}, {rank: 2, prompt: "How is cellular respiration related to breathing?", choices: ["They are the same thing","Breathing brings in the oxygen cells use to release energy from food","Breathing happens inside each cell","Cellular respiration only happens in the lungs"], answer: 1, explanation: "Breathing supplies oxygen, and cells use it to break down sugar for energy."}, {rank: 3, prompt: "You're running a long race and don't want your muscles to run short of oxygen. How should you pace it?", choices: ["At a steady pace where you can still breathe comfortably","Hold your breath going up hills","Alternate all-out sprints the whole way","Sprint all out from the start"], answer: 0, explanation: "At a steady pace, muscles get enough oxygen to release energy without building up waste."}]},
  {id: "bab96458-3e7e-4928-93c3-41b1d9c0c3d9", name: "Cell Division", order: 74, questions: [{rank: 1, prompt: "How many cells does one round of mitosis produce from one cell?", choices: ["4","1","8","2"], answer: 3, explanation: "Mitosis splits one cell into two identical cells."}, {rank: 2, prompt: "Why do sperm and egg cells carry only half the usual number of chromosomes?", choices: ["So the fertilized egg ends up with the normal full number","To make them lighter","Because they're damaged","So they divide faster"], answer: 0, explanation: "When sperm and egg join, their halves combine into a complete set."}, {rank: 3, prompt: "A gardener wants new plants identical to a prize rose. What should they do?", choices: ["Take cuttings, which grow by mitosis","Cross it with another rose","Pollinate it by hand","Plant its seeds"], answer: 0, explanation: "Mitosis makes identical copies of cells. Seeds come from sexual reproduction and vary."}]},
  {id: "cecac886-b6b7-4290-a333-506270b7d5c9", name: "DNA", order: 75, questions: [{rank: 1, prompt: "What is the shape of a DNA molecule?", choices: ["A double helix","A single straight line","A sphere","A triangle"], answer: 0, explanation: "DNA is two strands twisted into a double helix."}, {rank: 2, prompt: "Why do children look partly like each parent?", choices: ["They inherit DNA from both parents","They copy their parents' habits","DNA comes only from the mother","Looks are random"], answer: 0, explanation: "Each parent passes on half of their child's DNA."}, {rank: 3, prompt: "Police find a hair at a crime scene. What should they compare it with to learn who left it?", choices: ["Suspects' hair color","DNA from suspects' cheek swabs","Suspects' shoe sizes","Suspects' fingerprints"], answer: 1, explanation: "A DNA profile from the hair can be matched against each suspect's DNA."}]},
  {id: "6f1f8ab6-3f9a-4718-b962-eb74a58b8647", name: "Genetics", order: 76, questions: [{rank: 1, prompt: "What is a gene that shows its effect even with only one copy called?", choices: ["Recessive","Dominant","Mutant","Hybrid"], answer: 1, explanation: "A dominant gene's trait appears when just one copy is present."}, {rank: 2, prompt: "Why can two brown-eyed parents have a blue-eyed child?", choices: ["Both can carry a hidden recessive gene for blue eyes","Eye color is never inherited","Blue eyes are always dominant","The child's eyes changed after birth"], answer: 0, explanation: "Recessive genes can be passed on without showing."}, {rank: 3, prompt: "Two parents each carry one copy of a recessive gene for a condition but don't have it. What's the chance their child has the condition?", choices: ["1 in 2","1 in 4","0","1 in 1"], answer: 1, explanation: "The child must inherit the recessive copy from both, a one in four chance."}]},
  {id: "2318f39f-fdb8-4f9c-bdce-e9ca45dedbe9", name: "Evolution", order: 77, questions: [{rank: 1, prompt: "Who proposed the theory of evolution by natural selection?", choices: ["Isaac Newton","Gregor Mendel","Charles Darwin","Louis Pasteur"], answer: 2, explanation: "Darwin published On the Origin of Species in 1859."}, {rank: 2, prompt: "Why did giraffes come to have long necks, according to evolution?", choices: ["Each giraffe stretched its neck and passed that on","Giraffes chose to grow longer necks","Long necks appeared all at once","Those born with longer necks reached more food and had more offspring"], answer: 3, explanation: "Natural selection keeps variations that help survival and reproduction."}, {rank: 3, prompt: "Your doctor prescribes a course of antibiotics. What should you do to keep bacteria from becoming resistant?", choices: ["Save some pills for next time","Take double doses to finish sooner","Take every dose until the course is finished","Stop as soon as you feel better"], answer: 2, explanation: "Stopping early lets the toughest bacteria survive and pass on their resistance."}]},
  {id: "f5fbf6dd-6e84-44f1-9b54-712dbfd31edc", name: "Nervous System", order: 78, questions: [{rank: 1, prompt: "Which organ is the control center of the nervous system?", choices: ["The heart","The brain","The stomach","The liver"], answer: 1, explanation: "The brain processes information and sends commands."}, {rank: 2, prompt: "How do nerves carry messages around the body?", choices: ["As blood","As sound waves","As air pressure","As electrical signals passed along nerve cells"], answer: 3, explanation: "Neurons pass electrical impulses to one another."}, {rank: 3, prompt: "Someone has fallen from a height and has neck pain and tingling in their hands. What should you do?", choices: ["Sit them up quickly","Help them get up and walk it off","Massage their neck","Keep them still and call for help, in case the spinal cord is hurt"], answer: 3, explanation: "Tingling can mean a spinal injury, and moving them can make it worse."}]},
  {id: "c0d028ac-86c3-4ff2-b35d-819100c9c1ab", name: "Immune System", order: 79, questions: [{rank: 1, prompt: "Which blood cells fight infection?", choices: ["White blood cells","Red blood cells","Platelets","Plasma"], answer: 0, explanation: "White blood cells defend the body against germs."}, {rank: 2, prompt: "How does a vaccine protect you?", choices: ["It kills all germs in your body","It cures a disease you already have","It replaces your blood","It trains your immune system to recognize a germ without causing the disease"], answer: 3, explanation: "A vaccine shows the body a harmless version so it's ready for the real thing."}, {rank: 3, prompt: "You're traveling somewhere with yellow fever. What should you do before you go?", choices: ["Avoid tap water there","Take antibiotics when you arrive","Get vaccinated well before the trip","Nothing, your body will adapt"], answer: 2, explanation: "A vaccine lets the immune system build defenses before you meet the virus."}]},
  {id: "df1238db-a6dd-45be-a115-9f286792f37c", name: "Enzymes", order: 80, questions: [{rank: 1, prompt: "What do enzymes do to chemical reactions in the body?", choices: ["Stop them","Reverse them","Slow them down","Speed them up"], answer: 3, explanation: "Enzymes are catalysts that speed up reactions."}, {rank: 2, prompt: "Why does each enzyme work on only one particular kind of molecule?", choices: ["It's too small for others","Enzymes are used up after one use","Its shape fits only certain molecules","All enzymes are identical"], answer: 2, explanation: "An enzyme's active site matches a specific molecule, like a lock and key."}, {rank: 3, prompt: "A stain from egg won't wash out of a shirt. Which wash should you use?", choices: ["Biological detergent in boiling water","Biological detergent in warm water","Non-biological detergent in very hot water","Plain water at a boil"], answer: 1, explanation: "Enzymes in biological detergent break down the egg's protein, and too much heat stops them working."}]},
  {id: "dbd4a04a-6205-43a2-b083-0bb223200dfd", name: "States of Matter", order: 81, questions: [{rank: 1, prompt: "At what temperature does pure water freeze, in degrees Celsius?", choices: ["0","100","32","-10"], answer: 0, explanation: "Pure water freezes at 0 degrees Celsius."}, {rank: 2, prompt: "Why does a gas fill its whole container while a solid keeps its shape?", choices: ["Gas particles are larger","Gas particles move freely, while a solid's are held in place","Solids have no particles","Gases are heavier"], answer: 1, explanation: "In a solid, particles vibrate in fixed positions, while gas particles spread out."}, {rank: 3, prompt: "You want wet laundry to dry fast on a cold day. Where should you hang it?", choices: ["In a sealed plastic bag","Somewhere warm and breezy, spread out","Folded in a pile in a warm room","In a closed, damp room"], answer: 1, explanation: "Warmth, moving air and a large surface all speed up evaporation."}]},
  {id: "ec353a58-c4d0-407c-ab0f-00701badced8", name: "Mixtures", order: 82, questions: [{rank: 1, prompt: "What is a mixture where one substance dissolves evenly into another called?", choices: ["A suspension","An element","A solution","A compound"], answer: 2, explanation: "When something dissolves completely, as sugar in water, it forms a solution."}, {rank: 2, prompt: "Why is salt water a mixture rather than a compound?", choices: ["It has a fixed formula","It's a single element","The salt and water aren't chemically bonded and can be separated physically","It can't be separated at all"], answer: 2, explanation: "A mixture's parts keep their own properties and can be separated by physical means."}, {rank: 3, prompt: "Which method would separate sand from salt water?", choices: ["Magnet","Filtering","Boiling it first","Freezing"], answer: 1, explanation: "The sand is caught by the filter while the dissolved salt passes through."}]},
  {id: "ffe06199-f536-4839-a77b-9533b286ccf7", name: "Atoms", order: 83, questions: [{rank: 1, prompt: "Where in an atom are its protons and neutrons found?", choices: ["In the outer shells","Spread evenly through the atom","In the nucleus","Outside the atom"], answer: 2, explanation: "Protons and neutrons sit together in the dense center of the atom."}, {rank: 2, prompt: "Why is an atom electrically neutral overall?", choices: ["Neutrons cancel out all charge","It has no particles with charge","Electrons are positive","It has equal numbers of positive protons and negative electrons"], answer: 3, explanation: "Equal positive and negative charges balance out."}, {rank: 3, prompt: "An atom has 6 protons and 6 neutrons. What is its mass number?", choices: ["6","12","18","3"], answer: 1, explanation: "Mass number is protons plus neutrons."}]},
  {id: "87840a10-3111-41b9-b5b8-611e7989b302", name: "Chemical Elements", order: 84, questions: [{rank: 1, prompt: "What is the chemical symbol for oxygen?", choices: ["Ox","Om","O","Og"], answer: 2, explanation: "Oxygen's symbol is O."}, {rank: 2, prompt: "Why can't an element be broken down into simpler substances by chemical reactions?", choices: ["It's made of only one kind of atom","It's too heavy","It's always a gas","It has no atoms"], answer: 0, explanation: "An element is the simplest form of a substance, made of one type of atom."}, {rank: 3, prompt: "You need a metal for household wiring that conducts electricity well and isn't too expensive. Which should you use?", choices: ["Mercury","Iron","Lead","Copper"], answer: 3, explanation: "Copper is one of the best conductors and is affordable, which is why it's used in wiring."}]},
  {id: "d665d37c-f5cb-420b-ba28-06444da30052", name: "Periodic Table", order: 85, questions: [{rank: 1, prompt: "Who is credited with creating the periodic table?", choices: ["Marie Curie","Dmitri Mendeleev","Albert Einstein","John Dalton"], answer: 1, explanation: "Mendeleev arranged the elements by their properties in 1869."}, {rank: 2, prompt: "Why are elements in the same column of the periodic table alike?", choices: ["They have the same number of outer electrons","They have the same mass","They were discovered together","They are all gases"], answer: 0, explanation: "Outer electrons determine how elements react."}, {rank: 3, prompt: "You need a gas for party balloons that won't burn or react. Which group of the periodic table should you choose from?", choices: ["The alkali metals, such as sodium","The transition metals, such as iron","The noble gases, such as helium","The halogens, such as chlorine"], answer: 2, explanation: "Noble gases have full outer shells, so they don't react."}]},
  {id: "23d2d9c2-007e-47d4-b001-e2718a0ed180", name: "Chemical Compounds", order: 86, questions: [{rank: 1, prompt: "What is the chemical formula for water?", choices: ["CO2","O2","NaCl","H2O"], answer: 3, explanation: "Water is two hydrogen atoms bonded to one oxygen atom."}, {rank: 2, prompt: "How is a compound different from a mixture?", choices: ["It can be separated by filtering","Its elements are chemically bonded in fixed proportions","It contains only one element","Its parts keep their own properties"], answer: 1, explanation: "A compound's elements are joined chemically in a set ratio."}, {rank: 3, prompt: "A compound has one carbon atom and two oxygen atoms. How do you write its formula?", choices: ["CO2","C2O","CO","C2O2"], answer: 0, explanation: "Each element is written by its symbol, with a small number for how many atoms, left out when it's one."}]},
  {id: "dcc470b3-3fba-4fe2-9012-763f1b6285e5", name: "Chemical Reactions", order: 87, questions: [{rank: 1, prompt: "Which of these is a sign that a chemical reaction has happened?", choices: ["A gas is given off","The substance is cut in half","It is poured into a new glass","It is moved to another room"], answer: 0, explanation: "Bubbles, color changes and heat often signal a reaction."}, {rank: 2, prompt: "Why is burning wood a chemical change, but melting ice a physical one?", choices: ["Burning is hotter","Melting can't be reversed","Burning makes new substances, while melting only changes the state","They are both physical changes"], answer: 2, explanation: "A chemical change forms new substances."}, {rank: 3, prompt: "You want to keep an iron gate from rusting. What should you do?", choices: ["Paint it to keep air and water off the metal","Leave it bare so it can breathe","Hose it down regularly","Rub salt into it"], answer: 0, explanation: "Rust is iron reacting with oxygen and water, so a coating stops the reaction."}]},
  {id: "c3f9e742-5b51-4bef-ad53-8a65d6ac41bd", name: "Acids and Bases", order: 88, questions: [{rank: 1, prompt: "On the pH scale, what number is neutral?", choices: ["0","14","1","7"], answer: 3, explanation: "Pure water has a pH of 7, neither acidic nor basic."}, {rank: 2, prompt: "Why does mixing an acid and a base reduce how strong each one is?", choices: ["They both evaporate","The acid absorbs the base completely","They don't react","They neutralize each other to form water and a salt"], answer: 3, explanation: "Neutralization cancels out their acidic and basic properties."}, {rank: 3, prompt: "A bee sting is mildly acidic. Which household substance might ease it?", choices: ["Vinegar, an acid","Lemon juice","Baking soda, a mild base","Salt water"], answer: 2, explanation: "A base neutralizes an acid."}]},
  {id: "258322f9-1e40-472f-8307-ce6a1f1ae42d", name: "Chemical Bonding", order: 89, questions: [{rank: 1, prompt: "What kind of bond holds the atoms of a metal like copper together?", choices: ["An ionic bond","A metallic bond","A covalent bond","A hydrogen bond"], answer: 1, explanation: "Metal atoms are held together by metallic bonds, in a shared sea of electrons."}, {rank: 2, prompt: "Why does table salt form when sodium gives an electron to chlorine?", choices: ["They share electrons equally","The resulting opposite charges attract and hold them together","Chlorine loses its nucleus","They repel each other"], answer: 1, explanation: "Electron transfer creates charged ions, which attract."}, {rank: 3, prompt: "You're making a circuit with two wires in a cup of pure water, and want a bulb to light. What should you dissolve in the water?", choices: ["Nothing, pure water conducts well","Cooking oil","Sugar","Table salt"], answer: 3, explanation: "Salt is ionic, and its ions carry current once dissolved. Sugar's molecules don't."}]},
  {id: "7f2afc26-396f-43a8-8731-9db180cd874d", name: "Chemical Equations", order: 90, questions: [{rank: 1, prompt: "In a chemical equation, what are the starting substances called?", choices: ["Products","Reactants","Catalysts","Solutions"], answer: 1, explanation: "Reactants are written on the left and change into products."}, {rank: 2, prompt: "Why must a chemical equation be balanced?", choices: ["To make it look neat","Because reactions add atoms","Balancing changes the substances","Atoms are neither created nor destroyed in a reaction"], answer: 3, explanation: "Mass is conserved, so the same atoms appear on both sides."}, {rank: 3, prompt: "Balance this: H2 + O2 makes H2O. Which version is balanced?", choices: ["H2 + O2 makes H2O","2H2 + O2 makes 2H2O","H2 + 2O2 makes H2O","2H2 + 2O2 makes H2O"], answer: 1, explanation: "Both sides then have 4 hydrogen and 2 oxygen atoms."}]},
  {id: "d9867ac8-f269-4ab7-b8e7-913e8662c951", name: "The Mole", order: 91, questions: [{rank: 1, prompt: "About how many particles are in one mole?", choices: ["100","1,000","3.14","6.02 x 10 to the 23rd"], answer: 3, explanation: "One mole holds Avogadro's number of particles."}, {rank: 2, prompt: "Why do chemists count particles in moles?", choices: ["Atoms are so tiny that a convenient large number is needed","Moles are heavier than atoms","It avoids using numbers","Every substance has the same mass per mole"], answer: 0, explanation: "A mole groups a huge fixed number of particles into a usable amount."}, {rank: 3, prompt: "Carbon has a molar mass of 12 grams per mole. How many moles are in 36 grams of carbon?", choices: ["12","3","36","432"], answer: 1, explanation: "36 grams divided by 12 grams per mole is 3 moles."}]},
  {id: "2d60f57f-48c9-4e68-955d-96c8af3a8107", name: "Stoichiometry", order: 92, questions: [{rank: 1, prompt: "What do the numbers in front of formulas in a balanced equation, like the 2 in 2H2O, give?", choices: ["The atoms' sizes","The temperature","The time the reaction takes","The ratio of amounts that react and form"], answer: 3, explanation: "Coefficients show the proportions in which substances react."}, {rank: 2, prompt: "What is the limiting reactant in a reaction?", choices: ["The one that's most expensive","The one added last","The one there is the most of","The one that runs out first and so stops the reaction"], answer: 3, explanation: "Once one reactant is used up, no more product can form."}, {rank: 3, prompt: "2H2 + O2 makes 2H2O. How many moles of water can 4 moles of hydrogen make, with plenty of oxygen?", choices: ["4","2","8","1"], answer: 0, explanation: "Hydrogen and water are in a 2 to 2 ratio, so 4 moles give 4."}]},
  {id: "149c1cf0-aff5-49c4-a1cf-82a7d795566e", name: "Reaction Rates", order: 93, questions: [{rank: 1, prompt: "What is a substance that speeds up a reaction without being used up called?", choices: ["A reactant","A product","A catalyst","A solvent"], answer: 2, explanation: "Catalysts speed reactions and remain unchanged."}, {rank: 2, prompt: "Why does food spoil more slowly in a fridge?", choices: ["Lower temperature slows the reactions that spoil it","Cold kills all bacteria instantly","Fridges remove oxygen","Light speeds spoiling"], answer: 0, explanation: "Reactions, including those of bacteria, slow down in the cold."}, {rank: 3, prompt: "You want a fizzy tablet to dissolve as fast as possible. What should you do?", choices: ["Drop it whole into cold water","Drop it whole into ice water","Crush it and drop it into warm water","Wrap it in paper first"], answer: 2, explanation: "More surface area and a higher temperature both speed up a reaction."}]},
  {id: "aa976044-86d0-4f0f-8d5a-1eb15f6ae03d", name: "Redox Reactions", order: 94, questions: [{rank: 1, prompt: "What is the everyday name for the oxidation of iron?", choices: ["Melting","Rusting","Dissolving","Tarnishing gold"], answer: 1, explanation: "Iron combining with oxygen and water is rusting."}, {rank: 2, prompt: "In a redox reaction, why do oxidation and reduction always happen together?", choices: ["They are the same thing","One always cancels the other out","Reduction only happens in water","Electrons lost by one substance are gained by another"], answer: 3, explanation: "Electrons are transferred, so one loses and one gains."}, {rank: 3, prompt: "You've cut apple slices for a lunch box and don't want them to brown. What should you do?", choices: ["Leave them uncovered","Coat them in lemon juice","Cut them thinner","Warm them in the oven"], answer: 1, explanation: "Lemon juice's vitamin C reacts with oxygen first, slowing the apple's oxidation."}]},
  {id: "20e42796-3394-4da0-84fb-4edb0c6e07e5", name: "Organic Chemistry", order: 95, questions: [{rank: 1, prompt: "Which element is at the center of organic chemistry?", choices: ["Oxygen","Carbon","Nitrogen","Iron"], answer: 1, explanation: "Organic chemistry is the chemistry of carbon compounds."}, {rank: 2, prompt: "Why does organic chemistry include millions of different compounds?", choices: ["Its central element forms four bonds and builds long chains and rings","Its compounds are all very heavy","Its atoms never bond with each other","Its compounds are all metals"], answer: 0, explanation: "An atom that forms four bonds and links to itself can build huge, varied structures."}, {rank: 3, prompt: "You're naming a hydrocarbon with three carbon atoms joined by single bonds. What is it called?", choices: ["Propane","Butane","Methane","Propene"], answer: 0, explanation: "Prop- means three carbons, and -ane means only single bonds."}]},
  {id: "6caf678d-325a-4177-8287-081051a5bb5f", name: "Forces", order: 96, questions: [{rank: 1, prompt: "What is the unit of force?", choices: ["The joule","The watt","The meter","The newton"], answer: 3, explanation: "Force is measured in newtons."}, {rank: 2, prompt: "Why does a hockey puck slide much farther on ice than on carpet?", choices: ["Ice gives much less friction to slow it down","Ice pushes the puck forward","The puck is lighter on ice","Carpet has more gravity"], answer: 0, explanation: "Friction opposes motion, and smooth ice offers very little."}, {rank: 3, prompt: "A heavy box needs a push of 50 newtons to move. You push with 30 newtons. How much must a friend push, the same way, to move it?", choices: ["30 newtons","50 newtons","20 newtons","80 newtons"], answer: 2, explanation: "Forces in the same direction add up, so 30 plus 20 makes the 50 needed."}]},
  {id: "be946a58-7254-4b80-80aa-9464f3329604", name: "Magnetism", order: 97, questions: [{rank: 1, prompt: "Which of these metals is strongly attracted to a magnet?", choices: ["Iron","Copper","Aluminum","Gold"], answer: 0, explanation: "Iron is magnetic, while the others are not."}, {rank: 2, prompt: "Why does a compass needle point north?", choices: ["North is warmer","It's pulled by the sun","It lines up with Earth's magnetic field","The needle is heavier at one end"], answer: 2, explanation: "Earth acts like a giant magnet that the needle aligns with."}, {rank: 3, prompt: "You have a bar magnet with unmarked ends and a compass. How do you find its north pole?", choices: ["The end that pulls in the needle's north end is north","Bring each end near the compass; the north pole pushes away the needle's north end","Hang it up, and the end pointing south is north","The heavier end is the north pole"], answer: 1, explanation: "Like poles repel, so the end that pushes away the needle's north end is north."}]},
  {id: "76ab5013-b675-46b6-b2a7-95624872c105", name: "Light", order: 98, questions: [{rank: 1, prompt: "Which travels faster through air, light or sound?", choices: ["Sound","They travel at the same speed","It depends on the time of day","Light"], answer: 3, explanation: "Light is vastly faster, which is why lightning is seen before thunder is heard."}, {rank: 2, prompt: "Why does a straw look bent in a glass of water?", choices: ["Light bends as it passes from water into air","The water bends the straw","Light can't travel through water","The glass is curved"], answer: 0, explanation: "Light changes direction when it crosses from one material into another, which is refraction."}, {rank: 3, prompt: "You're making a periscope from a tube and two flat mirrors. How should you set the mirrors?", choices: ["Both lying flat","At right angles to each other","Parallel to each other, each at 45 degrees","Facing each other, both upright"], answer: 2, explanation: "Each mirror at 45 degrees turns the light 90 degrees, so light coming in the top leaves at the bottom."}]},
  {id: "849db49f-05cc-43e7-99ac-095ed2dc2b4f", name: "Sound", order: 99, questions: [{rank: 1, prompt: "What does a sound's pitch depend on?", choices: ["Its loudness","Its color","The frequency of its vibrations","Its weight"], answer: 2, explanation: "Faster vibrations make a higher pitch."}, {rank: 2, prompt: "Why can't sound travel through outer space?", choices: ["Space is too cold","Sound only travels downward","Sound needs a material to carry its vibrations, and space is nearly empty","Light blocks it"], answer: 2, explanation: "Sound is a vibration passed through matter."}, {rank: 3, prompt: "You see lightning and hear the thunder 6 seconds later. Sound travels about 340 meters per second. How far away was the strike?", choices: ["About 340 meters","About 2 kilometers","About 6 kilometers","About 60 meters"], answer: 1, explanation: "6 seconds times 340 meters per second is about 2,040 meters."}]}
] AS x
MATCH (t:Topic {id: x.id}), (c:Collection {id: "general-schooling-knowledge"})
MERGE (c)-[contains:CONTAINS]->(t)
SET contains.order = x.order
WITH t, x
UNWIND x.questions AS q
MATCH (t)-[:HAS_LEVEL]->(l:BloomLevel {rank: q.rank})
MERGE (question:QuizQuestion)-[:TESTS]->(l)
ON CREATE SET question.id = randomUUID(), question.prompt = q.prompt, question.choices = q.choices,
              question.answer = q.answer, question.explanation = q.explanation, question.createdAt = datetime();

UNWIND [
  {id: "2e1207c6-3bd1-446f-8d3e-9741b29e7df4", name: "Simple Machines", order: 100, questions: [{rank: 1, prompt: "What is the fixed point a lever turns on called?", choices: ["The pulley","The wedge","The axle","The fulcrum"], answer: 3, explanation: "A lever pivots on its fulcrum."}, {rank: 2, prompt: "Why does a ramp make it easier to roll a heavy barrel onto a truck?", choices: ["It removes the barrel's weight","It reduces gravity","It shortens the distance","You use less force spread over a longer distance"], answer: 3, explanation: "A ramp trades a longer path for a smaller push."}, {rank: 3, prompt: "You need to lift a heavy rock with a long bar resting on a smaller stone. Where should you push to lift it most easily?", choices: ["Right next to the stone","Directly on the rock","At the far end of the bar, away from the stone","It makes no difference"], answer: 2, explanation: "The farther you push from the pivot, the less force you need."}]},
  {id: "7b808c4d-a520-4718-af63-0e30b461a8ad", name: "Electric Circuits", order: 101, questions: [{rank: 1, prompt: "Which of these materials is a good electrical conductor?", choices: ["Copper","Rubber","Glass","Wood"], answer: 0, explanation: "Copper lets current flow easily, which is why it's used in wires."}, {rank: 2, prompt: "Why are the lights in a house wired in parallel rather than in a single loop?", choices: ["It uses less wire","It makes them brighter","It stops the current entirely","Each light gets its own path, so one going out doesn't turn off the others"], answer: 3, explanation: "Parallel branches work independently of each other."}, {rank: 3, prompt: "You're wiring three lamps so each keeps working if another burns out. How should you wire them?", choices: ["In series with a switch in the loop","All on one wire with no return","In series, in a single loop","In parallel, each on its own branch"], answer: 3, explanation: "In parallel, each lamp has its own path, so one failing doesn't break the others."}]},
  {id: "d24744d2-9fdd-4046-8d19-1bff8a4300a6", name: "Energy", order: 102, questions: [{rank: 1, prompt: "What is the energy an object has because it is moving called?", choices: ["Potential energy","Thermal energy","Nuclear energy","Kinetic energy"], answer: 3, explanation: "Kinetic energy is the energy of motion."}, {rank: 2, prompt: "Why does a car's engine get hot while it runs?", choices: ["Engines create energy from nothing","Some of the fuel's energy is turned into heat rather than motion","The road heats it","Heat makes the car move faster"], answer: 1, explanation: "No energy change is perfect, and some always becomes heat."}, {rank: 3, prompt: "You want a toy car to roll as far as possible across the floor after a ramp. What should you change?", choices: ["Make the floor rougher","Start it lower down the ramp","Start it higher up the ramp","Paint it a brighter color"], answer: 2, explanation: "Starting higher gives it more stored energy to turn into motion."}]},
  {id: "fc05f3cd-cb90-478e-a75c-f226ad2a4518", name: "Heat Transfer", order: 103, questions: [{rank: 1, prompt: "How does heat from the sun reach the Earth through space?", choices: ["By conduction","By radiation","By convection","By evaporation"], answer: 1, explanation: "Radiation carries heat across empty space."}, {rank: 2, prompt: "Why does hot air rise in a room?", choices: ["Hot air is heavier","Cold air pushes it from above","Heat makes air disappear","Warm air is less dense than cool air"], answer: 3, explanation: "Warming air spreads it out, making it lighter, so it rises."}, {rank: 3, prompt: "You're choosing a handle for a frying pan that won't burn your hand. What should it be made of?", choices: ["Aluminum","Steel","Wood or plastic","Copper"], answer: 2, explanation: "Wood and plastic conduct heat poorly, so the handle stays cool."}]},
  {id: "3c5a76c3-63cc-4739-809a-bb14d0134d96", name: "Density", order: 104, questions: [{rank: 1, prompt: "Which is denser, ice or liquid water?", choices: ["Liquid water","Ice","They are equally dense","It depends on the container"], answer: 0, explanation: "Ice is less dense than liquid water, which is why it floats."}, {rank: 2, prompt: "Why does a huge steel ship float while a small steel nail sinks?", choices: ["Steel floats in large amounts","The ship's hollow shape makes its overall density less than water's","The ship is lighter than the nail","Seawater pushes only on ships"], answer: 1, explanation: "Air inside the hull lowers its average density below water's."}, {rank: 3, prompt: "A block has a mass of 200 grams and a volume of 100 cubic centimeters. Water has a density of 1 gram per cubic centimeter. Will it float?", choices: ["No, it sinks","Yes, it floats","It floats halfway","It depends on the shape only"], answer: 0, explanation: "Its density is 2 grams per cubic centimeter, more than water's."}]},
  {id: "cfb8233d-fb47-4118-8f45-36bc06c6a3ed", name: "Pressure", order: 105, questions: [{rank: 1, prompt: "What is the metric unit of pressure?", choices: ["The newton","The pascal","The joule","The watt"], answer: 1, explanation: "Pressure is measured in pascals."}, {rank: 2, prompt: "Why do your ears pop when a plane climbs?", choices: ["The air pressure outside drops while the pressure in your ears is still higher","The plane gets louder","Your ears get colder","Gravity increases"], answer: 0, explanation: "Your ears adjust to the lower outside pressure."}, {rank: 3, prompt: "You need to cross thin ice to reach someone who has fallen in. How should you move?", choices: ["Jump on it first to test it","Walk normally","Lie flat and crawl, spreading your weight","Run across on your toes"], answer: 2, explanation: "Spreading your weight over a larger area lowers the pressure on the ice."}]},
  {id: "55c67b3e-f91d-4c08-8002-d6dff0171f1d", name: "Speed and Velocity", order: 106, questions: [{rank: 1, prompt: "Which unit could measure speed?", choices: ["Meters per second","Kilograms","Newtons","Liters"], answer: 0, explanation: "Speed is distance per unit of time."}, {rank: 2, prompt: "Two cars both travel at 60 km per hour, one heading north and one heading south. How do their velocities compare?", choices: ["Same speed, but different velocities because of their directions","Identical velocities","Different speeds","Neither has a velocity"], answer: 0, explanation: "Velocity includes direction, so opposite directions mean different velocities."}, {rank: 3, prompt: "A cyclist rides 30 kilometers in 2 hours. What is her average speed?", choices: ["60 kilometers per hour","32 kilometers per hour","28 kilometers per hour","15 kilometers per hour"], answer: 3, explanation: "Speed is distance divided by time: 30 over 2."}]},
  {id: "4075687f-4be2-499c-9d7c-e5fbce29a231", name: "Newton's Laws of Motion", order: 107, questions: [{rank: 1, prompt: "Which law says an object stays at rest or keeps moving in a straight line unless a force acts on it?", choices: ["Newton's second law","Newton's third law","Newton's first law","The law of gravity"], answer: 2, explanation: "The first law is the law of inertia."}, {rank: 2, prompt: "Why does a rocket move upward when it pushes gas downward?", choices: ["Every action has an equal and opposite reaction","The gas pulls the rocket up","Gravity pushes the rocket","Air lifts the rocket like a wing"], answer: 0, explanation: "The rocket pushes the gas down, and the gas pushes the rocket up."}, {rank: 3, prompt: "You're standing on a bus. How should you keep steady when it brakes hard?", choices: ["Hold a rail, since your body keeps moving forward as the bus slows","Stand on one foot","Jump as it brakes","Let go and lean back"], answer: 0, explanation: "Your body keeps moving at the old speed until a force, like a grip on the rail, slows it."}]},
  {id: "82118f89-e409-4529-820d-97bdc9b6e936", name: "Kinematics", order: 108, questions: [{rank: 1, prompt: "About how fast does gravity accelerate a falling object near Earth's surface?", choices: ["About 1 meter per second squared","About 100 meters per second squared","About 9.8 meters per second squared","About 0.5 meters per second squared"], answer: 2, explanation: "Near the surface, gravity adds about 9.8 meters per second of speed every second."}, {rank: 2, prompt: "On a graph of distance against time, what does a flat horizontal line mean?", choices: ["It's moving at a constant speed","It's speeding up","It's moving backward","The object is standing still"], answer: 3, explanation: "Distance isn't changing, so the object isn't moving."}, {rank: 3, prompt: "A car accelerates from 0 to 20 meters per second in 5 seconds. What is its acceleration?", choices: ["100 meters per second squared","25 meters per second squared","15 meters per second squared","4 meters per second squared"], answer: 3, explanation: "Acceleration is the change in velocity divided by the time: 20 over 5."}]},
  {id: "7b6342e8-ffb9-4e6c-9ab3-0269e2ca2a5e", name: "Work and Power", order: 109, questions: [{rank: 1, prompt: "What is the unit of power?", choices: ["The newton","The joule","The volt","The watt"], answer: 3, explanation: "Power is measured in watts, joules per second."}, {rank: 2, prompt: "Why is no work done on a heavy bag that you only hold still?", choices: ["Holding takes no force","The bag gets lighter","It doesn't move, and work needs a force to move something","Work is only done going downhill"], answer: 2, explanation: "In physics, work needs the force to move its object some distance."}, {rank: 3, prompt: "You lift a box weighing 100 newtons onto a shelf 2 meters high. How much work do you do?", choices: ["50 joules","200 joules","98 joules","102 joules"], answer: 1, explanation: "Work is force times distance: 100 newtons times 2 meters."}]},
  {id: "6cc2a0a2-e045-435c-9fb6-61f12202d88f", name: "Momentum", order: 110, questions: [{rank: 1, prompt: "What is the unit of momentum?", choices: ["Kilogram meters per second","Newtons","Joules","Watts"], answer: 0, explanation: "Momentum is measured in kilogram meters per second."}, {rank: 2, prompt: "Why does a moving bowling ball knock pins over more easily than a moving tennis ball at the same speed?", choices: ["It has much more momentum because of its greater mass","It's rounder","It moves faster","Tennis balls bounce off"], answer: 0, explanation: "More mass at the same speed means more momentum to transfer."}, {rank: 3, prompt: "A 2,000 kg truck at 10 meters per second has the same momentum as a car going 20 meters per second. What is the car's mass?", choices: ["4,000 kg","500 kg","1,000 kg","2,000 kg"], answer: 2, explanation: "Momentum is mass times velocity: 20,000 divided by 20 is 1,000."}]},
  {id: "42da33d2-bc45-44a3-beb1-ae3cfc463322", name: "Waves", order: 111, questions: [{rank: 1, prompt: "What is the height of a wave from its resting level to its crest called?", choices: ["The wavelength","The amplitude","The frequency","The period"], answer: 1, explanation: "Amplitude measures how far a wave rises from its resting level."}, {rank: 2, prompt: "A cork bobs on a pond as a wave passes. Why doesn't the cork travel along with the wave?", choices: ["The cork is too heavy","A wave carries energy across the water, not the water itself","The water moves backward","Waves don't move"], answer: 1, explanation: "The water just moves up and down as the energy passes through it."}, {rank: 3, prompt: "A wave on a rope has a frequency of 2 per second and a wavelength of 3 meters. How fast does it travel?", choices: ["1.5 meters per second","5 meters per second","0.67 meters per second","6 meters per second"], answer: 3, explanation: "A wave's speed is its frequency times its wavelength."}]},
  {id: "ab6cecb7-f186-4897-b7ec-7a09d8e91905", name: "Electromagnetic Spectrum", order: 112, questions: [{rank: 1, prompt: "Which color of visible light has the longest wavelength?", choices: ["Violet","Green","Red","Blue"], answer: 2, explanation: "Red is at the long-wavelength end of the visible spectrum."}, {rank: 2, prompt: "What do radio waves, visible light and X-rays have in common?", choices: ["They're all visible","They're all electromagnetic waves traveling at the speed of light","They all need air to travel","They all have the same wavelength"], answer: 1, explanation: "They're the same kind of wave, differing only in wavelength and energy."}, {rank: 3, prompt: "A doctor needs to see a broken bone inside an arm. Which kind of radiation is used?", choices: ["Radio waves","Visible light","X-rays","Microwaves"], answer: 2, explanation: "X-rays pass through soft tissue but are absorbed by bone."}]},
  {id: "ebe28d31-bd62-444b-9b3d-0e6f217aab2b", name: "Ohm's Law", order: 113, questions: [{rank: 1, prompt: "Which instrument measures voltage?", choices: ["An ammeter","A barometer","A thermometer","A voltmeter"], answer: 3, explanation: "A voltmeter measures the voltage across part of a circuit."}, {rank: 2, prompt: "If you double the resistance in a circuit while keeping the voltage the same, what happens to the current?", choices: ["It doubles","It stays the same","It halves","It drops to zero"], answer: 2, explanation: "With voltage fixed, current is inversely proportional to resistance."}, {rank: 3, prompt: "A 12-volt battery is connected to a 4-ohm resistor. How much current flows?", choices: ["3 amps","48 amps","16 amps","8 amps"], answer: 0, explanation: "Current is voltage divided by resistance: 12 over 4."}]},
  {id: "9dba18e2-5a89-4bc4-943a-9e803f2d7e18", name: "Electromagnetism", order: 114, questions: [{rank: 1, prompt: "Which scientist discovered that moving a magnet near a wire can make a current flow?", choices: ["Michael Faraday","Isaac Newton","Thomas Edison","Charles Darwin"], answer: 0, explanation: "Faraday discovered electromagnetic induction in 1831."}, {rank: 2, prompt: "How does a power station generator produce electricity?", choices: ["By spinning a magnet near coils of wire to create a current","By burning electrons","By storing lightning","By heating copper"], answer: 0, explanation: "A changing magnetic field near a wire pushes a current through it."}, {rank: 3, prompt: "You've made an electromagnet with wire around a nail, but it's too weak. What should you do?", choices: ["Use a weaker battery","Swap the iron nail for a wooden dowel","Wrap more turns of wire around the nail","Use fewer turns of wire"], answer: 2, explanation: "More turns, or more current, make a stronger magnetic field."}]},
  {id: "22afb179-0dea-4d55-b669-43ebab21f50f", name: "Gravity", order: 115, questions: [{rank: 1, prompt: "Who formulated the law of universal gravitation?", choices: ["Albert Einstein","Galileo Galilei","Nikola Tesla","Isaac Newton"], answer: 3, explanation: "Newton described gravity as a force between all masses."}, {rank: 2, prompt: "In a vacuum, a hammer and a feather dropped together land at the same time. Why don't they on Earth?", choices: ["The hammer has more gravity","Feathers are repelled by Earth","Heavier things always fall faster","Air resistance slows the feather much more"], answer: 3, explanation: "Gravity accelerates all objects equally, and only air makes the difference."}, {rank: 3, prompt: "An astronaut weighs 600 newtons on Earth. The Moon's gravity is about one sixth of Earth's. What does the astronaut weigh there?", choices: ["600 newtons","3,600 newtons","0 newtons","About 100 newtons"], answer: 3, explanation: "One sixth of 600 is 100."}]},
  {id: "b60ef8b1-2899-4897-9c1e-088addecedec", name: "Radioactivity", order: 116, questions: [{rank: 1, prompt: "Which scientist won two Nobel Prizes for her research on radioactivity?", choices: ["Rosalind Franklin","Marie Curie","Ada Lovelace","Lise Meitner"], answer: 1, explanation: "Marie Curie won Nobel Prizes in physics and chemistry."}, {rank: 2, prompt: "Why are radioactive materials dangerous to living tissue?", choices: ["Their radiation can damage cells and DNA","They are always very hot","They are poisonous to touch only","They make objects heavier"], answer: 0, explanation: "Radiation carries enough energy to break the molecules in cells."}, {rank: 3, prompt: "A radioactive sample has a half-life of 10 years. What fraction remains after 30 years?", choices: ["One third","One eighth","One half","None"], answer: 1, explanation: "Three half-lives halve it three times: one half, then a quarter, then an eighth."}]},
  {id: "2fc7fffb-762f-4585-bc01-e8cb909e5d60", name: "Weather", order: 117, questions: [{rank: 1, prompt: "Which instrument measures wind speed?", choices: ["An anemometer","A barometer","A thermometer","A rain gauge"], answer: 0, explanation: "An anemometer's spinning cups measure wind speed."}, {rank: 2, prompt: "Why do clouds form as warm, moist air rises?", choices: ["Rising air gains water","The air cools as it rises, and its water vapor condenses into droplets","The sun makes clouds","Clouds are made of smoke"], answer: 1, explanation: "Cooler air holds less water vapor, so the vapor turns into tiny droplets."}, {rank: 3, prompt: "Before a planned boat trip, you see the barometer falling fast. What should you do?", choices: ["Go, but bring extra sunscreen","Put the trip off, since a storm is likely","Leave early before it gets too hot","Go as planned, since falling pressure means clear skies"], answer: 1, explanation: "Falling pressure means a low is coming, which brings wind and rain."}]},
  {id: "85cf0dc0-ff34-415a-bd81-e8b40647f967", name: "Seasons", order: 118, questions: [{rank: 1, prompt: "What is the longest day of the year called?", choices: ["The spring equinox","The autumn equinox","The winter solstice","The summer solstice"], answer: 3, explanation: "The summer solstice has the most daylight."}, {rank: 2, prompt: "What causes the seasons on Earth?", choices: ["Earth's distance from the sun changing","The sun getting hotter and cooler","Earth's tilted axis, so each hemisphere gets more direct sunlight for part of the year","The moon blocking the sun"], answer: 2, explanation: "The tilt changes how directly sunlight strikes each hemisphere through the year."}, {rank: 3, prompt: "You live in Canada and want a hot beach vacation in December. Where should you go?", choices: ["Australia","Norway","Scotland","Japan"], answer: 0, explanation: "Australia is in the Southern Hemisphere, where December is summer."}]},
  {id: "fcf6cf3a-f28b-4afd-8d38-ee9b5cc1940c", name: "Water Cycle", order: 119, questions: [{rank: 1, prompt: "What is water falling from clouds, such as rain or snow, called?", choices: ["Precipitation","Evaporation","Condensation","Transpiration"], answer: 0, explanation: "Rain, snow, sleet and hail are precipitation."}, {rank: 2, prompt: "Why does water collect on the outside of a cold glass on a warm day?", choices: ["Water leaks through the glass","The glass sweats on its own","Water vapor in the air cools and condenses on it","Ice is melting outward"], answer: 2, explanation: "Warm, moist air cools against the glass and turns back into liquid."}, {rank: 3, prompt: "You're stranded with seawater, a plastic sheet and a cup. How do you get drinking water?", choices: ["Pour it through the sheet to filter out the salt","Let the sun evaporate it under the sheet and catch the drips in the cup","Leave it out overnight to let the salt settle","Mix it with sand and drink the top layer"], answer: 1, explanation: "Water evaporates and leaves the salt behind, then condenses on the sheet as fresh water."}]},
  {id: "ce7f1b9e-d50c-4397-aea7-a518502becd9", name: "Rocks and Minerals", order: 120, questions: [{rank: 1, prompt: "Which is the hardest natural mineral?", choices: ["Quartz","Diamond","Talc","Gold"], answer: 1, explanation: "Diamond is at the top of the hardness scale."}, {rank: 2, prompt: "How does igneous rock form?", choices: ["Layers of sediment are pressed together","Molten rock cools and hardens","Heat and pressure change existing rock","Minerals dissolve in water"], answer: 1, explanation: "Igneous rock comes from cooled magma or lava."}, {rank: 3, prompt: "You want to know whether a clear crystal is quartz or calcite. What can you do?", choices: ["Weigh it","Try to scratch glass with it; quartz scratches glass and calcite doesn't","Drop it in water to see if it floats","Look at its color"], answer: 1, explanation: "Quartz is harder than glass and calcite is softer, so a scratch test tells them apart."}]},
  {id: "bee55749-6999-4997-a70f-c11cec189d7c", name: "Rock Cycle", order: 121, questions: [{rank: 1, prompt: "What is molten rock beneath the Earth's surface called?", choices: ["Magma","Lava","Sediment","Basalt"], answer: 0, explanation: "Magma is called lava once it reaches the surface."}, {rank: 2, prompt: "Why is it called the rock cycle?", choices: ["Rocks keep changing from one type to another over time","Rocks travel in circles","Rocks are recycled by people","Rocks never change"], answer: 0, explanation: "Any rock can be worn down, melted or transformed into another type."}, {rank: 3, prompt: "You're out hunting for fossils. Which rocks should you search?", choices: ["Granite","Sedimentary rocks, such as shale and limestone","Marble","Basalt"], answer: 1, explanation: "Fossils form as layers of sediment bury remains. Heat and melting destroy them in the other rock types."}]},
  {id: "d5a735dd-5a13-4d09-86ea-60ee11406150", name: "Structure of the Earth", order: 122, questions: [{rank: 1, prompt: "What is the outermost solid layer of the Earth called?", choices: ["The mantle","The outer core","The crust","The inner core"], answer: 2, explanation: "We live on the thin crust."}, {rank: 2, prompt: "Why is the Earth's inner core solid even though it's extremely hot?", choices: ["The immense pressure keeps it solid","It's made of ice","It's cooler than the surface","It's made of rock that can't melt"], answer: 0, explanation: "Enormous pressure prevents the metal from melting."}, {rank: 3, prompt: "Scientists want to learn what lies thousands of kilometers inside the Earth. What do they study?", choices: ["Samples from holes drilled to the core","How earthquake waves travel through it","Satellite photos of the surface","Ash from the core blown out by volcanoes"], answer: 1, explanation: "No drill reaches far, but earthquake waves bend and slow as they pass through different layers."}]},
  {id: "25f1fe6b-745c-4bb4-ae91-7a5db16ff98a", name: "Plate Tectonics", order: 123, questions: [{rank: 1, prompt: "What was the single supercontinent that later broke up into today's continents called?", choices: ["Gondwana Ocean","Atlantis","Pangaea","Laurasia Sea"], answer: 2, explanation: "Pangaea broke apart around 200 million years ago."}, {rank: 2, prompt: "Why are earthquakes and volcanoes common along the edges of tectonic plates?", choices: ["Plates grind, collide or pull apart there","The edges are thinner","They are near oceans","Plates are hotter at the edges"], answer: 0, explanation: "Plate movement builds and releases stress at the boundaries."}, {rank: 3, prompt: "A fence crosses a fault where two plates slide past each other at 5 cm a year. After 40 years, how have its two halves moved?", choices: ["Pushed up by 2 meters","Pulled 2 meters apart","Offset sideways by about 2 meters","Not at all"], answer: 2, explanation: "Plates sliding past each other shift features sideways: 5 cm times 40 years."}]},
  {id: "6cbdc684-0910-46bb-89b3-2aaf9a86ab44", name: "Earth's Atmosphere", order: 124, questions: [{rank: 1, prompt: "Which gas makes up most of Earth's atmosphere?", choices: ["Oxygen","Carbon dioxide","Argon","Nitrogen"], answer: 3, explanation: "Nitrogen is about 78 percent of the air."}, {rank: 2, prompt: "What does the ozone layer do for life on Earth?", choices: ["It produces rain","It keeps the planet cold","It creates oxygen for breathing","It absorbs much of the sun's harmful ultraviolet radiation"], answer: 3, explanation: "Ozone high in the atmosphere screens out UV light."}, {rank: 3, prompt: "You're hiking high in the mountains on a sunny day. What should you bring?", choices: ["Only a heavier coat","Strong sunscreen, since thinner air blocks less UV","Less sunscreen, since it's colder up high","Nothing extra, the sun is the same everywhere"], answer: 1, explanation: "Higher up, there's less air above you to absorb ultraviolet light."}]},
  {id: "87e864ab-8424-44a6-a548-34cc8a6ca630", name: "Climate Change", order: 125, questions: [{rank: 1, prompt: "Which gas released by burning fossil fuels is the main driver of climate change?", choices: ["Carbon dioxide","Oxygen","Nitrogen","Helium"], answer: 0, explanation: "Burning coal, oil and gas releases carbon dioxide."}, {rank: 2, prompt: "How do greenhouse gases warm the planet?", choices: ["They block sunlight from reaching Earth","They make the sun hotter","They create holes in the atmosphere","They trap heat radiating from Earth's surface"], answer: 3, explanation: "The gases let sunlight in but absorb outgoing heat."}, {rank: 3, prompt: "Which of these would cut the most greenhouse gas from a home's energy use?", choices: ["Turning off the lights one extra hour a month","Painting the house","Buying a larger fridge","Replacing an oil furnace with a heat pump run on renewable electricity"], answer: 3, explanation: "Heating is a large share of home energy, and switching away from burning fuel cuts emissions most."}]},
  {id: "bf9a893b-3253-4d83-8f55-1ff1a9250373", name: "Solar System", order: 126, questions: [{rank: 1, prompt: "Which is the largest planet in our solar system?", choices: ["Saturn","Jupiter","Earth","Neptune"], answer: 1, explanation: "Jupiter is more than twice as massive as all the other planets combined."}, {rank: 2, prompt: "Why do planets farther from the sun take longer to orbit it?", choices: ["They travel a longer path, and more slowly","They are heavier","They spin faster","They're closer to other stars"], answer: 0, explanation: "Distant planets have bigger orbits and move more slowly."}, {rank: 3, prompt: "You're controlling a rover on Mars, 12 light-minutes from Earth. How long after sending a command can you first see it carried out?", choices: ["About 12 minutes","Right away","About 24 minutes","About 8 minutes"], answer: 2, explanation: "The command takes 12 minutes to get there and the reply 12 minutes to come back."}]},
  {id: "d6d86f06-943f-468c-8c12-da902de8825b", name: "Phases of the Moon", order: 127, questions: [{rank: 1, prompt: "What is the phase when the moon is not visible from Earth called?", choices: ["The full moon","The first quarter","The gibbous moon","The new moon"], answer: 3, explanation: "At new moon, its lit side faces away from Earth."}, {rank: 2, prompt: "Why does the moon seem to change shape over a month?", choices: ["We see different amounts of its sunlit half as it orbits Earth","Earth's shadow covers different parts of it","The moon shrinks and grows","Clouds block parts of it"], answer: 0, explanation: "Half the moon is always lit, and we view it from changing angles."}, {rank: 3, prompt: "You want to photograph faint stars with as little moonlight as possible. When should you go?", choices: ["At the first quarter","At the new moon","At the waxing gibbous","At the full moon"], answer: 1, explanation: "At the new moon, its lit side faces away from Earth, so the sky is darkest."}]},
  {id: "ab94eb01-5e8e-41b3-a602-2add6a3d0e33", name: "Stars", order: 128, questions: [{rank: 1, prompt: "Which is the closest star to Earth?", choices: ["The sun","Proxima Centauri","Sirius","The North Star"], answer: 0, explanation: "The sun is a star, far closer than any other."}, {rank: 2, prompt: "Why do stars shine?", choices: ["Nuclear fusion in their cores releases huge amounts of energy","They reflect the sun's light","They are burning like coal","They are made of glowing metal"], answer: 0, explanation: "Stars fuse light elements into heavier ones, releasing energy."}, {rank: 3, prompt: "You want to find the North Star on a clear night. What do you do?", choices: ["Follow the two stars at the end of the Big Dipper's cup","Look toward where the sun set","Look for the brightest star in the sky","Look straight overhead"], answer: 0, explanation: "Those two pointer stars line up with Polaris. It isn't the brightest star."}]},
  {id: "d2a68327-a17d-4e67-a120-ae15c0926271", name: "Galaxies", order: 129, questions: [{rank: 1, prompt: "What is the name of the galaxy containing our solar system?", choices: ["Andromeda","The Large Magellanic Cloud","The Whirlpool","The Milky Way"], answer: 3, explanation: "We live in the Milky Way."}, {rank: 2, prompt: "What holds the stars of a galaxy together?", choices: ["Magnetism","Wind","Gravity","Light pressure"], answer: 2, explanation: "The galaxy's mass holds it together by gravity."}, {rank: 3, prompt: "A galaxy is 50 million light-years away. If it changed today, when could we see the change from Earth?", choices: ["Right away","In 50 years","In 50 million years","We'd already have seen it"], answer: 2, explanation: "Its light takes 50 million years to reach us."}]},
  {id: "998f63f7-15ab-4c04-810c-8da609e13c83", name: "Big Bang", order: 130, questions: [{rank: 1, prompt: "About how old is the universe, according to the Big Bang theory?", choices: ["About 6,000 years","About 13.8 billion years","About 4.5 billion years","About 1 million years"], answer: 1, explanation: "The best estimate puts the Big Bang about 13.8 billion years ago."}, {rank: 2, prompt: "Why do scientists think the universe was once extremely hot and dense?", choices: ["Run backward, its expansion leads to everything packed together at the start","Stars used to be closer to Earth","The sun was once larger","Galaxies are getting hotter"], answer: 0, explanation: "An expanding universe was smaller, denser and hotter in the past."}, {rank: 3, prompt: "Galaxies move away faster the farther off they are. One 100 million light-years away moves away at 2,000 km per second. How fast does one 300 million light-years away move?", choices: ["About 700 km per second","About 6,000 km per second","About 2,000 km per second","About 600,000 km per second"], answer: 1, explanation: "In an expanding universe, speed grows in step with distance: three times as far, three times as fast."}]},
  {id: "640ffe5d-fe84-4597-a5a8-cf6453c0278d", name: "Prehistory", order: 131, questions: [{rank: 1, prompt: "What major change came with the start of farming, around 10,000 years ago?", choices: ["People invented writing","People began settling in permanent villages","People began using iron","People stopped making tools"], answer: 1, explanation: "Growing crops let people stay in one place."}, {rank: 2, prompt: "Why is the time before writing called prehistory?", choices: ["Nothing happened then","There are no written records from it, so it's known from objects and remains","It was before humans existed","It was too short to study"], answer: 1, explanation: "History in the strict sense relies on writing, so earlier times are studied through archaeology."}, {rank: 3, prompt: "You're an archaeologist dating charcoal from an ancient hearth. Which method do you use?", choices: ["Reading written records from the site","Radiocarbon dating","Checking the dates on coins found nearby","Measuring how deep the hearth is in meters"], answer: 1, explanation: "Radiocarbon dating measures how much carbon-14 is left in once-living material."}]},
  {id: "85f4b3a4-5364-4de0-bcd6-466c2405b0c8", name: "Ancient Egypt", order: 132, questions: [{rank: 1, prompt: "What were the rulers of ancient Egypt called?", choices: ["Pharaohs","Emperors","Caesars","Sultans"], answer: 0, explanation: "Egypt's kings were the pharaohs."}, {rank: 2, prompt: "Why did the ancient Egyptians mummify their dead?", choices: ["To make them lighter to carry","They believed the body was needed in the afterlife","To display them in markets","To stop them returning as ghosts"], answer: 1, explanation: "Preserving the body was meant to keep it ready for the next life."}, {rank: 3, prompt: "You're a farmer in ancient Egypt. When should you plant your crops?", choices: ["Just before the flood arrives","While the fields are underwater","In the driest part of summer","Once the Nile's flood goes down, into the fresh silt"], answer: 3, explanation: "The flood left rich, wet soil behind, ready for planting as the water drew back."}]},
  {id: "7b18123a-ea7f-4f8b-8e14-c1cba14282be", name: "Ancient Greece", order: 133, questions: [{rank: 1, prompt: "Who was Plato's teacher, a philosopher famous for asking questions?", choices: ["Aristotle","Socrates","Pythagoras","Homer"], answer: 1, explanation: "Socrates taught Plato, who taught Aristotle."}, {rank: 2, prompt: "Why is ancient Greece called the birthplace of Western philosophy?", choices: ["It invented writing","It had the first schools","Its people were the first to read","Thinkers there began reasoning about the world without relying only on myths"], answer: 3, explanation: "Greek thinkers questioned the world through argument and reason."}, {rank: 3, prompt: "A teacher wants to run a class the way Socrates taught. How should they run it?", choices: ["Ask probing questions that test each claim the students make","Vote on answers without discussion","Lecture with no questions allowed","Let the loudest student decide"], answer: 0, explanation: "Socrates taught by questioning, drawing out and testing people's ideas."}]},
  {id: "bdb7f240-1414-484a-bdab-e8582ea4bec4", name: "Ancient Rome", order: 134, questions: [{rank: 1, prompt: "Who was the first emperor of Rome?", choices: ["Julius Caesar","Augustus","Nero","Romulus"], answer: 1, explanation: "Augustus took power as the first emperor in 27 BCE."}, {rank: 2, prompt: "Why did the Roman Empire build aqueducts?", choices: ["To carry fresh water into cities from far away","To defend against invaders","To mark borders","To grow crops on hills"], answer: 0, explanation: "Aqueducts brought water for drinking, baths and fountains."}, {rank: 3, prompt: "You're building a large dome that must last for centuries, without steel. What Roman material would you use?", choices: ["Timber","Roman concrete","Glass","Mud brick"], answer: 1, explanation: "The Romans' concrete built the Pantheon's dome, still standing after nearly 2,000 years."}]},
  {id: "89ffb848-209e-403e-a976-64f2d8f8d1d6", name: "Mesopotamia", order: 135, questions: [{rank: 1, prompt: "Which two rivers was Mesopotamia between?", choices: ["The Nile and the Jordan","The Indus and the Ganges","The Tigris and the Euphrates","The Danube and the Rhine"], answer: 2, explanation: "Mesopotamia means \"land between the rivers\"."}, {rank: 2, prompt: "Why is Mesopotamia called a cradle of civilization?", choices: ["Some of the first cities, writing and laws arose there","It was the largest empire ever","It invented farming everywhere","It had no wars"], answer: 0, explanation: "Early cities like Ur and Babylon developed there."}, {rank: 3, prompt: "Farmers in an ancient land between two rivers face little rain. What would they build to grow crops?", choices: ["Terraces on mountains","Rain-catching roofs","Irrigation canals from the rivers","Underground greenhouses"], answer: 2, explanation: "Mesopotamian farmers dug canals to bring river water to their fields."}]},
  {id: "efae15ae-1263-4c5b-837b-a9a46519e881", name: "Ancient China", order: 136, questions: [{rank: 1, prompt: "Which of these was invented in ancient China?", choices: ["The steam engine","The telescope","Paper","Eyeglasses"], answer: 2, explanation: "Paper was invented in China around the 2nd century BCE."}, {rank: 2, prompt: "Why was the Silk Road so important to ancient China?", choices: ["It connected China to other regions for trade and exchanging ideas","It carried water to cities","It was a defensive wall","It brought silk into China from Europe"], answer: 0, explanation: "The routes carried silk west and brought goods, religions and ideas back."}, {rank: 3, prompt: "You're a merchant in ancient Chang'an and want to sell silk in Rome. Which way do you send it?", choices: ["West along the Silk Road through Central Asia","South around Africa by ship","East across the Pacific","North through Siberia"], answer: 0, explanation: "The Silk Road's overland routes linked China with the Mediterranean."}]},
  {id: "72b1ea70-5b1d-4a6e-8884-6b93331c51b3", name: "Middle Ages", order: 137, questions: [{rank: 1, prompt: "What was the large stone fortress home of a medieval lord called?", choices: ["A cathedral","A monastery","A castle","A palace of glass"], answer: 2, explanation: "Lords lived in fortified castles."}, {rank: 2, prompt: "Why did the Black Death change life in Europe so much?", choices: ["It only affected kings","It ended farming","It made Europe more crowded","It killed so many people that labor became scarce and social order shifted"], answer: 3, explanation: "The loss of a third or more of the population upended the economy."}, {rank: 3, prompt: "You're a medieval knight who holds land from a lord. What must you do when he goes to war?", choices: ["Choose whichever side pays more","Fight for him, as you swore to","Stay home and farm your land","Pay the king to stay out of it"], answer: 1, explanation: "Under feudalism, land was granted in return for military service."}]},
  {id: "335dde2e-1a06-4e55-8f89-b9255ea440b0", name: "Islamic Golden Age", order: 138, questions: [{rank: 1, prompt: "In which city was the House of Wisdom?", choices: ["Cairo","Jerusalem","Baghdad","Constantinople"], answer: 2, explanation: "The Abbasid caliphs founded it in Baghdad."}, {rank: 2, prompt: "Why was the House of Wisdom important?", choices: ["It was the caliph's palace","Scholars gathered there to translate and build on knowledge from many cultures","It was a fortress","It was a market for silk"], answer: 1, explanation: "It preserved and advanced Greek, Persian and Indian learning."}, {rank: 3, prompt: "A modern student writes 3,407 using place value with a zero. Which number system, spread to Europe through the Islamic world, makes this easy?", choices: ["Roman numerals","Egyptian hieroglyphs","Hindu-Arabic numerals","Greek letters"], answer: 2, explanation: "The Hindu-Arabic system with zero reached Europe through Arabic scholars."}]},
  {id: "aac646aa-0709-4218-8970-b170dceab8fe", name: "Renaissance", order: 139, questions: [{rank: 1, prompt: "Who painted the Mona Lisa?", choices: ["Michelangelo","Raphael","Vincent van Gogh","Leonardo da Vinci"], answer: 3, explanation: "Leonardo painted it in the early 1500s."}, {rank: 2, prompt: "Why is the Renaissance called a \"rebirth\"?", choices: ["It was when people were reborn","It began after a plague ended","It revived interest in the art and learning of ancient Greece and Rome","It brought back the Middle Ages"], answer: 2, explanation: "Scholars and artists returned to classical ideas."}, {rank: 3, prompt: "You're a Renaissance artist who wants to paint the human body accurately. What would you do, as Leonardo did?", choices: ["Use flat gold backgrounds","Study anatomy by dissecting and drawing bodies","Copy older religious icons","Paint from memory alone"], answer: 1, explanation: "Renaissance artists studied nature and the body directly to paint them realistically."}]},
  {id: "cf2d1487-9c14-4187-9772-2532ff3a4c68", name: "Age of Discovery", order: 140, questions: [{rank: 1, prompt: "Who led the first European expedition to sail across the Atlantic to the Americas, in 1492?", choices: ["Vasco da Gama","Ferdinand Magellan","Christopher Columbus","James Cook"], answer: 2, explanation: "Columbus reached the Caribbean in 1492."}, {rank: 2, prompt: "Why did European explorers seek sea routes to Asia in the 1400s?", choices: ["To find new places to farm","To escape the cold","To trade directly for spices and silk without going through middlemen","To spread the plague"], answer: 2, explanation: "Overland trade was controlled by others and expensive."}, {rank: 3, prompt: "A 15th-century navigator wants to sail from Portugal to India by sea. Which route would he take?", choices: ["North through the Arctic","Straight east overland","West across the Pacific","South around the tip of Africa"], answer: 3, explanation: "Portuguese ships reached India by rounding southern Africa."}]},
  {id: "8019bb7c-d3be-40d2-8552-9dc4c41be647", name: "Reformation", order: 141, questions: [{rank: 1, prompt: "Who nailed his Ninety-Five Theses to a church door in 1517?", choices: ["John Calvin","Henry VIII","Galileo","Martin Luther"], answer: 3, explanation: "Luther's theses challenged the sale of indulgences."}, {rank: 2, prompt: "Why did the printing press help the Reformation spread?", choices: ["It printed money for reformers","It replaced churches","It was invented by the Pope","It let new ideas be copied and shared quickly and cheaply"], answer: 3, explanation: "Printed pamphlets carried reformers' arguments far and fast."}, {rank: 3, prompt: "You're a reformer in the 1520s who wants ordinary people across Germany to read your ideas. What do you do?", choices: ["Print pamphlets in German on a printing press","Hand-copy them in Latin","Send them privately to the Pope","Read them aloud only in Rome"], answer: 0, explanation: "Printing in the local language let Luther's ideas reach huge numbers of readers."}]},
  {id: "8372e166-5560-4df4-b7bb-80773fefb650", name: "Atlantic Slave Trade", order: 142, questions: [{rank: 1, prompt: "Roughly how many Africans were forcibly carried across the Atlantic in the slave trade?", choices: ["About 100,000","About 1 million","About 12 million","About 100 million"], answer: 2, explanation: "Historians estimate about 12.5 million people were transported."}, {rank: 2, prompt: "Why did the plantation economies of the Americas depend so heavily on enslaved labor?", choices: ["Free workers were not allowed","Machines did most of the work","Crops like sugar and cotton needed huge amounts of labor, which enslavers forced from captives","The crops grew without labor"], answer: 2, explanation: "Enslavers built their profits on forced, unpaid labor."}, {rank: 3, prompt: "You're writing about what the Middle Passage was like for the people forced through it. Which source gives a firsthand account?", choices: ["A modern novel set at sea","A plantation's sale advertisement","The memoir of Olaudah Equiano, who was enslaved as a boy","A ship owner's profit ledger"], answer: 2, explanation: "Equiano wrote about his own crossing. The others are records by enslavers or later fiction."}]},
  {id: "df698120-7283-45f1-bf2f-77a81a1ab24e", name: "Industrial Revolution", order: 143, questions: [{rank: 1, prompt: "In which country did the Industrial Revolution begin?", choices: ["France","Great Britain","The United States","Japan"], answer: 1, explanation: "It began in Britain in the late 1700s."}, {rank: 2, prompt: "Why did cities grow so fast during the Industrial Revolution?", choices: ["People moved from farms to work in factories","Cities were safer than villages","Farming became illegal","Factories were built in the countryside"], answer: 0, explanation: "Factory jobs drew workers into towns."}, {rank: 3, prompt: "You're opening a factory in 1840 and want to ship goods across the country quickly. What should you build near?", choices: ["A railway line","A windmill","A horse trail","A Roman road"], answer: 0, explanation: "Railways, newly spreading by the 1840s, moved heavy goods far faster than anything before."}]},
  {id: "93bd3552-e4df-471d-82c3-06b2c891fcd0", name: "French Revolution", order: 144, questions: [{rank: 1, prompt: "Which Paris prison was stormed on July 14, 1789?", choices: ["The Bastille","The Louvre","Versailles","Notre-Dame"], answer: 0, explanation: "The storming of the Bastille is marked as France's national day."}, {rank: 2, prompt: "What ideals did the French Revolution's slogan \"Liberty, Equality, Fraternity\" stand for?", choices: ["Loyalty to the king","Freedom, equal rights and solidarity among citizens","Wealth for the nobles","Religious unity"], answer: 1, explanation: "It called for a society of free and equal citizens."}, {rank: 3, prompt: "You're drafting a declaration of rights in the spirit of the French Revolution. Which clause fits?", choices: ["Only the clergy may vote.","The king's word is law.","Nobles shall pay no taxes.","All citizens are equal before the law."], answer: 3, explanation: "The Revolution rejected privilege by birth in favor of equal rights for citizens."}]},
  {id: "d982e28f-bdbd-4748-bb3f-3e47a0ed9831", name: "Colonialism", order: 145, questions: [{rank: 1, prompt: "Which European country had the largest colonial empire by the early 1900s?", choices: ["Germany","Britain","Italy","Belgium"], answer: 1, explanation: "The British Empire covered about a quarter of the world's land."}, {rank: 2, prompt: "Why did European powers want colonies in the 1800s?", choices: ["To give land away","For raw materials, markets and power","To spread farming to empty lands","Because they had no resources at home"], answer: 1, explanation: "Colonies supplied resources and markets and raised a nation's power."}, {rank: 3, prompt: "You're researching a colonial war and want a balanced view. Which sources should you use?", choices: ["Two colonial officials' reports","A modern film about the war","Colonial officials' reports alongside accounts from the colonized people","A colonial newspaper and a governor's diary"], answer: 2, explanation: "Sources from both sides show what each one saw and left out."}]},
  {id: "37e95da4-db0b-4f7f-b5fc-3555ebc2c508", name: "World War I", order: 146, questions: [{rank: 1, prompt: "Whose assassination in 1914 triggered World War I?", choices: ["Tsar Nicholas II","Kaiser Wilhelm II","Archduke Franz Ferdinand","Otto von Bismarck"], answer: 2, explanation: "He was shot in Sarajevo in June 1914."}, {rank: 2, prompt: "Why did the Western Front become a stalemate of trenches?", choices: ["Soldiers refused to fight","The weather stopped all movement","Machine guns and artillery made attacks across open ground deadly","Both sides ran out of soldiers"], answer: 2, explanation: "Defensive weapons were stronger than the means of attack."}, {rank: 3, prompt: "Your country is considering an alliance like those of 1914, promising to defend any member that's attacked. What risk should you weigh?", choices: ["A small conflict involving one ally could pull you into a large war","It would stop all trade with other countries","Allies would never actually need help","It would make your army smaller"], answer: 0, explanation: "In 1914 alliance promises turned one assassination into a war across Europe."}]},
  {id: "d5c353f3-d27c-425f-bf0c-cd6f622bf3de", name: "World War II", order: 147, questions: [{rank: 1, prompt: "In which year did World War II end?", choices: ["1939","1945","1918","1950"], answer: 1, explanation: "The war ended in 1945, in Europe in May and in Asia in September."}, {rank: 2, prompt: "Why did Germany's 1941 invasion of the Soviet Union matter so much to the war's outcome?", choices: ["It forced Germany to fight on two major fronts","It ended the war in the west","It made the Soviets join Germany","It had little effect"], answer: 0, explanation: "The Eastern Front drained German forces enormously."}, {rank: 3, prompt: "You're planning the 1944 D-Day landings and need surprise. What should you do?", choices: ["Announce the date to rally your troops","Fool the enemy about where you'll land, with fake armies and false radio traffic","Land where the defenses are strongest","Wait for the winter storms"], answer: 1, explanation: "The Allies' deception convinced Germany the landing would come at Calais, not Normandy."}]},
  {id: "6351fe56-22c7-4c16-9ead-9278c52b9cf1", name: "The Holocaust", order: 148, questions: [{rank: 1, prompt: "About how many Jews were murdered in the Holocaust?", choices: ["About 600,000","About 60,000","About 60 million","About 6 million"], answer: 3, explanation: "Around six million Jews were murdered."}, {rank: 2, prompt: "What did the Nuremberg Laws of 1935 show about how Nazi persecution worked?", choices: ["Discrimination was written into the legal system as state policy","It relied only on mob violence","It was kept entirely secret","It applied only outside Germany"], answer: 0, explanation: "The laws stripped Jews of citizenship and rights by law."}, {rank: 3, prompt: "A friend shares a post claiming the Holocaust's death toll was invented. How do you check the claim?", choices: ["Ask the person who posted it","Believe it if many people have shared it","Compare it with Nazi records, camp documents and survivor testimony gathered by historians","Look for other posts that agree"], answer: 2, explanation: "The death toll is established by the Nazis' own records and overwhelming evidence."}]},
  {id: "75c03090-4bc2-4157-8c14-b770448909e7", name: "Cold War", order: 149, questions: [{rank: 1, prompt: "Which wall, a symbol of the Cold War, came down in 1989?", choices: ["The Great Wall","The Berlin Wall","Hadrian's Wall","The Western Wall"], answer: 1, explanation: "The Berlin Wall divided East and West Berlin."}, {rank: 2, prompt: "Why is it called the Cold War?", choices: ["It happened in cold countries","It took place in winter","No weapons existed","The superpowers never fought each other directly"], answer: 3, explanation: "The rivalry played out through arms races and proxy wars, not direct battle."}, {rank: 3, prompt: "You lead a country in a nuclear standoff with a rival. Going by how the Cuban Missile Crisis ended, what should you do?", choices: ["Cut off all contact","Strike first before they can","Talk directly and offer a trade that lets both sides back down","Issue a public ultimatum with no way out"], answer: 2, explanation: "Kennedy and Khrushchev ended it with a quiet deal: Soviet missiles out of Cuba, US missiles out of Turkey."}]}
] AS x
MATCH (t:Topic {id: x.id}), (c:Collection {id: "general-schooling-knowledge"})
MERGE (c)-[contains:CONTAINS]->(t)
SET contains.order = x.order
WITH t, x
UNWIND x.questions AS q
MATCH (t)-[:HAS_LEVEL]->(l:BloomLevel {rank: q.rank})
MERGE (question:QuizQuestion)-[:TESTS]->(l)
ON CREATE SET question.id = randomUUID(), question.prompt = q.prompt, question.choices = q.choices,
              question.answer = q.answer, question.explanation = q.explanation, question.createdAt = datetime();

UNWIND [
  {id: "60f43bce-1874-4fdf-8926-2e031409db3c", name: "Decolonization", order: 150, questions: [{rank: 1, prompt: "Who led India's nonviolent movement for independence from Britain?", choices: ["Nelson Mandela","Mahatma Gandhi","Kwame Nkrumah","Ho Chi Minh"], answer: 1, explanation: "Gandhi led mass nonviolent resistance until independence in 1947."}, {rank: 2, prompt: "Why did many colonies win independence after World War II?", choices: ["Colonies were given away as gifts","European powers were weakened and independence movements grew stronger","The colonies asked to be ruled","Europe gained more power"], answer: 1, explanation: "War-weakened empires faced rising demands for self-rule."}, {rank: 3, prompt: "A former colony's economy depends on exporting one crop to its old ruler. What should its new government do?", choices: ["Build up other industries and trading partners","Grow even more of that one crop","Trade only with the former ruler","Close its ports to all trade"], answer: 0, explanation: "Spreading its economy across more industries and partners makes it less dependent on one buyer."}]},
  {id: "7fee5cd3-6d8d-41a6-841b-5e7cd9d42933", name: "Globalization", order: 151, questions: [{rank: 1, prompt: "Which is a common criticism of globalization?", choices: ["Jobs can move to countries with lower wages","It makes goods more expensive everywhere","It ends all trade","It stops the internet"], answer: 0, explanation: "Firms can relocate work to where labor is cheaper."}, {rank: 2, prompt: "Why has globalization sped up since the 1990s?", choices: ["Countries stopped trading","Cheaper transport and the internet made worldwide trade and communication easier","Fewer goods were made","Travel became harder"], answer: 1, explanation: "Faster, cheaper connections link economies more closely."}, {rank: 3, prompt: "You make handmade bags and want customers all over the world. What's the simplest way to reach them?", choices: ["Wait for a buyer to visit","Sell only at your local market","Sell online and ship internationally","Open a shop in every country"], answer: 2, explanation: "Online stores and global shipping let even small sellers reach worldwide markets."}]},
  {id: "5bb22fd7-fef8-4867-8805-bb1bd789f832", name: "Maps", order: 152, questions: [{rank: 1, prompt: "What is the part of a map that explains its symbols called?", choices: ["The scale","The compass rose","The grid","The legend, or key"], answer: 3, explanation: "The legend tells you what each symbol means."}, {rank: 2, prompt: "Why do flat world maps distort the sizes of some countries?", choices: ["It's impossible to flatten a round globe without stretching it","Mapmakers make mistakes on purpose","Countries change size","The Earth is flat"], answer: 0, explanation: "Turning a sphere into a flat map always distorts something."}, {rank: 3, prompt: "A map's scale is 1 cm to 5 km. Two towns are 4 cm apart on the map. How far apart are they really?", choices: ["9 kilometers","20 kilometers","4 kilometers","1.25 kilometers"], answer: 1, explanation: "4 cm times 5 km per cm is 20 km."}]},
  {id: "1cab3214-581b-4ba6-9bee-ea9b221bc8ac", name: "Continents and Oceans", order: 153, questions: [{rank: 1, prompt: "Which is the largest ocean?", choices: ["The Pacific","The Atlantic","The Indian","The Southern"], answer: 0, explanation: "The Pacific is the biggest and deepest ocean."}, {rank: 2, prompt: "Why is Australia sometimes called an island continent?", choices: ["It's the smallest island","It's part of Asia","It's a continent surrounded entirely by ocean","It has no land borders by law"], answer: 2, explanation: "Australia is a single landmass bounded on every side by sea."}, {rank: 3, prompt: "A ship sails west from the coast of Portugal and keeps going. Which ocean does it cross first?", choices: ["The Pacific","The Indian","The Atlantic","The Arctic"], answer: 2, explanation: "West of Portugal lies the Atlantic."}]},
  {id: "2efd2bdb-0a45-4ddd-8e72-cd3b77e38a3a", name: "Landforms", order: 154, questions: [{rank: 1, prompt: "What is a large, flat area of land raised high above its surroundings called?", choices: ["A plateau","A valley","A plain","A peninsula"], answer: 0, explanation: "A plateau is an elevated flat area."}, {rank: 2, prompt: "How does a delta form?", choices: ["Wind piles sand up","A volcano erupts underwater","Glaciers push rock into the sea","A river slows at its mouth and drops its sediment"], answer: 3, explanation: "As the river meets the sea, it deposits the sediment it carried."}, {rank: 3, prompt: "You're choosing farmland with rich, flat soil. Which landform should you pick?", choices: ["A sand dune","A river delta or floodplain","A canyon floor","A mountain ridge"], answer: 1, explanation: "Rivers drop fertile silt on their deltas and floodplains."}]},
  {id: "07cd3eca-6fb4-41da-bc38-956922a49f64", name: "Latitude and Longitude", order: 155, questions: [{rank: 1, prompt: "What is the line of 0 degrees longitude called?", choices: ["The equator","The Tropic of Cancer","The prime meridian","The international date line"], answer: 2, explanation: "The prime meridian runs through Greenwich, England."}, {rank: 2, prompt: "Why do lines of longitude meet at the poles while lines of latitude never meet?", choices: ["Latitude is drawn only on maps","Longitude lines are straight","They both meet at the equator","Longitude lines run between the poles, while latitude lines circle the globe parallel to each other"], answer: 3, explanation: "Lines that run pole to pole must meet there, while lines circling the globe stay a fixed distance apart."}, {rank: 3, prompt: "A ship radios its position as 40 degrees north, 70 degrees west. Which ocean is it in?", choices: ["The Pacific, off California","The Atlantic, off the northeastern United States","The Arctic Ocean","The Indian Ocean"], answer: 1, explanation: "North of the equator and west of Greenwich at 70 degrees puts it off New England."}]},
  {id: "e66f21d0-e850-41ca-834c-37eaba7bd74f", name: "Climate Zones", order: 156, questions: [{rank: 1, prompt: "Which climate zone has hot weather and heavy rain all year?", choices: ["Polar","Tropical","Temperate","Arid"], answer: 1, explanation: "Tropical climates near the equator are hot and wet."}, {rank: 2, prompt: "Why are places near the equator warmer than places near the poles?", choices: ["The equator is closer to the sun","The poles have no sunlight ever","The equator has more water","Sunlight strikes the equator more directly"], answer: 3, explanation: "Direct rays concentrate the sun's energy."}, {rank: 3, prompt: "You want to grow olives and grapes, which like hot dry summers and mild wet winters. Where should you look for land?", choices: ["The tundra","A tropical rainforest","Coasts with a Mediterranean climate, about 30 to 45 degrees from the equator","Inland deserts near the equator"], answer: 2, explanation: "That's the Mediterranean climate, found on the west sides of continents in those latitudes."}]},
  {id: "80d7249e-e172-4707-9806-f381ba37d974", name: "Biomes", order: 157, questions: [{rank: 1, prompt: "Which biome has the greatest variety of plant and animal species?", choices: ["Desert","Tropical rainforest","Tundra","Taiga"], answer: 1, explanation: "Rainforests hold most of the world's species."}, {rank: 2, prompt: "Why do so few trees grow in the tundra?", choices: ["It rains too much","There is too much sun","The ground is frozen most of the year and the growing season is short","Animals eat all the trees"], answer: 2, explanation: "Permafrost and cold stop trees from rooting and growing."}, {rank: 3, prompt: "You're packing for a week in a tropical rainforest. What matters most?", choices: ["A heavy winter coat","Goggles for sandstorms","Light rain gear and quick-drying clothes","Extra water bottles, since water is scarce"], answer: 2, explanation: "Rainforests are hot and very wet all year."}]},
  {id: "392b92bf-5d3a-460d-94f4-bd51ffa455ea", name: "Rivers", order: 158, questions: [{rank: 1, prompt: "What is the place where a river begins called?", choices: ["Its mouth","Its source","Its delta","Its tributary"], answer: 1, explanation: "A river's source is where it starts."}, {rank: 2, prompt: "Why do rivers usually flow fastest in their upper course?", choices: ["They carry more water there","The land is steepest there","The sea pulls them","They are widest there"], answer: 1, explanation: "Steep slopes near the source speed up the water."}, {rank: 3, prompt: "You're choosing where to build a house near a river. Where is safest from flooding?", choices: ["On the floodplain right by the river","On higher ground, away from the floodplain","On low ground inside a bend of the river","At the river's mouth"], answer: 1, explanation: "The floodplain is the land the river covers when it floods."}]},
  {id: "79b827c9-4c41-4e85-9c06-e6b1f4f86980", name: "Natural Hazards", order: 159, questions: [{rank: 1, prompt: "What is the ring of volcanoes and earthquake zones around the Pacific Ocean called?", choices: ["The Pacific Belt","The Volcano Line","The Ring of Fire","The Coral Ring"], answer: 2, explanation: "The Ring of Fire circles the Pacific."}, {rank: 2, prompt: "Why are volcanoes and earthquakes found mostly in certain belts around the world?", choices: ["They happen where it's hot","They occur along the edges of tectonic plates","They follow rivers","They occur at random everywhere"], answer: 1, explanation: "Plate boundaries are where the crust moves and breaks."}, {rank: 3, prompt: "You feel a strong earthquake while at the beach, and the sea suddenly draws far back from the shore. What should you do?", choices: ["Walk out to look","Stay on the beach","Move to high ground immediately","Get into the water"], answer: 2, explanation: "A receding sea can signal an incoming tsunami."}]},
  {id: "ad9103fe-1d6b-4a6b-a2b0-eef9a480bc7a", name: "Natural Resources", order: 160, questions: [{rank: 1, prompt: "Which of these is a fossil fuel?", choices: ["Uranium","Natural gas","Hydropower","Geothermal heat"], answer: 1, explanation: "Natural gas formed from ancient living things, like coal and oil."}, {rank: 2, prompt: "Why are fossil fuels called nonrenewable?", choices: ["They can't be burned","They are made by people","They take millions of years to form, so they can't be replaced as fast as we use them","They're found only in deserts"], answer: 2, explanation: "They formed from ancient remains over millions of years, far slower than we use them."}, {rank: 3, prompt: "A country relies on coal for most of its electricity and wants supplies that won't run out. What should it shift toward?", choices: ["Building more coal plants","Burning wood from old forests","Importing more coal","Wind and solar power"], answer: 3, explanation: "Wind and sunshine are replenished naturally, while coal is used up."}]},
  {id: "95ff2a80-f11e-48e9-900e-e948d01f4690", name: "Population Geography", order: 161, questions: [{rank: 1, prompt: "What is the number of people per square kilometer of an area called?", choices: ["Birth rate","Migration rate","Life expectancy","Population density"], answer: 3, explanation: "Population density measures how crowded an area is."}, {rank: 2, prompt: "Why do many wealthier countries have aging populations?", choices: ["People move away when old","Wealthy countries have no children","Fewer children are born and people live longer","Health care shortens lives"], answer: 2, explanation: "Falling birth rates and longer lifespans raise the average age."}, {rank: 3, prompt: "A country's population pyramid is wide at the bottom and narrow at the top. What should its government plan more of?", choices: ["Retirement homes","Pensions","Schools","Fewer maternity wards"], answer: 2, explanation: "A wide base means many children, who will need schools."}]},
  {id: "777af7ed-6a52-4292-b674-70fdc2fc85d7", name: "Urbanization", order: 162, questions: [{rank: 1, prompt: "What is the growth of the share of people living in cities called?", choices: ["Migration","Globalization","Urbanization","Industrialization"], answer: 2, explanation: "Urbanization is the shift of population to cities."}, {rank: 2, prompt: "Why do people move from rural areas to cities?", choices: ["For jobs, services and opportunities","Because farms are illegal","To find more land","Cities are quieter"], answer: 0, explanation: "Cities offer more work, schools and health care."}, {rank: 3, prompt: "A city expects its population to double in 20 years. What should planners do first?", choices: ["Build more parking lots","Ban people from moving there","Plan housing, transit and water ahead of the growth","Wait until slums appear, then act"], answer: 2, explanation: "Planning ahead keeps growth from outrunning housing and services."}]},
  {id: "fa51f0b3-1723-4f43-ab9f-a6076ef287b0", name: "Migration", order: 163, questions: [{rank: 1, prompt: "What is a person forced to flee their country because of war or persecution called?", choices: ["A tourist","An emigrant by choice","A refugee","A commuter"], answer: 2, explanation: "Refugees flee danger and seek safety elsewhere."}, {rank: 2, prompt: "What is the difference between push and pull factors in migration?", choices: ["They are the same thing","Push factors are always good","Pull factors only concern weather","Push factors drive people away from a place, pull factors attract them to another"], answer: 3, explanation: "Migration is shaped by what drives people out and what draws them in."}, {rank: 3, prompt: "You're studying why people left Ireland in the 1840s. Which push factor should you look into?", choices: ["Jobs in American cities","Relatives already living in Boston","Cheap land in Canada","The potato famine"], answer: 3, explanation: "Push factors drive people away from home. The others are pull factors drawing them somewhere."}]},
  {id: "91e90375-c9b5-45b1-af0b-20546298dc2b", name: "Economic Development", order: 164, questions: [{rank: 1, prompt: "What does GDP stand for?", choices: ["Gross domestic product","General development plan","Global debt percentage","Government deficit payment"], answer: 0, explanation: "GDP is the total value of goods and services a country produces."}, {rank: 2, prompt: "Why is GDP per person a better measure of living standards than total GDP?", choices: ["It's always larger","It accounts for population size","It includes only rich people","It ignores income"], answer: 1, explanation: "A large GDP spread over many people can still mean low incomes."}, {rank: 3, prompt: "You're comparing living standards in two countries. Which measure should you use?", choices: ["The Human Development Index, combining income, health and schooling","Total GDP","Land area","Population size"], answer: 0, explanation: "The HDI looks at income per person along with life expectancy and education."}]},
  {id: "f02156ea-0386-4c6f-ba03-19ede4f4bdd5", name: "Sustainable Development", order: 165, questions: [{rank: 1, prompt: "Which international body adopted the 17 Sustainable Development Goals in 2015?", choices: ["The World Bank","NATO","The United Nations","The European Union"], answer: 2, explanation: "The UN adopted the goals for 2030."}, {rank: 2, prompt: "What does sustainable development aim for?", choices: ["Growing as fast as possible","Meeting today's needs without harming future generations' ability to meet theirs","Stopping all development","Using resources before they run out"], answer: 1, explanation: "It balances present needs with the future."}, {rank: 3, prompt: "A town's fishing catch is falling year after year. Which policy makes the fishery sustainable?", choices: ["Catching more while there are fish","Banning fish farming","Draining the lake","Limiting catches so fish can reproduce"], answer: 3, explanation: "Sustainable use takes no more than can be replaced."}]},
  {id: "502335bf-b658-4836-8b50-1b0433dab2ae", name: "Rules and Laws", order: 166, questions: [{rank: 1, prompt: "What is the body of people who hear evidence and decide a verdict in many trials called?", choices: ["A cabinet","A jury","A senate","A council"], answer: 1, explanation: "A jury decides the facts of a case."}, {rank: 2, prompt: "What makes a law different from a household rule?", choices: ["A law is made by a government and enforced by the state","A law is always written in a book at home","Household rules apply to everyone in a country","They are the same thing"], answer: 0, explanation: "Laws come from a government and carry penalties the state enforces."}, {rank: 3, prompt: "A sign says no vehicles over 3 meters tall may enter a tunnel. A van 3.4 meters tall drives in. Has the driver broken the rule?", choices: ["No, because vans are exempt","No, because signs are only advice","Yes, because 3.4 meters is over the limit","Only if the van gets stuck"], answer: 2, explanation: "The rule sets a limit, and the van exceeds it."}]},
  {id: "06353bfb-6874-4621-9938-a56a2772b399", name: "Forms of Government", order: 167, questions: [{rank: 1, prompt: "What is a country whose head of state is elected rather than a monarch called?", choices: ["A monarchy","An empire","A republic","A theocracy"], answer: 2, explanation: "In a republic, the head of state is chosen, not born to the role."}, {rank: 2, prompt: "How does a dictatorship differ from a democracy?", choices: ["Dictatorships hold more elections","Democracies have no laws","Power rests with one ruler or party rather than with elected representatives","They are the same"], answer: 2, explanation: "In a democracy citizens choose their leaders, while a dictator rules without that consent."}, {rank: 3, prompt: "You're founding a country and want elected leaders, with a royal family kept as a symbol. What do you set up?", choices: ["An absolute monarchy","A dictatorship","A theocracy","A constitutional monarchy"], answer: 3, explanation: "In a constitutional monarchy the monarch reigns, but elected bodies govern."}]},
  {id: "39a17533-13d0-4d87-af55-1e19324af02d", name: "Democracy", order: 168, questions: [{rank: 1, prompt: "Which ancient city is often called the birthplace of democracy?", choices: ["Rome","Sparta","Athens","Babylon"], answer: 2, explanation: "Athens practiced an early form of democracy around 500 BCE."}, {rank: 2, prompt: "Why do democracies hold regular elections?", choices: ["To raise taxes","So citizens can choose and replace their leaders","To give leaders life terms","To end debate"], answer: 1, explanation: "Regular elections keep leaders answerable to voters."}, {rank: 3, prompt: "Your 300-member club has to make decisions every month, and most members can't come to meetings. How should it decide, democratically?", choices: ["Whoever turns up decides, with no notice given","Members elect a committee to decide for them","The richest members decide","The founder decides alone"], answer: 1, explanation: "Electing representatives is how democracy works when everyone can't decide directly."}]},
  {id: "5dd1b170-d42c-4193-9b12-f92ba5a6321e", name: "Human Rights", order: 169, questions: [{rank: 1, prompt: "Which organization adopted the Universal Declaration of Human Rights in 1948?", choices: ["The United Nations","The European Union","NATO","The Red Cross"], answer: 0, explanation: "The UN General Assembly adopted it in 1948."}, {rank: 2, prompt: "Why are human rights called universal?", choices: ["They apply only in certain countries","They belong to every person simply because they are human","They are granted by each government","They apply only to citizens"], answer: 1, explanation: "Human rights aren't earned or granted; everyone has them."}, {rank: 3, prompt: "Your employer wants to read workers' personal messages. Which right should you weigh?", choices: ["The right to privacy","The right to education","The right to vote","Freedom of religion"], answer: 0, explanation: "Reading personal communications touches on the right to privacy."}]},
  {id: "49d241a7-d470-4c9f-89cb-b4c8b9675305", name: "Citizenship", order: 170, questions: [{rank: 1, prompt: "In most countries, at what age can citizens vote in national elections?", choices: ["12","18","25","30"], answer: 1, explanation: "Most countries set the voting age at 18."}, {rank: 2, prompt: "Why do citizens have responsibilities as well as rights?", choices: ["Rights are given only after responsibilities","Responsibilities cancel rights","A society works only if people also follow its laws and take part","Only leaders have responsibilities"], answer: 2, explanation: "Rights depend on others respecting them and contributing."}, {rank: 3, prompt: "A citizen disagrees with a new local law. Which is a lawful way to try to change it?", choices: ["Ignore it","Threaten officials","Petition and vote for representatives who will change it","Destroy public property"], answer: 2, explanation: "Democracies let citizens change laws through peaceful means."}]},
  {id: "33e09b25-0434-4062-921e-8b6a1394430a", name: "Separation of Powers", order: 171, questions: [{rank: 1, prompt: "Which branch of government makes laws?", choices: ["The executive","The judicial","The legislative","The military"], answer: 2, explanation: "The legislature, such as a parliament, passes laws."}, {rank: 2, prompt: "Why do many governments split power into separate branches?", choices: ["To stop any one person or group from holding too much power","To make laws faster","To avoid elections","To give the military control"], answer: 0, explanation: "Dividing power guards against abuse."}, {rank: 3, prompt: "You're drafting a constitution and want no one person to control making laws, enforcing them and judging cases. What do you do?", choices: ["Let the army enforce and judge","Let the courts make the laws","Give all three to an elected president","Give each to a separate branch that can check the others"], answer: 3, explanation: "Splitting power among branches that check each other keeps any one from dominating."}]},
  {id: "3a3acf4e-3626-45ed-9cff-cd16c87a6425", name: "Elections", order: 172, questions: [{rank: 1, prompt: "What is a vote that lets all citizens decide directly on a single question called?", choices: ["A primary","A caucus","A referendum","A census"], answer: 2, explanation: "In a referendum, voters decide an issue themselves."}, {rank: 2, prompt: "Why is the ballot kept secret?", choices: ["So people can vote freely without pressure or fear","So votes can't be counted","To make voting faster","Because it's tradition only"], answer: 0, explanation: "Secrecy protects voters from intimidation."}, {rank: 3, prompt: "In a three-candidate race, the winner gets 40% of the vote and the others get 35% and 25%. Under first-past-the-post, who wins?", choices: ["Nobody, since nobody has over half","The one with 40%","The one with 35%","All three share the seat"], answer: 1, explanation: "First-past-the-post gives the win to whoever has the most votes."}]},
  {id: "b88c60ef-9fb8-431d-bd8f-8a1bdc75b283", name: "International Organizations", order: 173, questions: [{rank: 1, prompt: "Which organization deals with global public health?", choices: ["NATO","The IMF","UNESCO","The World Health Organization"], answer: 3, explanation: "The WHO coordinates international health work."}, {rank: 2, prompt: "Why do countries join international organizations?", choices: ["To give up all independence","To cooperate on problems no one country can solve alone","To avoid trade","To form one world government"], answer: 1, explanation: "Shared problems like trade, health and peace need cooperation."}, {rank: 3, prompt: "Your country wants to settle a trade dispute with another under agreed rules. Where should it take the case?", choices: ["The World Trade Organization","The International Olympic Committee","The World Health Organization","UNESCO"], answer: 0, explanation: "The WTO settles disputes over trade between its members."}]},
  {id: "5409f921-368f-4449-ace3-406a38b47b24", name: "Money", order: 174, questions: [{rank: 1, prompt: "What is the money a country uses, such as the euro or the yen, called?", choices: ["Its budget","Its credit","Its tariff","Its currency"], answer: 3, explanation: "Currency is the money in use in a country."}, {rank: 2, prompt: "Why did money replace bartering?", choices: ["It is heavier","It's accepted by everyone, so you don't need someone who wants exactly what you have","Bartering was illegal","Money never loses value"], answer: 1, explanation: "Money works as a medium of exchange anyone will take."}, {rank: 3, prompt: "You have a $20 bill and buy items costing $7.35 and $4.90. How much change do you get?", choices: ["$8.75","$12.25","$7.75","$7.25"], answer: 2, explanation: "7.35 plus 4.90 is 12.25, and 20 minus 12.25 is 7.75."}]},
  {id: "71e0416b-bfea-4674-b065-d9e990019891", name: "Supply and Demand", order: 175, questions: [{rank: 1, prompt: "What is the price at which the amount supplied equals the amount demanded called?", choices: ["The retail price","The equilibrium price","The fixed price","The list price"], answer: 1, explanation: "At equilibrium, there's neither a shortage nor a surplus."}, {rank: 2, prompt: "Why does a concert's ticket price often climb on resale sites when it sells out?", choices: ["Concerts get cheaper to run","Sellers must charge more by law","Demand has fallen","Many people want tickets but few are available"], answer: 3, explanation: "When demand outstrips supply, buyers bid prices up."}, {rank: 3, prompt: "You sell lemonade and keep selling out by noon with a line still waiting. What should you do to earn more?", choices: ["Lower the price","Give it away free","Close earlier","Raise the price a little"], answer: 3, explanation: "When demand is greater than supply, a higher price still sells out and earns more."}]},
  {id: "50dd54e7-aefb-440d-ae7c-33a7e2274a1f", name: "Inflation", order: 176, questions: [{rank: 1, prompt: "Which organization usually raises interest rates to slow inflation?", choices: ["The tax office","The stock exchange","The parliament","The central bank"], answer: 3, explanation: "Central banks set interest rates to control inflation."}, {rank: 2, prompt: "Why can printing a lot of new money cause inflation?", choices: ["It makes goods cheaper","More money chasing the same goods pushes prices up","Printers raise prices","It reduces the money supply"], answer: 1, explanation: "If spending power grows faster than goods do, prices rise."}, {rank: 3, prompt: "Inflation is 6% a year and your savings account pays 1%. What should you consider?", choices: ["Nothing, since your savings are growing","Moving savings somewhere that grows faster than inflation","Putting more into the 1% account","Keeping the cash at home instead"], answer: 1, explanation: "At 1% against 6% inflation, your savings buy less each year."}]},
  {id: "fc58cd3b-49b4-49ff-9cff-90a4152b62a3", name: "Taxation", order: 177, questions: [{rank: 1, prompt: "What is a tax on goods brought into a country called?", choices: ["A tariff","A dividend","An income tax","A subsidy"], answer: 0, explanation: "Tariffs are taxes on imports."}, {rank: 2, prompt: "Why do governments collect taxes?", choices: ["To punish businesses","To pay for public services like roads, schools and defense","To lower prices","To reduce the money supply only"], answer: 1, explanation: "Taxes fund what governments provide."}, {rank: 3, prompt: "A 10% sales tax applies to a $50 purchase. What do you pay in total?", choices: ["$50.10","$55","$60","$45"], answer: 1, explanation: "10% of 50 is 5, added to the price."}]},
  {id: "567a2334-b916-4865-a214-6311d4cd8558", name: "International Trade", order: 178, questions: [{rank: 1, prompt: "What is it called when a country sells goods abroad?", choices: ["Exporting","Importing","Tariffing","Subsidizing"], answer: 0, explanation: "Goods sold to other countries are exports."}, {rank: 2, prompt: "Why might a government put a tax on imported goods?", choices: ["To make imports cheaper","To encourage more imports","To protect its own industries from foreign competition","To lower prices at home"], answer: 2, explanation: "Taxing imports raises their price, helping local producers."}, {rank: 3, prompt: "Country A makes cars cheaply and Country B grows coffee cheaply. What arrangement benefits both?", choices: ["Both make both cars and coffee","Neither trades","A sells cars to B and buys B's coffee","Only A sells"], answer: 2, explanation: "Each specializes in what it does best and trades for the rest."}]},
  {id: "192f7a50-33fe-436f-ad06-912dc69fa57d", name: "Personal Finance", order: 179, questions: [{rank: 1, prompt: "What is a plan for how you'll spend and save your income called?", choices: ["A loan","A mortgage","A dividend","A budget"], answer: 3, explanation: "A budget sets out income and spending."}, {rank: 2, prompt: "Why does saving early for retirement make such a difference?", choices: ["Banks pay more to young people","Money saved early can't be spent","Compound interest lets earnings grow on earlier earnings for longer","Inflation stops for savings"], answer: 2, explanation: "Interest on interest snowballs over time."}, {rank: 3, prompt: "You earn $2,000 a month and spend $1,700. You want to save $3,600 for a trip. How many months will it take?", choices: ["6 months","18 months","2 months","12 months"], answer: 3, explanation: "You save $300 a month, and 3,600 over 300 is 12."}]},
  {id: "005bb52b-1975-4738-85dc-ad6e2970b991", name: "Color Theory", order: 180, questions: [{rank: 1, prompt: "What color do you get by mixing red paint and yellow paint?", choices: ["Purple","Green","Brown","Orange"], answer: 3, explanation: "Red and yellow make orange."}, {rank: 2, prompt: "Why do red and green look so striking side by side?", choices: ["They're complementary colors, opposite on the color wheel","They're the same color","They're both primary colors","They're both cool colors"], answer: 0, explanation: "Opposite colors create strong contrast."}, {rank: 3, prompt: "You have only red, yellow and blue paint and want green leaves. What do you mix?", choices: ["Red and yellow","Yellow and blue","Red and blue","All three"], answer: 1, explanation: "Yellow and blue make green."}]},
  {id: "5e8cce19-d60b-4670-a3c6-e25de88df981", name: "Elements of Art", order: 181, questions: [{rank: 1, prompt: "What does \"texture\" refer to in art?", choices: ["The lightness of a color","How a surface feels or looks like it feels","The size of a work","The artist's signature"], answer: 1, explanation: "Texture is the surface quality."}, {rank: 2, prompt: "What is the difference between shape and form in art?", choices: ["They mean the same thing","Form is flat, shape has depth","Shape is flat and two-dimensional, form is three-dimensional","Shape refers only to color"], answer: 2, explanation: "A circle is a shape, while a sphere is a form."}, {rank: 3, prompt: "An artist wants a flat circle to look like a solid ball. Which element should she change, and how?", choices: ["Value, adding light and shadow","Color, making it brighter","Line, making it thicker","Texture, making it rough"], answer: 0, explanation: "Gradual light and dark make a shape look three-dimensional."}]},
  {id: "2d81c611-e46a-4833-b663-3623ea521fd3", name: "Perspective", order: 182, questions: [{rank: 1, prompt: "What is the point where parallel lines seem to meet in a perspective drawing called?", choices: ["The vanishing point","The focal point","The horizon line","The center line"], answer: 0, explanation: "The vanishing point is where receding lines converge."}, {rank: 2, prompt: "Why do distant mountains look paler and bluer than nearby hills?", choices: ["They are made of blue rock","They are colder","Air between us and them scatters light and softens their color","Our eyes can't see color far away"], answer: 2, explanation: "This effect, atmospheric perspective, helps show distance."}, {rank: 3, prompt: "In a drawing of a straight road, how should the road's edges look as it goes into the distance?", choices: ["They stay parallel","They converge toward a point on the horizon","They spread apart","They curve upward"], answer: 1, explanation: "Lines running away from you appear to meet at a single point on the horizon."}]},
  {id: "27158bd6-d679-4df9-96fa-f82ae4752274", name: "Art History", order: 183, questions: [{rank: 1, prompt: "Who painted the ceiling of the Sistine Chapel?", choices: ["Michelangelo","Leonardo da Vinci","Rembrandt","Picasso"], answer: 0, explanation: "Michelangelo painted it between 1508 and 1512."}, {rank: 2, prompt: "Why did photography change painting in the late 1800s?", choices: ["Photography made paint more expensive","Painting was banned","Photographs were all in color","Painters no longer needed to record exactly what things looked like, so they explored new styles"], answer: 3, explanation: "Freed from exact realism, artists experimented with style."}, {rank: 3, prompt: "You want to paint the way the Impressionists did. How do you work?", choices: ["In a studio, with smooth, hidden brushstrokes","Outdoors, with quick, visible brushstrokes that catch the light","From dreams, with impossible scenes","In flat geometric planes seen from many angles"], answer: 1, explanation: "The Impressionists painted outside to catch passing light, with loose, visible strokes."}]},
  {id: "1488e2ba-fd11-47c3-a36d-9cd01f26cb1c", name: "Art Movements", order: 184, questions: [{rank: 1, prompt: "Which artist is best known for Cubism?", choices: ["Claude Monet","Pablo Picasso","Salvador Dali","Andy Warhol"], answer: 1, explanation: "Picasso and Braque founded Cubism."}, {rank: 2, prompt: "What did Surrealist artists try to show?", choices: ["Dreams and the unconscious mind","Exact photographic detail","Only landscapes","Religious scenes"], answer: 0, explanation: "Surrealists painted dreamlike, illogical images."}, {rank: 3, prompt: "You want to make a Surrealist painting. What would you paint?", choices: ["A guitar broken into flat geometric planes","A realistic bowl of fruit","A melting clock in a dreamlike landscape","Soft outdoor light on a river"], answer: 2, explanation: "Surrealism shows dream images and the unconscious."}]},
  {id: "f4cc6293-49e5-436e-a1f0-a940586ece41", name: "Musical Rhythm", order: 185, questions: [{rank: 1, prompt: "What does the tempo of a piece of music describe?", choices: ["How loud it is","How fast it is played","Which key it is in","How long it lasts"], answer: 1, explanation: "Tempo is the speed of the music."}, {rank: 2, prompt: "Why does a waltz feel different from a march?", choices: ["A waltz is always louder","A waltz groups beats in threes, a march in twos or fours","A march has no beat","They use different notes only"], answer: 1, explanation: "The grouping of beats shapes the feel."}, {rank: 3, prompt: "You're writing a waltz. Which time signature should you use?", choices: ["2/4","3/4","4/4","5/4"], answer: 1, explanation: "A waltz has three beats to a measure, ONE-two-three."}]},
  {id: "3a18f620-f24b-4c82-9012-8a8f39481eaf", name: "Musical Instruments", order: 186, questions: [{rank: 1, prompt: "Which family of instruments does the clarinet belong to?", choices: ["Brass","Woodwind","Strings","Percussion"], answer: 1, explanation: "The clarinet is a woodwind instrument."}, {rank: 2, prompt: "Why does a longer guitar string play a lower note than a shorter one?", choices: ["It's thicker","It vibrates more slowly","It's louder","It's made of different metal"], answer: 1, explanation: "Longer strings vibrate at lower frequencies."}, {rank: 3, prompt: "You want a guitar string to play a lower note. What do you do?", choices: ["Tighten it","Press it down at a fret","Swap it for a thinner string","Loosen it"], answer: 3, explanation: "A looser string vibrates more slowly, which makes a lower note."}]},
  {id: "f9559144-c9a2-403d-927b-1145bdd14dcc", name: "Music Notation", order: 187, questions: [{rank: 1, prompt: "How many lines does a musical staff have?", choices: ["4","5","6","7"], answer: 1, explanation: "A staff has five lines and four spaces."}, {rank: 2, prompt: "What does a whole note tell a musician compared with a half note?", choices: ["Play it twice as loud","Hold it twice as long","Play it an octave higher","Play it faster"], answer: 1, explanation: "A whole note lasts twice as long as a half note."}, {rank: 3, prompt: "A note on the top line of the treble staff is F. What is the note in the space just below it?", choices: ["G","E","D","C"], answer: 1, explanation: "Lines and spaces go up one note at a time, so the space below F is E."}]},
  {id: "7dfbd670-7d9d-4197-ad44-e41c51944d68", name: "Musical Scales", order: 188, questions: [{rank: 1, prompt: "What is the distance from one note to the next note with the same name, such as C to the next C up, called?", choices: ["A chord","A measure","An octave","A tempo"], answer: 2, explanation: "Notes an octave apart share a name and sound alike."}, {rank: 2, prompt: "Why does a minor scale often sound sadder than a major one?", choices: ["It's played slower","It uses fewer notes","It's always quieter","Some of its notes are lowered, changing the pattern of steps"], answer: 3, explanation: "The minor scale's lowered third gives it a darker sound."}, {rank: 3, prompt: "You're playing the G major scale. Which note do you play sharp?", choices: ["E","B","C","F"], answer: 3, explanation: "To keep the major scale's pattern of steps, G major raises F to F sharp."}]},
  {id: "3acd7043-7cd8-4601-8459-739501b0927e", name: "Music History", order: 189, questions: [{rank: 1, prompt: "Which composer kept writing music after becoming deaf?", choices: ["Wolfgang Amadeus Mozart","Frederic Chopin","Ludwig van Beethoven","Antonio Vivaldi"], answer: 2, explanation: "Beethoven composed his Ninth Symphony while profoundly deaf."}, {rank: 2, prompt: "Why is Johann Sebastian Bach seen as a major figure of the Baroque era?", choices: ["He invented the piano","His intricate, many-voiced music summed up the style of the period","He wrote the first symphony","He lived in the 20th century"], answer: 1, explanation: "Bach's counterpoint is a high point of Baroque music."}, {rank: 3, prompt: "You're putting on a concert of Baroque music. Which composers should you choose?", choices: ["Mozart and Haydn","Beethoven and Brahms","Bach and Handel","Debussy and Ravel"], answer: 2, explanation: "Bach and Handel were the leading Baroque composers. Mozart and Haydn were Classical."}]},
  {id: "c9a255cd-b3c7-43af-8c48-07f77fb771a3", name: "Harmony", order: 190, questions: [{rank: 1, prompt: "What is the main tune of a song, which harmony accompanies, called?", choices: ["The rhythm","The melody","The tempo","The key signature"], answer: 1, explanation: "The melody is the tune, and harmony supports it."}, {rank: 2, prompt: "Why do some combinations of notes sound tense and others restful?", choices: ["Louder notes always sound tense","Higher notes are always restful","It depends only on the instrument","Some intervals clash, while others blend smoothly"], answer: 3, explanation: "Dissonant intervals create tension that consonant ones resolve."}, {rank: 3, prompt: "You want a song in C major to end sounding settled and finished. Which chord do you end on?", choices: ["C major","B diminished","F minor","G7"], answer: 0, explanation: "The home chord, the tonic, sounds most at rest. The others pull toward it."}]},
  {id: "64107c8a-9f0c-4782-85de-ac33a688fed4", name: "Hygiene", order: 191, questions: [{rank: 1, prompt: "For about how long should you scrub your hands with soap?", choices: ["About 2 seconds","At least 20 seconds","About 5 minutes","No scrubbing is needed"], answer: 1, explanation: "Health agencies recommend at least 20 seconds."}, {rank: 2, prompt: "Why does washing with soap remove germs better than water alone?", choices: ["Soap is hotter","Water spreads germs","Soap makes hands dry","Soap breaks up oils and dirt that hold germs, so they rinse away"], answer: 3, explanation: "Soap lifts germs off the skin."}, {rank: 3, prompt: "You've been outside and your hands look clean, and you're about to eat. What should you do?", choices: ["Skip washing since they look clean","Wash them with soap anyway","Wipe them on your clothes","Rinse with water only"], answer: 1, explanation: "Germs can be on hands even when they look clean."}]},
  {id: "c352ff50-9307-4d1a-a4a4-46b079214d15", name: "Nutrition", order: 192, questions: [{rank: 1, prompt: "Which nutrient is the body's main source of quick energy?", choices: ["Vitamins","Carbohydrates","Minerals","Water"], answer: 1, explanation: "The body breaks carbohydrates down into glucose for energy."}, {rank: 2, prompt: "Why does the body need fats in the diet?", choices: ["They have no use","Only for flavor","To replace water","For energy, cell building and absorbing some vitamins"], answer: 3, explanation: "Healthy fats are an essential nutrient."}, {rank: 3, prompt: "Someone eats mostly white bread and soda and feels hungry again soon after meals. Which change would help most?", choices: ["Adding protein, fiber and whole grains","Eating more sugar","Skipping breakfast","Drinking more soda"], answer: 0, explanation: "Protein and fiber digest more slowly and keep you full."}]},
  {id: "0df02f62-6e97-41a5-af5a-6acd3658cedf", name: "Physical Fitness", order: 193, questions: [{rank: 1, prompt: "Which kind of exercise builds muscle strength?", choices: ["Resistance training, such as weightlifting","Sleeping","Walking slowly","Stretching only"], answer: 0, explanation: "Working muscles against resistance builds strength."}, {rank: 2, prompt: "Why should you warm up before hard exercise?", choices: ["It makes you tired first","It gradually increases blood flow and loosens muscles to prevent injury","It burns all your energy","It isn't helpful"], answer: 1, explanation: "A warm-up prepares the body for strenuous effort."}, {rank: 3, prompt: "You want to strengthen your heart and lungs. Which activity would help most?", choices: ["Stretching for 5 minutes","Lifting a single heavy weight once","Brisk running or cycling for 30 minutes","Sitting still"], answer: 2, explanation: "Sustained aerobic exercise trains the heart and lungs."}]},
  {id: "22ef41bf-3dc0-4b94-8824-93f24cdf2df4", name: "First Aid", order: 194, questions: [{rank: 1, prompt: "What do the letters CPR stand for?", choices: ["Cardiopulmonary resuscitation","Central pulse recovery","Cardiac pressure release","Chest pumping routine"], answer: 0, explanation: "CPR combines chest compressions with rescue breaths."}, {rank: 2, prompt: "Why should you cool a burn under running water?", choices: ["It cleans the burn of germs only","Water heals all burns instantly","It stops the heat from damaging deeper skin and eases pain","It isn't advised"], answer: 2, explanation: "Cooling stops the burn from spreading through the tissue."}, {rank: 3, prompt: "Someone is bleeding heavily from a cut on their arm. What should you do first?", choices: ["Press firmly on the wound with a clean cloth","Run cold water over it","Give them something to eat","Let it bleed to clean it"], answer: 0, explanation: "Direct pressure slows bleeding."}]},
  {id: "bd2d2494-b94b-4bc9-9df4-7eb611e6fda5", name: "Puberty", order: 195, questions: [{rank: 1, prompt: "Which hormone drives many of the changes of puberty in boys?", choices: ["Insulin","Testosterone","Adrenaline","Estrogen"], answer: 1, explanation: "Testosterone drives male puberty."}, {rank: 2, prompt: "What causes the body changes of puberty?", choices: ["Eating more food","Hormones released as the body matures","Exercise alone","Getting more sleep"], answer: 1, explanation: "Hormones trigger the physical changes of puberty."}, {rank: 3, prompt: "A 13-year-old's skin has become oily and spotty. What's the best advice?", choices: ["Wash the face gently twice a day and don't squeeze spots","Stop washing so the skin can balance","Squeeze the spots to clear them","Scrub hard several times a day"], answer: 0, explanation: "Hormones in puberty make more oil. Gentle washing helps, and squeezing can cause scars."}]},
  {id: "a8177c91-7a11-46a4-84f9-0092e171adf4", name: "Mental Health", order: 196, questions: [{rank: 1, prompt: "Which of these is a common mental health condition?", choices: ["Diabetes","Asthma","Arthritis","Anxiety disorder"], answer: 3, explanation: "Anxiety disorders are among the most common mental health conditions."}, {rank: 2, prompt: "Why is mental health considered as important as physical health?", choices: ["It's separate from the body","It only matters in old age","It affects how people think, feel, work and relate to others","It can't be treated"], answer: 2, explanation: "Mental health shapes daily life and wellbeing."}, {rank: 3, prompt: "A friend has felt hopeless and lost interest in everything for over two weeks. What is the best response?", choices: ["Tell them to cheer up","Ignore it","Avoid them","Encourage them to talk to a doctor or counselor"], answer: 3, explanation: "Lasting low mood may be depression, which professionals can help treat."}]},
  {id: "7a395b04-568d-423b-8bd3-0f7e602240f2", name: "Infectious Disease", order: 197, questions: [{rank: 1, prompt: "What is a disease that spreads from animals to people called?", choices: ["A vaccine","A zoonosis","An allergy","A deficiency"], answer: 1, explanation: "Diseases like rabies spread from animals to humans."}, {rank: 2, prompt: "Why don't antibiotics work against viral infections like the flu?", choices: ["Antibiotics target bacteria, and viruses aren't bacteria","Viruses are too large","The flu is always mild","Antibiotics work on everything"], answer: 0, explanation: "Viruses lack the structures antibiotics attack."}, {rank: 3, prompt: "You're traveling to an area with malaria. What should you do?", choices: ["Drink only bottled water","Get a flu shot","Take antimalarial pills and use mosquito nets and repellent","Take antibiotics"], answer: 2, explanation: "Malaria comes from mosquito bites, so you prevent bites and take medicine against the parasite."}]},
  {id: "10605acd-cac2-41ca-b10a-621bd6770553", name: "Sexual Health", order: 198, questions: [{rank: 1, prompt: "What can protect against HPV, a common sexually transmitted infection?", choices: ["Antibiotics","Vitamin C","Painkillers","A vaccine"], answer: 3, explanation: "The HPV vaccine protects against the virus types that cause most related cancers."}, {rank: 2, prompt: "Why are condoms recommended even when using other birth control?", choices: ["They're the only birth control that works","They replace the need for testing","They prevent all diseases","They also reduce the spread of sexually transmitted infections"], answer: 3, explanation: "Condoms protect against STIs, which most other methods don't."}, {rank: 3, prompt: "Someone is diagnosed with chlamydia. What should they do to avoid catching it again?", choices: ["Rely on the pill for protection","Nothing, one infection gives immunity","Stop the treatment once symptoms ease","Make sure their partners are tested and treated too"], answer: 3, explanation: "An untreated partner can pass it straight back."}]},
  {id: "0e62726a-8a85-4bf3-8a30-6714383fbe8d", name: "Substance Use", order: 199, questions: [{rank: 1, prompt: "Which organ breaks down most of the alcohol in the body?", choices: ["The liver","The lungs","The kidneys","The stomach"], answer: 0, explanation: "The liver metabolizes alcohol."}, {rank: 2, prompt: "Why is nicotine so hard to quit?", choices: ["It has no effects","It improves health","It's highly addictive, and stopping causes withdrawal","It's only habit"], answer: 2, explanation: "The body comes to depend on nicotine."}, {rank: 3, prompt: "You're at a party and plan to have a couple of drinks. How do you keep your blood alcohol lower?", choices: ["Drink on an empty stomach","Drink quickly to get it over with","Have coffee to sober up","Pace your drinks, eat food and alternate with water"], answer: 3, explanation: "Food and time slow how fast alcohol builds up. Coffee doesn't lower it."}]}
] AS x
MATCH (t:Topic {id: x.id}), (c:Collection {id: "general-schooling-knowledge"})
MERGE (c)-[contains:CONTAINS]->(t)
SET contains.order = x.order
WITH t, x
UNWIND x.questions AS q
MATCH (t)-[:HAS_LEVEL]->(l:BloomLevel {rank: q.rank})
MERGE (question:QuizQuestion)-[:TESTS]->(l)
ON CREATE SET question.id = randomUUID(), question.prompt = q.prompt, question.choices = q.choices,
              question.answer = q.answer, question.explanation = q.explanation, question.createdAt = datetime();

UNWIND [
  {id: "f5042dea-80cb-4395-906e-eda94cdcf4a5", name: "Algorithms", order: 200, questions: [{rank: 1, prompt: "What do you call repeating a set of steps in an algorithm until a condition is met?", choices: ["A variable","A bug","A loop","A file"], answer: 2, explanation: "Loops repeat instructions."}, {rank: 2, prompt: "Why does a recipe count as an algorithm?", choices: ["It uses a computer","It's a set of clear steps followed in order to reach a result","It has ingredients","It's written in code"], answer: 1, explanation: "An algorithm is any step-by-step procedure."}, {rank: 3, prompt: "An algorithm doubles a number and then adds 3. What does it give for 5?", choices: ["16","10","8","13"], answer: 3, explanation: "5 doubled is 10, and 10 plus 3 is 13."}]},
  {id: "929c9a65-c2b1-44ab-831d-f7d864303430", name: "Binary Numbers", order: 201, questions: [{rank: 1, prompt: "What is a single binary digit called?", choices: ["A bit","A byte","A pixel","A hertz"], answer: 0, explanation: "A bit is a 0 or a 1."}, {rank: 2, prompt: "Why do computers use binary?", choices: ["Binary is easier for people to read","It uses less electricity than decimal by law","Their circuits have two states, on and off","Computers can only count to 2"], answer: 2, explanation: "Each switch is either on (1) or off (0)."}, {rank: 3, prompt: "What is the decimal value of the binary number 1011?", choices: ["1,011","13","11","7"], answer: 2, explanation: "8 + 0 + 2 + 1 is 11."}]},
  {id: "cc5319ce-e039-443e-9961-051c58e196b0", name: "Programming Fundamentals", order: 202, questions: [{rank: 1, prompt: "What is a mistake in a program's code called?", choices: ["A loop","A function","A compiler","A bug"], answer: 3, explanation: "Errors in code are called bugs."}, {rank: 2, prompt: "Why do programs use variables?", choices: ["To make code run slower","To print text only","To store values that can be used and changed later","To replace loops"], answer: 2, explanation: "Variables hold data the program works with."}, {rank: 3, prompt: "A program sets x = 5, then runs x = x + 3, then x = x * 2. What is x?", choices: ["13","11","10","16"], answer: 3, explanation: "5 plus 3 is 8, and 8 times 2 is 16."}]},
  {id: "1d433b68-929a-4d58-b899-b87c04669736", name: "Data Representation", order: 203, questions: [{rank: 1, prompt: "How many bits are in a byte?", choices: ["8","4","10","16"], answer: 0, explanation: "A byte is 8 bits."}, {rank: 2, prompt: "Why can the same sequence of bits mean a number, a letter or a color?", choices: ["Bits change shape","Each bit is a letter","Its meaning depends on how the program interprets it","Computers guess"], answer: 2, explanation: "Data is just bits until a format assigns them meaning."}, {rank: 3, prompt: "A photo is 1,000 by 1,000 pixels, and each pixel uses 3 bytes. Roughly how much storage does it take uncompressed?", choices: ["3 million bytes, about 3 megabytes","3,000 bytes","1 million bytes","3 billion bytes"], answer: 0, explanation: "1,000 times 1,000 pixels is a million, times 3 bytes."}]},
  {id: "2d8d84a8-afa2-4ab6-accb-0eeaa2629ba6", name: "Boolean Logic", order: 204, questions: [{rank: 1, prompt: "Who is Boolean logic named after?", choices: ["Alan Turing","Charles Babbage","George Boole","Ada Lovelace"], answer: 2, explanation: "The 19th-century mathematician George Boole developed it."}, {rank: 2, prompt: "What is the difference between AND and OR in logic?", choices: ["AND needs both conditions true, OR needs at least one","They are the same","OR needs both conditions true","AND needs neither condition"], answer: 0, explanation: "OR is satisfied by either input; AND only by both."}, {rank: 3, prompt: "A door alarm sounds if the door is open AND the alarm is armed. The door is open but the alarm is off. Does it sound?", choices: ["Yes","Only sometimes","No","It depends on the time"], answer: 2, explanation: "AND needs both conditions true."}]},
  {id: "49f8a636-aa20-41b0-ab83-8e09832806f2", name: "Computer Hardware", order: 205, questions: [{rank: 1, prompt: "What does CPU stand for?", choices: ["Computer power unit","Central processing unit","Central program utility","Core performance upgrade"], answer: 1, explanation: "The CPU carries out a computer's instructions."}, {rank: 2, prompt: "Why does a computer lose what's in its RAM when it's turned off?", choices: ["RAM is a type of hard disk","It's deleted on purpose","RAM needs power to hold data, unlike long-term storage","RAM stores nothing"], answer: 2, explanation: "RAM is volatile memory."}, {rank: 3, prompt: "You want a computer to start up and open files much faster. Which part should you replace an old hard disk with?", choices: ["A bigger monitor","A new keyboard","A sound card","A solid-state drive"], answer: 3, explanation: "Solid-state drives read and write data far faster than spinning disks."}]}
] AS x
MATCH (t:Topic {id: x.id}), (c:Collection {id: "general-schooling-knowledge"})
MERGE (c)-[contains:CONTAINS]->(t)
SET contains.order = x.order
WITH t, x
UNWIND x.questions AS q
MATCH (t)-[:HAS_LEVEL]->(l:BloomLevel {rank: q.rank})
MERGE (question:QuizQuestion)-[:TESTS]->(l)
ON CREATE SET question.id = randomUUID(), question.prompt = q.prompt, question.choices = q.choices,
              question.answer = q.answer, question.explanation = q.explanation, question.createdAt = datetime();
