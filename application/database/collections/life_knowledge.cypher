// =============================================================================
// Atlas of Us — Life Knowledge seed
// Spec: documentation/data_model/topics/topics.md
//
// The Life Knowledge collection, by the id the UI asks for it by, and the
// topics adult life takes that school mostly skipped, which it CONTAINS, each
// by its id, with `order` its place in the walkthrough. Each has three
// QuizQuestions, one TESTS each of its Remember, Understand and Apply levels.
// `answer` is the index of the right one of a question's `choices`. Run
// migrations 022 and 025 first.
//
// Idempotent: safe to re-run. The list and its order are set from this file on
// every run. A question is matched on the level it tests, and written once,
// when the level has none.
// =============================================================================

MERGE (c:Collection {id: "life-knowledge"})
SET c.name = "Life Knowledge",
    c.description = "What adult life takes that school mostly skipped: money, paperwork, work, health, the home, getting around and the people in your life.";

MATCH (:Collection {id: "life-knowledge"})-[contains:CONTAINS]->(:Topic)
DELETE contains;

UNWIND [
  {id: "c22e29ab-9c85-45a2-9148-0a3ef51f18e2", name: "Personal Budgeting", order: 0, questions: [{rank: 1, prompt: "What is the 50/30/20 rule a common guide for?", choices: ["How much tax to set aside from each paycheck","Paying off debts from the smallest to the largest","Splitting take-home pay between needs, wants and saving","How much of a home's price to put down"], answer: 2, explanation: "It suggests about half of take-home pay for needs, 30% for wants and 20% for saving or paying down debt."}, {rank: 2, prompt: "Why do good budgets set money aside each month for costs that only come up a few times a year, like car repairs or yearly bills?", choices: ["Those costs are certain to come, just not monthly, and leaving them out makes the budget look looser than it is","Banks require it before they'll open an account","Yearly bills are always cheaper when paid monthly","It lowers the total amount you spend"], answer: 0, explanation: "Spreading irregular costs over the year means they don't arrive as a shock that the budget can't cover."}, {rank: 3, prompt: "Your take-home pay is 2,400 a month. Rent and bills come to 1,500, and you want to save 10% of your pay. How much is left for everything else?", choices: ["900","760","600","660"], answer: 3, explanation: "10% of 2,400 is 240, and 2,400 minus 1,500 minus 240 leaves 660."}]},
  {id: "bc27d527-baa3-471f-9113-51cb9766edb2", name: "Saving Money", order: 1, questions: [{rank: 1, prompt: "What does \"pay yourself first\" mean?", choices: ["Paying off your own credit card before other bills","Moving money into savings as soon as you're paid, before spending any","Buying something you want before paying the bills","Asking your employer to pay you early"], answer: 1, explanation: "Saving comes off the top of your pay, and you live on what's left."}, {rank: 2, prompt: "Why does an automatic transfer to savings on payday help people save more than saving whatever is left at the end of the month?", choices: ["Banks pay a bonus on automatic transfers","It earns more interest than a manual transfer","The money is saved before it can be spent, without needing willpower each month","It's required to open a savings account"], answer: 2, explanation: "By the end of the month there's rarely anything left, so saving first makes it happen by default."}, {rank: 3, prompt: "You want 1,800 for a trip in 9 months. How much should you put aside each month?", choices: ["200","180","225","150"], answer: 0, explanation: "1,800 divided by 9 months is 200 a month."}]},
  {id: "67363ba4-0fd1-4c90-90ad-8632b071d66f", name: "Emergency Funds", order: 2, questions: [{rank: 1, prompt: "How much do financial planners commonly suggest keeping in an emergency fund?", choices: ["One week of pay","Enough for one large purchase","Ten years of income","Three to six months of essential expenses"], answer: 3, explanation: "That's usually enough to cover a job loss or a big unexpected cost while you recover."}, {rank: 2, prompt: "Why is an emergency fund usually kept in an easy-access savings account rather than invested in stocks?", choices: ["Stocks are illegal for emergency money","It has to be there in full at short notice, and stocks can be down just when you need them","Savings accounts always earn more than stocks","Stocks can't be sold during the week"], answer: 1, explanation: "An emergency fund is for certainty, not growth: its whole value must be ready when trouble hits."}, {rank: 3, prompt: "Your car needs a 900 repair so you can get to work. You have an emergency fund, and a credit card at 24% interest. What should you do?", choices: ["Pay from the emergency fund, then rebuild it","Put it on the credit card and keep the fund untouched","Skip the repair until you've saved separately for it","Take a payday loan so both stay untouched"], answer: 0, explanation: "This is what the fund is for, and using it avoids paying high interest on the card."}]},
  {id: "28718c93-9dc6-4690-a0c8-b8aa3c572d85", name: "Bank Accounts", order: 3, questions: [{rank: 1, prompt: "What kind of bank account is meant for everyday payments and spending?", choices: ["A fixed-term deposit","A retirement account","A checking (current) account","A brokerage account"], answer: 2, explanation: "A checking or current account is built for paying bills, cards and transfers."}, {rank: 2, prompt: "Why does a fixed-term deposit usually pay more interest than an everyday account?", choices: ["The bank charges higher fees on it","You agree to leave the money there for a set time, which the bank can count on","It's protected by the government and the everyday account isn't","Everyday accounts are only for businesses"], answer: 1, explanation: "Money the bank knows it can keep for a while is worth more to it, so it pays more for it."}, {rank: 3, prompt: "You've been charged an overdraft fee twice this month for small card purchases. What's the best change to make?", choices: ["Open a second account at another bank","Stop using your card and only pay cash forever","Ignore it, since the fees are small","Turn on low-balance alerts, and switch off overdraft for card payments if your bank allows it"], answer: 3, explanation: "An alert warns you before you run out, and without overdraft a payment that can't be covered is declined instead of charged a fee."}]},
  {id: "6e7a867a-8e8f-4674-a48f-7da21aa17bc6", name: "Compound Interest", order: 4, questions: [{rank: 1, prompt: "What is compound interest?", choices: ["Interest charged only on the amount you first borrowed","Interest earned on both the original amount and the interest already added","A fee for closing an account early","Interest paid only once, at the end"], answer: 1, explanation: "Interest is added to the balance, so later interest is earned on it too."}, {rank: 2, prompt: "Two people save the same amount each month at the same rate, but one starts ten years earlier. Why does the early starter end up with far more than just ten extra years of deposits?", choices: ["Banks pay higher rates to older accounts","The later saver pays more tax","Their early money has more years for its interest to earn interest too","Deposits made earlier are worth more by law"], answer: 2, explanation: "Compounding grows faster over time, so the earliest years add the most."}, {rank: 3, prompt: "You put 1,000 in an account paying 10% a year, added once a year, and leave it alone. How much is there after 2 years?", choices: ["1,200","1,100","1,210","1,020"], answer: 2, explanation: "After a year it's 1,100, and 10% of 1,100 is 110, which makes 1,210."}]},
  {id: "21938718-71d8-47a5-b973-aae1ebf3f075", name: "Debit and Credit Cards", order: 5, questions: [{rank: 1, prompt: "When you pay with a debit card, where does the money come from?", choices: ["Straight from your bank account","A loan from the card company","Your next paycheck","The shop's account"], answer: 0, explanation: "A debit card spends money you already have in your account."}, {rank: 2, prompt: "Why does a credit card cost some people nothing in interest and others a lot?", choices: ["Interest is only charged to people with low incomes","Card companies pick customers at random","Interest is charged on any balance not paid in full by the due date","Only cash withdrawals are ever charged interest"], answer: 2, explanation: "Pay the full statement balance each month and there's usually no interest; carry a balance and it's charged."}, {rank: 3, prompt: "Your card statement shows a 1,000 balance at 22% interest and a minimum payment of 25. You can afford to pay all of it. What should you do?", choices: ["Pay the minimum and keep the rest in savings","Pay the full 1,000 by the due date","Pay nothing this month and double up next month","Pay half now and half after the due date"], answer: 1, explanation: "Paying in full avoids 22% interest, far more than savings would earn."}]},
  {id: "12c76d72-5de2-4988-823e-a593319406d2", name: "Credit Scores", order: 6, questions: [{rank: 1, prompt: "What does a credit score try to show lenders?", choices: ["How much money you earn","How much you have in savings","How likely you are to repay borrowed money on time","How many bank accounts you have"], answer: 2, explanation: "It's built from your borrowing and repayment history."}, {rank: 2, prompt: "Why do missed payments hurt a credit score more than almost anything else?", choices: ["They're reported to the police","Your record of paying on time is the strongest sign of whether you'll repay in future","They cancel all your other accounts","Lenders only look at the last month"], answer: 1, explanation: "Past repayment is the best predictor lenders have of future repayment."}, {rank: 3, prompt: "You'll apply for a mortgage in six months and want the best rate. What should you do until then?", choices: ["Open a few store cards to build credit quickly","Close all your old credit cards","Run one card up to its limit to show you use credit","Pay every bill on time and avoid applying for new credit"], answer: 3, explanation: "On-time payments help, and each new application can lower the score for a while."}]},
  {id: "6c3f1bc9-dead-48c9-bbea-ec2f7bb1af17", name: "Personal Loans", order: 7, questions: [{rank: 1, prompt: "What does a loan's APR show?", choices: ["The yearly cost of borrowing, including interest and most fees","The amount you can borrow","How many payments you'll make","The bank's yearly profit"], answer: 0, explanation: "APR, the annual percentage rate, lets you compare loans on their full yearly cost."}, {rank: 2, prompt: "Why does a longer loan usually cost more in total, even though each monthly payment is lower?", choices: ["Longer loans always have hidden penalties","Interest is charged for more months on the money still owed","The bank adds the monthly payments twice","Lenders charge more for smaller payments by law"], answer: 1, explanation: "Paying it back more slowly means owing the money, and paying interest on it, for longer."}, {rank: 3, prompt: "A lender offers you 5,000 to repay at 160 a month for 3 years. How much will you repay in total, and how much of that is interest?", choices: ["5,160, with 160 interest","5,480, with 480 interest","6,000, with 1,000 interest","5,760, with 760 interest"], answer: 3, explanation: "160 times 36 months is 5,760, which is 760 more than the 5,000 borrowed."}]},
  {id: "6bbe88c2-d79f-4a7c-917f-3c2c89554b00", name: "Debt Management", order: 8, questions: [{rank: 1, prompt: "What is the \"avalanche\" way of paying off debts?", choices: ["Paying extra on the debt with the highest interest rate first, and the minimum on the rest","Paying off the smallest debt first","Paying every debt the same amount","Combining all debts into one new loan"], answer: 0, explanation: "It clears the most expensive debt first, which costs the least interest overall."}, {rank: 2, prompt: "Paying off the smallest debt first, the \"snowball\" way, can cost more in interest. Why do some people still do better with it?", choices: ["Small debts have higher interest rates by law","Lenders forgive the rest once one debt is paid","Clearing a debt quickly is a win that keeps them going","It lowers the interest rate on the others"], answer: 2, explanation: "Sticking with a plan matters, and early wins help people stick with it."}, {rank: 3, prompt: "You have 300 extra a month and three debts: a credit card at 24%, a car loan at 7%, and a student loan at 4%. Using the avalanche way, where does the 300 go?", choices: ["The student loan","The car loan","Split evenly across all three","The credit card"], answer: 3, explanation: "The avalanche puts extra money on the highest rate first, which is the credit card."}]},
  {id: "4e7ac4e9-5e2f-46b9-a9bb-3e48f4329bea", name: "Mortgage Loans", order: 9, questions: [{rank: 1, prompt: "What is a down payment on a home?", choices: ["The monthly mortgage payment","The part of the price you pay upfront rather than borrow","A fee paid to the real estate agent","The last payment on the mortgage"], answer: 1, explanation: "The rest of the price is borrowed with the mortgage."}, {rank: 2, prompt: "Why do lenders often charge a higher rate when the down payment is small?", choices: ["Small down payments take longer to process","The lender has to pay more tax","Less of the home's value is backing the loan, so the lender takes more risk","Small down payments are only allowed on old homes"], answer: 2, explanation: "If the borrower can't pay and the home is sold, a smaller down payment leaves the lender less room to get its money back."}, {rank: 3, prompt: "You're on a tight budget that couldn't cope with higher payments, and rates are expected to rise. Which mortgage suits you?", choices: ["A fixed-rate mortgage","A variable-rate mortgage","An interest-only mortgage","The one with the lowest rate today, whatever its type"], answer: 0, explanation: "A fixed rate keeps your payments the same, so rising rates can't push them up."}]},
  {id: "98a9b6b4-c568-442d-90ec-ae4d7fa95743", name: "Investment", order: 10, questions: [{rank: 1, prompt: "What does diversification mean in investing?", choices: ["Putting all your money in the best-performing stock","Spreading money across many different investments","Moving money between banks each year","Only investing in your own country's currency"], answer: 1, explanation: "Spreading it out means one bad investment can't sink everything."}, {rank: 2, prompt: "Why do investments that can earn more, like stocks, also swing more in value than a savings account?", choices: ["Banks limit how much savings can change","Stocks are taxed more heavily","Stock prices are set by the government","Higher possible returns are what investors are paid for taking more risk of loss"], answer: 3, explanation: "Return and risk go together: nobody would take the risk without the chance of more."}, {rank: 3, prompt: "You're 30, saving for retirement in 35 years, and can ride out ups and downs. Which mix suits you best?", choices: ["Mostly a broad mix of stocks, with some bonds","All of it in a savings account","All of it in one company's stock","Mostly bonds and cash, so it can never drop"], answer: 0, explanation: "With decades to go, short-term drops have time to recover, and stocks have grown the most over long periods."}]},
  {id: "b1f5729f-2d66-4fe9-9cae-74f3ffe753a9", name: "Index Funds", order: 11, questions: [{rank: 1, prompt: "What does an index fund do?", choices: ["Picks the stocks a manager thinks will beat the market","Lends money to small businesses","Holds the investments in a market index to match its return","Guarantees a fixed yearly return"], answer: 2, explanation: "It simply owns what's in the index, such as a country's largest companies."}, {rank: 2, prompt: "Why do index funds usually charge lower fees than actively managed funds?", choices: ["They follow an index instead of paying managers to pick investments","The government pays part of their costs","They only hold cash","They're only sold to large investors"], answer: 0, explanation: "Copying an index takes little research, so there's less to pay for."}, {rank: 3, prompt: "Two funds track the same index. One charges 0.1% a year and the other 1%. Which should you pick?", choices: ["The 1% fund, since higher fees mean better management","Either, since fees make no difference over time","Split your money evenly between them","The 0.1% fund, since they hold the same things and the lower fee leaves you more"], answer: 3, explanation: "Both get the index's return, and every bit of fee comes straight out of yours, compounding over the years."}]},
  {id: "5d8acf10-7572-4ffa-98a6-4bb1fb70f071", name: "Retirement Savings", order: 12, questions: [{rank: 1, prompt: "What is an employer match in a workplace retirement plan?", choices: ["A bonus paid when you retire","Money your employer adds to your retirement savings when you contribute","A rule that you must save as much as your manager","A loan from your employer against your pension"], answer: 1, explanation: "For example, an employer might add 1 for every 1 you put in, up to a limit."}, {rank: 2, prompt: "Why do many governments give tax breaks on retirement savings?", choices: ["Retirement money can never be spent","Banks pay the tax instead","To encourage people to save for when they stop working","Retirement accounts can't earn returns"], answer: 2, explanation: "Helping people provide for their own old age eases pressure on public support later."}, {rank: 3, prompt: "Your employer matches contributions up to 5% of your pay, and you put in 2%. What should you do first?", choices: ["Raise your contribution to 5% to get the full match","Stop contributing and save in a bank instead","Keep it at 2%, since the match is optional","Drop to 1% and invest the rest yourself"], answer: 0, explanation: "The match is extra pay you only get by contributing, an instant return no other investment beats."}]},
  {id: "a35f9aa9-0b44-44c6-b723-d29d26b2ee44", name: "Comparison Shopping", order: 13, questions: [{rank: 1, prompt: "What does a shelf label's unit price show?", choices: ["The price of one pack","The price before tax","The shop's profit on the item","The price per amount, such as per kilogram or per liter"], answer: 3, explanation: "It lets you compare packs of different sizes fairly."}, {rank: 2, prompt: "Why can a bigger pack sometimes cost more per unit than a smaller one?", choices: ["Bigger packs always contain more packaging by law","Sellers price each pack separately, so bigger isn't always cheaper per unit","Unit prices only apply to fresh food","Taxes are higher on large packs"], answer: 1, explanation: "Shops know people assume bulk is cheaper, so it pays to check the unit price."}, {rank: 3, prompt: "A 500 g box of cereal costs 3.00, and a 750 g box costs 4.20. Which is cheaper per 100 g?", choices: ["The 500 g box","They cost the same per 100 g","The 750 g box","You can't tell without the brand"], answer: 2, explanation: "The 500 g box is 0.60 per 100 g, and the 750 g box is 0.56."}]},
  {id: "61532bcb-af23-490d-bb04-f34985c59472", name: "Income Tax", order: 14, questions: [{rank: 1, prompt: "In a progressive income tax, what happens as income rises?", choices: ["Everyone pays the same amount","The rate falls on higher income","Higher portions of income are taxed at higher rates","Tax is only paid on the first part of income"], answer: 2, explanation: "Income is taxed in bands, with higher bands at higher rates."}, {rank: 2, prompt: "Why doesn't moving into a higher tax bracket cut your take-home pay?", choices: ["Only the income above the bracket's threshold is taxed at the higher rate","Employers make up the difference","Higher brackets don't apply to wages","The higher rate only starts the next year"], answer: 0, explanation: "The income below the threshold is still taxed at the lower rates."}, {rank: 3, prompt: "Income up to 20,000 is taxed at 10%, and income above that at 20%. You earn 30,000. How much tax do you owe?", choices: ["6,000","3,000","5,000","4,000"], answer: 3, explanation: "10% of the first 20,000 is 2,000, and 20% of the other 10,000 is 2,000."}]},
  {id: "12415d9b-f358-43d8-b045-3c608ffb5d46", name: "Tax Returns", order: 15, questions: [{rank: 1, prompt: "What is a tax return?", choices: ["A refund the government sends everyone each year","A bill from your employer","A form to change jobs","A report of your income and deductions that works out what tax you owe"], answer: 3, explanation: "It's sent to the tax authority, which compares it with what you've already paid."}, {rank: 2, prompt: "Why might someone get a refund after filing a tax return?", choices: ["Refunds are a reward for filing early","More tax was taken from their pay during the year than they owed","The government shares its surplus","They earned less than their neighbors"], answer: 1, explanation: "The refund gives back what was overpaid."}, {rank: 3, prompt: "You did some freelance work this year alongside your job. What should you do when filing your return?", choices: ["Report the freelance income too, with records of what you earned and spent for it","Leave it off, since your employer already handled your tax","Report it only if you were paid by bank transfer","Wait for the tax authority to ask about it"], answer: 0, explanation: "All income is usually taxable, and records back up the costs you can deduct."}]},
  {id: "09bbb092-db29-4c05-a83f-c1150d2604d1", name: "Contract Law", order: 16, questions: [{rank: 1, prompt: "What usually makes an agreement a binding contract?", choices: ["Signing it in front of a lawyer","An offer, its acceptance, and something of value exchanged","Writing it on official paper","Both sides being over 30"], answer: 1, explanation: "Many contracts are binding without a signature or lawyer once these are in place."}, {rank: 2, prompt: "Why is a written contract safer than a spoken one, even where spoken ones are binding?", choices: ["Spoken contracts expire after a month","Courts only accept typed documents","It records exactly what was agreed, so it can be proven later","Written contracts can't be broken"], answer: 2, explanation: "Memories differ, and a written record settles what the terms were."}, {rank: 3, prompt: "The gym membership you're about to sign renews automatically each year. What should you do?", choices: ["Sign it, since renewal terms can't be enforced","Cross out the clause after you sign","Ask the salesperson to promise it won't renew","Check how and by when you can cancel before signing"], answer: 3, explanation: "Knowing the cancellation terms up front stops you being charged for a year you didn't want."}]},
  {id: "a9e438ca-b55f-4b60-a8d1-02224f05eaab", name: "Home Rental", order: 17, questions: [{rank: 1, prompt: "What is a security deposit when renting?", choices: ["Money held to cover damage or unpaid rent, returned at the end if there's neither","The first month's rent","A fee the agent keeps","Money for the building's security guard"], answer: 0, explanation: "It's the tenant's money, held as a guarantee."}, {rank: 2, prompt: "Why should you photograph a rented home when you move in?", choices: ["Landlords require it by law","To decide where the furniture goes","It records its condition, so you aren't charged for damage you didn't cause","To advertise it later"], answer: 2, explanation: "Dated photos are strong evidence if the deposit is disputed."}, {rank: 3, prompt: "A common guide is to keep rent under about a third of take-home pay. For a rent of 1,200 a month, what's the lowest monthly take-home pay that fits?", choices: ["2,400","3,600","4,800","1,800"], answer: 1, explanation: "1,200 times 3 is 3,600."}]},
  {id: "a0ca6554-5a2a-4732-9d62-a4b36031ff4f", name: "Tenant Rights", order: 18, questions: [{rank: 1, prompt: "In most places, what must a landlord usually give before entering a rented home, except in emergencies?", choices: ["A rent reduction","A new lease","A spare key to the neighbors","Advance notice"], answer: 3, explanation: "Tenants have a right to privacy in their home."}, {rank: 2, prompt: "Why do tenancy laws usually make a landlord go through a legal process to evict someone?", choices: ["To slow down rent increases","To stop tenants being thrown out without a fair chance to respond","Because landlords can't own more than one home","To collect a government fee"], answer: 1, explanation: "A process protects tenants from sudden or unfair eviction."}, {rank: 3, prompt: "Your heating has broken in winter, and the landlord hasn't answered your phone call. What should you do next?", choices: ["Report it in writing, keep a copy, and contact a tenant advice service if it isn't fixed","Stop paying rent straight away","Change the locks","Hire someone and take double the cost out of the rent"], answer: 0, explanation: "A written record shows you reported it, and withholding rent on your own can put you in the wrong."}]},
  {id: "dfcef0a6-d5ea-4522-bbee-44a539defdf7", name: "Home Buying", order: 19, questions: [{rank: 1, prompt: "What is a home inspection?", choices: ["A tax assessment of the home","A visit from the neighbors","A professional check of a home's condition before you buy","The seller's tour of the home"], answer: 2, explanation: "An inspector looks for problems such as damp, roof damage or faulty wiring."}, {rank: 2, prompt: "Why do buyers usually get a mortgage pre-approval before house hunting?", choices: ["It shows what they can borrow and makes sellers take their offer seriously","It locks in the house price","It's required to view homes","It means they don't need a down payment"], answer: 0, explanation: "It sets a realistic budget and shows sellers the buyer can pay."}, {rank: 3, prompt: "The inspection finds the roof needs 8,000 of repairs. What's a sensible next step?", choices: ["Ignore it, since inspections always find something","Cancel your mortgage","Offer the seller more to make sure you get the house","Ask the seller to lower the price or fix it before the sale"], answer: 3, explanation: "A major defect is a reason to renegotiate, or to walk away."}]},
  {id: "8fbe1eb7-b2b6-474a-be70-54f7fbb0631d", name: "Insurance", order: 20, questions: [{rank: 1, prompt: "What is a deductible (or excess) on an insurance policy?", choices: ["The yearly cost of the policy","The amount you pay yourself on a claim before the insurer pays","A refund for not claiming","The most the insurer will pay"], answer: 1, explanation: "If the deductible is 500 and the damage is 2,000, the insurer pays 1,500."}, {rank: 2, prompt: "Most people pay more in premiums than they ever claim. Why is insurance still worth having?", choices: ["Premiums are refunded when you retire","Insurers must return unused premiums","It's always cheaper than paying yourself","It turns a rare, huge loss you couldn't afford into a small, regular cost"], answer: 3, explanation: "You're paying to avoid a loss that would ruin you, not to come out ahead."}, {rank: 3, prompt: "You could easily pay a 1,000 car repair yourself, but not a 20,000 one. Choosing a policy, what should you do?", choices: ["Pick the lowest deductible, whatever the premium","Skip insurance","Pick a higher deductible to lower the premium","Insure only small repairs"], answer: 2, explanation: "Covering small costs yourself makes the premium cheaper, while the big loss stays insured."}]},
  {id: "fff6d43c-d8c8-40d4-8974-bd901ecaaa59", name: "Car Insurance", order: 21, questions: [{rank: 1, prompt: "What does third-party (liability) car insurance cover?", choices: ["Damage and injury you cause to other people and their property","Damage to your own car only","Your car being stolen","Breakdowns and repairs"], answer: 0, explanation: "It's the minimum most countries require by law."}, {rank: 2, prompt: "Why do young, new drivers usually pay more for car insurance?", choices: ["They drive more expensive cars","The law sets a higher price for them","As a group they have more accidents, so insurers expect more claims","They have to buy two policies"], answer: 2, explanation: "Premiums follow the risk insurers expect."}, {rank: 3, prompt: "You've had a minor accident, and the other driver suggests sorting it out privately. What should you do at the scene?", choices: ["Leave right away","Exchange names, contact and insurance details, and take photos","Admit fault so it's quicker","Agree a cash amount on the spot"], answer: 1, explanation: "Records protect you if the damage costs more than it looks or the other driver changes their story."}]},
  {id: "79677e21-2210-447a-bbfc-91053603f872", name: "Wills and Testaments", order: 22, questions: [{rank: 1, prompt: "What is the executor of a will?", choices: ["The lawyer who wrote it","The oldest child","A judge who reads it","The person who carries out its instructions"], answer: 3, explanation: "The executor gathers the estate, pays debts and passes on what's left as the will says."}, {rank: 2, prompt: "Why should people with young children write a will?", choices: ["It names who would look after the children and leaves things where they want, instead of following default rules","Wills lower income tax","Children can't inherit without one","Schools ask for a copy"], answer: 0, explanation: "Without one, the law decides who inherits, and a court may decide who raises the children."}, {rank: 3, prompt: "You've had a child since you wrote your will. What should you do?", choices: ["Nothing, since wills update themselves","Tell your family what you want","Update the will, including a guardian for the child","Write a note on the old copy"], answer: 2, explanation: "Only a properly made new will or change reliably counts."}]},
  {id: "76366b72-c06a-49a2-a127-28935ae60914", name: "Consumer Law", order: 23, questions: [{rank: 1, prompt: "In most countries, what can you usually expect if something you bought turns out faulty soon after?", choices: ["Nothing, if the shop has a no-refunds sign","A repair, replacement or refund","Only a store voucher","A discount on your next purchase"], answer: 1, explanation: "Goods have to be of reasonable quality and work as described."}, {rank: 2, prompt: "Why can't a shop take away your rights with a \"no refunds\" sign?", choices: ["Signs only apply to sale items","Shops always refund anyway","Signs must be in two languages","Basic rights are set by law, and a sign can't remove a legal right"], answer: 3, explanation: "Contracts and notices can't override consumer protection law."}, {rank: 3, prompt: "A kettle you bought last week has stopped working, and the shop tells you to contact the manufacturer. What should you do?", choices: ["Insist the shop deals with it, since your purchase was from them","Contact the manufacturer, since the shop is right","Throw it away and buy another","Wait for the warranty card to arrive"], answer: 0, explanation: "Your rights are usually against the seller you bought it from."}]},
  {id: "c27ec20c-0efa-441b-9799-325ded39b177", name: "Warranties", order: 24, questions: [{rank: 1, prompt: "What is an extended warranty?", choices: ["The warranty that comes free with every product","A promise from the government","Extra cover you can buy that lasts past the standard warranty","Insurance on your home"], answer: 2, explanation: "It's sold separately, often at the till."}, {rank: 2, prompt: "Why are extended warranties often poor value?", choices: ["They're illegal in most countries","Most products don't fail during that time, and the price is set to make the seller a profit","They only cover cosmetic damage","They can't be claimed on"], answer: 1, explanation: "Sellers make money on them because claims are rarer than buyers expect."}, {rank: 3, prompt: "Your 8-month-old laptop's screen has failed. It came with a 1-year manufacturer's warranty. What should you do?", choices: ["Pay for a repair at any shop","Buy an extended warranty first, then claim","Wait until the warranty runs out","Claim under the warranty, with your proof of purchase"], answer: 3, explanation: "The fault happened within the warranty, so the repair should cost you nothing."}]},
  {id: "7170c857-1cf4-4346-8e80-05d5f98f6e15", name: "Identity Documents", order: 25, questions: [{rank: 1, prompt: "Which of these is a common official photo identity document?", choices: ["A passport","A library card","A store loyalty card","A utility bill"], answer: 0, explanation: "Passports, national ID cards and driving licenses are the usual photo IDs."}, {rank: 2, prompt: "Why should you be careful about sending a photo of your passport or ID card online?", choices: ["The photo makes the document expire","It's against the law everywhere","Criminals can use copies to open accounts or borrow in your name","Photos lower the document's quality"], answer: 2, explanation: "Only send it to organizations you trust that genuinely need it."}, {rank: 3, prompt: "You've lost your wallet with your ID card in it. What should you do first?", choices: ["Wait a few weeks in case it turns up","Report it lost to the issuer and police, and watch your accounts for misuse","Post about it online with your ID number","Get a new photo taken"], answer: 1, explanation: "Reporting it quickly limits what someone can do with it."}]},
  {id: "10a5d3b1-5c78-4244-8fb7-5928826b2c64", name: "Small Claims Court", order: 26, questions: [{rank: 1, prompt: "What is a small claims court for?", choices: ["Criminal cases","Divorces","Disputes between countries","Settling disputes over smaller sums of money simply and cheaply"], answer: 3, explanation: "It's designed so people can bring a case without a lawyer."}, {rank: 2, prompt: "Why are people often told to send a written demand before filing a small claim?", choices: ["It gives the other side a last chance to pay, and shows the court you tried","Courts can't accept claims without a lawyer's letter","It doubles the amount you can claim","It makes the claim free"], answer: 0, explanation: "Many disputes settle at this point, and courts expect a reasonable attempt first."}, {rank: 3, prompt: "A builder took a 2,000 deposit, never started work, and won't reply. What's a sensible order of steps?", choices: ["Post a bad review and do nothing else","Go to the builder's home and take back the money","Send a written demand with a deadline, then file a small claim with your evidence","Ask your bank to cancel the payment from a year ago"], answer: 2, explanation: "A paper trail and the small claims process are the usual route for an amount like this."}]},
  {id: "e4da92c6-72b5-4869-b805-0566bd807063", name: "Data Privacy and Security", order: 27, questions: [{rank: 1, prompt: "What is a privacy policy?", choices: ["A law against sharing photos","A statement of what data a company collects and how it uses it","A setting that hides your account","Insurance against identity theft"], answer: 1, explanation: "It's where a service says what it does with your information."}, {rank: 2, prompt: "Why are free apps often said to make money from your data?", choices: ["Their makers are paid by governments","They charge hidden fees","They're run by charities","They earn by using what they learn about you, such as for targeted advertising"], answer: 3, explanation: "If you aren't paying, your attention and information are usually what's sold."}, {rank: 3, prompt: "A new flashlight app asks for access to your contacts and location. What should you do?", choices: ["Deny the permissions it doesn't need, or use another app","Allow everything, since apps need it to work","Allow it and turn your phone off at night","Give it access only on weekends"], answer: 0, explanation: "A flashlight has no reason to need your contacts or location."}]},
  {id: "4fde1e14-0ff9-476b-a806-c21147bd12c7", name: "Job Searching", order: 28, questions: [{rank: 1, prompt: "What is networking in a job search?", choices: ["Setting up a home internet connection","Applying to as many jobs as possible","Building and using contacts who can tell you about or refer you to jobs","Posting your resume on every website"], answer: 2, explanation: "Many jobs are found through people you know."}, {rank: 2, prompt: "Why are many jobs filled without ever being advertised?", choices: ["Employers often hire through referrals and contacts they already trust","Advertising jobs is against the law","Unadvertised jobs pay less","Only part-time jobs are advertised"], answer: 0, explanation: "A trusted referral is quicker and less risky for an employer than a stranger."}, {rank: 3, prompt: "You've sent 40 identical applications and heard nothing back. What should you change?", choices: ["Send 40 more the same way","Lower the salary you ask for","Only apply to jobs you're overqualified for","Tailor each application to the job, and ask your contacts for referrals"], answer: 3, explanation: "A generic application rarely stands out, and referrals get read."}]},
  {id: "62bcb3cd-5db3-4e44-8ed7-38bb1307e9b0", name: "Resumes", order: 29, questions: [{rank: 1, prompt: "In which order do most resumes list work experience?", choices: ["Oldest first","Most recent first","Alphabetically by employer","By salary"], answer: 1, explanation: "Employers care most about what you've done lately."}, {rank: 2, prompt: "Why do resume guides say to show results rather than just list duties?", choices: ["Duties are confidential","Results are shorter to write","Results show what you achieved, which says more about how you'd do the job","Employers can't read lists"], answer: 2, explanation: "Anyone can hold a duty; results show you did it well."}, {rank: 3, prompt: "Which line is the strongest for a resume?", choices: ["Cut customer wait times by 30% by redesigning the booking process","Responsible for customer service","Hard-working team player","Did various tasks as needed"], answer: 0, explanation: "It's specific, measurable and shows an achievement."}]},
  {id: "80045080-92f7-4520-b149-84bf8ada5a0e", name: "Cover Letters", order: 30, questions: [{rank: 1, prompt: "What is a cover letter?", choices: ["A list of your references","A form from the employer","A letter of resignation","A short letter sent with an application, saying why you want the job and suit it"], answer: 3, explanation: "It sits alongside the resume and speaks to the specific role."}, {rank: 2, prompt: "Why should a cover letter be written for each job rather than reused?", choices: ["Employers check for copies","It should show you understand that employer and match your skills to what they need","Reusing letters is illegal","Each job needs a different font"], answer: 1, explanation: "A tailored letter shows real interest and fit."}, {rank: 3, prompt: "The job ad stresses managing budgets, and you ran a 50,000 project budget. How should you use that in your letter?", choices: ["Leave it out, since it's on your resume","Say you're good with money","Mention it directly, with the budget's size and what you achieved","Attach the budget spreadsheet"], answer: 2, explanation: "Matching concrete evidence to the employer's stated needs is what makes a letter work."}]},
  {id: "cae71fcf-2393-4085-8d04-35714ceb694b", name: "Job Interviews", order: 31, questions: [{rank: 1, prompt: "What is the STAR way of answering interview questions?", choices: ["Describing the Situation, Task, Action and Result","Staying calm, Talking slowly, Answering briefly, Relaxing","Starting with your salary","Telling a joke before each answer"], answer: 0, explanation: "It gives a clear story about what you did and what came of it."}, {rank: 2, prompt: "Why do interviewers ask about times you handled a problem in the past?", choices: ["To fill time","To check your memory","To find out your hobbies","How you acted before is a good guide to how you'll act in the job"], answer: 3, explanation: "Past behavior is one of the best predictors of future behavior."}, {rank: 3, prompt: "At the end of an interview, you're asked if you have any questions. What should you do?", choices: ["Say no, to keep it short","Ask a thoughtful question about the role or the team","Ask how soon you can take holiday","Ask what the company does"], answer: 1, explanation: "A good question shows interest and that you've prepared."}]},
  {id: "2ba6d228-d4ae-489c-906c-19cc7892402c", name: "Employment Contracts", order: 32, questions: [{rank: 1, prompt: "What is a probation period in a new job?", choices: ["The final month before you leave","A time when you aren't paid","A first stretch of employment when either side can end it more easily","Unpaid training before the job starts"], answer: 2, explanation: "It's a trial for both the employer and the employee."}, {rank: 2, prompt: "Why should you read a non-compete clause before signing a contract?", choices: ["It can limit where you're allowed to work after you leave","It sets your salary","It decides your job title","It's only for managers"], answer: 0, explanation: "Some restrict working for competitors for months or years."}, {rank: 3, prompt: "Your offer letter gives the salary but says nothing about hours, holidays or notice period. What should you do?", choices: ["Accept, since those are always standard","Turn the job down","Ask about them after you've started","Ask for those terms in writing before you accept"], answer: 3, explanation: "It's far easier to get clear terms before you've accepted."}]},
  {id: "8d8f226e-0cef-447d-ae6f-e19a4fa01677", name: "Employment Law", order: 33, questions: [{rank: 1, prompt: "What is a minimum wage?", choices: ["The most an employer may pay","The lowest hourly pay employers are legally allowed to pay","A wage paid only to trainees","The average wage in a country"], answer: 1, explanation: "Many countries set one, sometimes by age or region."}, {rank: 2, prompt: "Why do laws protect workers from being fired for reporting safety problems?", choices: ["Reporting is a manager's job","To reduce paperwork","Otherwise fear of losing their jobs would keep people quiet about dangers","It makes reports anonymous"], answer: 2, explanation: "Protection lets problems come to light before people get hurt."}, {rank: 3, prompt: "Your manager often has you work extra hours that your contract says should be paid, without paying them. What should you do?", choices: ["Keep a record of your hours and raise it in writing, then with HR, a union or the labor authority if needed","Quit without saying anything","Work slower to make up for it","Take the money from the till"], answer: 0, explanation: "Records and a written complaint give you a strong position."}]},
  {id: "1d6cc776-49fd-439b-9ea9-2862c69aa3ab", name: "Salary Negotiation", order: 34, questions: [{rank: 1, prompt: "In a salary negotiation, what is the \"anchor\"?", choices: ["The final agreed salary","Your current salary","Your manager's salary","The first number named, which the rest of the talk tends to move around"], answer: 3, explanation: "Whoever names a number first sets the starting point."}, {rank: 2, prompt: "Why is it usually better to negotiate pay after an offer rather than before?", choices: ["Offers can't be changed later","Once they've chosen you, they want you and have more reason to meet your terms","Negotiating early is against the law","Employers only discuss pay in writing"], answer: 1, explanation: "After an offer, you're the person they want, not one of many candidates."}, {rank: 3, prompt: "You're offered 50,000. Similar roles nearby pay 55,000 to 60,000. What should you do?", choices: ["Accept right away, so the offer isn't withdrawn","Ask for 100,000","Thank them and ask for about 58,000, citing what similar roles pay","Say you'll think about it for a month"], answer: 2, explanation: "A specific, well-supported request within the market range is reasonable and often met."}]},
  {id: "566f775d-eaa9-436b-9b9b-5cea8cb774ea", name: "Payslips", order: 35, questions: [{rank: 1, prompt: "What is gross pay on a payslip?", choices: ["Your pay before tax and other deductions","Your pay after tax","Your overtime only","Your yearly bonus"], answer: 0, explanation: "It's the full amount you earned for the period."}, {rank: 2, prompt: "Why is net pay lower than gross pay?", choices: ["Net pay doesn't include weekends","The employer keeps a share","Net pay is rounded down","Tax, social contributions and other deductions are taken out first"], answer: 3, explanation: "Net pay is what actually reaches your bank account."}, {rank: 3, prompt: "Your gross pay is 3,000. Deductions are 15% for tax and 5% for your pension. What's your net pay?", choices: ["2,550","2,850","2,400","2,250"], answer: 2, explanation: "The deductions add up to 20%, which is 600, leaving 2,400."}]},
  {id: "95186f0e-48a1-4fb4-85a2-890f48bc6c2c", name: "Professional Communication", order: 36, questions: [{rank: 1, prompt: "What goes in a work email's subject line?", choices: ["Your full name","A short summary of what the email is about","The date","A greeting"], answer: 1, explanation: "It helps the reader see what it's about and find it later."}, {rank: 2, prompt: "Why should a work email put its main point or request near the top?", choices: ["Busy readers may skim, so the key point should be seen first","Email programs hide the bottom","It's a legal requirement","It makes the email shorter"], answer: 0, explanation: "If the request is buried, it may be missed."}, {rank: 3, prompt: "You need a colleague's figures by Friday for a report. How should you ask?", choices: ["Mention it in passing at lunch","Send a long email about the whole project","Ask their manager to tell them","Say what you need, by when, and why, in a short clear message"], answer: 3, explanation: "A clear request with a deadline is easy to act on."}]},
  {id: "95d1b3a3-f524-4ec7-9d8d-fe0ba2946f07", name: "Workplace Etiquette", order: 37, questions: [{rank: 1, prompt: "What's generally expected if you're going to be late to a meeting?", choices: ["Nothing, as long as it's under half an hour","Send someone in your place","Let the organizer know ahead of time","Skip it and ask for notes"], answer: 2, explanation: "Telling people lets them plan around it."}, {rank: 2, prompt: "Why is it seen as good practice to praise in public but criticize in private?", choices: ["Criticism is against company rules","Private feedback avoids embarrassing someone and helps them listen","Praise only counts if others hear it","Managers aren't allowed to give feedback in meetings"], answer: 1, explanation: "People take criticism better when they don't have to save face."}, {rank: 3, prompt: "A coworker keeps taking long personal calls at the desk next to you. What should you do first?", choices: ["Mention it to them politely, in private","Complain to the manager straight away","Play loud music back","Post about it in the team chat"], answer: 0, explanation: "Raising it directly and kindly usually solves it without escalation."}]},
  {id: "00050c81-4139-4109-a690-e2cfd9cfde47", name: "Time Management", order: 38, questions: [{rank: 1, prompt: "What does the Eisenhower matrix sort tasks by?", choices: ["How long they take","Who gave them to you","Alphabetical order","How urgent and how important they are"], answer: 3, explanation: "It helps you do what matters first and drop what doesn't."}, {rank: 2, prompt: "Why does breaking a big project into small tasks help people finish it?", choices: ["Small tasks don't need deadlines","It makes the project smaller overall","Small tasks are easier to start and show clear progress","Managers prefer more tasks"], answer: 2, explanation: "A clear next step beats a vague, overwhelming one."}, {rank: 3, prompt: "You have a report due tomorrow, emails to answer, and a meeting to plan for next month. What do you do first?", choices: ["The report","The emails","The meeting plan","Whichever is quickest"], answer: 0, explanation: "It's both urgent and important."}]},
  {id: "eb64a75c-3087-4709-b69a-a5c9770c9caf", name: "Self-Employment", order: 39, questions: [{rank: 1, prompt: "Who usually pays the tax on a self-employed person's income?", choices: ["Their clients","The person themselves","Their bank","No one, since it's tax-free"], answer: 1, explanation: "There's no employer taking tax out, so they pay it themselves."}, {rank: 2, prompt: "Why are self-employed people told to set aside part of each payment for tax?", choices: ["Banks require it","Tax is cheaper if paid early","Clients ask for it","No employer takes tax out, so the whole bill comes due later"], answer: 3, explanation: "Without saving as they go, the tax bill can come as a shock."}, {rank: 3, prompt: "You earn 4,000 from a client and expect about 25% to go to tax. How much should you set aside?", choices: ["400","1,000","1,250","750"], answer: 1, explanation: "25% of 4,000 is 1,000."}]},
  {id: "7ccea91e-6c88-4c75-9313-6d87d77cb541", name: "Career Planning", order: 40, questions: [{rank: 1, prompt: "What is a transferable skill?", choices: ["A skill only one employer values","A skill you lose when changing jobs","A skill useful in many jobs, such as communication or problem-solving","A qualification from another country"], answer: 2, explanation: "These skills move with you from one role or field to another."}, {rank: 2, prompt: "Why do career advisers suggest talking to people already doing a job you're considering?", choices: ["They know what the work is really like day to day","They can hire you on the spot","It's required before you can apply","They'll tell you the interview questions"], answer: 0, explanation: "Job ads rarely show the real day-to-day."}, {rank: 3, prompt: "You want to move from retail into project management. What's a sensible first step?", choices: ["Quit and apply only to senior roles","Wait for your manager to suggest it","Change your job title on your resume","Take on organizing projects at your current job, and look into a recognized course"], answer: 3, explanation: "Real experience plus a credential makes the switch believable."}]},
  {id: "749e1bae-ad49-4562-811f-b855af472cba", name: "Healthcare Navigation", order: 41, questions: [{rank: 1, prompt: "Who is usually the first doctor to see for a health problem that isn't an emergency?", choices: ["A surgeon","A general practitioner or family doctor","An emergency room doctor","A pharmacist only"], answer: 1, explanation: "They treat common problems and refer you on when needed."}, {rank: 2, prompt: "Why are people asked to see a regular doctor rather than go to an emergency room for problems that aren't urgent?", choices: ["Emergency rooms are for serious problems, and minor ones there take longer and cost more","Emergency rooms can't treat adults","Regular doctors are always free","Emergency rooms only open at night"], answer: 0, explanation: "It keeps emergency care free for emergencies."}, {rank: 3, prompt: "You've had a sore throat and a mild fever for two days, but can breathe and swallow fine. Where should you go?", choices: ["The emergency room","Nowhere, ever","Your regular doctor or a walk-in clinic","A specialist hospital"], answer: 2, explanation: "It isn't an emergency, but a doctor can check whether it needs treatment."}]}
] AS x
MATCH (t:Topic {id: x.id}), (c:Collection {id: "life-knowledge"})
MERGE (c)-[contains:CONTAINS]->(t)
SET contains.order = x.order
WITH t, x
UNWIND x.questions AS q
MATCH (t)-[:HAS_LEVEL]->(l:BloomLevel {rank: q.rank})
MERGE (question:QuizQuestion)-[:TESTS]->(l)
ON CREATE SET question.id = randomUUID(), question.prompt = q.prompt, question.choices = q.choices,
              question.answer = q.answer, question.explanation = q.explanation, question.createdAt = datetime();

UNWIND [
  {id: "b45e660c-4d18-4df0-88d6-515d15082df8", name: "Health Insurance", order: 42, questions: [{rank: 1, prompt: "What is a health insurance premium?", choices: ["The cost of each doctor's visit","The most the insurer will pay","A refund for staying healthy","The regular amount you pay to have the insurance"], answer: 3, explanation: "You pay it whether or not you use care."}, {rank: 2, prompt: "Why do plans with lower premiums often have higher deductibles?", choices: ["They cover fewer doctors","You pay less up front but take on more of the cost when you need care","The law requires it","They're only for young people"], answer: 1, explanation: "The insurer's risk is shared differently between you and them."}, {rank: 3, prompt: "You rarely see a doctor but want protection from a very large bill. Which plan suits you?", choices: ["A lower premium with a higher deductible","The highest premium with the lowest deductible","No insurance","A plan that covers only checkups"], answer: 0, explanation: "You save on premiums while staying covered for a big, unexpected cost."}]},
  {id: "5435464a-929f-4aa1-b258-b21ffefb379d", name: "Prescription Drugs", order: 43, questions: [{rank: 1, prompt: "What is a generic medicine?", choices: ["A medicine without any active ingredient","A medicine sold only in hospitals","A copy of a brand-name medicine with the same active ingredient","An herbal remedy"], answer: 2, explanation: "Generics work the same and usually cost much less."}, {rank: 2, prompt: "Why should you tell a doctor about other medicines you take before getting a new prescription?", choices: ["Doctors need it for billing","It makes the prescription cheaper","Pharmacies won't open otherwise","Some medicines interact and can become harmful or stop working together"], answer: 3, explanation: "Interactions are a common and avoidable cause of harm."}, {rank: 3, prompt: "You've been prescribed a medicine and aren't sure whether it's safe with alcohol. What should you do?", choices: ["Assume it's fine","Check the leaflet or ask the pharmacist","Take half the dose if you drink","Skip the medicine on days you drink"], answer: 1, explanation: "The leaflet and pharmacist can tell you about that exact medicine."}]},
  {id: "eede4e79-0337-43bc-9680-81a113fe94a2", name: "Nutrition Labels", order: 44, questions: [{rank: 1, prompt: "On a nutrition label, what does the serving size tell you?", choices: ["The amount of food the nutrition figures refer to","How much you should eat in a day","The size of the package","How many people the pack serves"], answer: 0, explanation: "All the figures are per serving, which may not be what you actually eat."}, {rank: 2, prompt: "Why does the order of the ingredients on a label matter?", choices: ["It's alphabetical","The healthiest are listed first","They're listed from most to least by weight","It shows which were added last"], answer: 2, explanation: "If sugar is near the top, there's a lot of it."}, {rank: 3, prompt: "A serving is 30 g and has 6 g of sugar. You eat 90 g. How much sugar is that?", choices: ["12 g","18 g","6 g","24 g"], answer: 1, explanation: "90 g is three servings, and 3 times 6 g is 18 g."}]},
  {id: "4850e5ea-0f8c-42ad-b3b9-f6fe07c43a2e", name: "Sleep Hygiene", order: 45, questions: [{rank: 1, prompt: "How much sleep do most adults need each night?", choices: ["About 4 to 5 hours","About 10 to 12 hours","Exactly 6 hours","About 7 to 9 hours"], answer: 3, explanation: "Most adults function best in this range."}, {rank: 2, prompt: "Why does screen use right before bed make it harder to fall asleep?", choices: ["Bright light and stimulating content keep the brain alert and delay sleepiness","Screens use up the body's energy","Phones change room temperature","It only affects children"], answer: 0, explanation: "Light, especially blue light, tells the body it's still daytime."}, {rank: 3, prompt: "You lie awake for an hour most nights. Which change is most likely to help?", choices: ["Drink coffee in the evening to tire yourself out","Nap for two hours each afternoon","Go to bed and get up at the same times every day, and skip caffeine after noon","Use your phone in bed until you feel sleepy"], answer: 2, explanation: "A steady schedule and less caffeine strengthen the body's sleep rhythm."}]},
  {id: "37cc03b0-f8c9-4d12-9d3d-aaf61f12a7fd", name: "Stress Management", order: 46, questions: [{rank: 1, prompt: "Which of these is a common healthy way to manage stress?", choices: ["Skipping meals","Regular physical exercise","Working through the night","Avoiding all friends"], answer: 1, explanation: "Exercise lowers stress hormones and improves mood."}, {rank: 2, prompt: "Why does slow, deep breathing help calm a person down?", choices: ["It uses up adrenaline","It increases oxygen to the muscles","It makes the heart beat faster","It triggers the body's relaxation response and slows the heart rate"], answer: 3, explanation: "Slow breathing signals safety to the nervous system."}, {rank: 3, prompt: "You're overwhelmed by a pile of deadlines. What's a useful first step?", choices: ["List everything, pick the most important, and take one task at a time","Try to do them all at once","Ignore them until tomorrow","Start with the easiest ones, whatever is due first"], answer: 0, explanation: "Seeing it all and choosing a first task turns a cloud of worry into a plan."}]},
  {id: "6f5d28f4-ed3f-4e4b-a6ef-8fad43786e45", name: "Preventive Medicine", order: 47, questions: [{rank: 1, prompt: "What is a screening test?", choices: ["A test for people who already have symptoms","An eye test for screens","A test that looks for disease in people with no symptoms","A test before surgery"], answer: 2, explanation: "Examples include blood pressure checks and some cancer screenings."}, {rank: 2, prompt: "Why are some cancers screened for even in people who feel well?", choices: ["Screening cures cancer","Found early, they're far easier to treat","It's cheaper than a checkup","Feeling well means you're at higher risk"], answer: 1, explanation: "Many cancers cause no symptoms until they've spread."}, {rank: 3, prompt: "Your doctor suggests a routine blood pressure check, but you feel fine. What should you do?", choices: ["Refuse, since you have no symptoms","Check it yourself once a year with your hand","Wait until you feel dizzy","Have it, since high blood pressure often has no symptoms"], answer: 3, explanation: "It's called a silent condition because people feel fine until it causes harm."}]},
  {id: "3427debb-226a-4e02-a391-7c794a61c21b", name: "Vaccination", order: 48, questions: [{rank: 1, prompt: "What does a vaccine do?", choices: ["Trains the immune system to recognize a germ","Kills germs already in the body","Replaces the immune system","Cures any infection"], answer: 0, explanation: "It prepares the body to fight the real germ quickly."}, {rank: 2, prompt: "Why does vaccinating most of a community also protect people who can't be vaccinated?", choices: ["Vaccines spread from person to person","Unvaccinated people get a smaller dose","With few people able to catch and pass it on, the disease struggles to spread","It doesn't protect them at all"], answer: 2, explanation: "This is called herd or community immunity."}, {rank: 3, prompt: "You're traveling to a country where a disease your vaccines don't cover is common. What should you do?", choices: ["Buy medicine there if you get sick","See a doctor or travel clinic several weeks before you go","Get vaccinated at the airport on the way home","Avoid drinking water and do nothing else"], answer: 1, explanation: "Some vaccines need weeks to take effect, or several doses."}]},
  {id: "f3a9a2ce-ca62-4fcb-bef2-4de5de203166", name: "Dental Care", order: 49, questions: [{rank: 1, prompt: "How often do dentists recommend brushing your teeth?", choices: ["Once a week","After every meal and snack, at least six times","Once a day, in the morning","Twice a day"], answer: 3, explanation: "Morning and night, for about two minutes."}, {rank: 2, prompt: "Why does sugar cause tooth decay?", choices: ["Bacteria in the mouth turn it into acid that wears away enamel","Sugar crystals scratch the teeth","It makes teeth softer directly","It stops saliva forming"], answer: 0, explanation: "The more often sugar is eaten, the more acid attacks the teeth."}, {rank: 3, prompt: "One of your teeth has hurt when you drink something cold, for two weeks now. What should you do?", choices: ["Only drink warm drinks from now on","Pull it out yourself","Book a dental checkup","Wait a year for it to settle"], answer: 2, explanation: "Lasting sensitivity can be a sign of decay or a crack that's easier to fix early."}]},
  {id: "5c1cc48c-f4af-4fd9-b9a2-7ddcec253be3", name: "Cooking", order: 50, questions: [{rank: 1, prompt: "What does it mean to simmer something?", choices: ["Cook it in a very hot oven","Cook it in liquid just below boiling, with small bubbles","Fry it quickly in oil","Cook it over an open flame"], answer: 1, explanation: "Simmering is gentler than boiling."}, {rank: 2, prompt: "Why do recipes say to let meat rest after cooking?", choices: ["To let it cool enough to be safe","So it finishes cooking raw parts","To make it easier to carve thin","The juices settle back through the meat instead of running out when it's cut"], answer: 3, explanation: "Resting keeps the meat moist."}, {rank: 3, prompt: "A recipe for 4 people needs 300 g of rice. How much do you need for 6?", choices: ["450 g","400 g","600 g","500 g"], answer: 0, explanation: "300 g for 4 is 75 g each, and 6 times 75 is 450."}]},
  {id: "02f9d3fa-68b3-4cd2-9b31-de4f02fa9d11", name: "Meal Planning", order: 51, questions: [{rank: 1, prompt: "What is batch cooking?", choices: ["Cooking each meal fresh","Eating out in groups","Cooking large amounts at once to eat over several days","Cooking only on weekends"], answer: 2, explanation: "One session of cooking covers several meals."}, {rank: 2, prompt: "Why does planning a week's meals usually cut food waste?", choices: ["You buy only what you'll use","Planned food lasts longer","Shops give discounts to planners","It means eating less"], answer: 0, explanation: "Impulse buys and forgotten ingredients are what usually go off."}, {rank: 3, prompt: "You have chicken, rice and peppers that need using soon, and a busy week ahead. What's the best plan?", choices: ["Buy more fresh food for each day","Freeze the peppers and order takeout","Leave them until the weekend","Cook a big stir-fry early in the week and keep portions for later days"], answer: 3, explanation: "It uses the food before it spoils and saves time later."}]},
  {id: "1924bfc9-ef78-4bcf-bf06-aedafbb31bd4", name: "Food Safety", order: 52, questions: [{rank: 1, prompt: "What is the \"danger zone\" for food?", choices: ["Below freezing","The temperatures, roughly 5 to 60 °C (40 to 140 °F), where bacteria grow fastest","Above boiling","Any food left in the fridge"], answer: 1, explanation: "Food shouldn't sit in that range for long."}, {rank: 2, prompt: "Why should you use a separate cutting board for raw meat?", choices: ["Raw meat dulls knives","It makes cleaning faster","Bacteria from raw meat can spread to food that won't be cooked","Wooden boards absorb flavor"], answer: 2, explanation: "This is called cross-contamination."}, {rank: 3, prompt: "You've cooked a big pot of soup for dinner. What should you do with the leftovers?", choices: ["Cool them quickly and put them in the fridge within two hours","Leave the pot on the stove overnight","Let them cool on the counter until morning","Keep them warm on low heat all night"], answer: 0, explanation: "Cooling quickly keeps them out of the danger zone."}]},
  {id: "b6d48db7-d7cc-4c44-8373-1a40e56479f4", name: "Food Storage", order: 53, questions: [{rank: 1, prompt: "What does a \"use by\" date mean?", choices: ["The day the shop must sell it","When it's at its best quality","The day it was packed","The last day the food is safe to eat"], answer: 3, explanation: "\"Best before\" is about quality; \"use by\" is about safety."}, {rank: 2, prompt: "Why does freezing keep food safe for a long time?", choices: ["Freezing kills all bacteria","Cold stops bacteria from growing, though it doesn't kill them all","Ice seals the food from air","Frozen food can't spoil at all"], answer: 1, explanation: "Bacteria start growing again once the food thaws."}, {rank: 3, prompt: "You have raw chicken and a cake to put in the fridge. Where should the chicken go?", choices: ["On the bottom shelf, so nothing drips onto other food","On the top shelf, where it's coldest","In the door","Next to the cake"], answer: 0, explanation: "Keeping raw meat at the bottom stops its juices reaching ready-to-eat food."}]},
  {id: "84335eda-ae31-4a51-b1ba-395d4731fd09", name: "Household Chemical Safety", order: 54, questions: [{rank: 1, prompt: "Which two common cleaners should never be mixed, because together they give off a toxic gas?", choices: ["Soap and water","Vinegar and baking soda","Bleach and ammonia","Dish soap and laundry detergent"], answer: 2, explanation: "Bleach with ammonia, or with acids, releases harmful gases."}, {rank: 2, prompt: "Why should cleaning products be kept in their original containers?", choices: ["The label shows what's inside and how to use it safely, and a drink bottle could be mistaken for a drink","Other containers make them weaker","It's required to get a refund","The original bottles keep them colder"], answer: 0, explanation: "Many poisonings happen when chemicals are moved into food or drink containers."}, {rank: 3, prompt: "A child has swallowed some dish detergent. What should you do?", choices: ["Make them vomit","Give them milk and wait","Wait to see whether symptoms appear","Call a poison control center or emergency services and follow their advice"], answer: 3, explanation: "Making someone vomit can cause more harm, so get expert advice."}]},
  {id: "fed9d5d9-6f21-4335-a92e-d769306d7845", name: "Laundry", order: 55, questions: [{rank: 1, prompt: "On a care label, what does a tub with a hand in it mean?", choices: ["Machine wash only","Hand wash only","Do not wash","Dry clean only"], answer: 1, explanation: "It means the garment should be washed by hand."}, {rank: 2, prompt: "Why are new dark clothes often washed separately at first?", choices: ["They're heavier","They need hotter water","They take longer to dry","Their dye can run and stain lighter clothes"], answer: 3, explanation: "Excess dye washes out in the first few washes."}, {rank: 3, prompt: "Your wool sweater's label says to wash it cold. What should you do?", choices: ["Wash it hot to get it cleaner","Tumble dry it on high","Wash it on a cold, gentle cycle or by hand, and dry it flat","Never wash it"], answer: 2, explanation: "Heat and agitation shrink wool."}]},
  {id: "2849030b-abb8-4eaf-abe3-97845a8dada6", name: "Home Maintenance", order: 56, questions: [{rank: 1, prompt: "What does caulk do around a bath or sink?", choices: ["Seals the gap so water can't get behind","Holds the tiles on","Stops the drain from clogging","Makes the surface non-slip"], answer: 0, explanation: "Water behind a bath or sink can rot walls and floors."}, {rank: 2, prompt: "Why should gutters be cleared of leaves?", choices: ["Leaves make gutters heavier and they fall","Birds nest in them","Blocked gutters overflow and can send water into walls and foundations","Leaves rust the metal"], answer: 2, explanation: "Water that can't drain away does damage where it ends up."}, {rank: 3, prompt: "You notice a small damp patch spreading on the ceiling below the bathroom. What should you do?", choices: ["Paint over it","Find and fix the leak soon, before it does bigger damage","Wait until it drips","Open a window"], answer: 1, explanation: "Small leaks get worse and can rot wood or bring the ceiling down."}]},
  {id: "214319fc-ae78-4f80-9821-a626624cb76e", name: "Plumbing", order: 57, questions: [{rank: 1, prompt: "What is the main water shut-off valve for?", choices: ["Adjusting water temperature","Draining the water heater","Turning off one tap","Turning off the water to the whole home"], answer: 3, explanation: "Everyone in a home should know where it is."}, {rank: 2, prompt: "Why does the U-shaped trap under a sink always hold some water?", choices: ["The water blocks sewer gases from coming up the drain","It saves water","It catches jewelry","It keeps the pipe cool"], answer: 0, explanation: "Without it, the smell from the sewer would come into the room."}, {rank: 3, prompt: "A pipe under the sink bursts and water is spraying out. What should you do first?", choices: ["Call a plumber and wait","Mop up the water","Turn off the water supply","Wrap it in a towel"], answer: 2, explanation: "Stop the water first, then deal with the damage."}]},
  {id: "cf3a1dc8-48c7-4ae0-954e-34809c5a602f", name: "Electrical Safety", order: 58, questions: [{rank: 1, prompt: "What does a circuit breaker do?", choices: ["Measures electricity use","Cuts the power when a circuit draws too much current","Stores power for outages","Raises the voltage"], answer: 1, explanation: "It protects wiring from overheating."}, {rank: 2, prompt: "Why shouldn't you plug several high-power appliances into one extension lead?", choices: ["It wastes electricity","The appliances run slower","It voids the warranty","Too much current can overheat it and start a fire"], answer: 3, explanation: "Each lead has a limit on how much it can safely carry."}, {rank: 3, prompt: "Before changing a light fitting, what should you do?", choices: ["Switch off the circuit at the breaker, and check it's dead","Turn off the wall switch only","Wear rubber gloves and leave the power on","Unplug the nearest appliance"], answer: 0, explanation: "A wall switch may not cut all the wires."}]},
  {id: "3c6d2a2d-387d-4f39-83e7-276264110856", name: "Hand Tools", order: 59, questions: [{rank: 1, prompt: "Which tool is for tightening and loosening nuts and bolts?", choices: ["A hammer","A saw","A wrench (spanner)","A chisel"], answer: 2, explanation: "It grips the nut and turns it."}, {rank: 2, prompt: "Why does a longer wrench make a stuck bolt easier to turn?", choices: ["It's heavier","The longer handle gives more leverage for the same effort","It grips the bolt more tightly","It heats the bolt"], answer: 1, explanation: "Turning force grows with distance from the bolt."}, {rank: 3, prompt: "You need to hang a heavy mirror on a hollow plasterboard wall. What should you use?", choices: ["A single nail","Strong tape","Glue","Wall anchors rated for the weight, or screws into a stud"], answer: 3, explanation: "Plasterboard alone can't hold much weight."}]},
  {id: "39f0ac6d-ab9b-4609-9c60-d6ca2de84c55", name: "Household Utilities", order: 60, questions: [{rank: 1, prompt: "What does a kilowatt-hour measure on an electricity bill?", choices: ["The amount of energy used","The highest power drawn at once","The number of devices","The time the power was on"], answer: 0, explanation: "It's the unit you're charged for."}, {rank: 2, prompt: "Why can an \"estimated\" bill be wrong?", choices: ["Estimates include a penalty","Meters stop working in winter","It's based on a guess rather than an actual meter reading","Estimates are always higher by law"], answer: 2, explanation: "Sending a real reading puts the bill right."}, {rank: 3, prompt: "Electricity costs 0.25 per kWh. A 2 kW heater runs 4 hours a day. What does it cost to run per day?", choices: ["1.00","2.00","8.00","0.50"], answer: 1, explanation: "2 kW for 4 hours is 8 kWh, and 8 times 0.25 is 2.00."}]},
  {id: "f2b5d1f6-8616-49f5-aea4-014a7ca1723e", name: "Home Energy Saving", order: 61, questions: [{rank: 1, prompt: "Which kind of light bulb uses the least energy for the same light?", choices: ["Incandescent","Halogen","Fluorescent tube","LED"], answer: 3, explanation: "LEDs use a fraction of the energy and last far longer."}, {rank: 2, prompt: "Why does insulating a loft (attic) save money on heating?", choices: ["Much of a home's heat escapes through the roof without it","Insulation produces heat","It makes the boiler run faster","It cools the house in winter"], answer: 0, explanation: "Insulation keeps the heat you've paid for inside."}, {rank: 3, prompt: "Your heating bill is high in an old, drafty house. Which first step usually gives the most for the least?", choices: ["Replace the boiler","Install solar panels","Seal drafts around doors and windows","Buy a bigger heater"], answer: 2, explanation: "Draft-proofing is cheap and stops a lot of heat escaping."}]},
  {id: "f46a9f41-eb0d-45d5-84ec-8ed824bfd9ac", name: "Fire Safety", order: 62, questions: [{rank: 1, prompt: "How often should smoke alarms usually be tested?", choices: ["Once a year","Once a month","Only when they beep","Every five years"], answer: 1, explanation: "A monthly test makes sure they'll work when needed."}, {rank: 2, prompt: "Why should you never throw water on a pan of burning oil?", choices: ["Water makes it smoke more","It wastes water","It cools the pan too fast and cracks it","The water turns to steam instantly and throws burning oil everywhere"], answer: 3, explanation: "It can turn a pan fire into a fireball."}, {rank: 3, prompt: "A pan of oil catches fire on the stove. What should you do?", choices: ["Turn off the heat and cover the pan with a lid or fire blanket","Throw water on it","Carry it outside","Fan the flames out"], answer: 0, explanation: "Covering it cuts off the oxygen."}]},
  {id: "7fb22baf-98e4-4dc7-8285-c4423c99a5a4", name: "Pest Management Techniques", order: 63, questions: [{rank: 1, prompt: "What is integrated pest management?", choices: ["Spraying pesticide on a schedule","Using only natural predators","Controlling pests by combining prevention, monitoring and, only where needed, treatment","Hiring an exterminator every month"], answer: 2, explanation: "It aims to solve pest problems with as few chemicals as possible."}, {rank: 2, prompt: "Why does sealing food in containers help keep pests away?", choices: ["Containers repel insects","Pests come for food, and without it they have less reason to stay","It kills pests already inside","Pests can't smell through plastic at all"], answer: 1, explanation: "Taking away food, water and shelter is the first step."}, {rank: 3, prompt: "You've found mouse droppings in the kitchen. What should you do first?", choices: ["Ignore it, since one mouse is harmless","Leave food out to trap it","Get a cat","Seal food away, block the gaps they get in through, and set traps"], answer: 3, explanation: "Cutting off food and entry points stops more coming in."}]},
  {id: "a22c5284-8d46-4d64-a908-c4c056120ed4", name: "Gardening", order: 64, questions: [{rank: 1, prompt: "What is compost?", choices: ["Decayed plant and food waste used to enrich soil","A chemical fertilizer","A type of potting tray","A pest spray"], answer: 0, explanation: "It adds nutrients and improves the soil's structure."}, {rank: 2, prompt: "Why is it usually better to water plants deeply but less often?", choices: ["Plants only drink once a week","It saves time","It encourages roots to grow deep, where the soil stays moist longer","Shallow water evaporates more slowly"], answer: 2, explanation: "Deep roots make plants tougher in dry spells."}, {rank: 3, prompt: "A plant's label says \"full sun\". Where should you plant it?", choices: ["A shady corner","A spot with at least six hours of direct sun a day","Indoors away from windows","Under a tree"], answer: 1, explanation: "Full-sun plants grow poorly without plenty of direct light."}]},
  {id: "c9ee9023-1d01-4fc5-a32b-095b59a51981", name: "Road Traffic Laws", order: 65, questions: [{rank: 1, prompt: "What does a red traffic light mean?", choices: ["Speed up to clear the junction","Slow down and proceed","Go if the road is clear","Stop and wait"], answer: 3, explanation: "You wait until the light allows you to go."}, {rank: 2, prompt: "Why are speed limits lower near schools?", choices: ["Children may cross unexpectedly, and lower speeds give drivers time to stop","To reduce noise for lessons","Roads near schools are narrower by law","Teachers asked for it"], answer: 0, explanation: "At lower speeds, a crash is also far less likely to kill."}, {rank: 3, prompt: "An ambulance with its siren on is coming up behind you. What should you do?", choices: ["Speed up to stay ahead of it","Stop immediately where you are","Pull over safely to let it pass","Ignore it if you're in the right lane"], answer: 2, explanation: "Move aside safely, without braking suddenly or blocking a junction."}]},
  {id: "3299315f-ca28-4752-a375-8a12baed606d", name: "Car Maintenance", order: 66, questions: [{rank: 1, prompt: "What does engine oil do?", choices: ["Cools the passenger cabin","Lubricates the engine's moving parts","Powers the battery","Cleans the windshield"], answer: 1, explanation: "Without it, metal parts grind together and wear out."}, {rank: 2, prompt: "Why does driving on underinflated tires use more fuel?", choices: ["The engine runs hotter","Air weighs more in soft tires","Soft tires make the car lighter","Soft tires have more rolling resistance"], answer: 3, explanation: "More of the tire drags on the road, so the engine works harder."}, {rank: 3, prompt: "Your car's oil warning light comes on while you're driving. What should you do?", choices: ["Stop safely as soon as possible and check the oil","Keep driving and check it next week","Drive faster to get home sooner","Turn the radio off"], answer: 0, explanation: "Running without oil pressure can wreck an engine quickly."}]},
  {id: "e435e134-9f40-4c80-86a9-3c894148f032", name: "Car Financing", order: 67, questions: [{rank: 1, prompt: "What is a car lease?", choices: ["A loan to buy a car outright","Insurance for a rented car","Paying to use a car for a set time, then giving it back","A warranty on a used car"], answer: 2, explanation: "You never own the car unless you buy it at the end."}, {rank: 2, prompt: "Why do car dealers often talk about the monthly payment rather than the total price?", choices: ["A low monthly payment can hide a long loan or a high total cost","It's required by law","Monthly prices are always cheaper","Banks won't lend otherwise"], answer: 0, explanation: "Stretching a loan lowers the payment but raises what you pay overall."}, {rank: 3, prompt: "A dealer offers either 0% financing or a 2,000 discount if you pay cash. Your bank will lend at 5%. How should you decide?", choices: ["Always take the 0% offer","Always take the discount","Pick whichever the dealer prefers","Work out the total cost of each option, and pick the lower"], answer: 3, explanation: "Whether the discount beats the free financing depends on the loan size and length."}]},
  {id: "2272db21-7488-4558-a611-53b273982ad5", name: "Road Safety", order: 68, questions: [{rank: 1, prompt: "What is the \"two-second rule\" in driving?", choices: ["Wait two seconds at every stop sign","Keep at least two seconds behind the car in front","Check your mirrors every two seconds","Signal two seconds before turning"], answer: 1, explanation: "It leaves time to react if the car ahead stops."}, {rank: 2, prompt: "Why does stopping distance grow so much as speed goes up?", choices: ["Brakes get weaker at speed","Tires heat up","Braking distance rises with the square of speed","Drivers react more slowly"], answer: 2, explanation: "Twice the speed needs about four times the braking distance."}, {rank: 3, prompt: "It starts raining heavily on the highway. What should you do?", choices: ["Slow down and leave more space to the car in front","Keep your speed so you get home sooner","Turn on your hazard lights and keep going","Brake hard to test the road"], answer: 0, explanation: "Wet roads double stopping distances or more."}]},
  {id: "c2f728b1-d326-4908-bc11-e6ea6f635cb7", name: "Public Transport", order: 69, questions: [{rank: 1, prompt: "What does a transit timetable show?", choices: ["Ticket prices","The driver's name","The route's history","When services arrive at and leave each stop"], answer: 3, explanation: "It lets you plan a journey."}, {rank: 2, prompt: "Why do day or monthly passes often save frequent riders money?", choices: ["One price covers many trips for less than buying single tickets","Passes are tax-free","They include a free taxi","Single tickets are only for tourists"], answer: 0, explanation: "The more you ride, the less each trip costs."}, {rank: 3, prompt: "Single tickets cost 2.50 and a weekly pass costs 20. You make 2 trips a day, 5 days a week. Which is cheaper?", choices: ["Single tickets","The weekly pass","They cost the same","It depends on the time of day"], answer: 1, explanation: "10 single tickets cost 25, more than the 20 pass."}]},
  {id: "c7d2a1fc-4983-4ef7-9602-160ff6a4d61d", name: "Cycling Safety", order: 70, questions: [{rank: 1, prompt: "What should a cyclist wear to protect their head?", choices: ["A cap","A hood","A helmet","Headphones"], answer: 2, explanation: "A helmet reduces the risk of serious head injury."}, {rank: 2, prompt: "Why are cyclists told not to ride up the inside of a truck that's turning?", choices: ["The driver may not see them, and the truck's back wheels cut in","Trucks drive faster when turning","It's slower than going around","Trucks have priority by law everywhere"], answer: 0, explanation: "Many serious cycling crashes happen this way."}, {rank: 3, prompt: "You're cycling home at dusk. What should you do?", choices: ["Ride faster to get home before dark","Ride on the pavement","Ride in the middle of the road","Turn on front and rear lights and wear something bright"], answer: 3, explanation: "Being seen is the main defense in low light."}]},
  {id: "397e6f87-0c6d-409a-a3b2-048b580b47fe", name: "Travel Planning", order: 71, questions: [{rank: 1, prompt: "What does travel insurance usually cover?", choices: ["Your rent while you're away","Medical costs, cancellations and lost bags while traveling","Your car at home","Souvenirs"], answer: 1, explanation: "Medical care abroad in particular can be very expensive."}, {rank: 2, prompt: "Why are flights often cheaper when booked weeks ahead?", choices: ["Airlines give discounts for patience","Fuel is cheaper then","Airlines raise prices as seats fill up","Early bookings skip taxes"], answer: 2, explanation: "The cheapest fares sell first."}, {rank: 3, prompt: "You're flying abroad next month. What should you check first?", choices: ["That your passport is valid long enough and whether you need a visa","The weather forecast","What to pack","The airport's restaurants"], answer: 0, explanation: "Without the right documents, you may not be allowed to travel."}]},
  {id: "5f100a87-a346-4fa0-97b7-ff54694129eb", name: "Passports and Visas", order: 72, questions: [{rank: 1, prompt: "What is a visa?", choices: ["A type of passport","A credit card for travel","A ticket for a flight","Permission from a country to enter it for a set purpose and time"], answer: 3, explanation: "Some countries need one in advance, and some issue them on arrival."}, {rank: 2, prompt: "Why do many countries require your passport to be valid for months after your trip?", choices: ["To make you renew it more often","So you aren't stuck with an expired passport if your stay runs long","Because older passports are less secure","To charge a fee"], answer: 1, explanation: "It's a safety margin for delays."}, {rank: 3, prompt: "Your passport expires in 2 months, and you're visiting a country that requires 6 months' validity. What should you do?", choices: ["Travel anyway and explain at the border","Bring a photocopy","Renew your passport before you go","Book a shorter trip"], answer: 2, explanation: "You can be refused boarding or entry without enough validity."}]},
  {id: "5ec3cb30-440b-4aaa-aa3d-77aa5d04431b", name: "Parenting", order: 73, questions: [{rank: 1, prompt: "What does \"positive reinforcement\" mean in parenting?", choices: ["Rewarding good behavior so it happens more","Punishing bad behavior","Ignoring a child","Letting a child decide everything"], answer: 0, explanation: "Praise and rewards encourage the behavior they follow."}, {rank: 2, prompt: "Why do experts suggest consistent rules and routines for young children?", choices: ["They make children more independent right away","Children forget rules otherwise","Routines are required by schools","Predictability helps them feel secure and learn what's expected"], answer: 3, explanation: "Children cope better when they know what comes next."}, {rank: 3, prompt: "Your 4-year-old throws a tantrum in a shop because you won't buy a toy. What usually works best?", choices: ["Buy the toy so it stops","Stay calm, don't give in, and acknowledge their feelings","Shout until they stop","Leave them there"], answer: 1, explanation: "Giving in teaches that tantrums work."}]},
  {id: "2247cd3d-a508-4cce-a6fb-30702ff95115", name: "Child Protection", order: 74, questions: [{rank: 1, prompt: "Which of these can be a sign that a child is being harmed?", choices: ["Doing well at school","Having many friends","Unexplained injuries or sudden changes in behavior","Asking lots of questions"], answer: 2, explanation: "These signs aren't proof, but they're a reason to pay attention."}, {rank: 2, prompt: "Why do schools and clubs check the backgrounds of adults who work with children?", choices: ["To keep people known to be a risk away from children","To check their qualifications","To set their pay","It's only a formality"], answer: 0, explanation: "Checks are one layer of keeping children safe."}, {rank: 3, prompt: "A child tells you someone at home is hurting them. What should you do?", choices: ["Promise to keep it a secret","Confront the person yourself","Tell them they must be mistaken","Listen calmly, reassure them, and report it to child protection services or the police"], answer: 3, explanation: "Professionals can act safely, and promising secrecy can stop you getting them help."}]},
  {id: "6063a6ca-2e11-40cd-bd61-d803e72e6e58", name: "Pet Care", order: 75, questions: [{rank: 1, prompt: "What is a pet microchip?", choices: ["A tracker that shows the pet's location","A tiny implanted chip with an ID number that links the pet to its owner","A collar tag","A chip that trains behavior"], answer: 1, explanation: "A vet or shelter can scan it to find the owner."}, {rank: 2, prompt: "Why is chocolate dangerous for dogs?", choices: ["It's too sweet for them","It sticks to their teeth","It contains theobromine, which dogs can't break down well","It makes them too energetic"], answer: 2, explanation: "Dark chocolate has the most and is the most dangerous."}, {rank: 3, prompt: "Your dog has just eaten a bar of dark chocolate. What should you do?", choices: ["Call a vet straight away","Give it water and wait","Make it run it off","Wait until it shows symptoms"], answer: 0, explanation: "Quick treatment works best."}]},
  {id: "507ec85d-b249-4b94-93e2-829695d90e83", name: "Caring for Aging Parents", order: 76, questions: [{rank: 1, prompt: "What is a power of attorney?", choices: ["A will","A care home contract","A medical record","A legal document letting someone make decisions for another person"], answer: 3, explanation: "It can cover money, health or both."}, {rank: 2, prompt: "Why is it best to set up a power of attorney while a parent can still decide for themselves?", choices: ["It costs less later","It has to be agreed while they're able to make that decision","Courts only accept it from younger people","It expires after five years"], answer: 1, explanation: "Once they've lost capacity, family may need a slower court process."}, {rank: 3, prompt: "Your father has had two falls at home this month. What should you do?", choices: ["Have a doctor check him, and arrange a home safety assessment","Tell him to be more careful","Wait to see if it happens again","Move all his furniture out"], answer: 0, explanation: "Falls can have medical causes, and simple home changes prevent many."}]},
  {id: "aae53c89-add8-47b0-b1d4-8e7cb8cb805a", name: "Etiquette", order: 77, questions: [{rank: 1, prompt: "What is an RSVP?", choices: ["A gift for the host","A dress code","A reply saying whether you'll attend","A seating plan"], answer: 2, explanation: "It comes from the French for \"please reply\"."}, {rank: 2, prompt: "Why is it good to learn a few local customs before visiting another country?", choices: ["What's polite differs between cultures, and knowing avoids giving offense","Border officers test you","It's required for a visa","Customs are the same everywhere"], answer: 0, explanation: "A gesture that's friendly at home can be rude elsewhere."}, {rank: 3, prompt: "You said yes to a dinner invitation, then realize you can't go. What should you do?", choices: ["Just not show up","Send someone else","Arrive late instead","Tell the host as soon as possible and apologize"], answer: 3, explanation: "Early notice lets the host adjust their plans."}]},
  {id: "0b9e1aa9-e304-4b1f-968d-e38617284ff5", name: "Conflict Resolution", order: 78, questions: [{rank: 1, prompt: "What is an \"I statement\"?", choices: ["A promise to change","Saying how something affects you, like \"I feel ignored when...\", rather than blaming","An apology","A statement of facts only"], answer: 1, explanation: "It explains your side without putting the other person on the defensive."}, {rank: 2, prompt: "Why does listening and summarizing the other person's view help settle an argument?", choices: ["It proves they're wrong","It ends the conversation faster","People calm down when they feel heard, which makes compromise easier","It lets you win"], answer: 2, explanation: "Feeling understood lowers defensiveness."}, {rank: 3, prompt: "A roommate keeps leaving dishes in the sink, and it annoys you. What's the best approach?", choices: ["Raise it calmly, say how it affects you, and agree on a plan together","Leave passive-aggressive notes","Stop washing your own dishes too","Complain about it to other friends"], answer: 0, explanation: "Direct, calm talk solves it without damaging the relationship."}]},
  {id: "72d47f1d-745e-4591-bf87-e3182f122cfb", name: "Intimate Relationships", order: 79, questions: [{rank: 1, prompt: "What does consent mean in a relationship?", choices: ["Agreeing once, for good","Not saying no","Whatever a partner assumes","Freely given agreement that can be withdrawn at any time"], answer: 3, explanation: "It has to be given freely, every time."}, {rank: 2, prompt: "Why do researchers say how a couple handles disagreements matters more than how often they disagree?", choices: ["Couples who argue always split up","Respectful repair keeps trust, while contempt and shutting down wear it away","Disagreeing is always healthy","It doesn't matter at all"], answer: 1, explanation: "Every couple disagrees; the manner is what predicts how they last."}, {rank: 3, prompt: "Your partner seems distant lately, and you're worried. What should you do?", choices: ["Wait for them to bring it up","Check their phone","Bring it up gently at a calm time and ask how they're doing","Act distant back"], answer: 2, explanation: "An open, caring question invites them to share."}]},
  {id: "0387af43-7c7b-4389-ac3f-0aed2656b61f", name: "Friendship", order: 80, questions: [{rank: 1, prompt: "What is reciprocity in a friendship?", choices: ["Both friends giving and receiving support","One friend always helping the other","Keeping score of favors","Seeing each other every day"], answer: 0, explanation: "Give and take keeps a friendship balanced."}, {rank: 2, prompt: "Why do friendships often fade after people move or change jobs?", choices: ["People stop liking each other","Friendships expire after a few years","New jobs forbid old friends","They rely on regular contact, and fewer chances to meet means less of it"], answer: 3, explanation: "Friendships need upkeep, and life changes remove the easy chances."}, {rank: 3, prompt: "You've moved to a new city and know nobody. What's most likely to help you make friends?", choices: ["Wait for neighbors to invite you","Join a regular group activity, so you see the same people again and again","Only make friends online","Go to a different event every night"], answer: 1, explanation: "Seeing the same people repeatedly is how acquaintances become friends."}]},
  {id: "4582ebc7-d085-4a43-b105-52bb480128a3", name: "Emergency Preparedness", order: 81, questions: [{rank: 1, prompt: "What is an emergency kit?", choices: ["A first-aid box only","A list of phone numbers","Supplies such as water, food, a flashlight and medicines to last a few days without help","A fire extinguisher"], answer: 2, explanation: "It's meant to see a household through a few days of disruption."}, {rank: 2, prompt: "Why should a family agree on a meeting place before any emergency?", choices: ["Phones may not work, and everyone will know where to go","It's required by law","To save fuel","So the fire service knows"], answer: 0, explanation: "Planning ahead avoids searching for each other in a crisis."}, {rank: 3, prompt: "A storm warning says the power may be out for days. What should you do now?", choices: ["Wait until the power goes out","Fill up on fresh food","Go out to watch the storm","Charge phones, store water and food, and have flashlights ready"], answer: 3, explanation: "Preparing before is far easier than during."}]},
  {id: "aa0be87c-d72e-422d-a93f-bcb0061cde2c", name: "Grief", order: 82, questions: [{rank: 1, prompt: "What is grief?", choices: ["A mental illness","The deep sorrow and other reactions to a loss, especially a death","Anger at a doctor","Something only children feel"], answer: 1, explanation: "It can include sadness, anger, guilt and numbness."}, {rank: 2, prompt: "Why do experts say grief doesn't follow neat, fixed stages?", choices: ["Everyone grieves exactly the same way","Grief always lasts a year","People grieve differently, and feelings can come and go for a long time","Grief always ends after its final stage"], answer: 2, explanation: "Grief has no set order or timetable."}, {rank: 3, prompt: "A friend's mother has just died. What's the most helpful thing to do?", choices: ["Reach out, listen, and offer specific help, like bringing a meal","Avoid them until they feel better","Tell them everything happens for a reason","Talk about your own losses instead"], answer: 0, explanation: "Presence and practical help mean more than the right words."}]}
] AS x
MATCH (t:Topic {id: x.id}), (c:Collection {id: "life-knowledge"})
MERGE (c)-[contains:CONTAINS]->(t)
SET contains.order = x.order
WITH t, x
UNWIND x.questions AS q
MATCH (t)-[:HAS_LEVEL]->(l:BloomLevel {rank: q.rank})
MERGE (question:QuizQuestion)-[:TESTS]->(l)
ON CREATE SET question.id = randomUUID(), question.prompt = q.prompt, question.choices = q.choices,
              question.answer = q.answer, question.explanation = q.explanation, question.createdAt = datetime();
