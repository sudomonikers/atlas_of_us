// =============================================================================
// Atlas of Us — Physical Attributes sub-graph seed: measurements and norms
// Spec: documentation/data_model/physical_attributes/physical_attributes.md
//
// Generated by database/physical_norms_import. Change its measurements.rs and
// run it again rather than editing this file.
//
// One PhysicalMeasurement per measurement, each with a MeasurementNorm per sex
// (male, female and all) and age band: the value at each percentile of the US
// population, worked out from NHANES with its survey weights. A person's
// percentile is worked out from these when it's read. Measurements that show
// an ability link to it with MEASURES, so run physical_abilities_seed.cypher
// first.
//
// Source: the National Health and Nutrition Examination Survey (NHANES), by
// the CDC's National Center for Health Statistics. Public domain.
//   Height                    2017-2018, 2021-2023
//   Weight                    2017-2018, 2021-2023
//   Body Mass Index           2017-2018, 2021-2023
//   Waist Circumference       2017-2018, 2021-2023
//   Hip Circumference         2017-2018, 2021-2023
//   Upper Arm Length          2017-2018, 2021-2023
//   Upper Leg Length          2017-2018, 2021-2023
//   Resting Heart Rate        2017-2018, 2021-2023
//   Systolic Blood Pressure   2017-2018, 2021-2023
//   Diastolic Blood Pressure  2017-2018, 2021-2023
//   Grip Strength             2011-2012, 2013-2014
//   VO2 Max                   1999-2000, 2001-2002, 2003-2004
//   Body Fat                  2011-2012, 2013-2014, 2015-2016, 2017-2018
//   Hearing Threshold         2011-2012, 2015-2016
//   Visual Acuity             2005-2006, 2007-2008
//
// Idempotent: safe to re-run. Measurements MERGE on name and keep their id,
// and their norms are replaced on every run.
// =============================================================================


// -----------------------------------------------------------------------------
// 0. Constraints
// -----------------------------------------------------------------------------

CREATE CONSTRAINT physicalmeasurement_name_unique IF NOT EXISTS
FOR (n:PhysicalMeasurement) REQUIRE n.name IS UNIQUE;

CREATE CONSTRAINT physicalmeasurement_id_unique IF NOT EXISTS
FOR (n:PhysicalMeasurement) REQUIRE n.id IS UNIQUE;


// -----------------------------------------------------------------------------
// 1. Measurements
// -----------------------------------------------------------------------------

UNWIND [
  { name: "Height", unit: "cm", better: "neither", group: "Body", min: 50.0, max: 250.0,
    description: "Standing height without shoes." },
  { name: "Weight", unit: "kg", better: "neither", group: "Body", min: 20.0, max: 350.0,
    description: "Body weight in light clothing." },
  { name: "Body Mass Index", unit: "kg/m²", better: "neither", group: "Body", min: 10.0, max: 80.0,
    description: "Weight divided by height squared. A rough guide to body size that can't tell muscle from fat." },
  { name: "Waist Circumference", unit: "cm", better: "neither", group: "Body", min: 40.0, max: 200.0,
    description: "Around the waist, just above the top of the hip bones, at the end of a normal breath out." },
  { name: "Hip Circumference", unit: "cm", better: "neither", group: "Body", min: 50.0, max: 200.0,
    description: "Around the hips, at the widest part of the buttocks." },
  { name: "Upper Arm Length", unit: "cm", better: "neither", group: "Body", min: 15.0, max: 55.0,
    description: "From the top of the shoulder to the tip of the elbow, with the elbow bent at a right angle." },
  { name: "Upper Leg Length", unit: "cm", better: "neither", group: "Body", min: 20.0, max: 65.0,
    description: "From the crease at the top of the thigh to the top of the knee, sitting with the knee bent at a right angle." },
  { name: "Resting Heart Rate", unit: "beats/min", better: "lower", group: "Vitals", min: 25.0, max: 200.0,
    description: "Heartbeats a minute after sitting quietly for a few minutes. Lower usually means a fitter heart." },
  { name: "Systolic Blood Pressure", unit: "mmHg", better: "neither", group: "Vitals", min: 60.0, max: 260.0,
    description: "The top number of a blood pressure reading, the pressure while the heart beats, sitting and rested." },
  { name: "Diastolic Blood Pressure", unit: "mmHg", better: "neither", group: "Vitals", min: 30.0, max: 160.0,
    description: "The bottom number of a blood pressure reading, the pressure between beats, sitting and rested." },
  { name: "Grip Strength", unit: "kg", better: "higher", group: "Fitness", min: 1.0, max: 150.0,
    description: "The hardest squeeze of a hand dynamometer, the best of three tries with each hand." },
  { name: "VO2 Max", unit: "ml/kg/min", better: "higher", group: "Fitness", min: 5.0, max: 100.0,
    description: "How much oxygen the body can use at full effort, the standard measure of aerobic fitness. Many fitness watches estimate it. NHANES estimated it from heart rate on a submaximal treadmill test, for ages 12 to 49." },
  { name: "Body Fat", unit: "%", better: "neither", group: "Fitness", min: 2.0, max: 75.0,
    description: "The share of body weight that is fat, from a DXA scan. Smart scales estimate it less precisely." },
  { name: "Hearing Threshold", unit: "dB HL", better: "lower", group: "Senses", min: -10.0, max: 120.0,
    description: "The quietest sound heard, averaged across 500, 1000, 2000 and 4000 Hz, in the better ear. Under 25 dB is normal hearing. NHANES tested ages 20 to 69." },
  { name: "Visual Acuity", unit: "20/x", better: "lower", group: "Senses", min: 10.0, max: 400.0,
    description: "How sharply the better eye sees at a distance, with usual glasses or contacts, as the bottom of a Snellen fraction: 20 is 20/20 vision, and 40 is 20/40." }
] AS m
MERGE (n:PhysicalMeasurement {name: m.name})
ON CREATE SET n.id = randomUUID()
SET n.unit = m.unit,
    n.better = m.better,
    n.group = m.group,
    n.min = m.min,
    n.max = m.max,
    n.description = m.description;


// -----------------------------------------------------------------------------
// 2. Abilities they measure
// -----------------------------------------------------------------------------

UNWIND [
  { measurement: "Grip Strength", ability: "Static Strength" },
  { measurement: "VO2 Max", ability: "Stamina" },
  { measurement: "Hearing Threshold", ability: "Hearing Sensitivity" },
  { measurement: "Visual Acuity", ability: "Far Vision" }
] AS l
MATCH (m:PhysicalMeasurement {name: l.measurement})
MATCH (a:Ability {name: l.ability})
MERGE (m)-[:MEASURES]->(a);


