  { fmaId: "FMA61815", name: "Cardinal segment of brain", definition: "Segment of brain with one or more fixed or anchored fiat boundaries. Examples: thalamus, midbrain, pons, cerebellum, and medulla oblongata.", synonyms: ["Brain segment"], elements: ["FJ1770", "FJ1817"], major: false },
  { fmaId: "FMA61817", name: "Cerebral hemisphere", definition: "Segment of telencephalon which has as its direct proper parts cerebral cortex and cerebral medulla.", synonyms: [], elements: [], major: true },
  { fmaId: "FMA61819", name: "Left cerebral hemisphere", definition: "Left cerebral hemisphere is one of two bilateral, largely symmetrical organ subdivisions within the telencephalon which contain the cerebral cortex and cerebral white matter.", synonyms: [], elements: ["FJ1732", "FJ1739", "FJ1744", "FJ1746", "FJ1748", "FJ1750", "FJ1758", "FJ1759", "FJ1767", "FJ1783", "FJ1785", "FJ1787", "FJ1789", "FJ1791", "FJ1797", "FJ1800", "FJ1833", "FJ1835", "FJ1841"], major: false },
  { fmaId: "FMA61820", name: "Segment of cerebral hemisphere", definition: null, synonyms: ["Cerebral hemisphere subdivision"], elements: ["FJ1732", "FJ1733", "FJ1739", "FJ1740", "FJ1744", "FJ1745", "FJ1746", "FJ1747", "FJ1748", "FJ1749", "FJ1783", "FJ1784", "FJ1785", "FJ1786", "FJ1787", "FJ1788", "FJ1789", "FJ1790", "FJ1791", "FJ1792", "FJ1793", "FJ1794", "FJ1797", "FJ1798", "FJ1800", "FJ1801", "FJ1833", "FJ1834", "FJ1835", "FJ1836", "FJ1837", "FJ1838", "FJ1839", "FJ1840", "FJ1841", "FJ1842"], major: false },
  { fmaId: "FMA61823", name: "Lobe of cerebral hemisphere", definition: "Segment of cerebral hemisphere demarcated by both bonafide landmarks (sulci and fissures) and fiat boundaries.", synonyms: ["Cerebral hemisphere lobe", "Cerebral lobe"], elements: ["FJ1748", "FJ1749", "FJ1791", "FJ1792"], major: false },
  { fmaId: "FMA61824", name: "Frontal lobe", definition: "Frontal lobe is the anterior-most of five lobes of the cerebral hemisphere.  It is bounded by the central sulcus on its posterior border and by the longitudinal cerebral fissure on its medial border.", synonyms: ["Frontal cortex", "Frontal region"], elements: [], major: true },
  { fmaId: "FMA61825", name: "Temporal lobe", definition: "Temporal lobe is the ventrolateral lobe of five lobes comprising each cerebral hemisphere.  It is bounded dorsally by the lateral fissure and posteriorly by an arbitrary border shared with the occipital lobe.", synonyms: ["Temporal cortex"], elements: [], major: true },
  { fmaId: "FMA61826", name: "Parietal lobe", definition: "Parietal lobe is the one of five lobes of the cerebral hemisphere which occupies the dorsal-posterior portion of the hemisphere.  It is bounded by the central sulcus on its anterior border and and by the longitudinal cerebral fissure on its medial border. Posteriorly it shares an arbitrary border with the occipital lobe.", synonyms: ["Parietal cortex", "Parietal region"], elements: [], major: true },
  { fmaId: "FMA61830", name: "Cerebral cortex", definition: null, synonyms: ["Cortex of cerebral hemisphere", "Cortex of cerebrum"], elements: [], major: true },
  { fmaId: "FMA61833", name: "Caudate nucleus", definition: "Nucleus of  brain which is an elongated crescent-shaped mass lying parallel and adjacent to the lateral ventricle throughout its extent.", synonyms: ["Caudatus"], elements: ["FJ1754", "FJ1802"], major: false },
  { fmaId: "FMA61834", name: "Putamen", definition: "Nucleus of  brain which lies ventral to the caudate nucleus and internal capsule and medial to the external capsule.", synonyms: ["Nucleus putamen"], elements: ["FJ1776", "FJ1823"], major: false },
  { fmaId: "FMA61835", name: "Globus pallidus", definition: "Nucleus of  brain which is located medially to the putamen and laterally to the internal capsule.", synonyms: ["Paleostriatum"], elements: ["FJ1757", "FJ1805"], major: false },
  { fmaId: "FMA61841", name: "Amygdala", definition: "Basal ganglion of telencephalon  which is an almond-shaped gray mass in the dorsomedial part of the temporal lobe.", synonyms: ["Amygdaloid body", "Amygdaloid complex", "Amygdaloid nuclear complex", "Amygdaloid nuclear groups", "Amygdaloid nucleus", "Archistriatum"], elements: ["FJ1753", "FJ1829"], major: false },
  { fmaId: "FMA61842", name: "Septum of telencephalon", definition: "Subdivision of the telencephalon on the midline between the lateral ventricles which contains the septum pellucidum and the septal nuclei.", synonyms: ["Septal area", "Septum (NN)", "Telencephalon septum"], elements: ["FJ1832"], major: false },
  { fmaId: "FMA61857", name: "Superior frontal gyrus", definition: null, synonyms: ["Marginal gyrus", "Superior frontal convolution"], elements: ["FJ1833", "FJ1834"], major: false },
  { fmaId: "FMA61859", name: "Middle frontal gyrus", definition: null, synonyms: ["Intermediate frontal gyrus", "Medial frontal gyrus x"], elements: ["FJ1787", "FJ1788"], major: false },
  { fmaId: "FMA61860", name: "Inferior frontal gyrus", definition: null, synonyms: ["Inferior frontal convolution"], elements: ["FJ1744", "FJ1745"], major: false },
  { fmaId: "FMA61894", name: "Precentral gyrus", definition: null, synonyms: ["Precentral convolution", "Prerolandic gyrus"], elements: ["FJ1800", "FJ1801"], major: false },
  { fmaId: "FMA61896", name: "Postcentral gyrus", definition: null, synonyms: ["Postcentral convolution", "Posterior central gyrus", "Postrolandic gyrus"], elements: ["FJ1797", "FJ1798"], major: false },
  { fmaId: "FMA61897", name: "Supramarginal gyrus", definition: null, synonyms: ["Anterior part of inferior parietal lobule", "Inferior parietal lobule (Krieg)"], elements: ["FJ1841", "FJ1842"], major: false },
  { fmaId: "FMA61898", name: "Angular gyrus", definition: null, synonyms: ["AG", "Middle part of inferior parietal lobule", "Preoccipital gyrus"], elements: ["FJ1732", "FJ1733"], major: false },
  { fmaId: "FMA61899", name: "Superior parietal lobule", definition: null, synonyms: ["Superior parietal gyrus", "Superior portion of parietal gyrus"], elements: ["FJ1835", "FJ1836"], major: false },
  { fmaId: "FMA61906", name: "Middle temporal gyrus", definition: null, synonyms: ["Intermediate temporal gyrus"], elements: ["FJ1789", "FJ1790"], major: false },
  { fmaId: "FMA61907", name: "Inferior temporal gyrus", definition: null, synonyms: ["Lateral occipitotemporal gyrus (Heimer-83)"], elements: ["FJ1746", "FJ1747"], major: false },
  { fmaId: "FMA61908", name: "Fusiform gyrus", definition: null, synonyms: ["Lateral occipitotemporal gyrus", "Medial occipitotemporal gyrus-1 (Heimer)", "Occipitotemporal gyrus"], elements: ["FJ1783", "FJ1784"], major: false },
  { fmaId: "FMA61918", name: "Parahippocampal gyrus", definition: null, synonyms: ["Hippocampal gyrus"], elements: ["FJ1785", "FJ1786"], major: false },
  { fmaId: "FMA61934", name: "Choroid plexus of cerebral hemisphere", definition: null, synonyms: ["Chorioid plexus", "Choroid plexus"], elements: ["FJ1755", "FJ1803"], major: false },
  { fmaId: "FMA61950", name: "Internal capsule", definition: "Internal capsule is an organ subdivision of the telencephalon which is made up primarily of myelinated axonal neural tissue (white matter). The internal capsule is a major set of fiber bundles lateral to the thalamus and caudate nucleus and medial to the putamen and globus pallidus. It projects dorsally to the white matter underlying the cerebral cortex.", synonyms: ["Internal capsule radiations"], elements: ["FJ1750", "FJ1751"], major: false },
  { fmaId: "FMA61961", name: "Anterior commissure", definition: null, synonyms: ["Commissura rostralis"], elements: ["FJ1734"], major: false },
  { fmaId: "FMA61965", name: "Fornix of forebrain", definition: "Fornix of neuraxis which connects Ammon's horn of the hippocampus with the mammillary nuclei of the hypothalamus and anterior nuclei of the thalamus.", synonyms: ["Forebrain fornix", "Fornix (column and body of fornix)", "Fornix of brain"], elements: ["FJ1756", "FJ1804"], major: false },
  { fmaId: "FMA61970", name: "Commissure of fornix of forebrain", definition: null, synonyms: ["Dorsal hippocampal commissure", "Fornical commissure", "Fornix commissure", "Hippocampal commissure"], elements: ["FJ1741"], major: false },
  { fmaId: "FMA61974", name: "Stria terminalis", definition: null, synonyms: ["Semicircular stria"], elements: ["FJ1778", "FJ1825"], major: false },
  { fmaId: "FMA61975", name: "Lamina terminalis", definition: null, synonyms: [], elements: ["FJ1764", "FJ1812"], major: false },
  { fmaId: "FMA61991", name: "Trunk of right middle cerebral artery", definition: null, synonyms: ["Right middle cerebral arterial trunk"], elements: ["FJ1692"], major: false },
  { fmaId: "FMA61992", name: "Forebrain", definition: "Organ component of neuraxis that has as its parts the telencephalon, diencephalon, lateral ventricles and third ventricle. Examples: There is only one forebrain.", synonyms: [], elements: ["FJ1730", "FJ1732", "FJ1733", "FJ1739", "FJ1740", "FJ1743", "FJ1744", "FJ1745", "FJ1746", "FJ1747", "FJ1748", "FJ1749", "FJ1750", "FJ1751", "FJ1758", "FJ1759", "FJ1760", "FJ1767", "FJ1780", "FJ1783", "FJ1784", "FJ1785", "FJ1786", "FJ1787", "FJ1788", "FJ1789", "FJ1790", "FJ1791", "FJ1792", "FJ1795", "FJ1797", "FJ1798", "FJ1800", "FJ1801", "FJ1806", "FJ1807", "FJ1808", "FJ1814", "FJ1828", "FJ1833", "FJ1834", "FJ1835", "FJ1836", "FJ1841", "FJ1842"], major: false },
  { fmaId: "FMA61993", name: "Midbrain", definition: "Organ component of neuraxis that has as its parts the tectum, cerebral peduncle, midbrain tegmentum  and cerebral aqueduct. Examples: There is only one midbrain.", synonyms: [], elements: ["FJ1738", "FJ1762", "FJ1770", "FJ1779", "FJ1810", "FJ1817", "FJ1826"], major: false },
  { fmaId: "FMA61996", name: "Segment of forebrain", definition: null, synonyms: ["Forebrain segment"], elements: ["FJ1732", "FJ1733", "FJ1739", "FJ1740", "FJ1744", "FJ1745", "FJ1746", "FJ1747", "FJ1748", "FJ1749", "FJ1783", "FJ1784", "FJ1785", "FJ1786", "FJ1787", "FJ1788", "FJ1789", "FJ1790", "FJ1791", "FJ1792", "FJ1793", "FJ1794", "FJ1797", "FJ1798", "FJ1800", "FJ1801", "FJ1833", "FJ1834", "FJ1835", "FJ1836", "FJ1837", "FJ1838", "FJ1839", "FJ1840", "FJ1841", "FJ1842"], major: false },
