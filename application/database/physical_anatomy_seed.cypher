  { fmaId: "FMA61998", name: "Segment of hindbrain", definition: null, synonyms: ["Hindbrain segment"], elements: ["FJ1769", "FJ1831"], major: false },
  { fmaId: "FMA62000", name: "Telencephalon", definition: "Organ component of neuraxis that has as its parts the cerebral cortex, cerebral white matter, basal ganglia, septum and fornix, as well as subcortical gray and white matter structures.  There is only one telencephalon.", synonyms: [], elements: ["FJ1732", "FJ1733", "FJ1739", "FJ1740", "FJ1744", "FJ1745", "FJ1746", "FJ1747", "FJ1748", "FJ1749", "FJ1750", "FJ1751", "FJ1758", "FJ1759", "FJ1767", "FJ1783", "FJ1784", "FJ1785", "FJ1786", "FJ1787", "FJ1788", "FJ1789", "FJ1790", "FJ1791", "FJ1792", "FJ1797", "FJ1798", "FJ1800", "FJ1801", "FJ1806", "FJ1807", "FJ1814", "FJ1833", "FJ1834", "FJ1835", "FJ1836", "FJ1841", "FJ1842"], major: false },
  { fmaId: "FMA62001", name: "Diencephalon", definition: "Organ component of neuraxis that has as its parts the epithalamus, thalamus, hypothalamus, subthalamus. There is only one diencephalon.", synonyms: ["Between brain", "Interbrain", "Mature diencephalon"], elements: ["FJ1730", "FJ1743", "FJ1760", "FJ1780", "FJ1795", "FJ1808", "FJ1828"], major: false },
  { fmaId: "FMA62003", name: "Metencephalon", definition: "Rostral segment of the hindbrain that has as its parts the pons and the cerebellum.", synonyms: ["Epencephalon-2"], elements: ["FJ1775", "FJ1781", "FJ1822", "FJ1830"], major: false },
  { fmaId: "FMA62004", name: "Medulla oblongata", definition: "Organ component of neuraxis that has as its parts the medullary reticular formation, inferior olivary complex and cochlear nuclear complex, among other structures. Examples: There is only one medulla oblongata.", synonyms: ["Bulb", "Metepencephalon"], elements: ["FJ1769", "FJ1831"], major: false },
  { fmaId: "FMA62007", name: "Thalamus", definition: "Organ component of neuraxis, each instance of which is a large oval mass in the posterior part of some diencephalon adjacent to the lateral wall of some thrid ventricle, containing groups of some nuclei serving as relay centers for sensory impulses and cerebellar and basal nuclear rpojections to some cerebral cortex.", synonyms: ["Dorsal thalamus", "Dorsal thalamus (Anthoney)"], elements: ["FJ1782", "FJ1827"], major: false },
  { fmaId: "FMA62008", name: "Hypothalamus", definition: "Organ component of neuraxis, each instance of which is the ventral part of some diencephalon, forming the floor and part of the lateral wall of some third ventricle. Anatomically, it includes some preoptic area, optic tract, optic chiasm, mammillary bodies, tuber cinereum, infundibulum, and neurohypophysis, but for physiological purposes the neurohypophysis is considered a distinct structure.", synonyms: ["Preoptico-hypothalamic area", "Preoptico-hypothalamic region"], elements: ["FJ1760", "FJ1780", "FJ1808", "FJ1828"], major: true },
  { fmaId: "FMA62009", name: "Epithalamus", definition: null, synonyms: [], elements: ["FJ1743", "FJ1795"], major: false },
  { fmaId: "FMA62028", name: "Intermediate hypothalamic region", definition: null, synonyms: ["Intermediate hypothalamic area"], elements: ["FJ1780", "FJ1828"], major: false },
  { fmaId: "FMA62032", name: "Habenula", definition: "Habenula is a segment of the epithalamus that has as its parts the lateral and medial habenular nuclei and the habenular commissure.", synonyms: ["Habenular nuclei"], elements: ["FJ1743"], major: false },
  { fmaId: "FMA62033", name: "Pineal body", definition: "Circumventricular organ of neuraxis which is shaped like a pine cone and  attached on the midline near the posterior and habenular commissures of the epithalamus.", synonyms: ["Pineal gland"], elements: ["FJ1795"], major: false },
  { fmaId: "FMA62045", name: "Optic chiasm", definition: "Nerve trunk which is continuous with right and left optic nerves and right and left optic tracts.", synonyms: ["Decussation of optic nerve fibers", "Optic chiasma"], elements: ["FJ1771", "FJ1818"], major: false },
  { fmaId: "FMA62046", name: "Optic tract", definition: "Nerve trunk which is continuous with the optic chiasm and the lateral geniculate nucleus.", synonyms: ["Optic lemniscus"], elements: ["FJ1773", "FJ1820"], major: false },
  { fmaId: "FMA62072", name: "Posterior commissure", definition: null, synonyms: ["Caudal commissure", "Epithalamic commissure"], elements: ["FJ1799"], major: false },
  { fmaId: "FMA62080", name: "Stria medullaris of thalamus", definition: "Stria medullaris of thalamus is a slender fiber bundle on the dorsal surface of the diencephalon which terminates posteriorly in the habenular nuclei.", synonyms: [], elements: ["FJ1777", "FJ1824"], major: false },
  { fmaId: "FMA62209", name: "Lateral geniculate body", definition: null, synonyms: ["Lateral geniculate complex", "Lateral geniculate nucleus"], elements: ["FJ1766", "FJ1813"], major: false },
