  { fmaId: "FMA67504", name: "Subdivision of cardinal body part", definition: "anatomical structure, each instance of which is a regional part of some cardinal body part; it has as its constitutional part some subdivision of the integument, such that for each instance of cardinal body part the meronymic sum of its cardinal subdivisions constitutes the instance of cardinal body part. Examples: thorax, perineum, back of neck, forearm, hand, phalanx, nose, auricle of ear, scrotum.", synonyms: ["Principal body part subdivision"], elements: ["FJ2811", "FJ2814"], major: false },
  { fmaId: "FMA67536", name: "Cardinal tissue part", definition: "Anatomical structure, each instance of which is a subdivision of some tissue demarcated by bonafide or fiat boundaries. Examples: stratum germinativum, lamina of cerebral cortex.", synonyms: [], elements: ["FJ2813", "FJ2815"], major: false },
