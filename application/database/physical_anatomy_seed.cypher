  { fmaId: "FMA3807", name: "Conus branch of right coronary artery", definition: "Branch of right coronary artery which runs over the anterior part of conus arteriosus and supplies the pulmonary conus and the upper part of right ventricle.", synonyms: ["First ventricular branch of right coronary artery", "Right conus artery"], elements: ["FJ2670", "FJ2676"], major: false },
  { fmaId: "FMA3813", name: "Anterior ventricular branch of right coronary artery", definition: "Ventricular branch of right coronary artery which courses at nearly perpendicular to the trunk of the right coronary artery , curving upward and then downward to supply the anterior wall of right ventricle and the apex.", synonyms: ["Right anterior ventricular artery"], elements: ["FJ2667", "FJ2668", "FJ2671", "FJ2672", "FJ2673", "FJ2674", "FJ2675", "FJ2677"], major: false },
