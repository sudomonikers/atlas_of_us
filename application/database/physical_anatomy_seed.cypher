  { fmaId: "FMA9550", name: "Outflow part of right atrium", definition: "Outflow part of atrium which consists of wall and cavity of the outflow part of right atrium and the tricuspid valve.", synonyms: ["Main part of right atrium", "Outflow tract of right atrium"], elements: ["FJ2421", "FJ2433", "FJ2436"], major: false },
