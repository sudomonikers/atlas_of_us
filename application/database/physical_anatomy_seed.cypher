  { fmaId: "FMA19783", name: "Loose connective tissue", definition: "Irregular connective tissue, the intercellular matrix of which contains a sparse irregular network of collagen and elastic fiber bundles. Examples: areolar tissue, neuroglial tissue, mucoid tissue.", synonyms: [], elements: ["FJ1331", "FJ1382"], major: false },
