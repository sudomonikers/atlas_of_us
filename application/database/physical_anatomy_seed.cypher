  { fmaId: "FMA67242", name: "Gray matter of neuraxis", definition: "Cell part cluster consisting predominantly of somas of neurons in the brain and the spinal cord.", synonyms: ["Gray matter", "Grey matter", "Grey substance"], elements: ["FJ1753", "FJ1754", "FJ1757", "FJ1766", "FJ1768", "FJ1776", "FJ1802", "FJ1805", "FJ1813", "FJ1815", "FJ1816", "FJ1816M", "FJ1823", "FJ1829"], major: false },
  { fmaId: "FMA67292", name: "Right cerebral hemisphere", definition: "The right cerebral hemisphere is one of two bilateral, largely symmetrical organ subdivisions within the telencephalon which contain the cerebral cortex and cerebral white matter.", synonyms: [], elements: ["FJ1733", "FJ1740", "FJ1745", "FJ1747", "FJ1749", "FJ1751", "FJ1784", "FJ1786", "FJ1788", "FJ1790", "FJ1792", "FJ1798", "FJ1801", "FJ1806", "FJ1807", "FJ1814", "FJ1834", "FJ1836", "FJ1842"], major: false },
  { fmaId: "FMA67325", name: "Occipital lobe", definition: "Occipital lobe is the one of five lobes of the cerebral hemisphere which occupies the posterior-most portion of the hemisphere.  Anteriorly, it shares an arbitrary border with the parietal lobe and temporal lobe.  Medially, it is bounded by the longitudinal cerebral fissure.", synonyms: ["Occipital cortex", "Occipital region"], elements: ["FJ1791", "FJ1792"], major: true },
  { fmaId: "FMA67329", name: "Insula", definition: "Lobe of cerebral hemispheere located in the depths of the lateral fissure and is covered by portions of the frontal, parietal and temporal lobes.", synonyms: ["Central lobe", "Cortex of island", "Insula lobule", "Insular cortex", "Insular lobe", "Insular region", "Island of Reil"], elements: ["FJ1748", "FJ1749"], major: false },
