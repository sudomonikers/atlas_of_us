  { fmaId: "FMA9533", name: "Wall of right ventricle", definition: "Wall of ventricle which is continuous with the wall of pulmonary trunk.", synonyms: ["Right ventricular wall"], elements: ["FJ2419", "FJ2430", "FJ2437"], major: false },
