  { fmaId: "FMA19617", name: "Corpus spongiosum of penis", definition: "Cavernous organ, located on the ventral aspect of the penis. Examples: There is only one corpus spongiosum of penis.", synonyms: ["Corpus spongiosum", "Spongiose body of penis"], elements: ["FJ3133"], major: true },
