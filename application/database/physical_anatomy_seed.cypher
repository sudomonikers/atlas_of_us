  { fmaId: "FMA9496", name: "Fibrous skeleton of heart", definition: "Fibrous connective tissue which attaches the leaf and cusp of cardiac valve to the wall of heart.", synonyms: ["Cardiac fibrous skeleton", "Skeleton of heart"], elements: ["FJ2420", "FJ2426", "FJ2431"], major: false },
  { fmaId: "FMA9498", name: "Fibrous ring of mitral valve", definition: "left fibrous ring of heart which consists of the anulus proper, the interfilar connective tissue, the left fibrous trigone and the subaortic curtain of left ventricle that attaches the leaflets of mitral valve to the wall of heart.", synonyms: ["Anulus of mitral valve", "Mitral anulus", "Mitral valvar anulus", "Mitral valve anulus"], elements: ["FJ2420", "FJ2426", "FJ2431"], major: false },
