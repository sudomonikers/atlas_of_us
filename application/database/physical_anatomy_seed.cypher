  { fmaId: "FMA9465", name: "Cavity of left atrium", definition: "Cavity of atrium which is surrounded by the wall of left atrium and is continuous with the lumen of the pulmonary vein.", synonyms: ["Left atrial cavity"], elements: ["FJ2425"], major: false },
