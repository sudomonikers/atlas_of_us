  { fmaId: "FMA9438", name: "Left posterior segmental vein", definition: "Posterior segmental vein, each instance of which drains the posterior segment of the upper lobe (superior) lobe of some left lung.", synonyms: ["Left V2", "Posterior bronchopulmonary segment of left superior pulmonary vein"], elements: ["FJ2926", "FJ2927", "FJ2928", "FJ2929", "FJ2939", "FJ2940", "FJ2941", "FJ2942", "FJ2943", "FJ2965"], major: false },
