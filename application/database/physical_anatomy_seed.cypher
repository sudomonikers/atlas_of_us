  { fmaId: "FMA3818", name: "Marginal branch of right coronary artery", definition: "Anterior ventricular branch of right coronary artery which runs downward along the the acute margin and supplies the anterior wall of right ventricle and the apex.", synonyms: ["Acute marginal artery", "Right marginal artery", "Right marginal branch of right coronary artery"], elements: ["FJ2667", "FJ2668", "FJ2672", "FJ2674", "FJ2675"], major: false },
  { fmaId: "FMA3835", name: "Posterior ventricular branch of right coronary artery", definition: "Ventricular branch of right coronary artery which runs obliqually to the right upper and middle third of the posterior interventricular sulcus to supply the posterior wall of right ventricle.", synonyms: ["Right posterior ventricular artery"], elements: ["FJ2714", "FJ2715", "FJ2716", "FJ2717", "FJ2718", "FJ2719", "FJ2720", "FJ2721", "FJ2722"], major: false },
