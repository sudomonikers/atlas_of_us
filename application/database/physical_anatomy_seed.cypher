  { fmaId: "FMA9560", name: "Anterior wall of left ventricle", definition: "Region of wall of left ventricle which consists of the endocardium, basal, mid and apical anterior zones of myocardium of left ventricle and epicardium of anterior wall of left ventricle and is continuous with the lateral and septal walls of left ventricle.", synonyms: [], elements: ["FJ2418", "FJ2429"], major: false },
  { fmaId: "FMA9561", name: "Inferior wall of left ventricle", definition: "Region of wall of left ventricle which consists of the endocardium, basal, mid and apical zones of myocardium of left ventricle and epicardium of  inferior wall of myocardium of left ventricle and is continuous witht the lateral and septal walls of left ventricle..", synonyms: ["Posterior wall of left ventricle"], elements: ["FJ2432"], major: false },
  { fmaId: "FMA9563", name: "Lateral wall of left ventricle", definition: "Region of wall of left ventricle which consists of endocardium, basal, mid and apical lateral zones of myocardium of left ventricle and epicardium of lateral wall of left ventricle and is continuous with the anterior and inferior walls of left ventricle.", synonyms: [], elements: ["FJ2418", "FJ2429"], major: false },
