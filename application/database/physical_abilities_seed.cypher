// =============================================================================
// Atlas of Us — Physical Attributes sub-graph seed: abilities
// Spec: documentation/data_model/physical_attributes/physical_attributes.md
//
// One static Ability node per ability, from the abilities of the O*NET content
// model (the Fleishman taxonomy): 15 cognitive, 10 psychomotor, 9 physical and
// 12 sensory. The cognitive ones carry a second label, Cognitive. O*NET's verbal
// abilities (oral and written comprehension and expression) and quantitative
// abilities (mathematical reasoning, number facility) are skills in the Atlas,
// so they're left out here. A Person links to an
// ability with HAS_ABILITY {value, confidence}, a percentile from 0 to 1 with
// 0.5 typical, as for personality traits.
//
// `practice`, in section 3, is how much practice changes the ability, and its
// AbilityTip nodes, in section 4, say how a person can work on it.
//
// `examples` are O*NET's level anchors, from low to high: things that take a
// little of the ability up to a lot of it. `anchorLevels` is where each one
// sits on O*NET's 0 to 7 level scale, over 7, in the same order.
//
// Source: O*NET 30.0 Database, Content Model Reference and Level Scale Anchors,
// by the U.S. Department of Labor, Employment and Training Administration,
// under CC BY 4.0 (https://www.onetcenter.org/database.html). Credit O*NET
// wherever this data is shown.
//
// Idempotent: safe to re-run. MERGE on name, everything else overwritten from
// this file on every run. id is set once, when the ability is first created, so
// it never changes on a re-run.
// =============================================================================


// -----------------------------------------------------------------------------
// 0. Constraints
// -----------------------------------------------------------------------------

CREATE CONSTRAINT ability_name_unique IF NOT EXISTS
FOR (n:Ability) REQUIRE n.name IS UNIQUE;

CREATE CONSTRAINT ability_id_unique IF NOT EXISTS
FOR (n:Ability) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT ability_tip_id_unique IF NOT EXISTS
FOR (n:AbilityTip) REQUIRE n.id IS UNIQUE;


// -----------------------------------------------------------------------------
// 1. Abilities
// -----------------------------------------------------------------------------

UNWIND [

  // ---- cognitive ----
  { name: "Fluency of Ideas", onetId: "1.A.1.b.1", category: "Cognitive", group: "Idea Generation and Reasoning Abilities",
    description: "The ability to come up with a number of ideas about a topic (the number of ideas is important, not their quality, correctness, or creativity).",
    examples: ["Name four different uses for a screwdriver", "Think of as many ideas as possible for the name of a new company", "Identify as many strategies as possible for a company acquisition and merger"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Originality", onetId: "1.A.1.b.2", category: "Cognitive", group: "Idea Generation and Reasoning Abilities",
    description: "The ability to come up with unusual or clever ideas about a given topic or situation, or to develop creative ways to solve a problem.",
    examples: ["Use a credit card to open a locked door", "Redesign job tasks to be interesting for employees", "Invent a new type of man-made fiber"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Problem Sensitivity", onetId: "1.A.1.b.3", category: "Cognitive", group: "Idea Generation and Reasoning Abilities",
    description: "The ability to tell when something is wrong or is likely to go wrong. It does not involve solving the problem, only recognizing that there is a problem.",
    examples: ["Recognize that an unplugged lamp won't work", "Notice from a subtle difference in a client's mood that something is bothering them", "Recognize an illness at an early stage of a disease when there are only a few symptoms"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Deductive Reasoning", onetId: "1.A.1.b.4", category: "Cognitive", group: "Idea Generation and Reasoning Abilities",
    description: "The ability to apply general rules to specific problems to produce answers that make sense.",
    examples: ["Know that a stalled car can coast downhill", "Decide what factors to consider in selecting stocks", "Design an aircraft wing using principles of aerodynamics"],
    anchorLevels: [0.286, 0.714, 0.857] },
  { name: "Inductive Reasoning", onetId: "1.A.1.b.5", category: "Cognitive", group: "Idea Generation and Reasoning Abilities",
    description: "The ability to combine pieces of information to form general rules or conclusions (includes finding a relationship among seemingly unrelated events).",
    examples: ["Decide what to wear based on the weather report", "Determine the prime suspect based on crime scene evidence", "Diagnose a disease using results of many different lab tests"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Information Ordering", onetId: "1.A.1.b.6", category: "Cognitive", group: "Idea Generation and Reasoning Abilities",
    description: "The ability to arrange things or actions in a certain order or pattern according to a specific rule or set of rules (e.g., patterns of numbers, letters, words, pictures, mathematical operations).",
    examples: ["Put things in numerical order", "Follow the correct steps to make change", "Assemble a wind turbine"],
    anchorLevels: [0.143, 0.286, 0.857] },
  { name: "Category Flexibility", onetId: "1.A.1.b.7", category: "Cognitive", group: "Idea Generation and Reasoning Abilities",
    description: "The ability to generate or use different sets of rules for combining or grouping things in different ways.",
    examples: ["Sort paintbrushes based on length", "Classify flowers according to size, color, and smell", "Classify man-made fibers in terms of their characteristics, like strength or cost"],
    anchorLevels: [0.286, 0.429, 0.857] },
  { name: "Memorization", onetId: "1.A.1.d.1", category: "Cognitive", group: "Memory",
    description: "The ability to remember information such as words, numbers, pictures, and procedures.",
    examples: ["Remember the number on your bus to be sure you get back on the right one", "Recite the first names of the five people you just met", "Recite a 300-word speech after studying it for 15 minutes"],
    anchorLevels: [0.143, 0.571, 0.857] },
  { name: "Speed of Closure", onetId: "1.A.1.e.1", category: "Cognitive", group: "Perceptual Abilities",
    description: "The ability to quickly make sense of, combine, and organize information into meaningful patterns.",
    examples: ["Recognize a song after hearing only the first few notes", "Make sense of messy handwriting", "Interpret patterns on weather radar to decide if the weather is changing"],
    anchorLevels: [0.429, 0.571, 0.714] },
  { name: "Flexibility of Closure", onetId: "1.A.1.e.2", category: "Cognitive", group: "Perceptual Abilities",
    description: "The ability to identify or detect a known pattern (a figure, object, word, or sound) that is hidden in other distracting material.",
    examples: ["Detect that your phone is ringing while at a concert", "Look for a golf ball in tall grass", "Identify camouflaged animals from a moving vehicle while on a safari"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Perceptual Speed", onetId: "1.A.1.e.3", category: "Cognitive", group: "Perceptual Abilities",
    description: "The ability to quickly and accurately compare similarities and differences among sets of letters, numbers, objects, pictures, or patterns. The things to be compared may be presented at the same time or one after the other. This ability also includes comparing a presented object with a remembered object.",
    examples: ["Sort mail according to ZIP codes with no time pressure", "Read five pressure indicators in 10 seconds to make sure each is within safe limits", "Inspect electrical parts for defects as they pass on a fast-moving assembly line"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Spatial Orientation", onetId: "1.A.1.f.1", category: "Cognitive", group: "Spatial Abilities",
    description: "The ability to know your location in relation to the environment or to know where other objects are in relation to you.",
    examples: ["Use the floor plan to locate a store in a mall", "Find your way through a dark room without hitting anything", "Navigate an ocean voyage using a compass and landmarks"],
    anchorLevels: [0.286, 0.429, 0.857] },
  { name: "Visualization", onetId: "1.A.1.f.2", category: "Cognitive", group: "Spatial Abilities",
    description: "The ability to imagine how something will look after it is moved around or when its parts are moved or rearranged.",
    examples: ["Imagine how to place paper in a printer so that the letterhead comes out on top", "Follow a diagram to assemble a metal storage cabinet", "Anticipate future moves in a chess game"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Selective Attention", onetId: "1.A.1.g.1", category: "Cognitive", group: "Attentiveness",
    description: "The ability to concentrate on a task over a period of time without being distracted.",
    examples: ["Answer a business call with coworkers talking nearby", "Watch security monitors for intruders throughout the night shift", "Study a technical manual while listening to loud construction sounds"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Time Sharing", onetId: "1.A.1.g.2", category: "Cognitive", group: "Attentiveness",
    description: "The ability to shift back and forth between two or more activities or sources of information (such as speech, sounds, touch, or other sources).",
    examples: ["Listen to music while entering numbers into a spreadsheet", "Watch street signs while driving at 30 miles an hour", "Monitor radar and radio transmissions to keep track of heavy aircraft traffic"],
    anchorLevels: [0.286, 0.429, 0.857] },

  // ---- psychomotor ----
  { name: "Arm-Hand Steadiness", onetId: "1.A.2.a.1", category: "Psychomotor", group: "Fine Manipulative Abilities",
    description: "The ability to keep your hand and arm steady while moving your arm or while holding your arm and hand in one position.",
    examples: ["Light a candle", "Thread a needle", "Cut facets in a diamond"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Manual Dexterity", onetId: "1.A.2.a.2", category: "Psychomotor", group: "Fine Manipulative Abilities",
    description: "The ability to quickly move your hand, your hand together with your arm, or your two hands to grasp, manipulate, or assemble objects.",
    examples: ["Screw a light bulb into a light socket", "Pack oranges in crates as quickly as possible", "Perform open heart surgery with surgical instruments"],
    anchorLevels: [0.143, 0.571, 1] },
  { name: "Finger Dexterity", onetId: "1.A.2.a.3", category: "Psychomotor", group: "Fine Manipulative Abilities",
    description: "The ability to make precisely coordinated movements of the fingers of one or both hands to grasp, manipulate, or assemble very small objects.",
    examples: ["Put coins in a parking meter", "Attach small dials to audio equipment on an assembly line", "Put together the inner workings of a small wrist watch"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Control Precision", onetId: "1.A.2.b.1", category: "Psychomotor", group: "Control Movement Abilities",
    description: "The ability to quickly and repeatedly adjust the controls of a machine or a vehicle to exact positions.",
    examples: ["Adjust a room light with a dimmer switch", "Adjust farm tractor controls", "Drill a tooth"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Multilimb Coordination", onetId: "1.A.2.b.2", category: "Psychomotor", group: "Control Movement Abilities",
    description: "The ability to coordinate two or more limbs (for example, two arms, two legs, or one leg and one arm) while sitting, standing, or lying down. It does not involve performing the activities while the whole body is in motion.",
    examples: ["Row a boat", "Operate a forklift truck in a warehouse", "Play the drum set in a jazz band"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Response Orientation", onetId: "1.A.2.b.3", category: "Psychomotor", group: "Control Movement Abilities",
    description: "The ability to choose quickly between two or more movements in response to two or more different signals (lights, sounds, pictures). It includes the speed with which the correct response is started with the hand, foot, or other body part.",
    examples: ["When a doorbell and phone ring at the same time, quickly select which to answer first", "Use either the brake or gas pedal when your vehicle is skidding", "In an out-of-control commercial aircraft, react quickly to restore control"],
    anchorLevels: [0.286, 0.571, 1] },
  { name: "Rate Control", onetId: "1.A.2.b.4", category: "Psychomotor", group: "Control Movement Abilities",
    description: "The ability to time your movements or the movement of a piece of equipment in anticipation of changes in the speed and/or direction of a moving object or scene.",
    examples: ["Ride a bicycle alongside a jogger", "Keep up with a car that changes speed", "Shoot a duck in flight"],
    anchorLevels: [0.143, 0.571, 0.714] },
  { name: "Reaction Time", onetId: "1.A.2.c.1", category: "Psychomotor", group: "Reaction Time and Speed Abilities",
    description: "The ability to quickly respond (with the hand, finger, or foot) to a signal (sound, light, picture) when it appears.",
    examples: ["Start to slow down the car when a traffic light turns yellow", "Press a button to stop operation when a warning light goes off", "Hit the brake when a pedestrian steps in front of your car"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Wrist-Finger Speed", onetId: "1.A.2.c.2", category: "Psychomotor", group: "Reaction Time and Speed Abilities",
    description: "The ability to make fast, simple, repeated movements of the fingers, hands, and wrists.",
    examples: ["Use a screwdriver to twist in a screw", "Carve roast beef in a cafeteria", "Type 90 words per minute"],
    anchorLevels: [0.286, 0.429, 0.857] },
  { name: "Speed of Limb Movement", onetId: "1.A.2.c.3", category: "Psychomotor", group: "Reaction Time and Speed Abilities",
    description: "The ability to quickly move the arms and legs.",
    examples: ["Saw through a thin piece of wood", "Swat a fly with a fly swatter", "Throw punches in a boxing match"],
    anchorLevels: [0.286, 0.571, 0.857] },

  // ---- physical ----
  { name: "Static Strength", onetId: "1.A.3.a.1", category: "Physical", group: "Physical Strength Abilities",
    description: "The ability to exert maximum muscle force to lift, push, pull, or carry objects.",
    examples: ["Push an empty shopping cart", "Pull a 40-pound sack of fertilizer across the lawn", "Lift 75-pound bags of cement onto a truck"],
    anchorLevels: [0.143, 0.571, 0.857] },
  { name: "Explosive Strength", onetId: "1.A.3.a.2", category: "Physical", group: "Physical Strength Abilities",
    description: "The ability to use short bursts of muscle force to propel oneself (as in jumping or sprinting), or to throw an object.",
    examples: ["Hit a nail with a hammer", "Jump onto a 3-foot high platform", "Throw a shot-put in a track meet"],
    anchorLevels: [0.286, 0.571, 1] },
  { name: "Dynamic Strength", onetId: "1.A.3.a.3", category: "Physical", group: "Physical Strength Abilities",
    description: "The ability to exert muscle force repeatedly or continuously over time. This involves muscular endurance and resistance to muscle fatigue.",
    examples: ["Use pruning shears to trim a bush", "Climb a 48-foot long ladder", "Perform a gymnastics routine using the rings"],
    anchorLevels: [0.286, 0.714, 0.857] },
  { name: "Trunk Strength", onetId: "1.A.3.a.4", category: "Physical", group: "Physical Strength Abilities",
    description: "The ability to use your abdominal and lower back muscles to support part of the body repeatedly or continuously over time without \"giving out\" or fatiguing.",
    examples: ["Sit up in an office chair", "Shovel snow for half an hour", "Do 100 sit-ups"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Stamina", onetId: "1.A.3.b.1", category: "Physical", group: "Endurance",
    description: "The ability to exert yourself physically over long periods of time without getting winded or out of breath.",
    examples: ["Walk 1/4 mile", "Climb 6 flights of stairs", "Run 10 miles"],
    anchorLevels: [0.143, 0.571, 0.857] },
  { name: "Extent Flexibility", onetId: "1.A.3.c.1", category: "Physical", group: "Flexibility, Balance, and Coordination",
    description: "The ability to bend, stretch, twist, or reach with your body, arms, and/or legs.",
    examples: ["Reach to adjust the radio in a car", "Reach for a box on a high warehouse shelf", "Work under the dashboard of a car"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Dynamic Flexibility", onetId: "1.A.3.c.2", category: "Physical", group: "Flexibility, Balance, and Coordination",
    description: "The ability to quickly and repeatedly bend, stretch, twist, or reach out with your body, arms, and/or legs.",
    examples: ["Hand pick a bushel of apples from a tree", "Perform a dance routine as part of a cheerleading squad", "Maneuver a kayak through swift rapids"],
    anchorLevels: [0.286, 0.714, 0.857] },
  { name: "Gross Body Coordination", onetId: "1.A.3.c.3", category: "Physical", group: "Flexibility, Balance, and Coordination",
    description: "The ability to coordinate the movement of your arms, legs, and torso together when the whole body is in motion.",
    examples: ["Get in and out of a truck", "Swim the length of a pool", "Perform a ballet dance"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Gross Body Equilibrium", onetId: "1.A.3.c.4", category: "Physical", group: "Flexibility, Balance, and Coordination",
    description: "The ability to keep or regain your body balance or stay upright when in an unstable position.",
    examples: ["Stand on a ladder", "Walk on ice across a pond", "Walk on narrow beams in high-rise construction"],
    anchorLevels: [0.286, 0.571, 0.857] },

  // ---- sensory ----
  { name: "Near Vision", onetId: "1.A.4.a.1", category: "Sensory", group: "Visual Abilities",
    description: "The ability to see details at close range (within a few feet of the observer).",
    examples: ["Read indicators on the dashboard of a car", "Read the fine print of a legal document", "Detect minor defects in a diamond"],
    anchorLevels: [0.286, 0.714, 0.857] },
  { name: "Far Vision", onetId: "1.A.4.a.2", category: "Sensory", group: "Visual Abilities",
    description: "The ability to see details at a distance.",
    examples: ["Read a roadside billboard", "Read the slides on a presentation from across a room", "Detect differences in ships on the horizon"],
    anchorLevels: [0.286, 0.571, 1] },
  { name: "Visual Color Discrimination", onetId: "1.A.4.a.3", category: "Sensory", group: "Visual Abilities",
    description: "The ability to match or detect differences between colors, including shades of color and brightness.",
    examples: ["Separate laundry into colors and whites", "Trace electrical circuits marked by various colored wires", "Paint a color portrait of a person"],
    anchorLevels: [0.143, 0.571, 0.857] },
  { name: "Night Vision", onetId: "1.A.4.a.4", category: "Sensory", group: "Visual Abilities",
    description: "The ability to see under low-light conditions.",
    examples: ["Read street signs at dusk (just after sunset)", "Read a book in a dimly lit setting", "Find your way through the woods on a moonless night"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Peripheral Vision", onetId: "1.A.4.a.5", category: "Sensory", group: "Visual Abilities",
    description: "The ability to see objects or movement of objects to one's side when the eyes are looking ahead.",
    examples: ["Keep in step while marching in a band", "Be aware of the location of your teammates while dribbling a basketball", "Distinguish a teammate from a competitor passing by in a car race"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Depth Perception", onetId: "1.A.4.a.6", category: "Sensory", group: "Visual Abilities",
    description: "The ability to judge which of several objects is closer or farther away from you, or to judge the distance between you and an object.",
    examples: ["Merge a car into traffic on a city street", "Operate a crane to move materials from a truck bed to the ground", "Throw a long pass to a closely guarded teammate"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Glare Sensitivity", onetId: "1.A.4.a.7", category: "Sensory", group: "Visual Abilities",
    description: "The ability to see objects in the presence of a glare or bright lighting.",
    examples: ["Drive on a familiar road on a cloudy day", "See boats on the horizon when sailing", "Snow ski in bright sunlight"],
    anchorLevels: [0.286, 0.714, 0.857] },
  { name: "Hearing Sensitivity", onetId: "1.A.4.b.1", category: "Sensory", group: "Auditory and Speech Abilities",
    description: "The ability to detect or tell the differences between sounds that vary in pitch and loudness.",
    examples: ["Notice a doorbell ringing", "Diagnose what's wrong with a car engine from its sound", "Tune an orchestra"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Auditory Attention", onetId: "1.A.4.b.2", category: "Sensory", group: "Auditory and Speech Abilities",
    description: "The ability to focus on a single source of sound in the presence of other distracting sounds.",
    examples: ["Listen to a lecture while people nearby are talking", "Listen for your flight announcement at a busy airport", "Listen to instructions from a coworker in a noisy saw mill"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Sound Localization", onetId: "1.A.4.b.3", category: "Sensory", group: "Auditory and Speech Abilities",
    description: "The ability to tell the direction from which a sound originated.",
    examples: ["Listen to a sound system to determine which speaker is working", "Find a ringing phone in an unfamiliar apartment", "Determining the direction of an emergency vehicle from the sound of the siren"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Speech Recognition", onetId: "1.A.4.b.4", category: "Sensory", group: "Auditory and Speech Abilities",
    description: "The ability to identify and understand the speech of another person.",
    examples: ["Recognize the voice of a coworker", "Identify a former customer's voice over the phone", "Understand a speech presented by someone with an unfamiliar accent"],
    anchorLevels: [0.286, 0.571, 0.857] },
  { name: "Speech Clarity", onetId: "1.A.4.b.5", category: "Sensory", group: "Auditory and Speech Abilities",
    description: "The ability to speak clearly so others can understand you.",
    examples: ["Call numbers in a bingo game", "Make stadium-wide announcements during a sporting event", "Give a lecture to a large audience"],
    anchorLevels: [0.143, 0.571, 0.857] }

] AS a
MERGE (n:Ability {name: a.name})
ON CREATE SET n.id = randomUUID()
SET n.onetId = a.onetId,
    n.category = a.category,
    n.group = a.group,
    n.description = a.description,
    n.examples = a.examples,
    n.anchorLevels = a.anchorLevels;


// -----------------------------------------------------------------------------
// 2. Cognitive label
// -----------------------------------------------------------------------------

MATCH (n:Ability)
WHERE n.category = "Cognitive"
SET n:Cognitive;


// -----------------------------------------------------------------------------
// 3. Working on it
// -----------------------------------------------------------------------------
// `practice` is how much practice changes an ability: "a lot", "some" or
// "little".

UNWIND [
  { name: "Fluency of Ideas", practice: "a lot" },
  { name: "Originality", practice: "some" },
  { name: "Problem Sensitivity", practice: "some" },
  { name: "Deductive Reasoning", practice: "some" },
  { name: "Inductive Reasoning", practice: "some" },
  { name: "Information Ordering", practice: "some" },
  { name: "Category Flexibility", practice: "some" },
  { name: "Memorization", practice: "a lot" },
  { name: "Speed of Closure", practice: "some" },
  { name: "Flexibility of Closure", practice: "some" },
  { name: "Perceptual Speed", practice: "some" },
  { name: "Spatial Orientation", practice: "some" },
  { name: "Visualization", practice: "a lot" },
  { name: "Selective Attention", practice: "some" },
  { name: "Time Sharing", practice: "some" },
  { name: "Arm-Hand Steadiness", practice: "some" },
  { name: "Manual Dexterity", practice: "a lot" },
  { name: "Finger Dexterity", practice: "a lot" },
  { name: "Control Precision", practice: "a lot" },
  { name: "Multilimb Coordination", practice: "a lot" },
  { name: "Response Orientation", practice: "some" },
  { name: "Rate Control", practice: "some" },
  { name: "Reaction Time", practice: "little" },
  { name: "Wrist-Finger Speed", practice: "some" },
  { name: "Speed of Limb Movement", practice: "some" },
  { name: "Static Strength", practice: "a lot" },
  { name: "Explosive Strength", practice: "some" },
  { name: "Dynamic Strength", practice: "a lot" },
  { name: "Trunk Strength", practice: "a lot" },
  { name: "Stamina", practice: "a lot" },
  { name: "Extent Flexibility", practice: "a lot" },
  { name: "Dynamic Flexibility", practice: "some" },
  { name: "Gross Body Coordination", practice: "a lot" },
  { name: "Gross Body Equilibrium", practice: "a lot" },
  { name: "Near Vision", practice: "little" },
  { name: "Far Vision", practice: "little" },
  { name: "Visual Color Discrimination", practice: "little" },
  { name: "Night Vision", practice: "little" },
  { name: "Peripheral Vision", practice: "little" },
  { name: "Depth Perception", practice: "little" },
  { name: "Glare Sensitivity", practice: "little" },
  { name: "Hearing Sensitivity", practice: "little" },
  { name: "Auditory Attention", practice: "some" },
  { name: "Sound Localization", practice: "little" },
  { name: "Speech Recognition", practice: "some" },
  { name: "Speech Clarity", practice: "a lot" }
] AS w
MATCH (n:Ability {name: w.name})
SET n.practice = w.practice;


// -----------------------------------------------------------------------------
// 4. Tips
// -----------------------------------------------------------------------------
// An AbilityTip says how a person can work on an ability, linked with HAS_TIP.
// A "practice" tip is what to do, and for an ability practice barely changes,
// how to correct, protect or make up for it. An "impairment" tip is how to work
// on it around an impairment in what it rests on. Written for the Atlas. MERGE
// on the ability and kind, the text overwritten on every run.

UNWIND [
  { ability: "Fluency of Ideas", kind: "practice",
    text: "Set a timer for two minutes and list as many answers to one prompt as you can, such as uses for a spoon or names for a cafe, without judging them. Doing it most days, with a new prompt each time, makes ideas come faster." },
  { ability: "Fluency of Ideas", kind: "impairment",
    text: "If writing or speaking is hard, say your ideas into a voice recorder or have someone note them down, so getting them out doesn't slow the ideas." },
  { ability: "Originality", kind: "practice",
    text: "Once the obvious answers are out, push for three more that break a rule of the problem: use the thing for what it isn't for, join it to something unrelated, or turn the goal around. Borrowing ideas from a field you don't know well helps too." },
  { ability: "Originality", kind: "impairment",
    text: "Work in whatever way gets ideas out easiest for you, whether sketching, talking or typing. Originality is in the ideas, not in how they're recorded." },
  { ability: "Problem Sensitivity", kind: "practice",
    text: "Before you start something, ask what could go wrong and check for it. Afterwards, look back at what did go wrong and what its first sign was. Checklists and a habit of a second look build it." },
  { ability: "Problem Sensitivity", kind: "impairment",
    text: "If an impairment makes some signs hard to notice, like sounds or small details, lean on the ones you can: checklists, alarms, and asking someone to look over what matters." },
  { ability: "Deductive Reasoning", kind: "practice",
    text: "Practice with logic puzzles and by checking arguments: write out what you're told, then test whether the conclusion has to follow or only might. Telling the two apart gets easier with practice." },
  { ability: "Deductive Reasoning", kind: "impairment",
    text: "If reading or holding things in mind is hard, draw the statements as diagrams or have them read aloud, so the words don't hold up the reasoning." },
  { ability: "Inductive Reasoning", kind: "practice",
    text: "Pattern puzzles, like number sequences, matrices and logic grids, get easier with practice, mostly for puzzles like the ones you practice. Saying each rule out loud as you find it helps you see the next one." },
  { ability: "Inductive Reasoning", kind: "impairment",
    text: "If sight or attention gets in the way, take puzzles in larger print or with more time, and work through one rule at a time." },
  { ability: "Information Ordering", kind: "practice",
    text: "Practice putting things in order by a rule: the steps of a recipe, events in a story, or files by date. Following instructions exactly, ticking off each step, builds it." },
  { ability: "Information Ordering", kind: "impairment",
    text: "Numbered lists, checklists and step-by-step reminders on your phone can hold the order for you, so an impairment in memory or attention doesn't have to." },
  { ability: "Category Flexibility", kind: "practice",
    text: "Sort the same things in different ways, such as a drawer by color, then by size, then by use. Games where the rule changes partway, like card sorting games and Set, practice the switch." },
  { ability: "Category Flexibility", kind: "impairment",
    text: "If switching is hard because of an impairment in attention, write the current rule on a card where you can see it, and change it on purpose, one step at a time." },
  { ability: "Memorization", kind: "practice",
    text: "Memory techniques work: chunk long numbers into groups, link things to pictures or to places along a route you know, and test yourself instead of rereading. A spaced repetition app makes it a daily habit." },
  { ability: "Memorization", kind: "impairment",
    text: "If an impairment affects memory, lean on memory outside your head: notes, calendars, reminders and photos. The techniques still help, used with smaller amounts at a time." },
  { ability: "Speed of Closure", kind: "practice",
    text: "Word puzzles with missing letters, blurred-picture games and reading in unusual fonts all practice it. Reading widely gives you more words and shapes to recognize quickly." },
  { ability: "Speed of Closure", kind: "impairment",
    text: "If your sight is impaired, have it corrected first: glasses and good light make part-shown shapes much easier to fill in." },
  { ability: "Flexibility of Closure", kind: "practice",
    text: "Hidden-object pictures, find-the-shape puzzles and word searches practice picking a pattern out of a busy picture." },
  { ability: "Flexibility of Closure", kind: "impairment",
    text: "Good light, larger pictures and your glasses help most when sight is part of what holds you back." },
  { ability: "Perceptual Speed", kind: "practice",
    text: "Timed matching and comparing games, proofreading and spot-the-difference practice it. Practice helps most on tasks like the one you practice, so pick ones like what you need to do." },
  { ability: "Perceptual Speed", kind: "impairment",
    text: "If sight or attention slows you down, use larger print, strong contrast and short sessions: be accurate first, then get faster." },
  { ability: "Spatial Orientation", kind: "practice",
    text: "Use a paper map before your phone, turn it to match the way you're facing, and point to where places are before you check. Exploring new places on foot builds it fastest." },
  { ability: "Spatial Orientation", kind: "impairment",
    text: "If getting around is limited, practice with maps and street view, pointing to landmarks before you turn." },
  { ability: "Visualization", kind: "practice",
    text: "Picturing shapes trains well, and the gains last: 3D puzzles, building kits, drawing an object from another side, and games that turn shapes around all help." },
  { ability: "Visualization", kind: "impairment",
    text: "If your hands or sight make physical puzzles hard, digital ones with large pieces, or describing a shape's turns out loud, practice the same thing." },
  { ability: "Selective Attention", kind: "practice",
    text: "Practice doing one thing with distractions around, starting somewhere a little busy and moving somewhere busier. Turning off notifications and working in short blocks with breaks also helps you hold focus." },
  { ability: "Selective Attention", kind: "impairment",
    text: "If an impairment such as ADHD or hearing loss makes distractions worse, shape the space around you: noise-canceling headphones, a clear desk, and fewer things going on at once." },
  { ability: "Time Sharing", kind: "practice",
    text: "Practice two things together that you can already do alone, like walking and talking, then make one of them harder. Practice makes each one more automatic, which frees attention for the other." },
  { ability: "Time Sharing", kind: "impairment",
    text: "If doing two things at once is hard because of an impairment, take one off your hands with lists and alarms, or do them one after the other where you can." },
  { ability: "Arm-Hand Steadiness", kind: "practice",
    text: "Strength and practice both help: hold a full glass at arm's length, thread a needle, or trace lines slowly. Enough sleep and less caffeine make hands steadier too." },
  { ability: "Arm-Hand Steadiness", kind: "impairment",
    text: "If a tremor or weakness is the cause, see a doctor or an occupational therapist. Resting your forearm on a surface, and tools with weighted or thicker handles, steady the work." },
  { ability: "Manual Dexterity", kind: "practice",
    text: "Use your hands for things that need both speed and care, like chopping food, gardening, building kits or playing an instrument. Doing them often, a little faster each time, builds it." },
  { ability: "Manual Dexterity", kind: "impairment",
    text: "An occupational therapist can set exercises for your hands, and tools with thicker grips or easier fastenings make everyday tasks easier while you work on it." },
  { ability: "Finger Dexterity", kind: "practice",
    text: "Small, careful work trains it: playing an instrument, typing, knitting, building models, or turning coins over with one hand." },
  { ability: "Finger Dexterity", kind: "impairment",
    text: "An occupational therapist can set finger exercises that suit your hands, and aids like grip pens and easier fastenings help in the meantime." },
  { ability: "Control Precision", kind: "practice",
    text: "Tasks that need fine control of a pointer, wheel or lever train it, like drawing on a tablet or steering through a course, slowly at first and then faster." },
  { ability: "Control Precision", kind: "impairment",
    text: "If movement is limited, change the controls: a slower pointer, larger targets and a steady support for your arm make practice possible." },
  { ability: "Multilimb Coordination", kind: "practice",
    text: "Drumming, dancing, swimming and playing the piano all use your limbs together and improve with practice. Start slowly so each limb gets its part right, then speed up." },
  { ability: "Multilimb Coordination", kind: "impairment",
    text: "A physiotherapist can adapt coordination work to what your body can do. Seated drumming and swimming with floats are good places to start." },
  { ability: "Response Orientation", kind: "practice",
    text: "Fast games where the right response depends on what appears, like reaction apps with colors or directions, or ball sports, sharpen it. Be accurate first, then get faster." },
  { ability: "Response Orientation", kind: "impairment",
    text: "If sight or hearing is involved, practice with the sense that's strongest for you, and make the signals bigger, louder or brighter." },
  { ability: "Rate Control", kind: "practice",
    text: "Catching, hitting moving balls and timing games train it. Watch the moving thing all the way in." },
  { ability: "Rate Control", kind: "impairment",
    text: "If your sight limits tracking, larger, brighter and slower targets let you practice, and you can speed them up over time." },
  { ability: "Reaction Time", kind: "practice",
    text: "Reaction time changes only a little with training, but you're quickest when you're rested, alert and know what to expect. Sports and fast games help mostly by teaching you what to watch for." },
  { ability: "Reaction Time", kind: "impairment",
    text: "If an impairment slows your reactions, plan around it: leave more time and distance, such as when driving, and avoid needing split-second reactions where you can." },
  { ability: "Wrist-Finger Speed", kind: "practice",
    text: "Fast, repeated finger and wrist work trains it, like finger drumming, typing practice and instrument drills, a little faster each week." },
  { ability: "Wrist-Finger Speed", kind: "impairment",
    text: "Rest when it aches, and ask a physiotherapist about pain or stiffness in your hands or wrists. Faster isn't worth an injury." },
  { ability: "Speed of Limb Movement", kind: "practice",
    text: "Quick, light movements done often help: hitting pads, table tennis, agility drills and short sprints, done fresh and with good form." },
  { ability: "Speed of Limb Movement", kind: "impairment",
    text: "A physiotherapist can suggest safe speed work around an injury or a joint that limits you." },
  { ability: "Static Strength", kind: "practice",
    text: "Lift heavy for a few repetitions, two or three times a week: squats, deadlifts, presses and rows, adding weight slowly. Strength builds faster than almost anything else here." },
  { ability: "Static Strength", kind: "impairment",
    text: "Work with a physiotherapist or trainer around the impaired part: train what you can, with machines or resistance bands that let you control the load." },
  { ability: "Explosive Strength", kind: "practice",
    text: "Jump, throw and sprint, a few fast efforts at a time with full rest between, on top of getting stronger. Box jumps and medicine-ball throws are good starts." },
  { ability: "Explosive Strength", kind: "impairment",
    text: "Explosive work is hard on joints, so with an impairment start with seated throws or low steps, and check with a physiotherapist first." },
  { ability: "Dynamic Strength", kind: "practice",
    text: "Push-ups, pull-ups, rows and dips, in sets of 8 to 15, a few times a week, adding repetitions or weight as they get easier." },
  { ability: "Dynamic Strength", kind: "impairment",
    text: "Resistance bands, wall push-ups and machines let you train with less strain on an injured joint. A physiotherapist can help you choose." },
  { ability: "Trunk Strength", kind: "practice",
    text: "Planks, side planks and carrying something heavy in one hand train your core. A few minutes on most days is enough to see a change." },
  { ability: "Trunk Strength", kind: "impairment",
    text: "With back problems, start with the gentle exercises a physiotherapist gives you, and build up slowly." },
  { ability: "Stamina", kind: "practice",
    text: "Do something that gets you breathing hard, like brisk walking, cycling, running or swimming, three or more times a week, adding a little each week. Stamina improves within weeks." },
  { ability: "Stamina", kind: "impairment",
    text: "Pick a kind that spares the impaired part, such as swimming or cycling for sore joints, or arm cycling if your legs are limited. Ask a doctor first if it's your heart or lungs." },
  { ability: "Extent Flexibility", kind: "practice",
    text: "Stretch after exercise, while you're warm: hold each stretch for about 30 seconds, a few times, on most days. Yoga does this well." },
  { ability: "Extent Flexibility", kind: "impairment",
    text: "Stretch gently and stop at discomfort, before pain. A physiotherapist can show you what's safe around a stiff or injured joint." },
  { ability: "Dynamic Flexibility", kind: "practice",
    text: "Moving stretches, like leg swings, torso twists and yoga flows, done quickly but under control, train flexibility at speed." },
  { ability: "Dynamic Flexibility", kind: "impairment",
    text: "Keep the movements smaller and slower around the impaired part, and build up the range over weeks." },
  { ability: "Gross Body Coordination", kind: "practice",
    text: "Sports and dance that use your whole body, like swimming, martial arts, skipping and climbing, train it. Learning a new skill trains it most." },
  { ability: "Gross Body Coordination", kind: "impairment",
    text: "Adapted sports, seated dance and exercise in water let you train coordination more safely. A physiotherapist can suggest where to start." },
  { ability: "Gross Body Equilibrium", kind: "practice",
    text: "Stand on one leg while you brush your teeth, then with your eyes closed, then on a cushion. Tai chi and yoga train balance well at any age." },
  { ability: "Gross Body Equilibrium", kind: "impairment",
    text: "Practice next to a counter or wall you can hold, and ask a physiotherapist about balance work if you've fallen or often feel dizzy." },
  { ability: "Near Vision", kind: "practice",
    text: "Reading up close gets harder for nearly everyone after about 40. An eye test and the right reading glasses fix most of it, and good light helps." },
  { ability: "Near Vision", kind: "impairment",
    text: "Ask an optometrist about magnifiers, large print and zooming your screen, which help where glasses can't." },
  { ability: "Far Vision", kind: "practice",
    text: "Eyesight can't be trained much, but it can be corrected. Have an eye test every couple of years and wear the glasses or lenses you're given." },
  { ability: "Far Vision", kind: "impairment",
    text: "An optometrist can suggest low vision aids, like magnifiers and telescopic glasses, for what glasses can't fix." },
  { ability: "Visual Color Discrimination", kind: "practice",
    text: "Color vision is mostly fixed. Good, daylight-like light helps you tell colors apart, and apps can name a color for you." },
  { ability: "Visual Color Discrimination", kind: "impairment",
    text: "With color blindness, use labels and patterns, color-naming apps, and the color-blind settings on your phone and computer." },
  { ability: "Night Vision", kind: "practice",
    text: "Seeing in the dark gets harder with age. Keep your glasses and windscreen clean, give your eyes a few minutes to adjust to the dark, and have your eyes checked if it gets worse quickly." },
  { ability: "Night Vision", kind: "impairment",
    text: "Ask an eye doctor about it, as cataracts and some vitamin deficiencies can cause it, and avoid driving at night while it's hard." },
  { ability: "Peripheral Vision", kind: "practice",
    text: "Side vision can't be trained much, but you can learn to make up for it by scanning: turn your head more and check side to side often, especially when driving or crossing roads." },
  { ability: "Peripheral Vision", kind: "impairment",
    text: "If your side vision has narrowed, see an eye doctor, as it can be a sign of glaucoma. Scanning practice and extra mirrors help make up for it." },
  { ability: "Depth Perception", kind: "practice",
    text: "Judging distance depends mostly on both eyes working well together. An eye test can find a problem with one eye, and some can be helped with vision therapy." },
  { ability: "Depth Perception", kind: "impairment",
    text: "With sight in only one eye, use other clues to distance: move your head to see how things shift, and take extra care on steps and when catching." },
  { ability: "Glare Sensitivity", kind: "practice",
    text: "Polarized sunglasses, a hat with a brim and anti-glare coatings on your glasses cut glare. Keeping your windscreen and screens clean helps too." },
  { ability: "Glare Sensitivity", kind: "impairment",
    text: "Strong sensitivity to glare can come from cataracts or other eye conditions, so have it checked. Tinted lenses can help." },
  { ability: "Hearing Sensitivity", kind: "practice",
    text: "Hearing can't be trained back, but it can be protected: keep music down, wear ear protection around loud noise, and have a hearing test if you notice a change." },
  { ability: "Hearing Sensitivity", kind: "impairment",
    text: "Hearing aids, captions and sitting near whoever's speaking help most. An audiologist can find what suits you." },
  { ability: "Auditory Attention", kind: "practice",
    text: "Practice listening for one voice or sound with others around, like following one instrument in a song or one conversation in a busy room. Cutting background noise where you can helps a lot." },
  { ability: "Auditory Attention", kind: "impairment",
    text: "With hearing loss, hearing aids with directional microphones, captions and quieter places make it much easier to follow one voice." },
  { ability: "Sound Localization", kind: "practice",
    text: "Telling where a sound comes from depends on hearing well in both ears. Protect your hearing, and turn your head toward a sound to pin it down." },
  { ability: "Sound Localization", kind: "impairment",
    text: "With hearing loss in one ear it's much harder. Hearing aids in both ears help, and so does using your eyes to check." },
  { ability: "Speech Recognition", kind: "practice",
    text: "Listening to podcasts, audiobooks and people with different accents trains you to follow more kinds of speech. Face whoever's speaking and cut background noise when you can." },
  { ability: "Speech Recognition", kind: "impairment",
    text: "With hearing loss, hearing aids, captions, and asking people to face you and speak a little slower help most." },
  { ability: "Speech Clarity", kind: "practice",
    text: "Read aloud, record yourself and listen back, and slow down. Speaking or singing in a group trains it, and a speech therapist can help with particular sounds." },
  { ability: "Speech Clarity", kind: "impairment",
    text: "A speech and language therapist can give exercises for your voice and mouth, and suggest aids if speaking is hard." }
] AS t
MATCH (a:Ability {name: t.ability})
MERGE (a)-[:HAS_TIP]->(tip:AbilityTip {kind: t.kind})
ON CREATE SET tip.id = randomUUID()
SET tip.text = t.text;
