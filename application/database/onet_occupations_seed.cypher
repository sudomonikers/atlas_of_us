  {soc: "19-3039.03", title: "Clinical Neuropsychologists", description: "Assess and diagnose patients with neurobehavioral problems related to acquired or developmental disorders of the nervous system, such as neurodegenerative disorders, traumatic brain injury, seizure disorders, and learning disabilities. Recommend treatment after diagnosis, such as therapy, medication, or surgery. Assist with evaluation before and after neurosurgical procedures, such as deep brain stimulation.", alternateTitles: ["Adult Neuropsychologist", "Aviation Neuropsychologist", "Board Certified Clinical Neuropsychologist", "Clinical Neuropsychologist", "Neuropsychology Medical Consultant", "Pediatric Clinical Neuropsychologist", "Pediatric Neuropsychologist", "Staff Psychologist"], vector: [-0.00343,0.02352,0.00006,0.00127,0.00275,0.02284,-0.02752,-0.02817,0.01133,-0.00518,0.02424,0.00005,0.00308,0.00022,0.02621,-0.03062,-0.00432,0.01117,0.03854,0.03006,-0.10171,0.01155,0.03871,-0.04744,-0.00150,0.02346,-0.03466,0.03057,0.03187,0.04108,-0.02936,0.02478,-0.01259,0.01769,0.02165,-0.01125,0.03916,0.02416,-0.07260,0.03536,0.05442,-0.03290,-0.00018,0.00774,0.03506,-0.01680,-0.01367,0.02183,0.01383,-0.00769,-0.00199,0.01699,-0.03636,-0.02743,0.02727,0.05202,-0.04132,0.03404,0.03269,0.03567,-0.02520,0.01189,-0.02081,0.03576,-0.00134,0.01052,-0.00104,0.02913,-0.02787,-0.01771,-0.03305,0.01566,0.07457,-0.03865,-0.03274,0.01699,0.02525,0.02215,-0.03814,0.00910,-0.04838,0.07215,0.03650,0.03868,0.05499,0.01940,-0.00841,-0.00848,0.02176,0.02152,0.00610,0.03861,-0.01875,0.00324,0.01334,-0.02260,0.08382,0.01947,-0.01411,0.01607,-0.03905,-0.00101,-0.02769,-0.04004,-0.01025,-0.01115,0.00637,-0.01789,-0.01207,-0.02712,0.02293,-0.03160,0.00174,-0.06575,0.05373,0.06297,0.05102,-0.00388,0.02243,0.01120,0.00223,0.02496,0.06164,0.02215,0.00154,0.02958,-0.02967,0.01966,0.01021,-0.02918,-0.02625,-0.03287,-0.02413,0.02192,-0.00664,-0.05104,0.03889,-0.04566,-0.01195,-0.01069,-0.00230,-0.01934,0.02004,-0.00632,0.05