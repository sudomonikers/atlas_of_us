  {soc: "19-3032.00", title: "Industrial-Organizational Psychologists", description: "Apply principles of psychology to human resources, administration, management, sales, and marketing problems. Activities may include policy planning; employee testing and selection, training, and development; and organizational development and analysis. May work with management to organize the work setting to improve worker productivity.", alternateTitles: ["Consulting Psychologist", "Engineering Psychologist", "HR Consultant (Human Resources Consultant)", "HR OD Consultant (Human Resources Organizational Development Consultant)", "HR Psychologist (Human Resources Psychologist)", "I-O Practitioner (Industrial-Organizational Practitioner)", "I-O Psychologist (Industrial-Organizational Psychologist)", "Industrial Psychologist", "Learning and Organizational Development Specialist (Learning and OD Specialist)", "Management Consultant", "Management Psychologist", "Occupational Psychologist"], vector: [-0.04910,0.04468,0.02546,-0.00991,-0.02815,-0.03057,0.03438,-0.00771,0.05508,-0.00153,0.03069,-0.02295,0.03155,0.00021,-0.01281,0.04353,0.01703,0.03312,-0.04071,0.01852,-0.07248,0.03224,0.04501,0.05317,-0.07004,0.02932,-0.00679,0.01660,0.06007,0.03681,-0.02734,0.01322,0.03234,-0.03047,0.06554,0.01621,-0.03590,0.02181,-0.01060,-0.04060,0.00080,0.00984,-0.00100,0.03865,-0.03711,0.02918,0.04896,-0.00883,-0.01111,-0.00673,-0.01134,0.05700,-0.02206,0.01627,0.01819,-0.01426,0.00386,0.01410,0.07836,0.03055,-0.08786,-0.00118,-0.01965,0.01214,0.02592,0.00267,0.00524,0.05501,-0.04510,0.01817,0.03230,-0.01610,-0.00077,0.03482,0.05125,0.02465,-0.04082,0.02938,-0.02907,0.02219,-0.03613,0.04707,-0.01231,-0.02943,-0.00332,-0.01752,0.00789,0.04001,-0.03110,0.00516,-0.02692,0.03038,0.01934,0.01485,0.00088,0.00154,0.01482,0.07598,-0.00664,0.06929,-0.06370,0.01431,-0.00500,-0.03908,0.03833,-0.02367,-0.01397,-0.01869,-0.00233,-0.01124,0.01563,-0.01224,-0.04019,0.01707,0.00819,0.03408,0.05833,0.03294,0.07565,-