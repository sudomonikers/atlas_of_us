  {soc: "43-5061.00", title: "Production, Planning, and Expediting Clerks", description: "Coordinate and expedite the flow of work and materials within or between departments of an establishment according to production schedule. Duties include reviewing and distributing production, work, and shipment schedules; conferring with department supervisors to determine progress of work and completion dates; and compiling reports on progress of work, inventory levels, costs, and production problems.", alternateTitles: ["Advertising Dispatch Clerk", "Aircraft Log Clerk", "Alterations Workroom Clerk", "Assignment Agent", "Assignment Clerk", "Automated Logistical Specialist", "Back Shoe Worker", "Batch Records Clerk", "Beef Tagger", "Billet Recorder", "Box Estimator", "Clerical Production Worker"], vector: [0.01376,0.01253,-0.03144,0.03139,0.00470,-0.04866,0.00859,0.00642,0.01319,0.00259,-0.05858,-0.02011,-0.01115,-0.08853,0.03086,0.01275,0.01181,0.02308,0.02071,0.00413,0.03851,-0.06205,-0.01262,0.01808,0.01621,-0.03929,0.01195,-0.02698,0.03182,-0.03911,-0.05756,0.09309,0.04305,-0.00994,0.03306,0.00764,0.02907,-0.04097,-0.02057,-0.02848,0.00404,0.01075,-0.00091,0.03157,0.02872,0.04349,-0.02855,0.04611,0.00090,0.02787,0.01428,-0.00597,-0.01931,-0.03456,0.02239,0.08065,0.01183,-0.01350,0.01244,-0.03243,0.02442,0.00752,-0.06938,0.00600,-0.03954,0.02123,0.01627,0.07136,-0.01387,0.02339,-0.01617,0.00804,-0.00251,0.02345,-0.03706,0.02121,0.00642,0.07007,0.01134,0.02901,0.02333,0.03965,0.07417,0.01231,0.07135,0.00972,-0.00946,0.04149,-0.00075,0.05785,-0.00697,-0.03380,0.00848,-0.01960,-0.01456,-0.03861,0.02815,0.01111,0.02308,-0.00354,-0.02854,-0.01179,0.09395,-0.03148,0.04246,-0.00828,0.04329,0.00069,-0.06246,0.02194,0.02329,0.04057,0.00103,-0.00078,0.07226,0.07242,0.06217,0.02569,0.04451,0.02145,-0.04761,0.01387,-0.01624,0.00809,-0.00946,-0.00256,0.00154,-0.00863,-0.00585,0.02025,-0.00045,-0.02730,-0.01151,-0.01858,0.02106,0.07539,0.01182,-0.00511,0.01634,-0.01321,-0.00030,-0.03685