  {soc: "45-4011.00", title: "Forest and Conservation Workers", description: "Under supervision, perform manual labor necessary to develop, maintain, or protect areas such as forests, forested areas, woodlands, wetlands, and rangelands through such activities as raising and transporting seedlings; combating insects, pests, and diseases harmful to plant life; and building structures to control water, erosion, and leaching of soil. Includes forester aides, seedling pullers, tree planters, and gatherers of nontimber forestry products such as pine straw.", alternateTitles: ["Blister Rust Eradicator", "Box Chipper", "Box Cutter", "Brusher", "Chemical Sprayer", "Chopper", "Christmas Tree Farm Worker", "Christmas Tree Farmer", "Christmas Tree Grader", "Christmas Tree Grower", "Cone Picker", "Conservation Coordinator"], vector: [-0.08350,0.01053,-0.07215,0.00723,-0.01994,-0.02803,0.00159,-0.00807,-0.01977,0.01574,-0.03736,0.00546,-0.03021,-0.03136,-0.07355,0.01517,-0.05896,0.01279,-0.01210,0.02771,-0.00950,-0.00815,-0.05922,0.01623,-0.01574,-0.02515,0.02727,0.03683,0.00761,-0.02605,0.01649,0.01727,-0.00392,0.03750,0.00569,0.02371,-0.02023,-0.00707,-0.07840,-0.04121,-0.01332,-0.04489,-0.00009,-0.00010,0.00297,0.01273,-0.06540,0.04610,-0.01889,0.00455,-0.01786,-0.01291,-0.04481,0.02772,-0.00500,0.07777,-0.03467,-0.02209,-0.03021,0.01516,-0.05990,-0.06514,-0.04573,-0.05549,0.07460,0.00687,-0.04893,0.06921,-0.03565,0.04662,0.06107,0.00142,0.00240,0.02113,-0.00139,0.00015,-0.00644,0.05156,-0.00708,-0.00213,0.04849,0.02644,0.00563,0.02398,0.05557,-0.01360,0.01785,0.01253,0.03590,0.01069,-0.00967,0.01501,-0.03450,-0.02030,0.01640,-0.04512,-0.03179,-0.03413,0.04990,-0.07701,-0.00976,0.04805,0.06048,-0.02282,0.01723,-0.02251,-0.04834,0.02458,-0.02537,0.03730,-0.02923,0.00222,0.00856,-0.05048,0.05435,0.01652,-0.01937,-0.04830,0.00581,0.01420,-0.02784,-0.02115,0.02160,0.01130,0.03530,0.01469,-0.00864,0.01820,-0.01066,0.05033,0.01417,-0.04008,0.02362,0.01648,0.03414,0.02688,-0.02243,0.