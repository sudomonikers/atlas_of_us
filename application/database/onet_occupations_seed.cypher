  {soc: "37-3013.00", title: "Tree Trimmers and Pruners", description: "Using sophisticated climbing and rigging techniques, cut away dead or excess branches from trees or shrubs to maintain right-of-way for roads, sidewalks, or utilities, or to improve appearance, health, and value of tree. Prune or treat trees or shrubs using handsaws, hand pruners, clippers, and power pruners. Works off the ground in the tree canopy and may use truck-mounted lifts.", alternateTitles: ["Arborist", "Brush Clearing Laborer", "Climber", "Climber Trimmer", "Diagnostician", "Grape Pruner", "Grounds Worker", "Groundsman", "Groundsperson", "Laborer", "Line Clearance Trimmer", "Line Clearing Tree Trimmer"], vector: [-0.06838,-0.01578,-0.03150,0.03651,-0.01522,-0.02138,0.05145,-0.02959,0.02586,-0.00247,-0.02235,-0.02121,0.02883,-0.05682,-0.01941,0.01172,-0.04408,0.00278,0.04253,-0.00955,-0.06869,0.01951,-0.01662,0.03540,0.04433,-0.03070,0.04754,-0.02792,0.01510,-0.03259,0.02682,0.03104,-0.03017,0.00251,-0.00082,-0.03097,-0.03732,0.02668,-0.03766,-0.04968,-0.00295,-0.00992,0.00017,-0.01524,-0.00732,0.00400,-0.01113,-0.00755,-0.04957,-0.03817,0.00516,0.01676,0.00182,0.01621,0.06029,-0.00674,0.02608,-0.02910,-0.01593,0.01088,-0.03811,-0.03844,0.03223,-0.05424,0.03011,-0.01468,-0.02120,0.02418,0.01582,0.03242,0.02403,-0.02733,-0.00637,0.01158,-0.02195,-0.00841,0.00171,0.04180,0.00236,0.00360,0.05736,0.05169,0.00339,0.07173,0.03001,-0.00988,-0.04419,0.00162,0.02541,0.00755,0.03589,-0.00439,-0.03663,-0.00929,0.01858,-0.05652,-0.01939,-0.04858,0.05475,-0.02668,0.00919,0.06266,0.02735,-0.00303,0.01226,-0.00247,-0.05718,0.03836,0.02121,-0.03281,-0.01841,0.02006,0.04166,-0.04822,0.00139,0.01672,0.04755,0.02150,-0.00192,0.04660,-0.05862,0.00148,0.02338,0.02095,0.00219,-0.02139,0.01554,0.04792,-0.00655,0.00944,0.00662,-0.04104,0.01982,0.01271,0.00987,-0.04656,-0.01172,0.02272,-0.01473,-0.03201,0.00791,0.00433,-0.01228,-0.01048,0.03767,0.02728,-0.00304,-0.01603,0.02087,0.08220,-0.01161,-0.06670,0.01788