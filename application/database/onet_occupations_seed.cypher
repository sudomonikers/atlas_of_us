  {soc: "39-1013.00", title: "First-Line Supervisors of Gambling Services Workers", description: "Directly supervise and coordinate activities of workers in assigned gambling areas. May circulate among tables, observe operations, and ensure that stations and games are covered for each shift. May verify and pay off jackpots. May reset slot machines after payoffs and make repairs or adjustments to slot machines or recommend removal of slot machines for repair. May plan and organize activities and services for guests in hotels/casinos.", alternateTitles: ["Blackjack Pit Boss", "Blackjack Supervisor", "Cardroom Manager", "Cardroom Supervisor", "Casino Floor Runner", "Casino Floor Supervisor", "Casino Floorperson", "Casino Manager", "Casino Services Supervisor", "Casino Shift Manager (CSM)", "Casino Slot Supervisor", "Casino Supervisor"], vector: [-0.01321,0.04395,-0.01560,0.02864,0.03789,-0.12356,0.06042,-0.00898,-0.00377,0.02924,0.00721,0.03944,-0.00805,0.03890,0.04308,-0.00046,-0.01053,0.03313,0.04147,0.03737,-0.04462,0.04827,-0.01926,0.02479,0.00349,-0.02724,0.01395,0.05570,0.03343,-0.00266,-0.03695,0.00048,-0.01592,0.02368,-0.01966,0.04570,-0.01589,0.01024,-0.02648,-0.05729,-0.02938,0.03954,-0.00147,0.03392,0.04973,0.04030,0.04374,-0.02142,-0.00268,-0.03463,-0.02591,0.02672,-0.00585,-0.02399,0.03610,-0.02340,0.03221,0.07504,-0.01864,-0.00503,-0.03070,-0.02399,-0.03139,0.01351,0.05828,0.04426,-0.02209,0.03952,0.00366,0.03616,0.03515,-0.01721,0.02877,-0.03037,-0.00542,-0.00396,-0.04419,0.01253,0.04854,-0.02201,0.01282,-0.02756,0.05779,-0.00290,0.04811,0.03061,0.06213,0.02143,0.00278,0.05904,-0.05751,0.02489,0.00286,-0.05198,0.00592,-0.07118,-0.01296,-0.00366,-0.00986,-0.02150,-0.04512,-0.00448,0.03050,0.02215,-0.02515,0.04135,0.03493,-0.00732,-0.01109,0.03066,-0.02829,0.02751,0.01680,-0.06889,-0.05105,-0.01942,0.02522,-0.02633,0.04608,0.01443,-0.02719,0.06436,-0.03222,0.03641,0.04072,-0.02152,0.03961,-0.06277,0.01537,0.03586,-0.01013,-0.00657,0.00141,-0.00862,0.00906,