  {soc: "47-4041.00", title: "Hazardous Materials Removal Workers", description: "Identify, remove, pack, transport, or dispose of hazardous materials, including asbestos, lead-based paint, waste oil, fuel, transmission fluid, radioactive materials, or contaminated soil. Specialized training and certification in hazardous materials handling or a confined entry permit are generally required. May operate earth-moving equipment or trucks.", alternateTitles: ["Abatement Worker", "Asbestos Abatement Worker", "Asbestos Coverer", "Asbestos Handler", "Asbestos Hazard Abatement Worker", "Asbestos Remover", "Asbestos Technician", "Asbestos Worker", "Decontamination and Decommissioning Operator (D and D Operator)", "Decontamination Worker", "Disaster Restoration Technician", "Hazard Waste Handler"], vector: [-0.06304,-0.06133,-0.01576,-0.03576,-0.01896,-0.02989,0.01861,0.02851,-0.02645,0.00976,0.03252,0.03242,-0.02644,-0.02956,0.05167,-0.02412,0.03324,-0.01399,0.03074,-0.01994,-0.00157,-0.01524,-0.02376,0.02917,0.00431,-0.04399,0.04214,0.01668,-0.00964,-0.02505,-0.05102,-0.00098,0.03088,-0.02278,-0.00418,0.03749,-0.02643,-0.01201,-0.03535,0.02432,-0.00321,-0.01837,-0.00113,0.03386,0.01380,0.00396,-0.06395,0.01932,-0.01795,0.03990,0.01157,-0.00144,-0.02757,-0.04461,0.01469,0.06602,-0.03928,-0.02211,-0.00886,0.04368,-0.07414,-0.01390,0.00165,-0.04445,0.03458,0.02780,0.01469,0.07269,-0.01431,-0.01910,0.05089,-0.04474,0.00640,0.03619,-0.03660,-0.07821,-0.00497,0.06202,0.01023,0.01233,0.05891,0.00029,0.02209,-0.00114,0.04766,-0.01272,0.00165,0.11242,0.04828,0.01564,0.03229,0.08525,-0.03083,-0.03275,0.05703,-0.01345,-0.04752,0.01712,-0.01348,-0.08933,-0.03925,0.05885,-0.00994,-0.01378,-0.01273,-0.01271,0.06524,0.08587,-0.05399,0.00244,0.02366,-0.02478,-0.02076,0.01833,0.02000,-0.06061,0.02502,-0.03403,0.01463,0.03019,0.02737,0.02660,-0.01271,0.03501,-0.00709,0.01995,-0.03529,-0.02594,-0.01855,0.00068,0.06384,-0.02386,0.08941,0.01155,0.07578,-0.03380,-0.01615,0.01342,0.01820,-0.04509