  {soc: "51-9141.00", title: "Semiconductor Processing Technicians", description: "Perform any or all of the following functions in the manufacture of electronic semiconductors: load semiconductor material into furnace; saw formed ingots into segments; load individual segment into crystal growing chamber and monitor controls; locate crystal axis in ingot using x-ray equipment and saw ingots into wafers; and clean, polish, and load wafers into series of special purpose furnaces, chemical baths, and equipment used to form circuitry and change conductive properties.", alternateTitles: ["Charge Preparation Technician", "Chemical Etch Operator", "Circuit Recorder", "Crystal Cutter", "Crystal Finisher", "Crystal Grower", "Crystal Growing Technician", "Crystal Lapper", "Crystal Machining Coordinator", "Crystal Mounter", "Crystal Slicer", "Device Processing Engineer"], vector: [-0.01467,-0.02481,0.03128,-0.00437,-0.04327,-0.00033,0.03871,0.00037,0.07314,-0.00973,-0.00181,-0.02842,-0.05047,-0.06018,0.04342,0.02453,-0.02627,0.04190,0.08993,0.01133,0.01844,0.05301,0.02062,0.03392,-0.01979,0.01913,0.01580,0.01630,0.04708,-0.00522,-0.05412,-0.02913,0.01825,-0.06929,-0.04506,0.00104,0.01267,0.04901,-0.02824,0.00254,-0.04749,0.03114,-0.00073,0.02280,0.05715,-0.02302,0.02003,0.01427,0.01573,-0.02654,-0.01092,-0.00618,0.00546,-0.04030,0.04159,0.03080,-0.01287,0.04486,-0.01720,-0.00782,-0.09532,0.00915,-0.01465,0.03249,0.02741,-0.01308,-0.03928,0.06343,0.01733,-0.00083,-0.01132,-0.02846,0.05453,-0.01184,-0.00643,-0.04306,-0.07270,-0.00795,-0.04583,0.03343,-0.03784,0.05514,-0.03930,-0.01242,0.02958,0.05231,-0.02402,-0.04481,-0.00751,-0.00496,-0.00816,0.04481,0.00783,-0.01797,0.02191,-0.00754,-0.00666,-0.05545,-0.01998,-0.01053,-0.09556,0.02541,0.01428,0.04999,-0.02700,0.00609,0.00751,-0.00346,-0.05083,0.00072,0.03015,-0.01328,0.03985,-0.11356,0.03612,-0.01504,-0.00901,-0.05499,0.01765,0.00531,0.01003,0.06753,-0.01395,-0.02775,0.01581,0.01016,0.06539,-0.03056,0.01844,-0.03219,-0.02049,