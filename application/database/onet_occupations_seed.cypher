  {soc: "21-1022.00", title: "Healthcare Social Workers", description: "Provide individuals, families, and groups with the psychosocial support needed to cope with chronic, acute, or terminal illnesses. Services include advising family caregivers. Provide patients with information and counseling, and make referrals for other services. May also provide case and care management or interventions designed to promote health, prevent disease, and address barriers to access to healthcare.", alternateTitles: ["AIDS Social Worker", "Bereavement Counselor", "Case Manager", "Case Worker", "Caseworker", "Certified Health Care Social Worker", "Certified Social Worker in Health Care (C-SWHC)", "Client Advocate", "Clinical Social Worker", "Disability Advocate", "Disability Coordinator", "Disability Specialist"], vector: [0.02058,-0.02152,-0.00291,-0.02136,0.01021,-0.01147,-0.00135,0.01113,-0.00252,0.05415,0.00435,0.07089,-0.08340,0.04229,0.00784,-0.02694,-0.02265,-0.01879,-0.00912,0.06048,0.01140,-0.03429,0.01306,0.01664,-0.03916,0.00298,0.01936,-0.02392,-0.00293,0.00106,0.04120,0.03665,-0.01687,-0.01299,-0.03788,0.01650,0.02255,-0.01462,-0.00774,0.03793,-0.05612,0.08434,-0.00129,0.01695,-0.04058,-0.04888,0.02118,-0.00671,-0.00427,-0.02054,0.00066,0.05465,-0.03602,-0.03087,0.05010,0.00982,-0.00205,-0.02402,-0.02652,0.01843,-0.04924,-0.01026,-0.04756,0.04127,0.01146,0.00021,-0.02676,0.03114,-0.05366,-0.01803,-0.01386,0.01616,-0.01318,-0.07127,-0.03676,0.00722,0.05042,-0.03259,-0.00835,0.05166,-0.01661,0.01889,0.02381,0.00115,0.04379,-0.01705,-0.00955,0.06583,0.00424,0.06154,-0.01992,0.02155,-0.00013,-0.02004,0.02358,-0.02971,-0.05403,0.05128,-0.00229,-0.02396,0.05842,0.00291,0.02879,-0.05456,0.02325,-0.01029,-0.04689,0.00114,-0.01466,0.02423,0.06640,-0.00549,-0.05210,-0.03860,-0.01862,0.01571,0.07352,0.08030,0.02842,0.04265,0.03985,-0.03637,0.01379,0.00455,-0.00973,-0.04531,-0.01118,-0.04605,-0.02746,0.00288,-0.01520,0.02834,-0.02073,-0.04394,-0.00653,-0.04436,-0.03438,0.03633,-0.0