  {soc: "17-3024.00", title: "Electro-Mechanical and Mechatronics Technologists and Technicians", description: "Operate, test, maintain, or adjust unmanned, automated, servomechanical, or electromechanical equipment. May operate unmanned submarines, aircraft, or other equipment to observe or record visual information at sites such as oil rigs, crop fields, buildings, or for similar infrastructure, deep ocean exploration, or hazardous waste removal. May assist engineers in testing and designing robotics equipment.", alternateTitles: ["Automation Technician (Automation Tech)", "Automation Test Specialist", "Calibration Technician", "Certified Control Systems Technician", "Commercial Drone Operator", "Commercial Drone Pilot", "Commercial Drone Technician", "Drone Operator", "Drone Pilot", "Drone Technician", "Electrical and Instrumentation Technician (E and I Tech)", "Electro-Mechanic"], vector: [-0.07644,0.00850,-0.05214,0.03776,-0.00719,0.00950,0.05781,-0.01519,0.03714,0.02422,-0.01065,-0.01335,-0.01005,0.00782,0.02237,0.01207,-0.00914,0.02987,0.02601,0.01942,-0.00848,0.01270,-0.02809,0.00419,-0.00968,0.04569,-0.01201,-0.01704,0.04579,0.04622,-0.02866,0.00146,0.03665,-0.02835,0.03663,-0.02479,-0.01005,-0.00951,-0.01820,0.02471,-0.01307,0.02182,-0.00013,-0.02646,-0.01861,0.00523,0.01002,0.04144,-0.00110,-0.02168,-0.01219,-0.01633,0.02841,0.01186,-0.00062,0.01617,0.00040,-0.00896,0.04162,0.05269,-0.03892,-0.00153,0.01918,-0.00004,0.03149,-0.03597,0.06601,0.03647,-0.02910,0.03623,-0.03546,-0.00721,-0.00434,-0.03778,-0.06473,-0.02959,0.00451,0.02774,-0.04140,0.01601,-0.00498,0.04578,0.00897,-0.00998,0.03732,0.02405,0.02133,-0.01022,0.04420,-0.05495,0.00512,0.03205,0.02407,-0.03010,0.03133,0.00547,-0.02295,-0.00610,-0.01400,0.03366,0.02308,0.00918,-0.00526,0.05042,-0.02575,0.00370,0.03123,0.00584,0.01045,-0.01306,0.02002,0.04716,0.03345,-0.06832,0.04204,0.02142,0.01425,0.01786,0.00969,0.02827,-0.01199,0.05135,0.05036,0.04078,0.00106,-0.03485,0.04163,-0.05301,-0.02940,0.04