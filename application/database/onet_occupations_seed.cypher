  {soc: "37-2011.00", title: "Janitors and Cleaners, Except Maids and Housekeeping Cleaners", description: "Keep buildings in clean and orderly condition. Perform heavy cleaning duties, such as cleaning floors, shampooing rugs, washing walls and glass, and removing rubbish. Duties may include tending furnace and boiler, performing routine maintenance activities, notifying management of need for repairs, and cleaning snow or debris from sidewalk.", alternateTitles: ["Airport Attendant", "Alley Cleaner", "Blinds Cleaner", "Blinds Washer", "Brass Cleaner", "Brass Polisher", "Building Attendant", "Building Custodian", "Building Exterior Cleaner", "Building Maintenance Custodian", "Building Services Technician (Building Services Tech)", "Building Services Worker"], vector: [-0.05854,-0.00243,-0.03376,-0.02493,-0.02807,-0.01466,-0.01457,0.04860,-0.00888,0.04575,0.00741,0.07418,-0.01415,0.00196,-0.00216,0.00941,0.02114,-0.03940,-0.00177,0.03410,0.06440,0.00580,-0.06980,0.00122,-0.04324,-0.00583,-0.01959,-0.01386,0.06267,-0.03588,0.01648,-0.00676,0.02854,-0.01091,-0.01641,0.01457,-0.01436,-0.00389,-0.12233,0.02876,0.02637,-0.04500,-0.00086,-0.03881,0.01089,0.04239,0.03525,0.04421,-0.05876,0.00739,0.02581,0.00870,-0.03582,-0.05221,0.03681,-0.01216,0.03854,-0.02863,-0.03195,-0.01484,-0.02763,-0.00345,-0.02124,-0.02342,0.02214,0.00079,-0.05513,0.08221,0.01274,-0.04316,0.03455,-0.00347,0.00297,0.01198,-0.06202,-0.03585,-0.03356,0.08489,-0.01350,0.05339,0.03042,0.03743,-0.00644,0.00525,0.04300,0.01934,-0.01090,0.08095,0.00827,-0.02878,0.02077,0.02979,-0.03283,-0.08090,0.02463,-0.06651,-0.05606,-0.03185,0.04898,-0.08401,-0.01343,0.06243,0.01580,-0.05638,-0.03556,-0.01313,0.01020,0.07894,-0.03105,-0.03565,0.02446,-0.00799,0.02162,0.00175,0.01600,-0.00069,0.03870,-0.08559,0.03196,0.02315,-0.05172,0.00409,0.01146,0.00629,0.01676,-0.05859,-0.00107,-0.03673,-0.03879,0.00978,0.04572,-0.02621,0.00137,0.04058,-0.00442,-0.01330,-0.05322,0.00993,0.06206,0.01947,-0.03582,-0.01034,-0.00848,-