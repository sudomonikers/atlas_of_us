  {soc: "47-2011.00", title: "Boilermakers", description: "Construct, assemble, maintain, and repair stationary steam boilers and boiler house auxiliaries. Align structures or plate sections to assemble boiler frame tanks or vats, following blueprints. Work involves use of hand and power tools, plumb bobs, levels, wedges, dogs, or turnbuckles. Assist in testing assembled vessels. Direct cleaning of boilers and boiler furnaces. Inspect and repair boiler fittings, such as safety valves, regulators, automatic-control mechanisms, water columns, and auxiliary machines.", alternateTitles: ["Assembler", "Boiler Control Technician (Boiler Control Tech)", "Boiler Erector", "Boiler Fitter", "Boiler Installer", "Boiler Maker", "Boiler Mechanic", "Boiler Reliner", "Boiler Repairman", "Boiler Service Technician (Boiler Service Tech)", "Boiler Setter", "Boiler Shop Mechanic"], vector: [0.00458,-0.00657,-0.01943,-0.03733,-0.00270,-0.01992,0.04609,-0.02265,-0.00193,-0.07249,-0.00548,0.06872,-0.06669,-0.05011,0.02104,-0.00308,-0.04424,0.02904,0.00955,0.01419,0.03337,0.03777,-0.02473,0.00429,-0.03623,0.03337,0.00840,-0.01123,0.03320,-0.02149,-0.04138,0.05427,-0.00140,-0.02403,-0.01980,0.01400,-0.07495,-0.05810,-0.04488,0.01531,0.01448,0.00499,-0.00043,-0.04324,0.00217,0.01575,0.03787,0.02071,-0.00412,-0.00329,-0.00389,0.02918,0.02379,-0.02281,-0.01044,0.02801,0.00599,-0.03327,-0.03943,0.02375,0.04018,0.05204,0.01705,-0.01388,0.07974,0.01162,-0.00624,0.06244,0.02366,0.01532,0.00488,-0.04066,-0.00651,-0.01241,-0.07812,-0.04098,0.03139,0.02620,-0.02987,-0.04370,-0.00108,0.00289,-0.01493,-0.02742,0.01452,0.01454,-0.02234,0.02755,0.07214,-0.02540,-0.00636,0.02677,0.03664,0.00711,-0.02762,-0.06525,-0.07662,0.06439,0.04308,0.00948,-0.05212,-0.02655,0.06193,-0.06369,0.03264,0.01344,-0.01572,0.01801,-0.03005,0.00725,-0.02289,0.03598,-0.00089,-0.01519,0.02060,-0.02423,0.00867,-0.02063,0.02178,0.00655,0.00742,0.00461,-0.00986,0.01927,0.00880,0.00787,0.00171,-0.06030,0.01776,-0.00018,-0.02096,-0