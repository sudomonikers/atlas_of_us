  {soc: "19-1012.00", title: "Food Scientists and Technologists", description: "Use chemistry, microbiology, engineering, and other sciences to study the principles underlying the processing and deterioration of foods; analyze food content to determine levels of vitamins, fat, sugar, and protein; discover new food sources; research ways to make processed foods safe, palatable, and healthful; and apply food science knowledge to determine best ways to process, package, preserve, store, and distribute food.", alternateTitles: ["Corporate Food Scientist", "Crop Advisor", "Dairy Bacteriologist", "Enologist", "Fermentation Scientist", "Flavorist", "Food and Drug Research Scientist", "Food Engineer", "Food Preservation Scientist", "Food Processing Scientist", "Food Safety Auditor", "Food Safety Regulatory Manager"], vector: [-0.00319,0.04653,0.03135,0.00745,-0.03213,0.04003,0.04886,0.00290,-0.01738,0.03367,-0.04272,-0.03529,-0.00580,0.03858,0.00760,-0.04860,0.00909,0.00231,0.09751,-0.01104,-0.00828,-0.00058,0.01245,0.02329,-0.02034,0.04944,0.03315,-0.02362,0.06532,-0.04808,-0.03108,0.03143,0.01394,-0.00814,0.00442,-0.01006,0.03327,0.00039,-0.05164,-0.00274,-0.05195,-0.00533,-0.00095,-0.06728,-0.00797,0.03222,-0.01989,-0.02764,-0.00343,-0.00127,-0.07549,-0.03878,-0.00791,0.04979,-0.03069,0.04798,0.01767,0.04128,0.01253,0.03797,-0.01616,-0.02856,-0.00561,-0.05031,-0.01300,-0.01448,0.01442,0.04806,-0.02313,0.03888,0.02495,0.00087,-0.02338,-0.03537,0.02153,-0.00636,-0.00200,-0.00217,-0.01238,0.10275,-0.02494,0.08379,0.02896,-0.00549,0.02873,0.02391,0.01334,0.03517,0.05516,0.00944,0.05698,-0.00589,-0.00911,0.00001,0.05055,-0.06590,-0.04184,-0.05951,0.01087,0.05211,-0.02999,0.01767,0.03012,0.06325,0.04824,0.00818,0.02012,-0.02511,-0.05642,-0.00072,0.02024,-0.05153,0.03814,0.00900,-0.02646,0.03414,0.04997,0.00779,-0.07290,0.00893,0.01132,0.03641,0.01428,0.03757,-0.01532,0.00926,0.03290,-0.04761,-0.01389,-0.05359,0.03560,0.04450,0.03286,0.03844,0.01087,0.05688,-0.01106,0.02005,-0.