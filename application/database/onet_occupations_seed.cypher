  {soc: "21-1013.00", title: "Marriage and Family Therapists", description: "Diagnose and treat mental and emotional disorders, whether cognitive, affective, or behavioral, within the context of marriage and family systems. Apply psychotherapeutic and family systems theories and techniques in the delivery of services to individuals, couples, and families for the purpose of treating such diagnosed nervous and mental disorders.", alternateTitles: ["ABA Behavior Therapist (Applied Behavior Analysis Behavior Therapist)", "Behavior Intervention Specialist", "Behavior Specialist", "Behavior Support Specialist", "Behavior Technician (Behavior Tech)", "Behavior Therapist", "Behavioral Analyst", "Behavioral Health Clinician", "Behavioral Specialist", "Behavioral Therapist", "Bilingual Clinician", "Child and Adolescent Therapist"], vector: [-0.08288,0.06177,-0.00472,0.04929,-0.04771,-0.00167,-0.01266,-0.03388,0.05310,0.04365,0.00994,-0.00098,-0.03040,0.03047,0.01899,-0.01989,-0.02693,0.01144,0.04457,0.01240,-0.00178,0.05836,0.01399,0.00864,-0.02590,-0.02994,-0.02256,0.00427,0.01037,0.01820,-0.04243,-0.02213,-0.01607,0.03053,-0.01427,0.01687,-0.01237,0.02512,-0.01655,-0.02535,-0.00809,-0.02682,-0.00030,-0.01413,0.00373,-0.06029,0.03145,0.01448,0.02201,0.04148,-0.01633,0.01781,-0.05849,0.00594,0.00977,-0.02395,-0.04658,-0.00059,-0.00112,0.03973,-0.03278,-0.03655,-0.03122,0.02762,-0.01628,-0.05534,-0.00269,0.05211,0.03068,0.04783,0.04525,-0.02310,0.04144,-0.03776,0.03533,0.06314,0.04237,-0.01513,0.00270,0.06567,0.01347,0.02339,0.03161,-0.01867,0.02324,0.02089,-0.02716,-0.03125,-0.03779,-0.04987,0.04118,0.00133,0.00630,0.03844,0.00448,-0.02793,0.00204,0.04286,0.00925,0.02788,-0.03563,0.06108,0.01291,0.02887,0.06675,-0.02268,0.01329,-0.04580,-0.02845,-0.00654,-0.02061,-0.02502,0.01042,-0.07147,-0.00815,0.02164,0.07030,-0.00474,-0.04421,-0.03322,-0.02912,0.00881,-0.00062,0.08767,0.03140,-0.03790,0.01585,0.03782,-0.00015,0.01393,-0.01751,-0.03316,0.02855,0.01051,0.01043,0.03155,-0.0