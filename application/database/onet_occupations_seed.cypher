  {soc: "29-2033.00", title: "Nuclear Medicine Technologists", description: "Prepare, administer, and measure radioactive isotopes in therapeutic, diagnostic, and tracer studies using a variety of radioisotope equipment. Prepare stock solutions of radioactive materials and calculate doses to be administered by radiologists. Subject patients to radiation. Execute blood volume, red cell survival, and fat absorption studies following standard laboratory techniques.", alternateTitles: ["Certified Nuclear Medicine Technologist (CNMT)", "Isotope Technician", "Isotope Technologist", "Medical Radiation Dosimetrist", "Nuclear Cardiology Technologist", "Nuclear Medical Technologist", "Nuclear Medicine PET-CT Technologist (Nuclear Medicine Positron Emission Tomography - Computed Tomography Technologist)", "Nuclear Medicine Technician", "Nuclear Medicine Technologist (NMT)", "Nuclear Technologist", "PET Technologist (Positron Emission Tomography Technologist)", "Radiation Safety Officer"], vector: [-0.01966,0.01047,-0.02102,-0.02687,-0.01637,-0.00655,-0.03011,-0.00528,-0.02069,0.03941,0.02997,0.03502,0.00266,0.08703,0.02691,0.03719,-0.06599,-0.05538,0.07242,0.00797,-0.02604,-0.02147,-0.00281,0.01895,-0.02893,0.02660,-0.03168,-0.04633,0.04645,0.04360,-0.01302,0.02956,0.02003,-0.07933,0.03616,-0.01056,-0.03403,0.05141,-0.01453,0.01282,0.01384,-0.01412,-0.00097,0.05301,-0.00308,-0.02420,0.03221,-0.01545,-0.01805,-0.02041,-0.05614,0.03248,-0.01475,0.01138,-0.00720,0.02403,-0.00430,-0.00214,0.00932,0.01055,-0.04328,-0.02343,0.02095,-0.02415,-0.02086,-0.03456,0.02626,-0.01081,-0.02759,0.02459,-0.00214,-0.01017,-0.02349,-0.00406,-0.02136,0.02443,0.00557,0.03811,0.02104,-0.01625,-0.03402,-0.00168,-0.02718,0.03178,0.04572,0.01073,0.03395,-0.01294,0.03203,0.00292,0.00101,0.06584,0.01923,-0.00971,-0.00363,-0.01611,-0.06955,0.00579,-0.00768,0.02160,-0.03558,-0.01960,0.01320,0.07284,-0.00319,0.02295,0.04130,-0.00456,-0.01442,0.02793,0.01187,-0.00796,0.03585,-0.02588,-0.00369,0.00963,-0.0642