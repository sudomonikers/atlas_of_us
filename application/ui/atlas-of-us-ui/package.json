{
  "name": "Atlas Of Us",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && npm run deploy:assets && npm run deploy:site",
    "deploy:assets": "aws s3 sync dist/assets s3://atlas-of-us-site/assets --cache-control 'public,max-age=31536000,immutable'",
    "deploy:site": "aws s3 sync dist s3://atlas-of-us-site --exclude 'assets/*' --delete --cache-control no-cache"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "flag-icons": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
